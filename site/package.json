{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run --exclude \"tests/dist/**\" --exclude \"tests/e2e/**\"",
    "test:dist": "npm run build && vitest run tests/dist",
    "test:e2e": "vitest run tests/e2e",
    "generate-overlays": "node --import tsx scripts/generate-overlays.mjs",
    "prebuild": "npm run generate-overlays && node --input-type=commonjs -e \"const fs=require('fs');const src='src/assets/images/home/clown-zauberer-hero.jpg';const dst='public/images/og-startseite.jpg';try{fs.unlinkSync(dst)}catch(e){}fs.copyFileSync(src,dst)\"",
    "test:seo": "node scripts/seo-assertions.mjs",
    "snapshot:content": "tsx scripts/snapshot-content.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "astro": "^7.3.5",
    "motion": "^13.5.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
