---
// Legacy look (Tailwind + inline Poppins). Pages move to V2Layout one by one.
import Document from './Document.astro';
import type { Props as DocumentProps } from './Document.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
import '../styles/fonts.css';

export type Props = Omit<DocumentProps, 'bodyClass'>;
---

<Document {...Astro.props}>
  <!-- legacy critical CSS (Poppins, white body, Tailwind basics): legacy pages only -->
  <Fragment slot="head">
    <style is:inline>
      *{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:hidden}body{margin:0;background:#fff;color:#1f2025;font-family:Poppins,Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;font-size:17px;line-height:1.6;overflow-x:hidden!important;overflow-y:auto!important}header{width:100%;z-index:50}img{max-width:100%;height:auto}a{color:inherit;text-decoration:none}.relative{position:relative}.absolute{position:absolute}.inset-0{inset:0}.overflow-hidden{overflow:hidden}.w-full{width:100%}.h-full{height:100%}.object-cover{object-fit:cover}.text-white{color:#fff}.text-center{text-center}.font-extrabold{font-weight:800}.bg-white{background:#fff}.flex{display:flex}.items-center{align-items:center}.justify-center{justify-content:center}
    </style>
  </Fragment>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

    <!-- Mobile Sticky-CTA: Anrufen + Anfragen immer erreichbar (nur < md) -->
    <div class="mobile-cta-bar md:hidden" role="navigation" aria-label="Schnellkontakt">
      <a href="tel:+491721517578" class="mobile-cta-call">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#d7393e" width="18" height="18" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
        Anrufen
      </a>
      <a href="/kontakt/" class="mobile-cta-contact">Jetzt anfragen</a>
    </div>
    <style>
      .mobile-cta-bar {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 60;
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid #e5e7eb;
        padding-bottom: env(safe-area-inset-bottom);
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
      }
      .mobile-cta-call,
      .mobile-cta-contact {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.9rem 0.5rem;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
      }
      .mobile-cta-call { background: #ffffff; color: #1f2025; }
      .mobile-cta-contact { background: #d7393e; color: #ffffff; }
      @media (min-width: 768px) {
        .mobile-cta-bar { display: none; }
      }
      @media (max-width: 767.98px) {
        :global(body) { padding-bottom: calc(3.4rem + env(safe-area-inset-bottom)); }
      }
    </style>

    <!-- Floating WhatsApp-Button (nur Mobile, angedockt auf der Naht der CTA-Leiste) -->
    <WhatsAppButton />
</Document>
