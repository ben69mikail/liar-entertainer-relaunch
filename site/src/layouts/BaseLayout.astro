---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SiteHeader from '../components/v2/SiteHeader.astro';
import SiteFooter from '../components/v2/SiteFooter.astro';
import StickyCta from '../components/v2/StickyCta.astro';
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/motion.css';
import { zoneFor, alternatesFor } from '../lib/site-map';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  heroPreload?: string;
  /** 'v2' = relaunch design (zone tokens, new header/footer/sticky CTA). Pages opt in one by one. */
  design?: 'legacy' | 'v2';
}

const {
  title,
  description = 'Clown Zauberer mit TOP Bewertungen in NRW buchen: die lustigste Clown- und Zaubershow für Ihr Event! Lustig! Magisch! Preisfreundlich!',
  keywords,
  canonical = Astro.url.href,
  ogImage = 'https://liar-entertainer.com/images/og-startseite.jpg',
  ogType = 'website',
  structuredData,
  noindex = false,
  breadcrumbs,
  heroPreload,
  design = 'legacy',
} = Astro.props;
const v2 = design === 'v2';

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url.startsWith('http') ? item.url : `https://liar-entertainer.com${item.url}`
  }))
} : null;

const canonicalUrl = canonical.startsWith('http')
  ? canonical
  : `https://liar-entertainer.com${canonical}`;

// og:image MUSS absolut sein (Open-Graph-Spec; relative Pfade brechen
// WhatsApp/Facebook-Previews). Seiten übergeben teils Astro-Asset-Pfade (/_astro/...).
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : `https://liar-entertainer.com${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://liar-entertainer.com/#business",
  "name": "Clown Zauberer LIAR",
  "description": "Professioneller Clown, Zauberer und Entertainer in NRW",
  "image": "https://liar-entertainer.com/images/og-startseite.jpg",
  "url": "https://liar-entertainer.com",
  "telephone": "+491721517578",
  "email": "info@liar-entertainer.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Beethovenstr. 15",
    "addressLocality": "Gladbeck",
    "addressRegion": "NW",
    "postalCode": "45966",
    "addressCountry": "DE"
  },
  "logo": "https://liar-entertainer.com/images/og-startseite.jpg",
  "founder": {
    "@type": "Person",
    "@id": "https://liar-entertainer.com/#person",
    "name": "Michaël Prescler",
    "alternateName": "Clown Zauberer LIAR",
    "jobTitle": "Clown, Zauberer & Entertainer",
    "description": "Michaël Prescler, Künstlername LIAR, ist seit 2009 hauptberuflich Clown und Zauberer in Gladbeck (NRW). Er spielt rund 400 Shows pro Jahr und arbeitet auf Deutsch und Französisch.",
    "url": "https://liar-entertainer.com/ueber-mich/",
    // Audit Runde 2, Massnahme A1 (12.08.2026): aus dem entfernten zweiten
    // Person-Knoten in index.astro hierher gezogen, damit die Information
    // erhalten bleibt, aber an genau einer Entitaet haengt. Ballonmodellage
    // bewusst nicht uebernommen (abgewertete Zusatzleistung).
    "knowsAbout": ["Kinderzauberer", "Zaubershow für Kinder", "Kindergeburtstag", "Clownerie", "Zauberei", "Close-up Magie"],
    "knowsLanguage": ["de", "fr"],
    "birthPlace": { "@type": "Country", "name": "Frankreich" },
    "hasOccupation": {
      "@type": "Occupation",
      "name": "Clown und Zauberer",
      "occupationLocation": { "@type": "City", "name": "Gladbeck" }
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Erweitertes polizeiliches Führungszeugnis"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Ausbildung zum Animateur (Schauspiel, Tanz, Zauberei, Ballonmodellage)"
      }
    ],
    "sameAs": [
      "https://www.facebook.com/clownzaubererliar",
      "https://www.instagram.com/clown_zauberer_liar/",
      "https://www.linkedin.com/in/michael-prescler-b2308832/",
      "https://www.youtube.com/watch?v=Cop0SqRIX4Y"
    ]
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 51.5658,
    "longitude": 6.9857
  },
  "priceRange": "€€",
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "09:00",
    "closes": "20:00"
  }],
  // SEO-Audit 11.08.2026, Massnahme H5: areaServed auf den erklaerten Radius
  // geschaerft. Vorher standen Koeln (~70 km, ohne eigene Landingpage), Duesseldorf
  // (40 km) und Dortmund (34 km) gleichrangig neben Gladbeck, waehrend Dorsten,
  // Herten, Marl und Dinslaken (11-17 km, je mit eigener Stadtseite) ganz fehlten.
  // Der GeoCircle quantifiziert Naehe, was eine reine Staedteliste nicht kann.
  // Duesseldorf/Dortmund/Duisburg bleiben im Service-Schema ihrer eigenen
  // Stadtseiten - nur das globale Signal wird praeziser.
  "areaServed": [
    {
      "@type": "GeoCircle",
      "geoMidpoint": {"@type": "GeoCoordinates", "latitude": 51.5658, "longitude": 6.9857},
      "geoRadius": "20000"
    },
    {"@type": "City", "name": "Gladbeck"},
    {"@type": "City", "name": "Bottrop"},
    {"@type": "City", "name": "Gelsenkirchen"},
    {"@type": "City", "name": "Dorsten"},
    {"@type": "City", "name": "Herten"},
    {"@type": "City", "name": "Oberhausen"},
    {"@type": "City", "name": "Essen"},
    {"@type": "City", "name": "Marl"},
    {"@type": "City", "name": "Recklinghausen"},
    {"@type": "City", "name": "Dinslaken"},
    {"@type": "City", "name": "Herne"},
    {"@type": "City", "name": "Mülheim an der Ruhr"},
    {"@type": "City", "name": "Bochum"},
    {"@type": "State", "name": "Nordrhein-Westfalen"}
  ],
  "knowsAbout": ["Kinderzauberer", "Zaubershow für Kinder", "Kindergeburtstag", "Clownerie", "Zauberei", "Clown Zauberer"],
  "sameAs": [
    "https://www.facebook.com/clownzaubererliar",
    "https://www.instagram.com/clown_zauberer_liar/",
    "https://www.linkedin.com/in/michael-prescler-b2308832/",
    "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
    "https://www.google.com/maps/place/Clown+Zauberer+LIAR,+Beethovenstra%C3%9Fe+15,+45966+Gladbeck/data=!4m2!3m1!1s0x47b8eed84b67a41d:0x775f1c8f05280e76"
  ]
};

// WebSite-Knoten: stärkt den Entity-Graph (KI-Suche / Knowledge Graph)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://liar-entertainer.com/#website",
  "url": "https://liar-entertainer.com",
  "name": "Clown Zauberer LIAR",
  "inLanguage": "de",
  "publisher": { "@id": "https://liar-entertainer.com/#business" }
};

// WebPage-Knoten pro Seite: korrekter Träger für speakable
// (speakable ist nur auf WebPage/Article definiert, nicht auf LocalBusiness)
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": title,
  "inLanguage": "de",
  "isPartOf": { "@id": "https://liar-entertainer.com/#website" },
  "about": { "@id": "https://liar-entertainer.com/#business" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".hero-subtitle"]
  }
};
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'de'} data-zone={zoneFor(Astro.url.pathname)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Search Console Verification -->
    <!-- Füge deinen echten Code hier ein: Google Search Console → Einstellungen → Inhaberschaft bestätigen → HTML-Tag -->
    <!-- <meta name="google-site-verification" content="DEIN_CODE_HIER" /> -->

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternatesFor(Astro.url.pathname).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Clown Zauberer LIAR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preconnect: nur eigene Domain (keine externen Google-Verbindungen, DSGVO) -->
    <link rel="preconnect" href="https://liar-entertainer.com" />

    <!-- Hero Image Preload für LCP-Optimierung -->
    {heroPreload && <link rel="preload" as="image" href={heroPreload} fetchpriority="high" />}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#d7393e" />

    <!-- Critical CSS für sofortiges Rendering (Above-the-fold) -->
    <style is:inline>
      *{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:hidden}body{margin:0;background:#fff;color:#1f2025;font-family:Poppins,Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;font-size:17px;line-height:1.6;overflow-x:hidden!important;overflow-y:auto!important}header{width:100%;z-index:50}img{max-width:100%;height:auto}a{color:inherit;text-decoration:none}.relative{position:relative}.absolute{position:absolute}.inset-0{inset:0}.overflow-hidden{overflow:hidden}.w-full{width:100%}.h-full{height:100%}.object-cover{object-fit:cover}.text-white{color:#fff}.text-center{text-center}.font-extrabold{font-weight:800}.bg-white{background:#fff}.flex{display:flex}.items-center{align-items:center}.justify-center{justify-content:center}
    </style>

    <!-- Fonts: Google-Fonts-CDN entfernt (DSGVO) – System-Font-Fallback (Poppins falls lokal vorhanden). Selbst-Hosting siehe PR-Hinweis. -->

    <!-- Google Consent Mode v2 – Standard: alles verweigert. GA4 lädt erst nach Einwilligung (CookieConsent-Banner). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
    </script>

    <!-- Structured Data: LocalBusiness + WebSite + WebPage (global, @id-verknüpft) -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

    <!-- BreadcrumbList structured data -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Page-specific structured data -->
    {structuredData && (
      Array.isArray(structuredData)
        ? structuredData.map((sd) => (
            <script type="application/ld+json" set:html={JSON.stringify(sd)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class:list={{ v2 }}>
    {v2 ? <SiteHeader /> : <Header />}
    <main>
      <slot />
    </main>
    {v2 ? <SiteFooter /> : <Footer />}
    {v2 && <StickyCta />}

    {!v2 && (
      <Fragment>
    <!-- Mobile Sticky-CTA: Anrufen + Anfragen immer erreichbar (nur < md) -->
    <div class="mobile-cta-bar md:hidden" role="navigation" aria-label="Schnellkontakt">
      <a href="tel:+491721517578" class="mobile-cta-call">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#d7393e" width="18" height="18" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
        Anrufen
      </a>
      <a href="/kontakt/" class="mobile-cta-contact">Jetzt anfragen</a>
    </div>
    <style>
      .mobile-cta-bar {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 60;
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid #e5e7eb;
        padding-bottom: env(safe-area-inset-bottom);
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
      }
      .mobile-cta-call,
      .mobile-cta-contact {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.9rem 0.5rem;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
      }
      .mobile-cta-call { background: #ffffff; color: #1f2025; }
      .mobile-cta-contact { background: #d7393e; color: #ffffff; }
      @media (min-width: 768px) {
        .mobile-cta-bar { display: none; }
      }
      @media (max-width: 767.98px) {
        body:not(.v2) { padding-bottom: calc(3.4rem + env(safe-area-inset-bottom)); }
      }
    </style>

    <!-- Floating WhatsApp-Button (nur Mobile, angedockt auf der Naht der CTA-Leiste) -->
    <WhatsAppButton />
      </Fragment>
    )}

    <CookieConsent />

    <!-- Minimal JS: sticky nav + mobile menu handled inline in Header -->

    <!-- GA4-Ereignisse: Telefon-, E-Mail- und WhatsApp-Klicks als Conversion-Signale.
         Läuft über den gtag-Stub aus dem Head; Daten fließen nur, wenn GA4
         nach Consent-Opt-in geladen wurde (DSGVO-konform). -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest
          ? e.target.closest('a[href^="tel:"], a[href^="mailto:"], a[href*="wa.me"]')
          : null;
        if (!a || typeof window.gtag !== 'function') return;
        var href = a.getAttribute('href') || '';
        var eventName = href.indexOf('tel:') === 0
          ? 'phone_click'
          : href.indexOf('mailto:') === 0
            ? 'email_click'
            : 'whatsapp_click';
        window.gtag('event', eventName, {
          link_url: href,
          page_location: window.location.href
        });
      });
    </script>

    <script>
      import { initReveals } from '../lib/motion/reveal';
      initReveals();
    </script>
  </body>
</html>
