---
// Relaunch look: zone tokens, v2 header/footer/sticky contact. No legacy CSS on these pages.
import Document from './Document.astro';
import type { Props as DocumentProps } from './Document.astro';
import SiteHeader from '../components/v2/SiteHeader.astro';
import SiteFooter from '../components/v2/SiteFooter.astro';
import StickyCta from '../components/v2/StickyCta.astro';
import FontPreloads from '../components/v2/FontPreloads.astro';
import { zoneFor } from '../lib/site-map';
import '../styles/seam-fade.css';

export type Props = Omit<DocumentProps, 'bodyClass'> & { mainClass?: string };
const { mainClass, ...docProps } = Astro.props;
// kids / neutral: every dark stage fades into the page (seam-fade.css); adult opts in per page
const seam = zoneFor(Astro.url.pathname) !== 'adult';
---

<Document {...docProps} bodyClass="v2">
  <FontPreloads slot="head" />
  <SiteHeader />
  <main class:list={[mainClass, { 'seam-fade': seam }]}>
    <slot />
  </main>
  <SiteFooter />
  <StickyCta />
</Document>
