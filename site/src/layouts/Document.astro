---
// Shared document: <head> (SEO, schema, consent mode) + body scripts. Chrome comes from
// BaseLayout (legacy look) or V2Layout (relaunch look), so each page only ships its own CSS.
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/motion.css';
import { zoneFor, alternatesFor } from '../lib/site-map';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  heroPreload?: string;
  /** class on <body>, set by the chrome layout ('v2' for the relaunch look) */
  bodyClass?: string;
}

const {
  title,
  description = 'Clown Zauberer mit TOP Bewertungen in NRW buchen: die lustigste Clown- und Zaubershow für Ihr Event! Lustig! Magisch! Preisfreundlich!',
  keywords,
  canonical = Astro.url.href,
  ogImage = 'https://liar-entertainer.com/images/og-startseite.jpg',
  ogType = 'website',
  structuredData,
  noindex = false,
  breadcrumbs,
  heroPreload,
  bodyClass,
} = Astro.props;

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url.startsWith('http') ? item.url : `https://liar-entertainer.com${item.url}`
  }))
} : null;

const canonicalUrl = canonical.startsWith('http')
  ? canonical
  : `https://liar-entertainer.com${canonical}`;

// og:image MUSS absolut sein (Open-Graph-Spec; relative Pfade brechen
// WhatsApp/Facebook-Previews). Seiten übergeben teils Astro-Asset-Pfade (/_astro/...).
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : `https://liar-entertainer.com${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://liar-entertainer.com/#business",
  "name": "Clown Zauberer LIAR",
  "description": "Professioneller Clown, Zauberer und Entertainer in NRW",
  "image": "https://liar-entertainer.com/images/og-startseite.jpg",
  "url": "https://liar-entertainer.com",
  "telephone": "+491721517578",
  "email": "info@liar-entertainer.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Beethovenstr. 15",
    "addressLocality": "Gladbeck",
    "addressRegion": "NW",
    "postalCode": "45966",
    "addressCountry": "DE"
  },
  "logo": "https://liar-entertainer.com/images/og-startseite.jpg",
  "founder": {
    "@type": "Person",
    "@id": "https://liar-entertainer.com/#person",
    "name": "Michaël Prescler",
    "alternateName": "Clown Zauberer LIAR",
    "jobTitle": "Clown, Zauberer & Entertainer",
    "description": "Michaël Prescler, Künstlername LIAR, ist seit 2009 hauptberuflich Clown und Zauberer in Gladbeck (NRW). Er spielt rund 400 Shows pro Jahr und arbeitet auf Deutsch und Französisch.",
    "url": "https://liar-entertainer.com/ueber-mich/",
    // Audit Runde 2, Massnahme A1 (12.08.2026): aus dem entfernten zweiten
    // Person-Knoten in index.astro hierher gezogen, damit die Information
    // erhalten bleibt, aber an genau einer Entitaet haengt. Ballonmodellage
    // bewusst nicht uebernommen (abgewertete Zusatzleistung).
    "knowsAbout": ["Kinderzauberer", "Zaubershow für Kinder", "Kindergeburtstag", "Clownerie", "Zauberei", "Close-up Magie"],
    "knowsLanguage": ["de", "fr"],
    "birthPlace": { "@type": "Country", "name": "Frankreich" },
    "hasOccupation": {
      "@type": "Occupation",
      "name": "Clown und Zauberer",
      "occupationLocation": { "@type": "City", "name": "Gladbeck" }
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Erweitertes polizeiliches Führungszeugnis"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Ausbildung zum Animateur (Schauspiel, Tanz, Zauberei, Ballonmodellage)"
      }
    ],
    "sameAs": [
      "https://www.facebook.com/clownzaubererliar",
      "https://www.instagram.com/clown_zauberer_liar/",
      "https://www.linkedin.com/in/michael-prescler-b2308832/",
      "https://www.youtube.com/watch?v=Cop0SqRIX4Y"
    ]
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 51.5658,
    "longitude": 6.9857
  },
  "priceRange": "€€",
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "09:00",
    "closes": "20:00"
  }],
  // SEO-Audit 11.08.2026, Massnahme H5: areaServed auf den erklaerten Radius
  // geschaerft. Vorher standen Koeln (~70 km, ohne eigene Landingpage), Duesseldorf
  // (40 km) und Dortmund (34 km) gleichrangig neben Gladbeck, waehrend Dorsten,
  // Herten, Marl und Dinslaken (11-17 km, je mit eigener Stadtseite) ganz fehlten.
  // Der GeoCircle quantifiziert Naehe, was eine reine Staedteliste nicht kann.
  // Duesseldorf/Dortmund/Duisburg bleiben im Service-Schema ihrer eigenen
  // Stadtseiten - nur das globale Signal wird praeziser.
  "areaServed": [
    {
      "@type": "GeoCircle",
      "geoMidpoint": {"@type": "GeoCoordinates", "latitude": 51.5658, "longitude": 6.9857},
      "geoRadius": "20000"
    },
    {"@type": "City", "name": "Gladbeck"},
    {"@type": "City", "name": "Bottrop"},
    {"@type": "City", "name": "Gelsenkirchen"},
    {"@type": "City", "name": "Dorsten"},
    {"@type": "City", "name": "Herten"},
    {"@type": "City", "name": "Oberhausen"},
    {"@type": "City", "name": "Essen"},
    {"@type": "City", "name": "Marl"},
    {"@type": "City", "name": "Recklinghausen"},
    {"@type": "City", "name": "Dinslaken"},
    {"@type": "City", "name": "Herne"},
    {"@type": "City", "name": "Mülheim an der Ruhr"},
    {"@type": "City", "name": "Bochum"},
    {"@type": "State", "name": "Nordrhein-Westfalen"}
  ],
  "knowsAbout": ["Kinderzauberer", "Zaubershow für Kinder", "Kindergeburtstag", "Clownerie", "Zauberei", "Clown Zauberer"],
  "sameAs": [
    "https://www.facebook.com/clownzaubererliar",
    "https://www.instagram.com/clown_zauberer_liar/",
    "https://www.linkedin.com/in/michael-prescler-b2308832/",
    "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
    "https://www.google.com/maps/place/Clown+Zauberer+LIAR,+Beethovenstra%C3%9Fe+15,+45966+Gladbeck/data=!4m2!3m1!1s0x47b8eed84b67a41d:0x775f1c8f05280e76"
  ]
};

// WebSite-Knoten: stärkt den Entity-Graph (KI-Suche / Knowledge Graph)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://liar-entertainer.com/#website",
  "url": "https://liar-entertainer.com",
  "name": "Clown Zauberer LIAR",
  "inLanguage": "de",
  "publisher": { "@id": "https://liar-entertainer.com/#business" }
};

// WebPage-Knoten pro Seite: korrekter Träger für speakable
// (speakable ist nur auf WebPage/Article definiert, nicht auf LocalBusiness)
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": title,
  "inLanguage": "de",
  "isPartOf": { "@id": "https://liar-entertainer.com/#website" },
  "about": { "@id": "https://liar-entertainer.com/#business" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".hero-subtitle"]
  }
};
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'de'} data-zone={zoneFor(Astro.url.pathname)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Search Console Verification -->
    <!-- Füge deinen echten Code hier ein: Google Search Console → Einstellungen → Inhaberschaft bestätigen → HTML-Tag -->
    <!-- <meta name="google-site-verification" content="DEIN_CODE_HIER" /> -->

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    <link rel="canonical" href={canonicalUrl} />
    <slot name="head" />
    {alternatesFor(Astro.url.pathname).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Clown Zauberer LIAR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preconnect: nur eigene Domain (keine externen Google-Verbindungen, DSGVO) -->
    <link rel="preconnect" href="https://liar-entertainer.com" />

    <!-- Hero Image Preload für LCP-Optimierung -->
    {heroPreload && <link rel="preload" as="image" href={heroPreload} fetchpriority="high" />}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#d7393e" />

    <!-- Critical CSS für sofortiges Rendering (Above-the-fold) -->

    <!-- Fonts: Google-Fonts-CDN entfernt (DSGVO) – System-Font-Fallback (Poppins falls lokal vorhanden). Selbst-Hosting siehe PR-Hinweis. -->

    <!-- Google Consent Mode v2 – Standard: alles verweigert. GA4 lädt erst nach Einwilligung (CookieConsent-Banner). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
    </script>

    <!-- Structured Data: LocalBusiness + WebSite + WebPage (global, @id-verknüpft) -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

    <!-- BreadcrumbList structured data -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Page-specific structured data -->
    {structuredData && (
      Array.isArray(structuredData)
        ? structuredData.map((sd) => (
            <script type="application/ld+json" set:html={JSON.stringify(sd)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class={bodyClass}>
    <slot />

    <CookieConsent />

    <!-- Minimal JS: sticky nav + mobile menu handled inline in Header -->

    <!-- GA4-Ereignisse: Telefon-, E-Mail- und WhatsApp-Klicks als Conversion-Signale.
         Läuft über den gtag-Stub aus dem Head; Daten fließen nur, wenn GA4
         nach Consent-Opt-in geladen wurde (DSGVO-konform). -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest
          ? e.target.closest('a[href^="tel:"], a[href^="mailto:"], a[href*="wa.me"]')
          : null;
        if (!a || typeof window.gtag !== 'function') return;
        var href = a.getAttribute('href') || '';
        var eventName = href.indexOf('tel:') === 0
          ? 'phone_click'
          : href.indexOf('mailto:') === 0
            ? 'email_click'
            : 'whatsapp_click';
        window.gtag('event', eventName, {
          link_url: href,
          page_location: window.location.href
        });
      });
    </script>

    <script>
      import { initFx } from '../lib/motion/fx';
      initFx();
    </script>
  </body>
</html>
