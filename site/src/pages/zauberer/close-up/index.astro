---
/**
 * /zauberer/close-up/ — zauberer-liar.de/close-up-zauberer.html in the adult salon design
 * (user, 2026-10-07). Texts, photos and alt texts 1:1 from the frozen source page
 * (src/data/zauberer-closeup.json ← scripts/extract-zauberer-closeup.ts). Not in the menu:
 * reached from /zauberer/tisch-zauberer/ and, later, through the 301 from zauberer-liar.de.
 * Indexing follows ZAUBERER_CITIES_LIVE (same duplicate-content rule as the city pages).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import V2Layout from '../../../layouts/V2Layout.astro';
import MagicFrame from '../../../components/v2/adult/MagicFrame.astro';
import StageLights from '../../../components/v2/adult/StageLights.astro';
import SuitRule from '../../../components/v2/adult/SuitRule.astro';
import { ZAUBERER_CITIES_LIVE } from '../../../data/zauberer-cities';
import page from '../../../data/zauberer-closeup.json';
import { CONTACT } from '../../../data/site';
import '../../../styles/adult-kit.css';

const photos = import.meta.glob<ImageMetadata>('../../../assets/images/zauberer-closeup/*.webp', { eager: true, import: 'default' });
const photo = (file: string) => {
  const p = photos[`../../../assets/images/zauberer-closeup/${file}`];
  if (!p) throw new Error(`zauberer-closeup: photo ${file} missing (npx tsx scripts/extract-zauberer-closeup.ts --photos)`);
  return p;
};
const heroPhoto = photo(page.heroImg);
const introPhoto = photo(page.intro.img.file);
const PATH = '/zauberer/close-up/';
const URL_ABS = `https://liar-entertainer.com${PATH}`;
// playing cards speak German: Ass, König, Dame, Bube
const SUITS = ['♠', '♥', '♣', '♦'] as const;
const RANKS = ['A', 'K', 'D', 'B'] as const;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Close-up Zauberer / Tischzauberei',
    name: 'Close-up Zauberer NRW',
    url: URL_ABS,
    provider: { '@id': 'https://liar-entertainer.com/#business' },
    areaServed: { '@type': 'State', name: 'Nordrhein-Westfalen' },
  },
];
---

<V2Layout
  mainClass="ce-salon-page seam-fade"
  title="Close-up Zauberer NRW für Firmenevent, Messe & Empfang | LIAR"
  description="Close-up Zauberer LIAR für Firmenevent, Messe, Empfang & Gala in NRW ✓ Verblüffende Magie direkt vor Ihren Augen ✓ Deutsch & Französisch ✓ Jetzt anfragen!"
  canonical={URL_ABS}
  noindex={!ZAUBERER_CITIES_LIVE}
  ogImage={heroPhoto.src}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Zauberer', url: '/zauberer/' },
    { name: 'Close-up', url: PATH },
  ]}
  structuredData={structuredData}
>
  <section class="ce-hero ce-hero--stage">
    <StageLights />
    <div class="container ce-hero__grid">
      <div class="ce-hero__copy">
        <p class="ce-crumbs">
          <a href="/">Clown</a> » <a href="/zauberer/">Zauberer</a> » <span>Close-up</span>
        </p>
        <h1 class="ce-hero__title">Close-up <em>Zauberer</em> für Firmenevent, Messe &amp; Empfang</h1>
        <div class="ce-spot">
          <div class="ce-hero__frame ce-spot__frame">
            <MagicFrame corner="tr" rank="A" suit="♠">
              <Image src={heroPhoto} alt="Close-up Zauberer LIAR beim Galadiner in NRW" widths={[450, 720, 1080]} sizes="(max-width: 900px) 88vw, 736px" loading="eager" fetchpriority="high" />
            </MagicFrame>
          </div>
        </div>
        <SuitRule />
        <p class="ce-hero__claim ce-hero__claim--soft zu-lead">{page.lead}</p>
        <div class="ce-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-magnetic>Unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.phoneHref}>0172 – 151 75 78</a>
        </div>
      </div>
    </div>
  </section>

  <section class="ce-salon zu-intro">
    <div class="container zu-split">
      <div class="zu-prose">
        <p class="ce-eyebrow">{page.intro.eyebrow}</p>
        <h2 class="ce-h2">{page.intro.h2}</h2>
        <div class="ce-soft" set:html={page.intro.html} />
      </div>
      <div class="zu-photo" data-reveal>
        <MagicFrame corner="br" rank="K" suit="♥">
          <Image src={introPhoto} alt={page.intro.img.alt} widths={[400, 584]} sizes="(max-width: 900px) 88vw, 480px" loading="lazy" />
        </MagicFrame>
      </div>
    </div>
  </section>

  <section class="ce-salon zu-props">
    <div class="container">
      <SuitRule />
      <p class="ce-eyebrow ce-center">{page.props.eyebrow}</p>
      <h2 class="ce-h2 ce-center">{page.props.h2}</h2>
      <div class="ce-spread">
        {page.props.items.map((item, i) => (
          <div class:list={['ce-scard', { 'ce-pcard--red': i % 2 }]} data-reveal="tilt" data-reveal-delay={i * 0.08}>
            <span class:list={['ce-why__suit', { 'ce-red': i % 2 }]} aria-hidden="true">{SUITS[i % 4]}</span>
            <h3 class="ce-why__title">{item.title}</h3>
            <p class="ce-soft" set:html={item.html} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ce-salon zu-formats">
    <div class="container">
      <SuitRule />
      <p class="ce-eyebrow ce-center">{page.formats.eyebrow}</p>
      <h2 class="ce-h2 ce-center">{page.formats.h2}</h2>
      <div class="ce-hand zu-hand">
        {page.formats.items.map((f, i) => (
          <article class:list={['ce-hcard', 'ce-format', { 'ce-pcard--red': i % 2 }]} data-reveal="tilt" data-reveal-delay={i * 0.12}>
            <span class="ce-pcard__idx" aria-hidden="true">{RANKS[i]}<br />{SUITS[i]}</span>
            <span class="ce-pcard__idx ce-pcard__idx--end" aria-hidden="true">{RANKS[i]}<br />{SUITS[i]}</span>
            <div class="ce-hcard__photo">
              <MagicFrame corner="tr" rank={RANKS[i + 2]} suit={SUITS[i + 2]} style={`--sheen-delay: ${2.2 + i * 0.9}s`}>
                <Image src={photo(f.img.file)} alt={f.img.alt} widths={[400, 600]} sizes="(max-width: 900px) 84vw, 440px" loading="lazy" />
              </MagicFrame>
            </div>
            <div class="ce-format__body">
              <h3>{f.title}</h3>
              <p class="ce-soft" set:html={f.html} />
              <a href={f.href} class="ce-ink-link">{f.more}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ce-salon zu-gallery">
    <div class="container">
      <SuitRule />
      <h2 class="ce-h2 ce-center">{page.gallery.h2}</h2>
      <div class="zu-tiles">
        {page.gallery.items.map((g, i) => (
          <figure class="zu-tile" data-reveal data-reveal-delay={(i % 3) * 0.08}>
            <MagicFrame corner={i % 2 ? 'tl' : 'tr'} rank={RANKS[i % 4]} suit={SUITS[i % 4]}>
              <Image src={photo(g.file)} alt={g.alt} widths={[360, 540]} sizes="(max-width: 900px) 88vw, 340px" loading="lazy" />
            </MagicFrame>
            <figcaption>{g.cap}</figcaption>
          </figure>
        ))}
      </div>
      <p class="ce-center"><a class="btn btn--ghost" href={page.gallery.more.href}>{page.gallery.more.label}</a></p>
    </div>
  </section>

  <div class="ce-finale ce-stage ce-lit">
    <StageLights soft />
    <section class="ce-contact">
      <div class="container ce-center">
        <p class="ce-eyebrow">{page.cta.eyebrow}</p>
        <h2 class="ce-h2 zu-cta" set:html={page.cta.h2Html} />
        <p class="ce-soft ce-narrow">{page.cta.text}</p>
        <div class="ce-hero__actions">
          <a href="/kontakt/" class="btn btn--primary" data-magnetic>Anfrage senden</a>
          <a href={CONTACT.phoneHref} class="btn btn--ghost">Direkt anrufen</a>
        </div>
        <p><a class="zu-phone" href={CONTACT.phoneHref}>0172 – 151 75 78</a></p>
      </div>
    </section>
  </div>
</V2Layout>

<style>
  .zu-lead { max-width: 40rem; margin-inline: auto; }
  .zu-split { display: grid; gap: var(--space-4); align-items: center; }
  @media (min-width: 901px) { .zu-split { grid-template-columns: 1.15fr 0.85fr; } }
  .zu-prose :global(p) { margin-bottom: var(--space-2); }
  .zu-photo { width: min(100%, 30rem); justify-self: center; }
  /* two formats instead of the three-card hand of /zauberer/ */
  @media (min-width: 901px) {
    :global(.v2 main > .ce-salon .ce-hand.zu-hand) { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 58rem; margin-inline: auto; }
    :global(.v2 main > .ce-salon .zu-hand .ce-hcard:nth-child(1)) { rotate: -2deg; --ty: 1.2rem; }
    :global(.v2 main > .ce-salon .zu-hand .ce-hcard:nth-child(2)) { rotate: 2deg; --ty: 1.2rem; }
  }
  .zu-tiles { display: grid; gap: var(--space-4); margin: var(--space-4) auto; max-width: 68rem; }
  @media (min-width: 601px) { .zu-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 901px) { .zu-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; } }
  .zu-tile { margin: 0; text-align: center; }
  .zu-tile figcaption { margin-top: 0.6rem; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.75; }
  .zu-cta :global(span) { color: #d9b46a; }
  .zu-phone { font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.4rem); text-decoration: none; color: #d9b46a; }
  /* ghost buttons on the dark stages (hero, finale): light ink */
  .ce-hero .btn--ghost, .ce-finale .btn--ghost { color: #fbf8f1; border-color: rgb(251 248 241 / 0.65); background: transparent; }
  .ce-finale .ce-hero__actions { justify-content: center; margin-bottom: var(--space-2); }
</style>
