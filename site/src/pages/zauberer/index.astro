---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reviews from '../../components/v2/Reviews.astro';
import ReviewBadge from '../../components/v2/ReviewBadge.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/zauberer/zauberer-nrw.png';
import tischZaubererImg from '../../assets/images/zauberer/tisch-zauberer.jpg';
import buehneFeuerImg from '../../assets/images/zauberer/tisch-zauberer-nrw-buehne.png';
import kindergeburtstagImg from '../../assets/images/zauberer/kindergeburtstag.jpg';
import karteImg from '../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';

const seoTitle = "Zauberer NRW buchen – Zaubershow für Kinder & Erwachsene";
const seoDescription = 'Französischer Zauberer LIAR in NRW ✓ Professionelle Zaubershow für Kindergeburtstag, Hochzeit & Firmenevent ✓ Tischzauber & Bühnenzauberei ✓ 370+ Top-Bewertungen!';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Zauberer in NRW",
  "description": "Professioneller Zauberer LIAR in NRW – Close-up, Bühnenshow und Kinderzaubershow für Kindergeburtstag, Hochzeit und Firmenevent",
  "url": "https://liar-entertainer.com/zauberer/",
  "serviceType": ["Zauberer", "Bühnenzauberer", "Tischzauberer", "Kinderzauberer"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Was kostet ein Zauberer für Kinder in NRW?', acceptedAnswer: { '@type': 'Answer', text: 'Ich arbeite mit transparenten Festpreisen ohne versteckte Kosten. Alle Details zu den Paketen und Preisen finden Sie auf der Kindergeburtstag-Seite – für andere Anlässe erstelle ich Ihnen gern ein individuelles Angebot.' } },
    { '@type': 'Question', name: 'Für welche Anlässe kann ich Clown Zauberer LIAR buchen?', acceptedAnswer: { '@type': 'Answer', text: 'LIAR ist buchbar für Kindergeburtstage, Kindergartenfeste, Schulfeste, Familienfeiern, Stadtfeste und Firmenfeiern – überall in NRW und dem Ruhrgebiet.' } },
    { '@type': 'Question', name: 'Wie weit im Voraus sollte ich den Zauberer buchen?', acceptedAnswer: { '@type': 'Answer', text: 'Empfohlen wird eine Buchung 4–8 Wochen im Voraus, besonders für Wochenenden und Feiertage. Kurzfristige Anfragen sind bei freien Terminen möglich.' } },
    { '@type': 'Question', name: 'Welche Zusatzleistungen bietet Clown Zauberer LIAR an?', acceptedAnswer: { '@type': 'Answer', text: 'Neben der Zaubershow bietet LIAR Ballonmodellage und Glitzer Tattoos als Zusatzleistungen an. Kombiniert ergibt das ein bis zu 90-minütiges Programm – alles zu transparenten Festpreisen, Details auf der Kindergeburtstag-Seite bzw. im individuellen Angebot.' } },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow für Kinder in NRW. Professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];


const formats = [
  {
    icon: '🎩',
    img: tischZaubererImg,
    imgAlt: 'Eindruck von Tisch Zauberer',
    title: 'Close-up Zauberei / Tischzauberer',
    subtitle: 'Magie zum Greifen nah – direkt vor Ihren Augen',
    description: 'Als Close-up Zauberer bewege ich mich zwischen Ihren Gästen und präsentiere verblüffende Tricks mit Karten, Münzen und Alltagsgegenständen. Die Magie geschieht in unmittelbarer Nähe, sodass jede Täuschung nahezu unmöglich erscheint.',
    events: ['Hochzeiten (während Sektempfang oder Dinner)', 'Firmenfeiern & Gala-Events', 'Geburtstagsfeiern für Erwachsene', 'Networking-Events & Messen'],
    advantages: ['Keine Bühne erforderlich', 'Flexibel während der Veranstaltung einsetzbar', 'Persönliche Interaktion mit jedem Gast', 'Schafft Gesprächsstoff und lockert die Atmosphäre'],
    extra: 'Dauer: 2-4 Stunden (je nach Gästezahl) | Gruppengröße: 20-200 Personen',
    href: '/zauberer/tisch-zauberer/',
  },
  {
    icon: '🎭',
    img: buehneFeuerImg,
    imgAlt: 'Feuertrick mit Zauberer LIAR auf einer Bühne',
    title: 'Bühnenzauberer / Stand-up Show',
    subtitle: 'Fesselnde Show für Ihr gesamtes Publikum',
    description: 'Eine professionelle Bühnenshow, die Ihr Publikum in eine Welt voller Illusionen entführt. Mit spektakulären Tricks, Humor und Charme schaffe ich ein Erlebnis, das alle Altersgruppen begeistert.',
    events: ['Betriebsfeiern & Weihnachtsfeiern', 'Stadtfeste & öffentliche Events', 'Schulveranstaltungen & Abschlussfeiern', 'Private Feiern mit größerer Gästezahl'],
    advantages: ['Kompakte Show (20-45 Minuten)', 'Für 10-150 Personen optimiert', 'Interaktive Einbindung des Publikums', 'Minimal 2×2 Meter Fläche ausreichend'],
    extra: 'Technische Anforderungen: Mikrofon (ab 50 Personen) | Aufbauzeit: Nur 5 Minuten',
    href: '/zauberer/buehnen-zauberer/',
  },
  {
    icon: '🎪',
    img: kindergeburtstagImg,
    imgAlt: 'Einsatz von Zauberer LIAR bei Kindergeburtstag',
    title: 'Kinderzauberer & Kinderanimation',
    subtitle: 'Zaubershow, die Kinderaugen zum Leuchten bringt',
    description: 'Als Kinderzauberer verbinde ich professionelle Zaubertricks mit lustiger Clownerie. Die Kinder werden aktiv eingebunden, stehen im Mittelpunkt und erleben eine Show, die sie nie vergessen werden.',
    events: ['Kindergeburtstage (ab 4 Jahren)', 'Kinderfeste in Kindergärten & Schulen', 'Kommunion, Taufe & Familienfeiern', 'Sommerfeste & Tag der offenen Tür'],
    advantages: ['ZAUBERSHOW (30-45 Min.) – Professionelle Mischung aus Magie & Comedy', 'Altersgerechte Tricks mit Wow-Effekt', 'Jedes Kind wird aktiv eingebunden', 'BALLONMODELLAGE auf Wunsch', 'GLITZER-TATTOOS auf Wunsch'],
    href: '/kinderzauberer/',
  },
];

const whyUs = [
  { title: '370+ TOP-Bewertungen auf Google', desc: 'Zufriedene Kunden in ganz NRW und darüber hinaus' },
  { title: 'Professionelle Erfahrung seit 2009', desc: 'Hunderte erfolgreiche Auftritte bei Events jeder Größe' },
  { title: 'Französisches Flair mit NRW-Bodenständigkeit', desc: 'Charmant, sympathisch und authentisch' },
  { title: 'Flexible & unkomplizierte Buchung', desc: 'Auch kurzfristige Termine oft möglich' },
  { title: 'Minimaler Aufwand für Sie', desc: 'Nur 2×2 Meter Platz nötig, 10 Minuten Aufbauzeit' },
  { title: 'Mehrsprachig', desc: 'Shows auf Deutsch und Französisch möglich' },
  { title: 'Vollständig versichert', desc: 'Haftpflichtversicherung für professionelle Events' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Zauberer NRW, Zauberer buchen, Zauberer Kindergeburtstag, Kinderzauberer NRW, Zaubershow NRW, Zauberer Hochzeit, Close-up Zauberer, Bühnenzauberer"
  canonical="https://liar-entertainer.com/zauberer/"
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Zauberer', url: '/zauberer/' },
  ]}
  structuredData={structuredData}
  design="v2"
>
  <!-- ── Hero: cinematic, night + gold. No reveal on LCP. ───── -->
  <section class="zb-hero">
    <div class="zb-hero__media">
      <Image
        src={heroImg}
        alt="Zauberer NRW für Kindergeburtstag und Hochzeit – TOP Bewertet"
        widths={[600, 900, 1152]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="zb-stars" aria-hidden="true"></div>
    <div class="container zb-hero__inner">
      <p class="zb-crumbs">
        <a href="/">Clown</a> »
        <a href="/">Clown Zauberer LIAR</a> »
        <span>Zauberer</span>
      </p>
      <h1 class="zb-hero__title">
        <em>Zauberer</em> in NRW für Events, Firmenfeiern &amp; Familienfeste
      </h1>
      <span class="zb-rule" aria-hidden="true"></span>
      <h2 class="zb-hero__sub">
        Der Zauberer in NRW<br />mit TOP Bewertungen
      </h2>
      <p class="zb-hero__claim">Über 400 begeisterte 5-Sterne-Bewertungen auf Google</p>
      <p class="zb-hero__claim zb-hero__claim--soft">Professionelle Zauberkunst mit französischem Charme</p>
      <div class="zb-hero__actions">
        <a class="btn btn--primary" href="/kontakt/">Unverbindlich anfragen</a>
        <ReviewBadge />
      </div>
    </div>
  </section>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="zb-intro">
    <div class="container zb-narrow zb-center" data-reveal>
      <p class="zb-lead">
        Ob <a href="/kindergeburtstag/">Kindergeburtstag</a>, Hochzeit oder Firmenevent – als Clown Zauberer LIAR erleben Sie Magie, die begeistert und in Erinnerung bleibt. Als <a href="/kinderzauberer/">Kinderzauberer</a> bringe ich Kinderaugen zum Leuchten, als <a href="/zauberer/buehnen-zauberer/">Bühnenzauberer</a> fessle ich Ihr Publikum, und als <a href="/zauberer/tisch-zauberer/">Tischzauberer</a> verzaubere ich Ihre Gäste aus nächster Nähe.
      </p>
      <p>
        Als Zauberer für Kinder passe ich Tempo, Humor und Requisiten an die Altersgruppe an.
      </p>
      <div class="zb-chips">
        <span>✓ Clown Zauberer: Close-up, Bühne, Kinderzauberei</span>
        <span>✓ Kurzfristige Buchungen möglich</span>
        <span>✓ Einsatz in ganz NRW & darüber hinaus</span>
      </div>
    </div>
  </section>

  <!-- ── Anlässe ───────────────────────────────────────────── -->
  <section class="zb-occasions" data-related-services>
    <div class="container zb-narrow">
      <h2 class="zb-h2 zb-center" data-reveal>
        Für welche Anlässe kann man Zauberer LIAR sonst buchen?
      </h2>
      <div class="zb-occasions__grid">
        <a href="/zauberer/hochzeit/" class="zb-occasion" data-reveal>
          <p class="zb-occasion__title">Zauberer für die Hochzeit</p>
          <p class="zb-occasion__text">Close-up-Zauberei am Tisch, beim Sektempfang und während der Fotosession.</p>
        </a>
        <a href="/zauberer/firmenfeier/" class="zb-occasion" data-reveal data-reveal-delay="0.1">
          <p class="zb-occasion__title">Zauberer für die Firmenfeier</p>
          <p class="zb-occasion__text">Walk-Act zwischen den Tischen oder Bühnenshow für Betriebsfeier und Jubiläum.</p>
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Formate ───────────────────────────────────────────── -->
  <section class="zb-formats">
    <div class="container">
      <h2 class="zb-eyebrow zb-center">ZAUBEREI-FORMATE</h2>
      <h3 class="zb-h2 zb-center">Welche Art von Zaubershow passt zu Ihrem Event?</h3>
      <p class="zb-center zb-narrow zb-soft">Tauchen Sie ein in die faszinierende Welt der Magie und buchen Sie den Zauberer aus Frankreich. Ob <a href="/zauberer/zaubershow/">Zaubershow</a> für Kinder oder elegante <a href="/clown/clownshow/">Clownshow</a> – lassen Sie sich von niveauvoller Kunst und unvergleichlichem Charme verzaubern.</p>
      <div class="zb-formats__grid">
        {formats.map((format, i) => (
          <article class="zb-format" data-reveal data-reveal-delay={i * 0.1}>
            <div class="zb-format__img">
              <Image src={format.img} alt={format.imgAlt} loading="lazy" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 33vw" />
            </div>
            <div class="zb-format__body">
              <div class="zb-format__icon">{format.icon}</div>
              <h3>{format.title}</h3>
              <p class="zb-format__sub">{format.subtitle}</p>
              <p class="zb-soft">{format.description}</p>
              <p class="zb-format__label">Perfekt geeignet für:</p>
              <ul>{format.events.map((e) => <li>• {e}</li>)}</ul>
              <p class="zb-format__label">Ihre Vorteile:</p>
              <ul>{format.advantages.map((a) => <li>✓ {a}</li>)}</ul>
              {format.extra && <p class="zb-format__extra">{format.extra}</p>}
              <a href={format.href} class="zb-format__more">Mehr erfahren</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Warum ─────────────────────────────────────────────── -->
  <section class="zb-why">
    <div class="container">
      <p class="zb-eyebrow zb-center">WARUM ZAUBERER LIAR?</p>
      <h2 class="zb-h2 zb-center">🎯 Das macht mich aus</h2>
      <div class="zb-why__grid">
        {whyUs.map((item, i) => (
          <div class="zb-why__item" data-reveal data-reveal-delay={(i % 3) * 0.08}>
            <p class="zb-why__title">✓ {item.title}</p>
            <p class="zb-soft">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Buchung ───────────────────────────────────────────── -->
  <section class="zb-steps">
    <div class="container zb-narrow-wide">
      <p class="zb-eyebrow zb-center">SO FUNKTIONIERT DIE BUCHUNG</p>
      <h2 class="zb-h2 zb-center">In 3 einfachen Schritten zu Ihrer Zaubershow</h2>
      <ol class="zb-steps__list">
        <li data-reveal>
          <div class="zb-step__num">1</div>
          <h3>Anfrage stellen</h3>
          <p class="zb-soft">Kontaktieren Sie mich per Telefon (0172-1517578), E-Mail oder Kontaktformular mit Ihrem Wunschtermin und Event-Details.</p>
        </li>
        <li data-reveal data-reveal-delay="0.12">
          <div class="zb-step__num">2</div>
          <h3>Angebot erhalten</h3>
          <p class="zb-soft">Sie erhalten innerhalb von 24 Stunden ein individuelles, unverbindliches Angebot basierend auf Ihrer Veranstaltung.</p>
        </li>
        <li data-reveal data-reveal-delay="0.24">
          <div class="zb-step__num">3</div>
          <h3>Show erleben</h3>
          <p class="zb-soft">Nach der Buchungsbestätigung kümmere ich mich um alles – Sie lehnen sich zurück und genießen die Show!</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Einsatzgebiet ─────────────────────────────────────── -->
  <section class="zb-area">
    <div class="container">
      <h2 class="zb-h2 zb-center">In welchen Städten ist Clown Zauberer LIAR buchbar?</h2>
      <div class="zb-area__grid">
        <div>
          <p class="zb-format__label">Haupteinsatzgebiete:</p>
          <p class="zb-soft zb-cities">Oberhausen | Gelsenkirchen | Essen | Duisburg | Dorsten | Herten | Herne | Marl | Gladbeck | Mülheim | Dinslaken | Dortmund | Bochum | Bottrop | Recklinghausen</p>
          <p class="zb-format__label">Weitere Städte in NRW:</p>
          <p class="zb-soft zb-cities">Düsseldorf | Köln | Münster | Bielefeld | Bonn | Aachen | Krefeld | Moers | Lünen | Hagen | Hamm | Solingen | Wuppertal | Leverkusen | Neuss | Paderborn</p>
          <p class="zb-soft">🌍 <strong>Überregional &amp; International:</strong> Auf Anfrage auch außerhalb von NRW buchbar – inklusive Belgien, Frankreich, Österreich und Schweiz!</p>
        </div>
        <figure class="zb-frame" data-reveal>
          <Image
            src={karteImg}
            alt="Einsatzgebiet Zauberer LIAR für Kindergeburtstag und Events in NRW – Karte"
            loading="lazy"
            widths={[400, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ── FAQ (visible twin of the FAQPage schema) ──────────── -->
  <section class="zb-faq">
    <div class="container zb-narrow">
      <h2 class="zb-h2 zb-center">Häufig gestellte Fragen</h2>
      <div class="zb-faq__list">
        {faqSchema.mainEntity.map((item) => (
          <details class="zb-faq__item">
            <summary>{item.name}</summary>
            <p>{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Kontakt ───────────────────────────────────────────── -->
  <section class="zb-contact">
    <div class="container zb-center">
      <p class="zb-contact__name">Clown Zauberer LIAR</p>
      <p class="zb-soft">Anschrift : Beethovenstr. 15, 45966 Gladbeck</p>
      <p class="zb-soft">
        TEL : <a href="tel:+491721517578">0172 – 1517578</a>
        {' '}// Email :
        <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a>
      </p>
      <a href="/kontakt/" class="btn btn--primary">
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  section { padding-block: var(--space-6); position: relative; }
  .zb-center { text-align: center; }
  .zb-narrow { max-width: 50rem; margin-inline: auto; }
  .zb-narrow-wide { max-width: 64rem; }
  .zb-soft { color: var(--ink-soft); }
  p { margin: 0 0 var(--space-2); }
  .zb-h2 { font-size: clamp(1.9rem, 4vw, 3rem); margin: 0 0 var(--space-3); color: var(--ink); }
  .zb-eyebrow {
    display: flex; align-items: center; justify-content: center; gap: 1rem;
    margin: 0 0 var(--space-2);
    font-family: var(--font-body); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.32em; text-transform: uppercase; color: var(--accent);
  }
  .zb-eyebrow::before, .zb-eyebrow::after { content: ''; width: 2.5rem; height: 1px; background: linear-gradient(90deg, transparent, var(--accent)); }
  .zb-eyebrow::after { transform: scaleX(-1); }

  /* ── hero ── */
  .zb-hero {
    min-height: min(88vh, 46rem);
    display: grid;
    align-items: end;
    padding-block: var(--space-6) var(--space-5);
    overflow: hidden;
    isolation: isolate;
  }
  /* photo on the right half so the magician stays visible next to the copy */
  .zb-hero__media {
    position: absolute; inset: 0 0 0 38%; z-index: -2;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 32%);
    mask-image: linear-gradient(90deg, transparent, #000 32%);
  }
  .zb-hero__media img {
    width: 100%; height: 100%; object-fit: cover; object-position: 30% 28%;
    filter: saturate(0.9) contrast(1.05);
  }
  .zb-hero__media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 12, 20, 0.55) 0%, rgba(10, 12, 20, 0.05) 45%, rgba(10, 12, 20, 0.25) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 35%);
  }
  .zb-stars {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      radial-gradient(1px 1px at 12% 22%, #f0d79b, transparent),
      radial-gradient(1px 1px at 28% 68%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 42% 14%, #f0d79b, transparent),
      radial-gradient(1px 1px at 8% 82%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 33% 40%, #c9a14e, transparent),
      radial-gradient(1px 1px at 52% 78%, #f0d79b, transparent),
      radial-gradient(1px 1px at 20% 52%, #fff, transparent);
    animation: twinkle 5s ease-in-out infinite alternate;
  }
  @keyframes twinkle { from { opacity: 0.35; } to { opacity: 1; } }
  .zb-hero__inner { max-width: var(--container); }
  .zb-crumbs { font-size: 0.85rem; letter-spacing: 0.08em; color: var(--ink-soft); }
  .zb-crumbs a { color: var(--ink-soft); text-decoration: none; }
  .zb-crumbs a:hover { color: var(--accent-strong); }
  .zb-hero__title {
    max-width: 16ch;
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    line-height: 1.04;
    margin: 0 0 var(--space-3);
  }
  .zb-hero__title em {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(100deg, var(--gold-deep), var(--accent-strong) 40%, #fff6dc 50%, var(--accent-strong) 60%, var(--accent));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 6s ease-in-out infinite;
  }
  @keyframes shimmer { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } }
  .zb-rule {
    display: block; width: 7rem; height: 1px; margin-bottom: var(--space-3);
    background: linear-gradient(90deg, var(--accent), transparent);
    transform-origin: left; animation: draw 1.4s var(--ease-out) 0.3s both;
  }
  @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .zb-hero__sub {
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    font-style: italic; font-weight: 400; color: var(--accent-strong);
    margin: 0 0 var(--space-2);
  }
  .zb-hero__claim { color: var(--ink); max-width: 36rem; }
  .zb-hero__claim--soft { color: var(--ink-soft); }
  .zb-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: var(--space-3); }

  /* ── intro ── */
  .zb-intro { padding-top: var(--space-5); }
  .zb-lead { font-family: var(--font-display); font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1.55; color: var(--ink); }
  .zb-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: var(--space-3); }
  .zb-chips span {
    padding: 0.55rem 1.1rem; font-size: 0.85rem; letter-spacing: 0.04em; color: var(--ink-soft);
    border: 1px solid var(--line); background: rgba(20, 24, 38, 0.6);
  }

  /* ── occasions ── */
  .zb-occasions { padding-top: 0; }
