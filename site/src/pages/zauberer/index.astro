---
import V2Layout from '../../layouts/V2Layout.astro';
import Reviews from '../../components/v2/Reviews.astro';
import ReviewBadge from '../../components/v2/ReviewBadge.astro';
import MagicFrame from '../../components/v2/adult/MagicFrame.astro';
import StageLights from '../../components/v2/adult/StageLights.astro';
import SuitRule from '../../components/v2/adult/SuitRule.astro';
import PickACard from '../../components/v2/adult/PickACard.astro';
import '../../styles/adult-kit.css';
import { Image } from 'astro:assets';
import { ZAUBERER_CITIES, zaubererCityPath } from '../../data/zauberer-cities';
import heroImg from '../../assets/images/zauberer/zauberer-nrw.png';
import tischZaubererImg from '../../assets/images/zauberer/tisch-zauberer.jpg';
import buehneFeuerImg from '../../assets/images/zauberer/tisch-zauberer-nrw-buehne.png';
import kindergeburtstagImg from '../../assets/images/zauberer/kindergeburtstag.jpg';
import karteImg from '../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';

const seoTitle = "Zauberer NRW buchen – Zaubershow für Kinder & Erwachsene";
const seoDescription = 'Französischer Zauberer LIAR in NRW ✓ Professionelle Zaubershow für Kindergeburtstag, Hochzeit & Firmenevent ✓ Tischzauber & Bühnenzauberei ✓ 370+ Top-Bewertungen!';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Zauberer in NRW",
  "description": "Professioneller Zauberer LIAR in NRW – Close-up, Bühnenshow und Kinderzaubershow für Kindergeburtstag, Hochzeit und Firmenevent",
  "url": "https://liar-entertainer.com/zauberer/",
  "serviceType": ["Zauberer", "Bühnenzauberer", "Tischzauberer", "Kinderzauberer"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Was kostet ein Zauberer für Kinder in NRW?', acceptedAnswer: { '@type': 'Answer', text: 'Ich arbeite mit transparenten Festpreisen ohne versteckte Kosten. Alle Details zu den Paketen und Preisen finden Sie auf der Kindergeburtstag-Seite – für andere Anlässe erstelle ich Ihnen gern ein individuelles Angebot.' } },
    { '@type': 'Question', name: 'Für welche Anlässe kann ich Clown Zauberer LIAR buchen?', acceptedAnswer: { '@type': 'Answer', text: 'LIAR ist buchbar für Kindergeburtstage, Kindergartenfeste, Schulfeste, Familienfeiern, Stadtfeste und Firmenfeiern – überall in NRW und dem Ruhrgebiet.' } },
    { '@type': 'Question', name: 'Wie weit im Voraus sollte ich den Zauberer buchen?', acceptedAnswer: { '@type': 'Answer', text: 'Empfohlen wird eine Buchung 4–8 Wochen im Voraus, besonders für Wochenenden und Feiertage. Kurzfristige Anfragen sind bei freien Terminen möglich.' } },
    { '@type': 'Question', name: 'Welche Zusatzleistungen bietet Clown Zauberer LIAR an?', acceptedAnswer: { '@type': 'Answer', text: 'Neben der Zaubershow bietet LIAR Ballonmodellage und Glitzer Tattoos als Zusatzleistungen an. Kombiniert ergibt das ein bis zu 90-minütiges Programm – alles zu transparenten Festpreisen, Details auf der Kindergeburtstag-Seite bzw. im individuellen Angebot.' } },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow für Kinder in NRW. Professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];


const formats = [
  {
    icon: '🎩',
    img: tischZaubererImg,
    imgAlt: 'Eindruck von Tisch Zauberer',
    title: 'Close-up Zauberei / Tischzauberer',
    subtitle: 'Magie zum Greifen nah – direkt vor Ihren Augen',
    description: 'Als Close-up Zauberer bewege ich mich zwischen Ihren Gästen und präsentiere verblüffende Tricks mit Karten, Münzen und Alltagsgegenständen. Die Magie geschieht in unmittelbarer Nähe, sodass jede Täuschung nahezu unmöglich erscheint.',
    events: ['Hochzeiten (während Sektempfang oder Dinner)', 'Firmenfeiern & Gala-Events', 'Geburtstagsfeiern für Erwachsene', 'Networking-Events & Messen'],
    advantages: ['Keine Bühne erforderlich', 'Flexibel während der Veranstaltung einsetzbar', 'Persönliche Interaktion mit jedem Gast', 'Schafft Gesprächsstoff und lockert die Atmosphäre'],
    extra: 'Dauer: 2-4 Stunden (je nach Gästezahl) | Gruppengröße: 20-200 Personen',
    href: '/zauberer/tisch-zauberer/',
  },
  {
    icon: '🎭',
    img: buehneFeuerImg,
    imgAlt: 'Feuertrick mit Zauberer LIAR auf einer Bühne',
    title: 'Bühnenzauberer / Stand-up Show',
    subtitle: 'Fesselnde Show für Ihr gesamtes Publikum',
    description: 'Eine professionelle Bühnenshow, die Ihr Publikum in eine Welt voller Illusionen entführt. Mit spektakulären Tricks, Humor und Charme schaffe ich ein Erlebnis, das alle Altersgruppen begeistert.',
    events: ['Betriebsfeiern & Weihnachtsfeiern', 'Stadtfeste & öffentliche Events', 'Schulveranstaltungen & Abschlussfeiern', 'Private Feiern mit größerer Gästezahl'],
    advantages: ['Kompakte Show (20-45 Minuten)', 'Für 10-150 Personen optimiert', 'Interaktive Einbindung des Publikums', 'Minimal 2×2 Meter Fläche ausreichend'],
    extra: 'Technische Anforderungen: Mikrofon (ab 50 Personen) | Aufbauzeit: Nur 5 Minuten',
    href: '/zauberer/buehnen-zauberer/',
  },
  {
    icon: '🎪',
    img: kindergeburtstagImg,
    imgAlt: 'Einsatz von Zauberer LIAR bei Kindergeburtstag',
    title: 'Kinderzauberer & Kinderanimation',
    subtitle: 'Zaubershow, die Kinderaugen zum Leuchten bringt',
    description: 'Als Kinderzauberer verbinde ich professionelle Zaubertricks mit lustiger Clownerie. Die Kinder werden aktiv eingebunden, stehen im Mittelpunkt und erleben eine Show, die sie nie vergessen werden.',
    events: ['Kindergeburtstage (ab 4 Jahren)', 'Kinderfeste in Kindergärten & Schulen', 'Kommunion, Taufe & Familienfeiern', 'Sommerfeste & Tag der offenen Tür'],
    advantages: ['ZAUBERSHOW (30-45 Min.) – Professionelle Mischung aus Magie & Comedy', 'Altersgerechte Tricks mit Wow-Effekt', 'Jedes Kind wird aktiv eingebunden', 'BALLONMODELLAGE auf Wunsch', 'GLITZER-TATTOOS auf Wunsch'],
    href: '/kinderzauberer/',
  },
];

const whyUs = [
  { title: '370+ TOP-Bewertungen auf Google', desc: 'Zufriedene Kunden in ganz NRW und darüber hinaus' },
  { title: 'Professionelle Erfahrung seit 2009', desc: 'Hunderte erfolgreiche Auftritte bei Events jeder Größe' },
  { title: 'Französisches Flair mit NRW-Bodenständigkeit', desc: 'Charmant, sympathisch und authentisch' },
  { title: 'Flexible & unkomplizierte Buchung', desc: 'Auch kurzfristige Termine oft möglich' },
  { title: 'Minimaler Aufwand für Sie', desc: 'Nur 2×2 Meter Platz nötig, 10 Minuten Aufbauzeit' },
  { title: 'Mehrsprachig', desc: 'Shows auf Deutsch und Französisch möglich' },
  { title: 'Vollständig versichert', desc: 'Haftpflichtversicherung für professionelle Events' },
];
---

<V2Layout
  mainClass="ce-salon-page seam-fade"
  title={seoTitle}
  description={seoDescription}
  keywords="Zauberer NRW, Zauberer buchen, Zauberer Kindergeburtstag, Kinderzauberer NRW, Zaubershow NRW, Zauberer Hochzeit, Close-up Zauberer, Bühnenzauberer"
  canonical="https://liar-entertainer.com/zauberer/"
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Zauberer', url: '/zauberer/' },
  ]}
  structuredData={structuredData}
>
  <!-- ── Hero: editorial headline + a fanned hand of cards. The photo card (LCP) never hides. ── -->
  <section class="ce-hero ce-hero--stage">
    <StageLights />
    <div class="container ce-hero__grid">
      <div class="ce-hero__copy">
        <p class="ce-crumbs">
          <a href="/">Clown</a> »
          <a href="/">Clown Zauberer LIAR</a> »
          <span>Zauberer</span>
        </p>
        <h1 class="ce-hero__title">
          <em>Zauberer</em> in NRW für Events, Firmenfeiern &amp; Familienfeste
        </h1>
        <div class="ce-spot">
          <div class="ce-hero__frame ce-spot__frame">
            <MagicFrame corner="tr" rank="A" suit="♠" data-tilt>
              <Image
                src={heroImg}
                alt="Zauberer NRW für Kindergeburtstag und Hochzeit – TOP Bewertet"
                widths={[450, 720, 1080, 1440]}
                sizes="(max-width: 900px) 88vw, 736px"
                loading="eager"
                fetchpriority="high"
              />
            </MagicFrame>
          </div>
        </div>
        <SuitRule />
        <h2 class="ce-hero__sub">
          Der Zauberer in NRW<br />mit TOP Bewertungen
        </h2>
        <p class="ce-hero__claim">370+ begeisterte Bewertungen auf Google</p>
        <p class="ce-hero__claim ce-hero__claim--soft">Professionelle Zauberkunst mit französischem Charme</p>
        <div class="ce-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-magnetic>Unverbindlich anfragen</a>
          <ReviewBadge />
        </div>
      </div>

    </div>
  </section>

  <!-- ══ Body v2 (grill 2026-10-07): ivory "salon" with a gold card-back lattice; content laid out
       as playing-card compositions with art-deco gold; dark stages only for reviews + finale. ══ -->

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="ce-intro ce-salon">
    <div class="container ce-narrow ce-center">
      <span class="ce-ornament" aria-hidden="true"></span>
      <p class="ce-lead" data-reveal>
        Ob <a href="/kindergeburtstag/">Kindergeburtstag</a>, Hochzeit oder Firmenevent – als Clown Zauberer LIAR erleben Sie Magie, die begeistert und in Erinnerung bleibt. Als <a href="/kinderzauberer/">Kinderzauberer</a> bringe ich Kinderaugen zum Leuchten, als <a href="/zauberer/buehnen-zauberer/">Bühnenzauberer</a> fessle ich Ihr Publikum, und als <a href="/zauberer/tisch-zauberer/">Tischzauberer</a> verzaubere ich Ihre Gäste aus nächster Nähe.
      </p>
      <p class="ce-soft" data-reveal data-reveal-delay="0.08">
        Als Zauberer für Kinder passe ich Tempo, Humor und Requisiten an die Altersgruppe an.
      </p>
      <div class="ce-chips ce-tickets">
        <span data-reveal="tilt">✓ Clown Zauberer: Close-up, Bühne, Kinderzauberei</span>
        <span data-reveal="tilt" data-reveal-delay="0.08">✓ Kurzfristige Buchungen möglich</span>
        <span data-reveal="tilt" data-reveal-delay="0.16">✓ Einsatz in ganz NRW & darüber hinaus</span>
      </div>
    </div>
  </section>

  <!-- ── Anlässe: two big cards, fanned ─────────────────────── -->
  <section class="ce-occasions ce-salon" data-related-services>
    <div class="container ce-narrow">
      <SuitRule />
      <h2 class="ce-h2 ce-center">
        Für welche Anlässe kann man Zauberer LIAR sonst buchen?
      </h2>
      <div class="ce-pair">
        <a href="/zauberer/hochzeit/" class="ce-occasion ce-pcard ce-pcard--red" data-reveal="tilt">
          <span class="ce-occasion__suit ce-pcard__idx" aria-hidden="true">D<br />♥</span>
          <span class="ce-pcard__idx ce-pcard__idx--end" aria-hidden="true">D<br />♥</span>
          <span class="ce-pcard__pip" aria-hidden="true">♥</span>
          <p class="ce-occasion__title">Zauberer für die Hochzeit</p>
          <p class="ce-occasion__text">Close-up-Zauberei am Tisch, beim Sektempfang und während der Fotosession.</p>
        </a>
        <a href="/zauberer/firmenfeier/" class="ce-occasion ce-pcard" data-reveal="tilt" data-reveal-delay="0.12">
          <span class="ce-occasion__suit ce-pcard__idx" aria-hidden="true">K<br />♠</span>
          <span class="ce-pcard__idx ce-pcard__idx--end" aria-hidden="true">K<br />♠</span>
          <span class="ce-pcard__pip" aria-hidden="true">♠</span>
          <p class="ce-occasion__title">Zauberer für die Firmenfeier</p>
          <p class="ce-occasion__text">Walk-Act zwischen den Tischen oder Bühnenshow für Betriebsfeier und Jubiläum.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Bewertungen: dark stage with spotlights ───────────── -->
  <div class="ce-stage ce-lit">
    <StageLights soft />
    <Reviews />
  </div>

  <!-- ── Formate: a fanned hand of three big cards ─────────── -->
  <section class="ce-formats ce-salon">
    <div class="container">
      <h2 class="ce-eyebrow ce-cartouche ce-center">ZAUBEREI-FORMATE</h2>
      <h3 class="ce-h2 ce-center">Welche Art von Zaubershow passt zu Ihrem Event?</h3>
      <p class="ce-center ce-narrow ce-soft">Tauchen Sie ein in die faszinierende Welt der Magie und buchen Sie den Zauberer aus Frankreich. Ob <a href="/zauberer/zaubershow/">Zaubershow</a> für Kinder oder elegante <a href="/clown/clownshow/">Clownshow</a> – lassen Sie sich von niveauvoller Kunst und unvergleichlichem Charme verzaubern.</p>
      <div class="ce-hand">
        {formats.map((format, i) => (
          <article class:list={['ce-hcard', 'ce-format', { 'ce-pcard--red': i === 1 }]} data-reveal="tilt" data-reveal-delay={i * 0.12}>
            <span class="ce-pcard__idx" aria-hidden="true">{['A', 'K', 'D'][i]}<br />{['♠', '♥', '♣'][i]}</span>
            <span class="ce-pcard__idx ce-pcard__idx--end" aria-hidden="true">{['A', 'K', 'D'][i]}<br />{['♠', '♥', '♣'][i]}</span>
            <div class="ce-hcard__photo">
              <MagicFrame corner="tr" rank={['A', 'K', 'Q'][i]} suit={(['♠', '♥', '♣'] as const)[i]} style={`--sheen-delay: ${2.2 + i * 0.9}s`}>
                <Image src={format.img} alt={format.imgAlt} loading="lazy" widths={[400, 600, 900]} sizes="(max-width: 900px) 84vw, 340px" />
              </MagicFrame>
            </div>
            <div class="ce-format__body">
              <div class="ce-format__icon">{format.icon}</div>
              <h3>{format.title}</h3>
              <p class="ce-format__sub">{format.subtitle}</p>
              <p class="ce-soft">{format.description}</p>
              <p class="ce-label">Perfekt geeignet für:</p>
              <ul>{format.events.map((e) => <li>• {e}</li>)}</ul>
              <p class="ce-label">Ihre Vorteile:</p>
              <ul>{format.advantages.map((a) => <li>✓ {a}</li>)}</ul>
              {format.extra && <p class="ce-format__extra">{format.extra}</p>}
              <a href={format.href} class="ce-ink-link">Mehr erfahren</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Warum: a spread of cards laid out on the table ────── -->
  <section class="ce-why ce-salon">
    <div class="container">
      <SuitRule />
      <p class="ce-eyebrow ce-center">WARUM ZAUBERER LIAR?</p>
      <h2 class="ce-h2 ce-center">🎯 Das macht mich aus</h2>
      <div class="ce-spread">
        {whyUs.map((item, i) => (
          <div class:list={['ce-why__item', 'ce-scard', { 'ce-pcard--red': i % 2 }]} data-reveal="tilt" data-reveal-delay={(i % 4) * 0.08}>
            <span class:list={['ce-why__suit', { 'ce-red': i % 2 }]} aria-hidden="true">{['♠', '♥', '♣', '♦'][i % 4]}</span>
            <p class="ce-why__title">✓ {item.title}</p>
            <p class="ce-soft">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Buchung: a dealt row, turned face up ──────────────── -->
  <section class="ce-steps ce-salon">
    <div class="container ce-narrow-wide">
      <SuitRule />
      <p class="ce-eyebrow ce-center">SO FUNKTIONIERT DIE BUCHUNG</p>
      <h2 class="ce-h2 ce-center">In 3 einfachen Schritten zu Ihrer Zaubershow</h2>
      <ol class="ce-steps__list">
        <li class="ce-step" data-reveal="flip">
          <span class="card-back" aria-hidden="true"></span>
          <span class="ce-pcard__idx" aria-hidden="true">1<br />♠</span>
          <span class="ce-pcard__idx ce-pcard__idx--end" aria-hidden="true">1<br />♠</span>
          <div class="ce-step__num">1</div>
          <h3>Anfrage stellen</h3>
          <p class="ce-soft">Kontaktieren Sie mich per Telefon (0172-1517578), E-Mail oder Kontaktformular mit Ihrem Wunschtermin und Event-Details.</p>
        </li>
        <li class="ce-step ce-pcard--red" data-reveal="flip" data-reveal-delay="0.18">
          <span class="card-back" aria-hidden="true"></span>
          <span class="ce-pcard__idx" aria-hidden="true">2<br />♥</span>
          <span class="ce-pcard__idx ce-pcard__idx--end" aria-hidden="true">2<br />♥</span>
          <div class="ce-step__num">2</div>
          <h3>Angebot erhalten</h3>
          <p class="ce-soft">Sie erhalten innerhalb von 24 Stunden ein individuelles, unverbindliches Angebot basierend auf Ihrer Veranstaltung.</p>
        </li>
        <li class="ce-step" data-reveal="flip" data-reveal-delay="0.36">
          <span class="card-back" aria-hidden="true"></span>
          <span class="ce-pcard__idx" aria-hidden="true">3<br />♣</span>
          <span class="ce-pcard__idx ce-pcard__idx--end" aria-hidden="true">3<br />♣</span>
          <div class="ce-step__num">3</div>
          <h3>Show erleben</h3>
          <p class="ce-soft">Nach der Buchungsbestätigung kümmere ich mich um alles – Sie lehnen sich zurück und genießen die Show!</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Einsatzgebiet ─────────────────────────────────────── -->
  <section class="ce-area ce-salon">
    <div class="container">
      <SuitRule />
      <h2 class="ce-h2 ce-center">In welchen Städten ist Clown Zauberer LIAR buchbar?</h2>
      <div class="ce-area__grid">
        <div class="ce-deco ce-area__panel">
          <p class="ce-label">Haupteinsatzgebiete:</p>
          <p class="ce-soft ce-cities">Oberhausen | Gelsenkirchen | Essen | Duisburg | Dorsten | Herten | Herne | Marl | Gladbeck | Mülheim | Dinslaken | Dortmund | Bochum | Bottrop | Recklinghausen</p>
          <p class="ce-label">Weitere Städte in NRW:</p>
          <p class="ce-soft ce-cities">Düsseldorf | Köln | Münster | Bielefeld | Bonn | Aachen | Krefeld | Moers | Lünen | Hagen | Hamm | Solingen | Wuppertal | Leverkusen | Neuss | Paderborn</p>
          <p class="ce-label">Zauberer vor Ort:</p>
          <ul class="ce-citylinks">
            {ZAUBERER_CITIES.map((c) => <li><a href={zaubererCityPath(c.slug)}>Zauberer {c.name}</a></li>)}
          </ul>
          <p class="ce-soft">🌍 <strong>Überregional &amp; International:</strong> Auf Anfrage auch außerhalb von NRW buchbar – inklusive Belgien, Frankreich, Österreich und Schweiz!</p>
        </div>
        <div class="ce-area__map" data-reveal>
          <Image
            src={karteImg}
            alt="Einsatzgebiet Zauberer LIAR für Kindergeburtstag und Events in NRW – Karte"
            loading="lazy"
            widths={[400, 600, 900, 1200]}
            sizes="(max-width: 900px) 92vw, 560px"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ (visible twin of the FAQPage schema) ──────────── -->
  <section class="ce-faq ce-salon">
    <div class="container ce-narrow">
      <SuitRule />
      <h2 class="ce-h2 ce-center">Häufig gestellte Fragen</h2>
      <div class="ce-faq__list ce-deco">
        {faqSchema.mainEntity.map((item, i) => (
          <details class="ce-faq__item" data-reveal data-reveal-delay={i * 0.05}>
            <summary><span class="ce-faq__suit" aria-hidden="true">{['♠', '♥', '♣', '♦'][i % 4]}</span>{item.name}</summary>
            <p>{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Finale: dark stage – the card trick, then the contact ── -->
  <div class="ce-finale ce-stage ce-lit">
  <StageLights soft />
  <PickACard />

  <!-- ── Kontakt ───────────────────────────────────────────── -->
  <section class="ce-contact">
    <div class="container ce-center">
      <p class="ce-contact__name">Clown Zauberer LIAR</p>
      <p class="ce-soft">Anschrift : Beethovenstr. 15, 45966 Gladbeck</p>
      <p class="ce-soft">
        TEL : <a href="tel:+491721517578">0172 – 1517578</a>
        {' '}// Email :
        <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a>
      </p>
      <a href="/kontakt/" class="btn btn--primary" data-magnetic>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>
  </div>
</V2Layout>
