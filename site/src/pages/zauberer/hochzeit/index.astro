---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import MagicFrame from '../../../components/v2/adult/MagicFrame.astro';
import StageLights from '../../../components/v2/adult/StageLights.astro';
import SuitRule from '../../../components/v2/adult/SuitRule.astro';
import '../../../styles/adult-kit.css';
import { Image } from 'astro:assets';
import heroImg from '../../../assets/images/zauberer/tisch-zauberei-hero.jpg';
import closeupImg from '../../../assets/images/zauberer/close-up-zauberei-duesseldorf.jpg';
import buehneImg from '../../../assets/images/galerie/buehnen-zauberei.jpg';
import tischImg from '../../../assets/images/galerie/tisch-zauberer-nrw.jpg';

const seoTitle = 'Zauberer Hochzeit NRW | Tischzauberei & Show | LIAR';
const seoDescription = 'Zauberer für Ihre Hochzeit in NRW ✓ Elegante Tischzauberei am Sektempfang & Bühnen-Highlight ✓ Deutsch & Französisch ✓ 370+ Top-Bewertungen ✓ Jetzt anfragen!';

const features = [
  { icon: '🥂', title: 'Zauberei am Sektempfang', text: 'Während Fotos gemacht werden oder Gäste auf das Brautpaar warten, sorge ich mit Close-up-Zauberei direkt an den Gruppen für beste Stimmung – ganz ohne Leerlauf.' },
  { icon: '🇫🇷', title: 'Deutsch & Französisch', text: 'Als gebürtiger Franzose unterhalte ich Ihre Gäste auf Deutsch und Französisch – ideal für zweisprachige Hochzeiten und internationale Gäste.' },
  { icon: '💫', title: 'Persönlich & nah', text: 'Zauberei zum Anfassen: Karten, Ringe und Alltagsgegenstände verwandeln sich direkt in den Händen Ihrer Gäste. Persönlicher geht Unterhaltung nicht.' },
  { icon: '🎭', title: 'Show als Highlight', text: 'Auf Wunsch runde ich den Abend mit einer eleganten Bühnenshow ab – als gemeinsamer Programmpunkt für alle Gäste.' },
  { icon: '⭐', title: '370+ Top-Bewertungen', text: 'Über 400 Kundinnen und Kunden haben mich mit 5,0 von 5 Sternen bewertet. Verlässlichkeit an Ihrem wichtigsten Tag.' },
  { icon: '⚡', title: 'Unkompliziert & flexibel', text: 'Kein Bühnenaufbau nötig, kein Programm von der Stange – ich füge mich organisch in Ihren Ablauf ein und stimme alles vorab mit Ihnen ab.' },
];

const faqItems = [
  { q: 'Was macht ein Zauberer auf einer Hochzeit?', a: 'Am beliebtesten ist die Close-up-Zauberei (Tischzauberei): Ich gehe von Gruppe zu Gruppe und zeige Zauberkunst direkt in Griffweite – am Sektempfang, während der Fotosession des Brautpaars oder zwischen den Gängen. Auf Wunsch zusätzlich eine kurze Bühnenshow als gemeinsames Highlight.' },
  { q: 'Wann ist der beste Zeitpunkt für die Zauberei?', a: 'Ideal sind die Wartezeiten: der Sektempfang, die Fotosession des Brautpaars oder die Pause zwischen Essen und Abendprogramm. Genau dann überbrücke ich Leerlauf und sorge für gelöste Stimmung.' },
  { q: 'Ist die Zauberei auch auf Französisch möglich?', a: 'Ja. Als gebürtiger Franzose unterhalte ich Ihre Gäste auf Deutsch und Französisch – perfekt für zweisprachige Hochzeiten oder Gäste aus dem Ausland.' },
  { q: 'Wie viel Platz und Technik wird benötigt?', a: 'Für die Tischzauberei genügt der vorhandene Raum – keine Bühne, kein Mikrofon, kein Aufbau. Für eine zusätzliche Bühnenshow reichen eine kleine freie Fläche und ab ca. 70 Gästen eine Tonanlage.' },
  { q: 'In welchen Städten sind Sie für Hochzeiten buchbar?', a: 'In ganz NRW – u. a. Essen, Düsseldorf, Dortmund, Köln, Duisburg, Bochum, Gladbeck und im gesamten Ruhrgebiet. Auf Anfrage auch deutschlandweit sowie in Frankreich, Belgien, den Niederlanden, Österreich und der Schweiz.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Zauberer für Hochzeiten in NRW",
  "serviceType": "Hochzeitszauberer / Tischzauberei",
  "description": "Zauberer LIAR für Hochzeiten in NRW – elegante Close-up- und Tischzauberei am Sektempfang sowie Bühnenshow als Highlight. Deutsch und Französisch.",
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" },
  "url": "https://liar-entertainer.com/zauberer/hochzeit/"
};
---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Zauberer Hochzeit, Hochzeitszauberer NRW, Tischzauberer Hochzeit, Zauberer Sektempfang, Close-up Hochzeit"
  canonical="https://liar-entertainer.com/zauberer/hochzeit/"
  structuredData={[serviceSchema, faqSchema]}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Zauberer', url: '/zauberer/' }, { name: 'Hochzeit', url: '/zauberer/hochzeit/' }]}
>
  <!-- ── Hero: two hearts leaning on each other like a couple. The photo card (LCP) never hides. ── -->
  <section class="ce-hero ce-hero--stage">
    <StageLights />
    <div class="container ce-hero__grid">
      <div class="ce-hero__copy">
        <p class="ce-crumbs">
          <a href="/">Clown</a> »
          <a href="/zauberer/">Zauberer</a> »
          <span>Hochzeit</span>
        </p>
        <h1 class="ce-hero__title">Zauberer für die <em>Hochzeit</em> in NRW</h1>
        <div class="ce-spot">
          <div class="ce-hero__frame ce-spot__frame">
            <MagicFrame corner="tr" rank="K" suit="♥" data-tilt>
              <Image
                src={heroImg}
                alt="Zauberer für die Hochzeit – elegante Tischzauberei in NRW"
                loading="eager"
                fetchpriority="high"
                widths={[450, 720, 1080, 1440]}
                sizes="(max-width: 900px) 88vw, 736px"
              />
            </MagicFrame>
          </div>
        </div>
        <SuitRule />
        <h2 class="ce-hero__sub">
          Magische Momente für Ihre Hochzeit
        </h2>
        <p class="ce-hero__claim">Elegante Tischzauberei am Sektempfang &amp; Show als Highlight</p>
        <div class="ce-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-magnetic>Jetzt unverbindlich anfragen</a>
          <ReviewBadge />
        </div>
      </div>

    </div>
  </section>

  <!-- ── Intro + "Auf einen Blick" as a menu card ─────────── -->
  <section class="hz-intro ce-smoke">
    <div class="container hz-intro__grid">
      <div>
        <p class="hz-intro__text" data-reveal>
          Der schönste Tag im Leben verdient besondere Unterhaltung. Als Zauberer sorge ich in den Wartezeiten Ihrer Hochzeit – am Sektempfang, während der Fotosession oder zwischen den Gängen – für Staunen und gelöste Stimmung. Im Mittelpunkt steht die <a href="/zauberer/tisch-zauberer/">Tischzauberei (Close-up)</a> direkt an den Gästen; auf Wunsch ergänzt um eine elegante <a href="/zauberer/buehnen-zauberer/">Bühnenshow</a> als gemeinsames Highlight.
        </p>
        <ul class="hz-checks">
          {['✓ Zauberei direkt an den Tischen & Gruppen', '✓ Deutsch & Französisch', '✓ 370+ TOP-Bewertungen ⭐⭐⭐⭐⭐', '✓ Ohne Bühnenaufbau, flexibel im Ablauf'].map((item, i) => (
            <li data-reveal data-reveal-delay={0.08 + i * 0.06}>
              <span class="hz-checks__mark">{item.split(' ').slice(0,1)}</span>
              <span>{item.split(' ').slice(1).join(' ')}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="hz-menu ce-sheet ce-sheet--red" data-reveal="tilt">
        <h3 class="hz-menu__title">📊 Auf einen Blick</h3>
        <dl class="hz-menu__list">
          {[
            ['Format', 'Tischzauberei (Close-up) & optional Bühnenshow'],
            ['Anlässe', 'Sektempfang, Fotopause, Abendprogramm'],
            ['Gäste', 'Von der kleinen Feier bis zur großen Gesellschaft'],
            ['Sprachen', 'Deutsch, Französisch'],
            ['Aufbau', 'Für Close-up keiner – flexibel & mobil'],
            ['Gebiet', 'NRW, deutschlandweit & international'],
          ].map(([k, v]) => (
            <div class="hz-menu__row">
              <dt>{k}:</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Ablauf: three place cards along the wedding day ──── -->
  <section class="hz-day ce-smoke">
    <div class="container">
      <h2 class="ce-h2 ce-center">So passt die Zauberei in Ihren Hochzeitstag</h2>
      <p class="ce-center ce-soft">Unterhaltung genau dann, wenn sonst Leerlauf entsteht</p>
      <div class="hz-places">
        {[
          { title: '🥂 Sektempfang', text: 'Ich gehe von Gruppe zu Gruppe und verwandle das Warten in kleine Wow-Momente – ein perfekter Eisbrecher zwischen Gästen, die sich noch nicht kennen.' },
          { title: '📸 Fotopause', text: 'Während das Brautpaar für Fotos unterwegs ist, bleibt die Gesellschaft bestens unterhalten – keine Langeweile, keine Wartelücke.' },
          { title: '🎭 Abendprogramm', text: 'Als Übergang zum Abend eine kurze Bühnenshow – elegant, humorvoll und für alle Gäste gleichzeitig.' },
        ].map((item, i) => (
          <div class="hz-place ce-sheet" data-reveal="deal" data-reveal-delay={i * 0.12} data-tilt>
            <span class="hz-place__suit" aria-hidden="true">♥</span>
            <h4>{item.title}</h4>
            <p class="ce-soft">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Eindrücke ─────────────────────────────────────────── -->
  <section class="hz-gallery ce-night ce-lit">
    <StageLights soft />
    <div class="container">
      <h2 class="ce-h2 ce-center">📸 Eindrücke</h2>
      <p class="ce-center ce-soft">Weitere Fotos und Videos in meiner <a href="/galerie/">Foto- und Videogalerie</a>.</p>
      <div class="hz-gallery__grid">
        <div data-reveal="deal">
          <MagicFrame corner="tr" rank="A" suit="♥" class="hz-gallery__card" data-tilt style="--sheen-delay: 2.2s">
            <Image src={closeupImg} alt="Close-up-Zauberei an einem Tisch in Düsseldorf" loading="lazy" widths={[400, 550, 800, 1100]} sizes="(max-width: 900px) 92vw, 500px" />
          </MagicFrame>
        </div>
        <div data-reveal="deal" data-reveal-delay="0.12">
          <MagicFrame corner="tl" rank="K" suit="♦" class="hz-gallery__card" data-tilt style="--sheen-delay: 3.1s">
            <Image src={tischImg} alt="Tischzauberei für Gäste in NRW" loading="lazy" widths={[400, 550, 800, 1100]} sizes="(max-width: 900px) 92vw, 500px" />
          </MagicFrame>
        </div>
        <div data-reveal="deal" data-reveal-delay="0.24">
          <MagicFrame corner="br" rank="Q" suit="♥" class="hz-gallery__card" data-tilt style="--sheen-delay: 4s">
            <Image src={buehneImg} alt="Elegante Bühnenshow von Zauberer LIAR" loading="lazy" widths={[400, 550, 800, 1100]} sizes="(max-width: 900px) 92vw, 500px" />
          </MagicFrame>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Warum ─────────────────────────────────────────────── -->
  <section class="ce-why ce-smoke">
    <div class="container">
      <SuitRule />
      <h2 class="ce-h2 ce-center">Warum LIAR für Ihre Hochzeit?</h2>
      <div class="ce-why__grid">
        {features.map((f, i) => (
          <div class="ce-why__item" data-reveal="tilt" data-reveal-delay={(i % 3) * 0.07}>
            <p class="ce-why__suit">{f.icon}</p>
            <h3 class="ce-why__title">{f.title}</h3>
            <p class="ce-soft">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ (visible twin of the FAQPage schema) ──────────── -->
  <section class="ce-faq ce-night">
    <div class="container ce-narrow">
      <SuitRule />
      <h2 class="ce-h2 ce-center">Häufig gestellte Fragen</h2>
      <div class="ce-faq__list">
        {faqItems.map((i, n) => (
          <details class="ce-faq__item" data-reveal data-reveal-delay={n * 0.05}>
            <summary>
              <span class="ce-faq__suit" aria-hidden="true">♥</span>
              <span>{i.q}</span>
              <span class="hz-faq__plus">+</span>
            </summary>
            <p>{i.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA: an invitation card ──────────────────────────── -->
  <section class="hz-invite ce-velvet ce-lit">
    <StageLights soft />
    <div class="container">
      <div class="hz-invite__card ce-sheet ce-sheet--red" data-reveal>
        <span class="hz-invite__index hz-invite__index--tl" aria-hidden="true">A<br />♥</span>
        <span class="hz-invite__index hz-invite__index--br" aria-hidden="true">A<br />♥</span>
        <h2 class="ce-h2">💍 Zauberei für Ihre Hochzeit anfragen</h2>
        <p class="ce-soft">Sichern Sie sich Ihren Wunschtermin frühzeitig. Erzählen Sie mir kurz von Ihrer Hochzeit – ich erstelle Ihnen ein passendes, unverbindliches Angebot.</p>
        <div class="hz-invite__contact">
          <p>📞 Telefon: <a href="tel:+491721517578">0172 – 1517578</a></p>
          <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
          <p>📍 Standort: Gladbeck, NRW (mobil in ganz Deutschland)</p>
        </div>
        <a href="/kontakt/" class="btn btn--primary" data-magnetic>
          Jetzt unverbindlich anfragen
        </a>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero: the photo in its magic frame (ce-hero__frame, adult-kit.css) ── */

  /* ── intro ── */
  .hz-intro { padding-top: var(--space-4); }
  .hz-intro__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-5); align-items: center; }
  .hz-intro__text { font-family: var(--font-display); font-size: clamp(1.2rem, 2.1vw, 1.5rem); line-height: 1.5; margin-bottom: var(--space-3); }
  .hz-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .hz-checks li { display: flex; gap: 0.8rem; align-items: baseline; }
  .hz-checks__mark { color: var(--accent-strong); font-weight: 700; }

  /* menu card: card stock with an inset hairline frame, centred like a dinner menu */
  .hz-menu {
    position: relative; padding: var(--space-5) var(--space-4) var(--space-4); text-align: center;
  }
  .hz-menu__title { font-size: 1.7rem; font-style: italic; font-weight: 500; margin-bottom: var(--space-3); }
  .hz-menu__list { margin: 0; display: grid; gap: var(--space-2); }
  .hz-menu__row + .hz-menu__row::before {
    content: ''; display: block; width: 2.5rem; height: 1px; margin: 0 auto var(--space-2); background: rgba(20, 18, 16, 0.3);
  }
  .hz-menu__row dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--accent-strong); margin-bottom: 0.25rem; }
  .hz-menu__row dd { margin: 0; font-family: var(--font-display); font-size: 1.1rem; }

  /* ── wedding day: place cards ── */
  .hz-places { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); max-width: 64rem; margin: var(--space-4) auto 0; }
  .hz-place {
    position: relative; padding: 3.6rem var(--space-3) var(--space-3); text-align: center;
  }
  :global(.v2) main .hz-place { border-radius: var(--radius-sm); }
  /* the fold of a tent place card */
  .hz-place::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 2.4rem; border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: linear-gradient(to bottom, rgba(20, 18, 16, 0.07), rgba(20, 18, 16, 0)); border-bottom: 1px solid rgba(20, 18, 16, 0.18);
  }
  .hz-place__suit { position: absolute; top: 0.55rem; left: 50%; translate: -50% 0; font-family: var(--font-display); font-size: 1.2rem; color: var(--accent); }
  .hz-place h4 { font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; margin: 0 0 0.6rem; }
  .hz-place p { margin: 0; }

  /* ── gallery ── */
  .hz-gallery { overflow-x: clip; }
  /* photos ~50 % larger (2026-10-06): full width on phones, two per row on wide screens with the
     third centred below. Image sizes: ≤900px 92vw · 500px */
  .hz-gallery__grid { display: grid; gap: var(--space-4) var(--space-4); max-width: 30rem; margin: var(--space-4) auto 0; align-items: center; }
  @media (min-width: 901px) {
    .hz-gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 66rem; }
    .hz-gallery__grid > div:nth-child(3) { grid-column: 1 / -1; justify-self: center; width: calc(50% - var(--space-4) / 2); }
  }
  .hz-gallery__grid > div:nth-child(1) :global(.hz-gallery__card) { rotate: -3deg; }
  .hz-gallery__grid > div:nth-child(2) :global(.hz-gallery__card) { translate: 0 -0.8rem; }
  .hz-gallery__grid > div:nth-child(3) :global(.hz-gallery__card) { rotate: 3deg; }

  /* ── faq: keep the legacy "+" as text, hide the kit's generated one ── */
  :global(.v2) .ce-faq__item summary::after { content: none; }
  .hz-faq__plus {
    position: absolute; right: 0.25rem; top: 50%; translate: 0 -50%;
    font-family: var(--font-body); font-weight: 300; font-size: 1.8rem; line-height: 1; color: var(--accent-strong);
    transition: rotate 0.25s var(--ease-out);
  }
  .ce-faq__item[open] .hz-faq__plus { rotate: 45deg; }

  /* ── invitation ── */
  .hz-invite__card {
    position: relative; max-width: 44rem; margin-inline: auto; padding: var(--space-5) var(--space-4); text-align: center;
  }
  .hz-invite__index { position: absolute; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1; text-align: center; color: var(--accent); }
  .hz-invite__index--tl { top: 1.3rem; left: 1.4rem; }
  .hz-invite__index--br { bottom: 1.3rem; right: 1.4rem; rotate: 180deg; }
  .hz-invite__contact { margin: var(--space-3) 0; }
  .hz-invite__contact p { margin-bottom: 0.4rem; }
  .hz-invite .btn { margin-top: var(--space-1); }

  @media (max-width: 900px) {
    .hz-intro__grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .hz-gallery__grid > div :global(.hz-gallery__card) { translate: none; }
    .hz-invite__card { padding: var(--space-5) var(--space-3); }
  }
</style>
