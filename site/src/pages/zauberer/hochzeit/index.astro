---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroStage from '../../../components/HeroStage.astro';
import GoogleReviews from '../../../components/GoogleReviews.astro';
import { Image } from 'astro:assets';
import heroImg from '../../../assets/images/zauberer/tisch-zauberei-hero.jpg';
import closeupImg from '../../../assets/images/zauberer/close-up-zauberei-duesseldorf.jpg';
import buehneImg from '../../../assets/images/galerie/buehnen-zauberei.jpg';
import tischImg from '../../../assets/images/galerie/tisch-zauberer-nrw.jpg';

const seoTitle = 'Zauberer Hochzeit NRW | Tischzauberei & Show | LIAR';
const seoDescription = 'Zauberer für Ihre Hochzeit in NRW ✓ Elegante Tischzauberei am Sektempfang & Bühnen-Highlight ✓ Deutsch & Französisch ✓ 370+ Top-Bewertungen ✓ Jetzt anfragen!';

const features = [
  { icon: '🥂', title: 'Zauberei am Sektempfang', text: 'Während Fotos gemacht werden oder Gäste auf das Brautpaar warten, sorge ich mit Close-up-Zauberei direkt an den Gruppen für beste Stimmung – ganz ohne Leerlauf.' },
  { icon: '🇫🇷', title: 'Deutsch & Französisch', text: 'Als gebürtiger Franzose unterhalte ich Ihre Gäste auf Deutsch und Französisch – ideal für zweisprachige Hochzeiten und internationale Gäste.' },
  { icon: '💫', title: 'Persönlich & nah', text: 'Zauberei zum Anfassen: Karten, Ringe und Alltagsgegenstände verwandeln sich direkt in den Händen Ihrer Gäste. Persönlicher geht Unterhaltung nicht.' },
  { icon: '🎭', title: 'Show als Highlight', text: 'Auf Wunsch runde ich den Abend mit einer eleganten Bühnenshow ab – als gemeinsamer Programmpunkt für alle Gäste.' },
  { icon: '⭐', title: '370+ Top-Bewertungen', text: 'Über 400 Kundinnen und Kunden haben mich mit 5,0 von 5 Sternen bewertet. Verlässlichkeit an Ihrem wichtigsten Tag.' },
  { icon: '⚡', title: 'Unkompliziert & flexibel', text: 'Kein Bühnenaufbau nötig, kein Programm von der Stange – ich füge mich organisch in Ihren Ablauf ein und stimme alles vorab mit Ihnen ab.' },
];

const faqItems = [
  { q: 'Was macht ein Zauberer auf einer Hochzeit?', a: 'Am beliebtesten ist die Close-up-Zauberei (Tischzauberei): Ich gehe von Gruppe zu Gruppe und zeige Zauberkunst direkt in Griffweite – am Sektempfang, während der Fotosession des Brautpaars oder zwischen den Gängen. Auf Wunsch zusätzlich eine kurze Bühnenshow als gemeinsames Highlight.' },
  { q: 'Wann ist der beste Zeitpunkt für die Zauberei?', a: 'Ideal sind die Wartezeiten: der Sektempfang, die Fotosession des Brautpaars oder die Pause zwischen Essen und Abendprogramm. Genau dann überbrücke ich Leerlauf und sorge für gelöste Stimmung.' },
  { q: 'Ist die Zauberei auch auf Französisch möglich?', a: 'Ja. Als gebürtiger Franzose unterhalte ich Ihre Gäste auf Deutsch und Französisch – perfekt für zweisprachige Hochzeiten oder Gäste aus dem Ausland.' },
  { q: 'Wie viel Platz und Technik wird benötigt?', a: 'Für die Tischzauberei genügt der vorhandene Raum – keine Bühne, kein Mikrofon, kein Aufbau. Für eine zusätzliche Bühnenshow reichen eine kleine freie Fläche und ab ca. 70 Gästen eine Tonanlage.' },
  { q: 'In welchen Städten sind Sie für Hochzeiten buchbar?', a: 'In ganz NRW – u. a. Essen, Düsseldorf, Dortmund, Köln, Duisburg, Bochum, Gladbeck und im gesamten Ruhrgebiet. Auf Anfrage auch deutschlandweit sowie in Frankreich, Belgien, den Niederlanden, Österreich und der Schweiz.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Zauberer für Hochzeiten in NRW",
  "serviceType": "Hochzeitszauberer / Tischzauberei",
  "description": "Zauberer LIAR für Hochzeiten in NRW – elegante Close-up- und Tischzauberei am Sektempfang sowie Bühnenshow als Highlight. Deutsch und Französisch.",
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" },
  "url": "https://liar-entertainer.com/zauberer/hochzeit/"
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Zauberer Hochzeit, Hochzeitszauberer NRW, Tischzauberer Hochzeit, Zauberer Sektempfang, Close-up Hochzeit"
  canonical="https://liar-entertainer.com/zauberer/hochzeit/"
  structuredData={[serviceSchema, faqSchema]}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Zauberer', url: '/zauberer/' }, { name: 'Hochzeit', url: '/zauberer/hochzeit/' }]}
>

  <!-- Page Title -->
  <section class="bg-white pt-8 pb-0">
    <div class="max-w-6xl mx-auto px-4">
      <p class="text-sm text-[#595959] mb-4">
        <a href="/" class="hover:text-[#d7393e]">Clown</a> »
        <a href="/zauberer/" class="hover:text-[#d7393e]">Zauberer</a> »
        <span>Hochzeit</span>
      </p>
      <h1 class="font-black text-[#1f2025] text-3xl sm:text-5xl mb-6">Zauberer für die Hochzeit in NRW</h1>
    </div>
  </section>

  <!-- Hero -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl" style="min-height: 560px; box-shadow: 0 12px 32px rgba(0,0,0,0.14);">
        <Image
          src={heroImg}
          alt="Zauberer für die Hochzeit – elegante Tischzauberei in NRW"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          widths={[600, 900, 1200]}
          sizes="(max-width: 1152px) 100vw, 1120px"
        />
        <div class="absolute inset-0 bg-black/50"></div>
        <div class="relative flex items-center justify-center" style="min-height: 560px;">
          <div class="text-center px-6">
            <h2 class="text-white font-bold leading-tight mb-4" style="font-size: clamp(1.6rem, 4vw, 3rem); text-shadow: 2px 2px 8px rgba(0,0,0,0.5);">
              Magische Momente für Ihre Hochzeit
            </h2>
            <p class="text-white/90 text-lg font-medium">Elegante Tischzauberei am Sektempfang &amp; Show als Highlight</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="text-[#374151] leading-relaxed mb-6">
            Der schönste Tag im Leben verdient besondere Unterhaltung. Als Zauberer sorge ich in den Wartezeiten Ihrer Hochzeit – am Sektempfang, während der Fotosession oder zwischen den Gängen – für Staunen und gelöste Stimmung. Im Mittelpunkt steht die <a href="/zauberer/tisch-zauberer/" class="text-[#d7393e] hover:underline">Tischzauberei (Close-up)</a> direkt an den Gästen; auf Wunsch ergänzt um eine elegante <a href="/zauberer/buehnen-zauberer/" class="text-[#d7393e] hover:underline">Bühnenshow</a> als gemeinsames Highlight.
          </p>
          <ul class="space-y-3">
            {['✓ Zauberei direkt an den Tischen & Gruppen', '✓ Deutsch & Französisch', '✓ 370+ TOP-Bewertungen ⭐⭐⭐⭐⭐', '✓ Ohne Bühnenaufbau, flexibel im Ablauf'].map(item => (
              <li class="flex items-center gap-3 text-[#374151]">
                <span class="text-[#d7393e] font-bold">{item.split(' ').slice(0,1)}</span>
                <span>{item.split(' ').slice(1).join(' ')}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 card-hover reveal">
          <h3 class="font-bold text-[#1f2025] mb-4">📊 Auf einen Blick</h3>
          <dl class="space-y-3 text-sm">
            {[
              ['Format', 'Tischzauberei (Close-up) & optional Bühnenshow'],
              ['Anlässe', 'Sektempfang, Fotopause, Abendprogramm'],
              ['Gäste', 'Von der kleinen Feier bis zur großen Gesellschaft'],
              ['Sprachen', 'Deutsch, Französisch'],
              ['Aufbau', 'Für Close-up keiner – flexibel & mobil'],
              ['Gebiet', 'NRW, deutschlandweit & international'],
            ].map(([k, v]) => (
              <div class="flex gap-4">
                <dt class="font-semibold text-[#1f2025] w-28 flex-shrink-0">{k}:</dt>
                <dd class="text-[#374151]">{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  </HeroStage>
  <GoogleReviews />

  <!-- Ablauf -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-bold text-[#1f2025] text-2xl sm:text-3xl text-center mb-2">So passt die Zauberei in Ihren Hochzeitstag</h2>
      <p class="text-center text-[#374151] mb-8">Unterhaltung genau dann, wenn sonst Leerlauf entsteht</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {[
          { title: '🥂 Sektempfang', text: 'Ich gehe von Gruppe zu Gruppe und verwandle das Warten in kleine Wow-Momente – ein perfekter Eisbrecher zwischen Gästen, die sich noch nicht kennen.' },
          { title: '📸 Fotopause', text: 'Während das Brautpaar für Fotos unterwegs ist, bleibt die Gesellschaft bestens unterhalten – keine Langeweile, keine Wartelücke.' },
          { title: '🎭 Abendprogramm', text: 'Als Übergang zum Abend eine kurze Bühnenshow – elegant, humorvoll und für alle Gäste gleichzeitig.' },
        ].map(item => (
          <div class="bg-white rounded-lg p-5 shadow-sm card-hover reveal">
            <h4 class="font-bold text-[#1f2025] mb-2">{item.title}</h4>
            <p class="text-[#374151] text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="bg-white py-14">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-bold text-[#1f2025] text-2xl text-center mb-4">📸 Eindrücke</h2>
      <p class="text-[#374151] text-center mb-8">Weitere Fotos und Videos in meiner <a href="/galerie/" class="text-[#d7393e] hover:underline">Foto- und Videogalerie</a>.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Image src={closeupImg} alt="Close-up-Zauberei an einem Tisch in Düsseldorf" class="rounded-xl shadow-sm w-full h-56 object-cover" loading="lazy" widths={[400,700]} sizes="(max-width:640px) 100vw, 33vw" />
        <Image src={tischImg} alt="Tischzauberei für Gäste in NRW" class="rounded-xl shadow-sm w-full h-56 object-cover" loading="lazy" widths={[400,700]} sizes="(max-width:640px) 100vw, 33vw" />
        <Image src={buehneImg} alt="Elegante Bühnenshow von Zauberer LIAR" class="rounded-xl shadow-sm w-full h-56 object-cover" loading="lazy" widths={[400,700]} sizes="(max-width:640px) 100vw, 33vw" />
      </div>
    </div>
  </section>

  <!-- Why LIAR -->
  <section class="py-14 bg-[#eff4ff] border-y border-[#c5d3f7]">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-bold text-2xl sm:text-3xl text-center mb-10 text-[#1f2025]">Warum LIAR für Ihre Hochzeit?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {features.map(f => (
          <div class="bg-white rounded-xl p-5 border border-[#c5d3f7] shadow-sm card-hover reveal">
            <p class="text-2xl mb-2">{f.icon}</p>
            <h3 class="font-bold mb-2 text-[#1f2025]">{f.title}</h3>
            <p class="text-[#374151] text-sm leading-relaxed">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-center text-2xl font-extrabold text-[#1f2025] mb-8">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqItems.map((i) => (
          <details class="bg-[#f9fafb] rounded-xl p-5 group">
            <summary class="font-bold cursor-pointer text-[#1f2025] flex justify-between items-center gap-4">
              <span>{i.q}</span>
              <span class="text-[#d7393e] transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-[#374151] text-[17px] leading-relaxed">{i.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#1f2025] py-14 text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="font-bold text-2xl sm:text-3xl mb-4">💍 Zauberei für Ihre Hochzeit anfragen</h2>
      <p class="text-gray-300 mb-6">Sichern Sie sich Ihren Wunschtermin frühzeitig. Erzählen Sie mir kurz von Ihrer Hochzeit – ich erstelle Ihnen ein passendes, unverbindliches Angebot.</p>
      <div class="space-y-2 text-gray-300 mb-8">
        <p>📞 Telefon: <a href="tel:+491721517578" class="text-white hover:underline font-semibold">0172 – 1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com" class="text-white hover:underline">info@liar-entertainer.com</a></p>
        <p>📍 Standort: Gladbeck, NRW (mobil in ganz Deutschland)</p>
      </div>
      <a href="/kontakt/" class="inline-block bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold px-10 py-4 rounded transition-colors">
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>

</BaseLayout>
