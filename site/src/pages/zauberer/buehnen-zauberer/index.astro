---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import PlayingCard from '../../../components/v2/adult/PlayingCard.astro';
import SuitRule from '../../../components/v2/adult/SuitRule.astro';
import '../../../styles/adult-kit.css';
import { Image } from 'astro:assets';
import heroImg from '../../../assets/images/zauberer/buehnen-zauberer-hero.jpg';
import feuerImg from '../../../assets/images/zauberer/tisch-zauberer-nrw-buehne.png';
import standUpImg from '../../../assets/images/galerie/stand-up-zauberei.jpg';
import buehnenZaubereiImg from '../../../assets/images/galerie/buehnen-zauberei.jpg';
import buehnenGelsenkirchenImg from '../../../assets/images/galerie/buehnen-zauberei-gelsenkirchen.jpg';
import buehnenEssenImg from '../../../assets/images/galerie/buehnen-zauberer-essen.jpg';

const seoTitle = "Bühnenzauberer NRW buchen – Zaubershow für Bühne & Gala";
const seoDescription = 'Bühnenzauberer NRW ✓ Professionelle Stand-up Comedy-Zauberei ✓ 20-45 Min. für 10-150 Personen ✓ 370+ TOP-Bewertungen ✓ Auch auf Französisch ✓ Jetzt buchen!';

const features = [
  { icon: '✨', title: 'Einzigartige Comedy-Zauberei', text: 'Ich zaubere nicht nur – ich unterhalte. Die Kombination aus verblüffenden Tricks und französischem Humor macht jede Show zu einem besonderen Erlebnis.' },
  { icon: '🇫🇷', title: 'Französischer Charme', text: 'Als gebürtiger Franzose bringe ich Pariser Flair und Eleganz in meine Shows. Perfekt für internationale Events oder als besonderes Highlight.' },
  { icon: '⭐', title: '370+ TOP-Bewertungen', text: 'Über 400 zufriedene Kunden haben mich mit 5.0 von 5 Sternen bewertet. Zuverlässigkeit und Qualität sind garantiert.' },
  { icon: '🎭', title: 'Professionelle Ausbildung', text: 'Umfassende Ausbildung als Entertainer und Animateur mit Spezialisierung in Schauspiel, Comedy und Zauberei. Seit 2009 professionell im Entertainment-Bereich.' },
  { icon: '💼', title: 'Erfahrung mit allen Event-Typen', text: 'Von intimen 10-Personen-Dinners bis zu 150-Personen-Galas – ich habe Erfahrung mit jedem Event-Format und passe mich perfekt an.' },
  { icon: '🌍', title: 'Mehrsprachig', text: 'Shows auf Deutsch und Französisch möglich. Ideal für internationale Gäste oder zweisprachige Events.' },
  { icon: '⚡', title: 'Unkompliziert & Flexibel', text: 'Minimaler technischer Aufwand, kurze Aufbauzeit, flexible Anpassung an Ihr Programm. Ich mache es Ihnen leicht.' },
  { icon: '🎯', title: 'Individuelle Abstimmung', text: 'Jedes Event ist einzigartig. Ich stimme meine Show auf Ihre Gäste, Ihr Thema und Ihre Wünsche ab.' },
];

const faqItems = [
  { q: 'Wie lange dauert die Bühnenzaubershow?', a: 'Die Show ist flexibel zwischen 20 und 45 Minuten buchbar. Die beliebteste Variante sind 30 Minuten – perfekt, um zu begeistern, ohne zu lang zu sein. Ich passe die Dauer gerne an Ihr Programm an.' },
  { q: 'Für wie viele Zuschauer ist die Show geeignet?', a: 'Optimal für 10 bis 150 Personen. Bei kleineren Gruppen (unter 10) empfehle ich Close-up Zauberei, die persönlicher wirkt. Bei größeren Gruppen (über 150) können wir spezielle Setups besprechen.' },
  { q: 'Welche technischen Anforderungen gibt es?', a: 'Minimaler Aufwand! Ich benötige: Eine Fläche von ca. 3×3 Meter, idealerweise eine kleine Bühne, Mikrofon & Soundanlage (ab 70 Zuschauer), ausreichende Beleuchtung. Das war\'s schon! Keine großen Aufbauten, keine Pyrotechnik.' },
  { q: 'Ist die Show nur für Erwachsene?', a: 'Die Bühnenzauberei ist für gemischtes Publikum ab 12 Jahren geeignet. Der Humor ist familienfreundlich, aber anspruchsvoll genug für Erwachsene. Für jüngere Kinder (4-11 Jahre) empfehle ich meine spezielle Kinderzauberer-Show.' },
  { q: 'Kann die Show auch auf Französisch sein?', a: 'Absolut! Als gebürtiger Franzose biete ich Shows sowohl auf Deutsch als auch auf Französisch an. Perfekt für internationale Firmenfeiern, Events mit französischen Gästen oder zweisprachige Hochzeiten.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Bühnenzauberer NRW – Stand-up Comedy-Zauberei",
  "serviceType": "Bühnenzauberei / Stand-up Zauberei",
  "description": "Professionelle Bühnenzauberei und Stand-up Comedy-Zauberei für Firmenfeiern, Galas und Events in NRW. 20–45 Minuten für 10–150 Personen, auch auf Französisch.",
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" },
  "url": "https://liar-entertainer.com/zauberer/buehnen-zauberer/"
};
const _pageGallery = [
  { src: feuerImg, alt: 'Bühnenzauberer LIAR mit einem Feuer-Zaubertrick auf der Bühne' },
  { src: standUpImg, alt: 'Stand-up Zauberei vor Publikum in NRW' },
  { src: buehnenZaubereiImg, alt: 'Bühnenzauberer LIAR bei einer Show' },
  { src: buehnenGelsenkirchenImg, alt: 'Bühnenshow von Zauberer LIAR in Gelsenkirchen' },
  { src: buehnenEssenImg, alt: 'Stand-up bei einer Firmenfeier in Essen mit Assistentin aus dem Publikum' },
];

---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Bühnenzauberer NRW, Stand-up Zauberer, Bühnenzauberei buchen, Gala Zauberer, Bühnenzauberer Firmenfeier"
  canonical="https://liar-entertainer.com/zauberer/buehnen-zauberer/"
  structuredData={[serviceSchema, faqSchema]}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Zauberer', url: '/zauberer/' }, { name: 'Bühnen Zauberer', url: '/zauberer/buehnen-zauberer/' }]}
>
  <!-- ── Hero: house lights down, one card in the spotlight ── -->
  <section class="ce-hero bz-hero">
    <div class="container ce-hero__grid">
      <div class="ce-hero__copy">
        <p class="ce-crumbs">
          <a href="/">Clown</a> »
          <a href="/zauberer/">Zauberer</a> »
          <span>Bühnen Zauberer</span>
        </p>
        <h1 class="ce-hero__title"><em>Bühnenzauberer</em> NRW für Firmenfeiern &amp; Galas</h1>
        <SuitRule />
        <h2 class="ce-hero__sub">
          Professionelle Bühnenzauberei in NRW
        </h2>
        <p class="ce-hero__claim ce-hero__claim--soft">Stand-up Comedy-Zauberei für Events, Galas &amp; Feiern</p>
        <div class="ce-hero__actions">
          <a class="btn btn--primary bz-btn" href="/kontakt/" data-magnetic>Unverbindlich anfragen</a>
          <ReviewBadge />
        </div>
      </div>

      <div class="bz-spot">
        <span class="bz-spot__beam" aria-hidden="true"></span>
        <PlayingCard back class="bz-spot__back" aria-hidden="true" />
        <PlayingCard rank="K" suit="♠" class="bz-spot__photo" data-tilt>
          <Image
            src={heroImg}
            alt="Bühnenzauberer NRW – Professionelle Stand-up Zauberei"
            title="Bühnenzauberer LIAR – Stand-up Zauberei in NRW"
            widths={[400, 700, 1000]}
            sizes="(max-width: 900px) 70vw, 380px"
            loading="eager"
            fetchpriority="high"
            style="object-position: 47% 40%"
          />
        </PlayingCard>
      </div>
    </div>
  </section>

  <!-- ── Intro + playbill ──────────────────────────────────── -->
  <section class="bz-intro">
    <div class="container bz-intro__grid">
      <div>
        <p class="bz-intro__text" data-reveal>
          Elegante Zauberkunst trifft auf französischen Charme – erleben Sie eine Show, die Ihre Gäste zwischen Staunen und Lachen pendeln lässt. Als professioneller Bühnenzauberer verwandle ich Ihre Veranstaltung in ein unvergessliches Erlebnis. Für kleinere Runden empfehle ich alternativ meine <a href="/zauberer/tisch-zauberer/">Tischzauberei und Close-up Magie</a>.
        </p>
        <ul class="bz-ticks">
          {['✓ 35 Minuten Show', '✓ Für 10-150 Personen', '✓ 370+ TOP-Bewertungen ⭐⭐⭐⭐⭐', '✓ Auch auf Französisch verfügbar'].map((item, i) => (
            <li data-reveal data-reveal-delay={i * 0.06}>
              <span class="bz-tick">{item.split(' ').slice(0,1)}</span>
              <span>{item.split(' ').slice(1).join(' ')}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bz-bill" data-reveal="deal" data-tilt>
        <span class="bz-bill__corner bz-bill__corner--tl" aria-hidden="true">♠</span>
        <span class="bz-bill__corner bz-bill__corner--br ce-red" aria-hidden="true">♥</span>
        <h3>📊 Eckdaten der Show</h3>
        <dl>
          {[
            ['Dauer', '20–45 Minuten (flexibel)'],
            ['Publikum', 'Optimal für 10–150 Personen'],
            ['Platzbedarf', 'Ca. 3×3 Meter Fläche'],
            ['Aufbauzeit', '15–20 Minuten'],
            ['Sprachen', 'Deutsch, Französisch'],
            ['Techn. Aufwand', 'Minimal'],
          ].map(([k, v]) => (
            <div class="bz-bill__row">
              <dt>{k}:</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ── Anlässe ───────────────────────────────────────────── -->
  <section class="ce-occasions" data-related-services>
    <div class="container ce-narrow">
      <h2 class="ce-h2 ce-center">
        Für welche Anlässe kann man Zauberer LIAR sonst buchen?
      </h2>
      <div class="ce-occasions__grid">
        <a href="/zauberer/hochzeit/" class="ce-occasion" data-reveal="deal" data-tilt>
          <span class="ce-occasion__suit ce-red" aria-hidden="true">♥</span>
          <p class="ce-occasion__title">Zauberer für die Hochzeit</p>
          <p class="ce-occasion__text">Close-up-Zauberei am Tisch, beim Sektempfang und während der Fotosession.</p>
        </a>
        <a href="/zauberer/firmenfeier/" class="ce-occasion" data-reveal="deal" data-reveal-delay="0.12" data-tilt>
          <span class="ce-occasion__suit" aria-hidden="true">♠</span>
          <p class="ce-occasion__title">Zauberer für die Firmenfeier</p>
          <p class="ce-occasion__text">Walk-Act zwischen den Tischen oder Bühnenshow für Betriebsfeier und Jubiläum.</p>
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Was ist Bühnenzauberei? ───────────────────────────── -->
  <section class="bz-what">
    <div class="container">
      <h2 class="ce-h2 ce-center">Was ist Bühnenzauberei?</h2>
      <p class="bz-what__sub ce-center">Zauberkunst für Ihr gesamtes Publikum</p>
      <div class="ce-narrow">
        <p class="ce-soft ce-center bz-what__text" data-reveal>
          Bei der Bühnenzauberei (auch Stand-up Zauberei genannt) präsentiere ich meine Illusionen auf einer Bühne oder im Parkett für 10 bis 150 Zuschauer gleichzeitig. Im Gegensatz zur <a href="/zauberer/tisch-zauberer/">Close-up Zauberei am Tisch</a> erleben bei einer Bühnenshow alle Gäste zur gleichen Zeit die gleichen verblüffenden Momente.
        </p>
      </div>
      <div class="bz-what__grid">
        {[
          { title: 'Eleganter Stil mit Comedy-Elementen', text: 'Keine „klassische" <a href="/zauberer/zaubershow/">Zaubershow</a>, sondern eine raffinierte Mischung aus Illusion und Humor.' },
          { title: 'Interaktiv & Einbindend', text: 'Ihr Publikum wird Teil der Show. Ausgewählte Gäste werden auf die Bühne geholt und erleben die Magie aus nächster Nähe.' },
          { title: 'Flexibel & Anpassbar', text: 'Elegant für Galas, humorvoll für Betriebsfeiern, zurückhaltend für feierliche Anlässe.' },
        ].map((item, i) => (
          <div class="bz-what__card" data-reveal="deal" data-reveal-delay={i * 0.12} data-tilt>
            <span class:list={['bz-what__suit', { 'ce-red': i === 1 }]} aria-hidden="true">{['♠', '♥', '♣'][i]}</span>
            <h4>{item.title}</h4>
            <p class="ce-soft" set:html={item.text} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Galerie: a spread of photo cards on the stage ─────── -->
  <section class="bz-stageband bz-gallery">
    <div class="container">
      <h2 class="ce-h2 ce-center">📸 Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <p class="ce-center bz-gallery__text">Weitere Fotos und Videos finden Sie in meiner <a href="/galerie/">Foto- und Videogalerie</a>.</p>
      <div class="bz-spread">
        {_pageGallery.map((g, i) => (
          <div class="bz-spread__slot" style={`--i: ${i - 2}; --lift: ${Math.abs(i - 2)}`} data-reveal="deal" data-reveal-delay={i * 0.1}>
            <PlayingCard
              rank={['A', 'K', 'Q', 'J', '10'][i]}
              suit={(['♠', '♥', '♣', '♦', '♠'] as const)[i]}
              class="bz-spread__card"
              style={`--sheen-delay: ${2 + i * 0.8}s`}
            >
              <Image src={g.src} alt={g.alt} widths={[300, 600]} sizes="(max-width: 700px) 44vw, 15rem" loading="lazy" />
            </PlayingCard>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Warum ─────────────────────────────────────────────── -->
  <section class="bz-why">
    <div class="container">
      <h2 class="ce-h2 ce-center">Warum Bühnenzauberer LIAR?</h2>
      <div class="bz-why__grid">
        {features.map((f, i) => (
          <div class="bz-why__item" data-reveal="tilt" data-reveal-delay={(i % 4) * 0.07}>
            <p class="bz-why__icon">{f.icon}</p>
            <h3>{f.title}</h3>
            <p class="ce-soft">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Einsatzgebiet + Kurz-FAQ ──────────────────────────── -->
  <section class="bz-area">
    <div class="container">
      <h2 class="ce-h2 ce-center">In welchen Städten ist Clown Zauberer LIAR buchbar?</h2>
      <h3 class="bz-area__sub ce-center">Wo bin ich als Bühnenzauberer buchbar?</h3>
      <div class="bz-area__grid">
        <div data-reveal>
          <h4>🏙️ Haupteinsatzgebiet: Nordrhein-Westfalen</h4>
          <p class="ce-soft bz-area__cities">
            Essen • Düsseldorf • Dortmund • Köln • Duisburg • Oberhausen • Gelsenkirchen • Bochum • Gladbeck • Mülheim an der Ruhr • Herne • Marl • Dorsten • Herten • Recklinghausen • Krefeld • Moers • Münster • Hagen • Lünen • Bottrop • Castrop-Rauxel • Wuppertal
          </p>
          <h4>🌍 Überregional & International</h4>
          <p class="ce-soft">Deutschland: Gesamtes Bundesgebiet<br />International: Frankreich, Belgien, Niederlande, Österreich, Schweiz</p>
        </div>
        <div class="bz-qa" data-reveal data-reveal-delay="0.1">
          <h4>FAQ</h4>
          {faqItems.slice(0, 3).map((item) => (
            <div class="bz-qa__item">
              <p class="bz-qa__q">{item.q}</p>
              <p class="bz-qa__a">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA: curtain call ─────────────────────────────────── -->
  <section class="bz-stageband bz-cta">
    <div class="container ce-narrow ce-center">
      <h2 class="ce-h2">🎪 Jetzt buchen – Lassen Sie sich verzaubern!</h2>
      <p class="bz-cta__text">Machen Sie Ihr Event zu einem unvergesslichen Erlebnis mit professioneller Bühnenzauberei. Über 400 zufriedene Kunden können nicht irren! Verschaffen Sie sich einen Eindruck in meiner <a href="/galerie/">Fotogalerie</a>.</p>
      <div class="bz-cta__contact">
        <p>📞 Telefon: <a href="tel:+491721517578">0172 – 1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
        <p>📍 Standort: Gladbeck, NRW (mobil in ganz Deutschland)</p>
      </div>
      <a href="/kontakt/" class="btn btn--primary bz-btn" data-magnetic>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>
</V2Layout>

<style>
  /* Stage palette: ink background, paper text. Red is lifted for contrast on black (#ec4a60: 4.9:1). */
  .bz-hero, .bz-stageband {
    --stage-red: #ec4a60;
    --stage-soft: #d9d1c2;
    background: var(--ink); color: var(--bg);
  }

  /* ── hero ── */
  .bz-hero { isolation: isolate; }
  :global(.v2) .bz-hero .ce-crumbs, :global(.v2) .bz-hero .ce-crumbs a { color: var(--stage-soft); }
  :global(.v2) .bz-hero .ce-hero__title { color: var(--bg); }
  :global(.v2) .bz-hero .ce-hero__title em { color: var(--stage-red); }
  :global(.v2) .bz-hero .ce-hero__sub { color: var(--bg); }
  :global(.v2) .bz-hero .ce-hero__claim--soft { color: var(--stage-soft); }
  :global(.v2) .bz-hero .sr { color: var(--bg); }
  :global(.v2) .bz-hero .sr__suit--red { color: var(--stage-red); }
  :global(.v2) .bz-btn { background: var(--accent); color: var(--accent-ink); }
  @media (hover: hover) and (pointer: fine) {
    :global(.v2) .bz-btn:hover { background: var(--accent-strong); }
  }

  .bz-spot { position: relative; height: clamp(26rem, 44vw, 34rem); display: grid; place-items: center; }
  /* the spotlight: a soft cone from above and a pool of light on the floor; fades up once */
  .bz-spot__beam {
    position: absolute; inset: -20% -10% -6%; z-index: -1; pointer-events: none;
    background:
      radial-gradient(ellipse 34% 9% at 50% 92%, rgba(255, 246, 225, 0.22), transparent 70%),
      conic-gradient(at 50% -8%, transparent 0deg 162deg, rgba(255, 246, 225, 0.13) 170deg 190deg, transparent 198deg 360deg);
    animation: bz-lights 1.6s var(--ease-out) 0.2s backwards;
  }
  @keyframes bz-lights { from { opacity: 0; } }
  .bz-spot :global(.bz-spot__photo) { position: relative; z-index: 2; width: clamp(18rem, 36vw, 28rem); rotate: 2.5deg; }
  .bz-spot :global(.bz-spot__back) {
    /* lies sideways like the photo card and peeks out above-left of it */
    position: absolute; left: 50%; top: 50%; width: clamp(16rem, 32vw, 25rem); aspect-ratio: 7 / 5;
    translate: -50% -50%;
    transform: translate(-30%, -26%) rotate(-9deg);
    box-shadow: 0 0 0 1px rgba(255, 253, 247, 0.25), var(--shadow);
    animation: bz-slide 1s var(--ease-out) 0.5s backwards;
  }
  @keyframes bz-slide { from { transform: translate(0, 0) rotate(0deg); } }

  /* ── intro + playbill ── */
  .bz-intro__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-5); align-items: center; }
  .bz-intro__text { font-family: var(--font-display); font-size: clamp(1.2rem, 2.2vw, 1.55rem); line-height: 1.5; }
  .bz-ticks { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: 0.2rem; }
  .bz-ticks li { display: flex; gap: 0.8rem; align-items: baseline; padding: 0.55rem 0; border-top: 1px solid rgba(20, 18, 16, 0.2); }
  .bz-tick { color: var(--accent-strong); font-weight: 700; }
  .bz-bill {
    position: relative; padding: var(--space-4) var(--space-4) var(--space-3);
    background: var(--surface); border-radius: var(--radius);
    box-shadow: inset 0 0 0 0.5rem var(--surface), inset 0 0 0 calc(0.5rem + 1px) rgba(20, 18, 16, 0.5), 0 0 0 1px rgba(20, 18, 16, 0.18), var(--shadow);
  }
  .bz-bill__corner { position: absolute; font-family: var(--font-display); font-size: 1.3rem; line-height: 1; }
  .bz-bill__corner--tl { top: 1rem; left: 1.1rem; }
  .bz-bill__corner--br { bottom: 1rem; right: 1.1rem; rotate: 180deg; }
  .bz-bill h3 { font-size: 1.5rem; text-align: center; margin: 0 0 var(--space-3); }
  .bz-bill dl { margin: 0; display: grid; gap: 0.55rem; }
  /* programme rows with a dotted leader between label and value */
  .bz-bill__row { display: flex; align-items: baseline; gap: 0.6rem; font-size: 0.95rem; }
  .bz-bill__row::after { content: ''; order: 1; flex: 1; border-bottom: 1px dotted rgba(20, 18, 16, 0.45); min-width: 1rem; }
  .bz-bill dt { font-weight: 600; white-space: nowrap; }
  .bz-bill dd { order: 2; margin: 0; text-align: right; color: var(--ink-soft); }

  /* ── what ── */
  .bz-what { background: var(--bg-alt); }
  .bz-what__sub { font-family: var(--font-display); font-style: italic; font-size: 1.35rem; margin-top: calc(var(--space-2) * -1) !important; }
  .bz-what__text { margin-top: var(--space-3) !important; }
  .bz-what__grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); max-width: 62rem; margin: var(--space-4) auto 0; }
  .bz-what__card {
    position: relative; padding: var(--space-4) var(--space-3) var(--space-3);
    background: var(--surface); border-radius: var(--radius); box-shadow: 0 0 0 1px rgba(20, 18, 16, 0.16), var(--shadow);
  }
  .bz-what__suit { position: absolute; top: 0.8rem; left: 1rem; font-family: var(--font-display); font-size: 1.5rem; line-height: 1; }
  .bz-what__card h4 { font-size: 1.35rem; margin: 0.4rem 0 0.5rem; }
  .bz-what__card p { margin: 0; }

  /* ── gallery: five photo cards fanned under the spotlight ── */
  .bz-gallery { overflow: clip; }
  .bz-gallery::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 55% 60% at 50% 0%, rgba(255, 246, 225, 0.14), transparent 70%);
  }
  :global(.v2) .bz-stageband .ce-h2 { color: var(--bg); }
  .bz-stageband a:not(.btn) { color: var(--bg); text-decoration-color: var(--stage-red); text-underline-offset: 0.2em; }
  .bz-gallery__text { color: var(--stage-soft); }
