---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import MagicFrame from '../../../components/v2/adult/MagicFrame.astro';
import StageLights from '../../../components/v2/adult/StageLights.astro';
import SuitRule from '../../../components/v2/adult/SuitRule.astro';
import '../../../styles/adult-kit.css';
import { Image } from 'astro:assets';
import heroImg from '../../../assets/images/zauberer/tisch-zauberei-hero.jpg';
import tischMuelheimImg from '../../../assets/images/galerie/tisch-zauberer-muelheim.jpg';
import tischNrwImg from '../../../assets/images/galerie/tisch-zauberer-nrw.jpg';
import closeUpDortmundImg from '../../../assets/images/galerie/close-up-zauberei-dortmund.jpg';
import closeUpMuelheimImg from '../../../assets/images/galerie/close-up-zauberei-muelheim.jpg';
import closeUpDuesseldorfImg from '../../../assets/images/zauberer/close-up-zauberei-duesseldorf.jpg';

const seoTitle = 'Tischzauberer NRW | Close-up Magie | LIAR';
const seoDescription = 'Tisch Zauberer LIAR in NRW ✓ Close-up Magie für Hochzeit, Firmenevent & Geburtstag ✓ 370+ Top-Bewertungen ✓ Elegant & niveauvoll ✓ Jetzt unverbindlich anfragen!';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Tischzauberer & Close-up Zauberei NRW",
  "serviceType": "Tischzauberei / Close-up Magie",
  "description": "Professionelle Tischzauberei und Close-up Magie für Hochzeiten, Firmenevents und Empfänge in ganz NRW. Magie direkt an den Tischen Ihrer Gäste.",
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" },
  "url": "https://liar-entertainer.com/zauberer/tisch-zauberer/"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist Tischzauberei (Close-up Zauberei)?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tischzauberei ist Zauberkunst in ihrer intimsten Form: Karten, Münzen und Alltagsgegenstände verwandeln sich direkt vor den Augen der Gäste – in Griffweite, persönlich und ohne Bühne. Ideal für Hochzeiten, Empfänge und Dinner-Events." }
    },
    {
      "@type": "Question",
      "name": "Braucht die Tischzauberei eine Bühne oder Technik?",
      "acceptedAnswer": { "@type": "Answer", "text": "Nein. Tischzauberer LIAR kommt direkt zu den Tischen Ihrer Gäste – kein Platzbedarf, keine Bühne, kein Mikrofon. Die Zauberei fügt sich organisch in den Ablauf Ihres Events ein." }
    },
    {
      "@type": "Question",
      "name": "Für welche Events eignet sich Close-up Zauberei?",
      "acceptedAnswer": { "@type": "Answer", "text": "Besonders für Hochzeiten, Sekt- und Cocktail-Empfänge, Dinner- und Gala-Events sowie Firmenfeiern, bei denen die Gäste in Gruppen sitzen oder stehen. Auch eine Kombination mit einer Bühnenshow ist möglich." }
    },
    {
      "@type": "Question",
      "name": "In welchen Städten ist Tischzauberer LIAR buchbar?",
      "acceptedAnswer": { "@type": "Answer", "text": "Hauptsächlich in ganz NRW (u. a. Essen, Düsseldorf, Dortmund, Köln, Duisburg, Mülheim, Gladbeck) sowie deutschlandweit und international in Frankreich, Belgien, den Niederlanden, Österreich und der Schweiz." }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert der Einsatz eines Tischzauberers?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der Einsatz ist flexibel über 2–4 Stunden buchbar. Pro Tischgruppe (3–8 Personen) zeigt LIAR ca. 5–10 Minuten Zauberkunst und wechselt dann zur nächsten Gruppe." }
    }
  ]
};
const ablauf = [
  { step: '1', title: 'Ankommen bei der Gruppe', text: 'Mit einem charmanten „Darf ich Ihnen etwas Magisches zeigen?" stelle ich mich vor.' },
  { step: '2', title: '5-10 Minuten Zauberkunst', text: 'Eine Abfolge verblüffender Tricks – Karten, Münzen, Mentalmagie. Alles direkt vor ihren Augen.' },
  { step: '3', title: 'Persönliche Interaktion', text: 'Gäste werden einbezogen, dürfen Karten ziehen, Gegenstände prüfen. Jeder wird Teil der Magie.' },
  { step: '4', title: 'Weiter zur nächsten Gruppe', text: 'Nach 8-10 Minuten ziehe ich weiter. Die Gruppe bleibt staunend zurück – mit Gesprächsstoff für den Rest des Abends.' },
];
const _pageGallery = [
  { src: tischMuelheimImg, alt: 'Tisch Zauberer Mülheim – die Sparkasse empfängt Zauberkünstler LIAR' },
  { src: tischNrwImg, alt: 'Tisch Zauberer NRW bei einem Event' },
  { src: closeUpDortmundImg, alt: 'Close-up Zauberei in Dortmund mit Karten und Münzen' },
  { src: closeUpMuelheimImg, alt: 'Close-up Zauberei in Mülheim für Gäste am Tisch' },
  { src: closeUpDuesseldorfImg, alt: 'Close-up Zauberei bei Firmenevent in Düsseldorf' },
];

---

<V2Layout
  mainClass="ce-salon-page seam-fade"
  title={seoTitle}
  description={seoDescription}
  keywords="Tischzauberer NRW, Close-up Zauberer, Tischzauberei Hochzeit, Close-up Zauberei buchen, Tischzauberer Event"
  canonical="https://liar-entertainer.com/zauberer/tisch-zauberer/"
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Zauberer', url: '/zauberer/' }, { name: 'Tisch Zauberer', url: '/zauberer/tisch-zauberer/' }]}
  structuredData={[serviceSchema, faqSchema]}
>
  <!-- ── Hero: photo card beside a deck; the chosen card rises out of it (ambitious card) ── -->
  <section class="ce-hero ce-hero--stage">
    <StageLights />
    <div class="container ce-hero__grid">
      <div class="ce-hero__copy">
        <p class="ce-crumbs">
          <a href="/">Clown</a> »
          <a href="/zauberer/">Zauberer</a> »
          <span>Tisch Zauberer</span>
        </p>
        <h1 class="ce-hero__title">Tischzauberer NRW – <em>Close-up Magie</em> für Hochzeit &amp; Event</h1>
        <div class="ce-spot">
          <div class="ce-hero__frame ce-spot__frame">
            <MagicFrame corner="tr" rank="D" suit="♥" data-tilt>
              <Image
                src={heroImg}
                alt="Tischzauberer NRW – Close-up Zauberei für Hochzeiten & Events"
                title="Tischzauberer LIAR – Close-up Zauberei in NRW"
                widths={[450, 720, 1080, 1440]}
                sizes="(max-width: 900px) 88vw, 736px"
                loading="eager"
                fetchpriority="high"
              />
            </MagicFrame>
          </div>
        </div>
        <SuitRule />
        <h2 class="ce-hero__sub">
          Tischzauberer &amp; Close-up Zauberei in NRW
        </h2>
        <p class="ce-hero__claim ce-hero__claim--soft">Magie zum Greifen nah – Direkt an den Tischen Ihrer Gäste</p>
        <div class="ce-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-magnetic>Unverbindlich anfragen</a>
          <ReviewBadge />
        </div>
      </div>

    </div>
  </section>

  <!-- ── Intro + facts laid out on an ink table ────────────── -->
  <section class="tz-intro ce-salon">
    <div class="container tz-intro__grid">
      <div>
        <p class="tz-intro__text" data-reveal>
          Erleben Sie Zauberkunst in ihrer intimsten Form. Als professioneller Tischzauberer bringe ich die Magie direkt zu Ihren Gästen – verblüffend nah, persönlich und unvergesslich. Perfekt für Hochzeiten, Empfänge und Dinner-Events. Wenn Sie lieber eine Show vor großem Publikum wünschen, schauen Sie sich meine <a href="/zauberer/buehnen-zauberer/">Bühnenzauberei</a> an.
        </p>
        <ul class="tz-ticks">
          <li data-reveal><span class="tz-tick">✓</span> 2–4 Stunden flexibler Einsatz</li>
          <li data-reveal data-reveal-delay="0.05"><span class="tz-tick">✓</span> Kleine Gruppen (3–8 Personen)</li>
          <li data-reveal data-reveal-delay="0.1"><span class="tz-tick">✓</span> 370+ TOP-Bewertungen ⭐⭐⭐⭐⭐</li>
          <li data-reveal data-reveal-delay="0.15"><span class="tz-tick">✓</span> Französischer Charme</li>
          <li data-reveal data-reveal-delay="0.2"><span class="tz-tick">✓</span> Kein Platzbedarf – Ich komme zu den Tischen</li>
        </ul>
      </div>
      <div class="tz-table">
        <h3>📊 Eckdaten</h3>
        <dl class="tz-facts">
          {[
            ['Einsatzzeit', '2–4 Stunden (flexibel buchbar)'],
            ['Pro Gruppe', '5–10 Minuten Zauberkunst'],
            ['Gruppengröße', '3–8 Personen'],
            ['Format', 'Walk Around (zwischen Tischen)'],
            ['Platzbedarf', 'Keiner! Ich komme zu den Gästen'],
            ['Techn. Aufwand', 'Keiner (keine Bühne, kein Mikrofon)'],
          ].map(([k, v], i) => (
            <div class="tz-facts__card ce-sheet" data-reveal="deal" data-reveal-delay={i * 0.08}>
              <dt>{k}:</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ── Anlässe ───────────────────────────────────────────── -->
  <section class="ce-occasions ce-salon" data-related-services>
    <div class="container ce-narrow">
      <SuitRule />
      <h2 class="ce-h2 ce-center">
        Für welche Anlässe kann man Zauberer LIAR sonst buchen?
      </h2>
      <div class="ce-occasions__grid">
        <a href="/zauberer/hochzeit/" class="ce-occasion" data-reveal="deal" data-tilt>
          <span class="ce-occasion__suit ce-red" aria-hidden="true">♥</span>
          <p class="ce-occasion__title">Zauberer für die Hochzeit</p>
          <p class="ce-occasion__text">Close-up-Zauberei am Tisch, beim Sektempfang und während der Fotosession.</p>
        </a>
        <a href="/zauberer/firmenfeier/" class="ce-occasion" data-reveal="deal" data-reveal-delay="0.12" data-tilt>
          <span class="ce-occasion__suit" aria-hidden="true">♠</span>
          <p class="ce-occasion__title">Zauberer für die Firmenfeier</p>
          <p class="ce-occasion__text">Walk-Act zwischen den Tischen oder Bühnenshow für Betriebsfeier und Jubiläum.</p>
        </a>
      </div>
    </div>
  </section>

  <div class="ce-stage ce-lit">
    <StageLights soft />
    <Reviews />
  </div>

  <!-- ── Was ist Close-up: four cards turned face up ───────── -->
  <section class="tz-what ce-salon">
    <div class="container">
      <h2 class="ce-h2 ce-center">Was ist Close-up Zauberei?</h2>
      <div class="tz-what__grid">
        {[
          { icon: '👁️', title: 'Zum Greifen nah', text: 'Die Magie geschieht direkt vor den Augen Ihrer Gäste – in Griffweite. Karten, Münzen, Ringe und Alltagsgegenstände werden zu Zauberwerkzeugen.' },
          { icon: '🤝', title: 'Persönlich & Intim', text: 'Keine anonyme Show vor großem Publikum. Ich trete mit jeder Gruppe in direkten Kontakt und schaffe persönliche, magische Momente.' },
          { icon: '🔄', title: 'Flexibel & Organisch', text: 'Keine feste Show zu fester Zeit. Ich bewege mich während Ihres Events zwischen den Gruppen und füge mich organisch in den Ablauf ein.' },
          { icon: '🇫🇷', title: 'Französischer Charme', text: 'Als gebürtiger Franzose bringe ich eine besondere Note – charmant, eloquent und mit einer Prise Pariser Flair.' },
        ].map((item, i) => (
          <div class="tz-what__card ce-sheet" data-reveal="flip" data-reveal-delay={i * 0.14}>
            <span class="card-back" aria-hidden="true"></span>
            <span class:list={['tz-what__suit', { 'ce-red': i % 2 }]} aria-hidden="true">{['♠', '♥', '♣', '♦'][i]}</span>
            <p class="tz-what__icon">{item.icon}</p>
            <h3>{item.title}</h3>
            <p class="ce-soft">{item.text}</p>
          </div>
        ))}
      </div>
      <p class="ce-center tz-what__more"><a class="btn btn--ghost" href="/zauberer/close-up/">Close-up-Zauberei</a></p>
    </div>
  </section>

  <!-- ── Ablauf: one round from table to table ─────────────── -->
  <section class="tz-round ce-salon">
    <div class="container ce-narrow-wide">
      <h2 class="ce-h2 ce-center">🎭 Typischer Ablauf</h2>
      <ol class="tz-round__list">
        {ablauf.map((step, i) => (
          <li class="tz-round__step" data-reveal="deal" data-reveal-delay={i * 0.12}>
            <div class="tz-chip">{step.step}</div>
            <div>
              <h3>{step.title}</h3>
              <p class="ce-soft">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Galerie: photos scattered on the table ───────────── -->
  <section class="tz-gallery ce-salon">
    <div class="container">
      <h2 class="ce-h2 ce-center">📸 Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <p class="ce-center ce-soft">Noch mehr Eindrücke gibt es in der <a href="/galerie/">Foto- und Videogalerie</a>.</p>
      <div class="tz-scatter">
        {_pageGallery.map((g, i) => (
          <div class="tz-scatter__slot" data-reveal="deal" data-reveal-delay={i * 0.1}>
            <MagicFrame
              corner={(['tr', 'bl', 'tl', 'br', 'tr'] as const)[i]}
              rank={['A', '8', 'K', '3', 'B'][i]}
              suit={(['♦', '♣', '♥', '♠', '♦'] as const)[i]}
              style={`--sheen-delay: ${2.4 + i * 0.7}s`}
              data-tilt
            >
              <Image src={g.src} alt={g.alt} widths={[300, 450, 600, 900]} sizes="(max-width: 600px) 88vw, (max-width: 900px) 40vw, 300px" loading="lazy" />
            </MagicFrame>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Wann Close-up? Two cards to choose from ──────────── -->
  <section class="tz-choose ce-salon">
    <div class="container ce-narrow-wide">
      <SuitRule />
      <h2 class="ce-h2 ce-center">Wann Close-up wählen?</h2>
      <div class="tz-choose__grid">
        <div class="tz-choice tz-choice--red ce-sheet ce-sheet--red" data-reveal="deal" data-tilt>
          <span class="tz-choice__index tz-choice__index--tl" aria-hidden="true">A<br />♦</span>
          <span class="tz-choice__index tz-choice__index--br" aria-hidden="true">A<br />♦</span>
          <h3>✅ Perfekt für Close-up Zauberei:</h3>
          <ul>
            {['Hochzeiten (DER Klassiker!)', 'Empfänge (Sekt, Cocktail)', 'Dinner-Events (Gala, Business)', 'Gäste sitzen/stehen in Gruppen', 'Kein fixes Showprogramm gewünscht', 'Intimate, persönliche Atmosphäre', 'Flexibilität wichtig', 'Events über mehrere Stunden'].map(i => (
              <li><span class="tz-tick">✓</span>{i}</li>
            ))}
          </ul>
        </div>
        <div class="tz-choice ce-sheet" data-reveal="deal" data-reveal-delay="0.14" data-tilt>
          <span class="tz-choice__index tz-choice__index--tl" aria-hidden="true">A<br />♠</span>
          <span class="tz-choice__index tz-choice__index--br" aria-hidden="true">A<br />♠</span>
          <h3>✅ Perfekt für Bühnenshow:</h3>
          <ul>
            {['Betriebsfeiern mit Programm', 'Galas mit Show-Teil', 'Große Geburtstage (50+)', 'Alle sollen gleichzeitig unterhalten werden', 'Fester Programmpunkt gewünscht', 'Show-Charakter', 'Bühne vorhanden', '10–150 Gäste'].map(i => (
              <li><span class="tz-tick">✓</span>{i}</li>
            ))}
          </ul>
          <p class="tz-choice__tip">💡 Tipp: Bei vielen Events ist auch eine Kombination möglich! Bühnenshow (30 Min.) + Close-up während Dinner (2h)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── So buchen Sie: five cards turned over ─────────────── -->
  <section class="ce-steps tz-book ce-salon">
    <div class="container">
      <h2 class="ce-h2 ce-center">So buchen Sie</h2>
      <div class="ce-steps__list tz-book__list">
        {[
          { n: '1', t: 'Kontakt', d: 'Anrufen oder E-Mail schreiben' },
          { n: '2', t: 'Beratung', d: 'Wir besprechen Ihr Event, Gäste-Anzahl & Wünsche' },
          { n: '3', t: 'Angebot', d: 'Individuelles, unverbindliches Angebot innerhalb 24h' },
          { n: '4', t: 'Bestätigung', d: 'Buchungsbestätigung mit allen Details' },
          { n: '5', t: 'Ihr Event', d: 'Ich komme pünktlich und sorge für magische Momente!' },
        ].map((step, i) => (
          <div class="ce-step tz-book__step" data-reveal="flip" data-reveal-delay={i * 0.14}>
            <span class="card-back" aria-hidden="true"></span>
            <div class:list={['ce-step__num', { 'ce-red': i % 2 }]}>{step.n}</div>
            <p class="tz-book__title">{step.t}</p>
            <p class="ce-soft">{step.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Einsatzgebiet + direkt anfragen ───────────────────── -->
  <section class="tz-area ce-salon">
    <div class="container">
      <h2 class="ce-h2 ce-center">Wo bin ich als Tischzauberer buchbar?</h2>
      <div class="tz-area__grid">
        <div data-reveal>
          <h3>🏙️ Haupteinsatzgebiet: Nordrhein-Westfalen</h3>
          <p class="ce-soft tz-area__cities">
            Essen • Düsseldorf • Dortmund • Köln • Duisburg • Oberhausen • Gelsenkirchen • Bochum • Gladbeck • Mülheim an der Ruhr • Herne • Marl • Dorsten • Herten • Recklinghausen • Krefeld • Moers • Münster • Hagen • Lünen • Bottrop • Castrop-Rauxel • Wuppertal • Ahaus • Reken
          </p>
          <h3>🌍 Überregional & International</h3>
          <p class="ce-soft">Deutschland: Gesamtes Bundesgebiet<br />International: Frankreich, Belgien, Niederlande, Österreich, Schweiz</p>
        </div>
        <div class="tz-direct ce-sheet ce-sheet--red" data-reveal="deal" data-tilt>
          <span class="tz-direct__suit" aria-hidden="true">♦</span>
          <h3>📞 Direkt anfragen</h3>
          <div class="tz-direct__lines">
            <p>📱 Telefon & WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
            <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
            <p>📍 Standort: Beethovenstr. 15, 45966 Gladbeck</p>
            <p>⚡ Reaktionszeit: Meist innerhalb 24 Stunden</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────── -->
  <section class="tz-cta ce-stage ce-lit">
    <StageLights soft />
    <div class="container ce-narrow ce-center">
      <h2 class="ce-h2">✨ Jetzt Tischzauberer buchen!</h2>
      <p class="tz-cta__text">Zauberei zum Greifen nah – für Ihre Hochzeit, Ihr Dinner-Event oder Ihren Empfang. Kombinieren Sie die Tischzauberei mit einer <a href="/zauberer/buehnen-zauberer/">Bühnenshow</a> für das perfekte Gesamtpaket. Weitere Eindrücke finden Sie in meiner <a href="/galerie/">Galerie</a>.</p>
      <a href="/kontakt/" class="btn btn--primary tz-cta__btn" data-magnetic>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>

  <!-- ── FAQ (visible twin of the FAQPage schema) ──────────── -->
  <section class="ce-faq ce-salon">
    <div class="container ce-narrow">
      <h2 class="ce-h2 ce-center">Häufig gestellte Fragen</h2>
      <div class="ce-faq__list">
        {faqSchema.mainEntity.map((q, i) => (
          <details class="ce-faq__item tz-faq" data-reveal data-reveal-delay={i * 0.05}>
            <summary>
              <span class="ce-faq__suit" aria-hidden="true">{['♠', '♥', '♣', '♦'][i % 4]}</span>
              <span>{q.name}</span>
              <span class="tz-faq__plus">+</span>
            </summary>
            <p>{q.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero: the panorama photo whole in its magic frame (ce-hero__frame, adult-kit.css) ── */

  /* ── intro ── */
  .tz-intro__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: var(--space-5); align-items: center; }
  .tz-intro__text { font-family: var(--font-display); font-size: clamp(1.2rem, 2.2vw, 1.55rem); line-height: 1.5; }
  .tz-ticks { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .tz-ticks li { padding: 0.55rem 0; border-top: 1px solid var(--hair); }
  .tz-tick { color: var(--accent-strong); font-weight: 700; margin-right: 0.5rem; }
  /* the facts as small cards laid out on the black card table (a gold hairline marks its edge) */
  .tz-table {
    padding: var(--space-4) var(--space-3) var(--space-3); background: #0d0b0a; border-radius: calc(var(--radius) * 1.6);
    box-shadow: inset 0 0 0 1px var(--gold), 0 30px 60px -30px rgb(0 0 0 / 0.9);
  }
  /* the table is a dark felt even in the ivory salon: its heading stays cream */
  .tz-table h3 { font-size: 1.5rem; margin: 0 0 var(--space-3); text-align: center; color: #f3ede1; }
  .tz-facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .tz-facts__card {
    padding: 0.9rem 1rem;
  }
  :global(.v2) main .tz-facts__card { border-radius: var(--radius-sm); }
  .tz-facts__card:nth-child(odd) { rotate: -1deg; }
  .tz-facts__card:nth-child(even) { rotate: 1.2deg; }
  .tz-facts dt { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: var(--accent-strong); }
  .tz-facts dd { margin: 0.25rem 0 0; font-family: var(--font-display); font-size: 1.05rem; line-height: 1.3; }

  /* ── what (flip) ── */
  .tz-what__grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); margin-top: var(--space-4); }
  .tz-what__card {
    position: relative; padding: var(--space-4) var(--space-3) var(--space-3);
  }
  .tz-what__card .card-back {
    border-radius: var(--radius);
    background:
