---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import K3Hero from '../../../components/v2/kids/K3Hero.astro';
import ProgramFrame from '../../../components/v2/kids/ProgramFrame.astro';
import GoldDivider from '../../../components/v2/kids/GoldDivider.astro';
import Curtain from '../../../components/v2/kids/Curtain.astro';
import HatTrick from '../../../components/v2/kids/HatTrick.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import '../../../styles/kids-v3.css';
import { Image } from 'astro:assets';
import heroImg from '../../../assets/images/zauberer/zaubershow-hero.jpg';
import staunendeKinderImg from '../../../assets/images/zauberer/zaubershow-staunende-kinder.jpg';
import karteImg from '../../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';

const seoTitle = 'Zaubershow NRW für Kinder & Familien | LIAR';
const seoDescription = 'Die lustigste Zaubershow für Kinder in NRW ✓ Clown Zauberer LIAR ✓ Für Kindergeburtstag, Kita & Schule ✓ 370+ Top-Bewertungen ✓ Kinder lachen & staunen!';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Zaubershow für Kinder in NRW",
  "description": "Interaktive Zaubershow für Kinder in NRW – Kindergeburtstag, Kita, Schule und Stadtfest mit Clown Zauberer LIAR",
  "url": "https://liar-entertainer.com/zauberer/zaubershow/",
  "serviceType": ["Zaubershow", "Kinderunterhaltung"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Wie bekomme ich ein Angebot für eine Zaubershow?', acceptedAnswer: { '@type': 'Answer', text: 'Jede Zaubershow wird individuell auf Anlass, Dauer und Gruppengröße abgestimmt. Für ein unverbindliches Angebot einfach telefonisch (0172-1517578) oder per E-Mail (info@liar-entertainer.com) anfragen – meist Antwort innerhalb 24 Stunden.' } },
    { '@type': 'Question', name: 'Für welche Altersgruppe ist die Zaubershow geeignet?', acceptedAnswer: { '@type': 'Answer', text: 'Die Zaubershow ist ab 4 Jahren geeignet. Sie wird altersgerecht angepasst – für Kindergartenkinder einfacher, für Grundschulkinder anspruchsvoller.' } },
    { '@type': 'Question', name: 'Wie lange dauert die Zaubershow?', acceptedAnswer: { '@type': 'Answer', text: 'Die Zaubershow dauert ca. 40 Minuten. Mit Ballonmodellage und Glitzer Tattoos als Zusatzprogramm verlängert sich das Programm auf bis zu 90 Minuten.' } },
    { '@type': 'Question', name: 'Wie weit fährt Clown Zauberer LIAR für Auftritte?', acceptedAnswer: { '@type': 'Answer', text: 'LIAR ist in ganz NRW buchbar – Ruhrgebiet, Rheinland, Münsterland und darüber hinaus. Auf Anfrage auch deutschlandweit sowie in Belgien, Niederlande, Frankreich, Österreich und der Schweiz.' } },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow für Kinder in NRW – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];

const pillars = [
  {
    num: '1️⃣',
    title: 'Kinder im Mittelpunkt – Nicht die Tricks',
    text: 'Bei mir sind die Kinder die Stars, nicht die Zaubertricks! Jedes Kind wird gesehen, wertgeschätzt und aktiv eingebunden. Schüchterne Kinder werden behutsam ermutigt, wilde Energiebündel bekommen eine sinnvolle Aufgabe. So fühlt sich jedes Kind als wichtiger Teil der Show – und das ist echte Magie! ✨',
  },
  {
    num: '2️⃣',
    title: 'Clownerie trifft Zauberei',
    text: 'Diese Kombination ist mein Geheimrezept! Als Clown finde ich den direkten Draht zu den Kindern, schaffe Vertrauen und bringe sie zum Lachen. Als Zauberer überrasche und verblüffe ich sie. Das Resultat? Kinder pendeln die ganze Show über zwischen herzhaftem Gelächter und ehrfürchtigem Staunen.',
  },
  {
    num: '3️⃣',
    title: 'Interaktiv statt passiv',
    text: 'Vergessen Sie Shows, bei denen Kinder nur zuschauen! Bei mir gibt es keine passiven Zuschauer. Die Kinder werden zu Zauberassistenten, halten magische Gegenstände, sprechen Zaubersprüche und erleben, wie durch IHRE Hilfe Unmögliches möglich wird.',
  },
  {
    num: '4️⃣',
    title: 'Zauberhafte Geschichten',
    text: 'Meine Tricks sind in fantasievolle Geschichten eingebettet. Ein gewöhnlicher Bleistift wird zum Zauberstab, ein Seil zur magischen Schlange, ein Tuch zum fliegenden Teppich. Kinder lieben Geschichten – und so wird jeder Zaubertrick zu einem Mini-Abenteuer! 📖✨',
  },
  {
    num: '5️⃣',
    title: 'Altersgerecht & flexibel',
    text: 'Keine Show gleicht der anderen! Ich passe mich perfekt an die Altersgruppe ab 4 Jahre an: Für Kindergartenkinder einfachere Tricks mit viel Bewegung, für Grundschulkinder anspruchsvollere Zauberei mit mehr Humor. Jede Show wird individuell auf Ihre Gruppe zugeschnitten! 🎯',
  },
];

const whyUs = [
  'über 17 Jahre Erfahrung – Hunderte erfolgreiche Shows',
  'TOP-Bewertungen – Zufriedene Kunden im ganzen Ruhrgebiet',
  'Einzigartige Kombi – Clown + Zauberer = Lachen + Staunen',
  'Kinder im Fokus – Nicht die Tricks, sondern die Kinder sind die Stars',
  'Flexibel & unkompliziert – Passt sich jeder Situation an',
  'Professionell & sympathisch – Ruhrgebiets-Authentizität ohne Getue',
  'Faire Preise – Transparent kalkuliert, ohne versteckte Kosten',
];
---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Zaubershow Kinder NRW, Zaubershow buchen, Kindershow Zauberer, Zaubershow Kindergeburtstag, interaktive Zaubershow"
  canonical="https://liar-entertainer.com/zauberer/zaubershow/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Zauberer', url: '/zauberer/' }, { name: 'Zaubershow', url: '/zauberer/zaubershow/' }]}
>
  <!-- ── Hero: the big top, kids v3. No reveal here (LCP). ── -->
  <K3Hero>
    <p class="k3-crumbs">
      <a href="/">Clown</a> »
      <a href="/">Clown Zauberer LIAR</a> »
      <a href="/zauberer/">Zauberer</a> »
      <span>Zaubershow</span>
    </p>
    <ReviewBadge />
    <h1 class="k3-hero__title" data-letters><span class="k3-mark">Zaubershow</span> in NRW – für Kinder &amp; die ganze Familie</h1>
    <h2 class="zs-hero__sub">
      ✨ Die Zaubershow –<br />Wo Magie auf Lachen trifft! 🎭
    </h2>
    <p class="zs-hero__claim">Flexible. Professionell. Unvergesslich.</p>
    <p class="zs-hero__lead">
      Eine Zaubershow für Kinder bei Clown Zauberer LIAR dauert ca. 40 Minuten und ist für Kinder ab 4 Jahren geeignet – interaktiv, lustig und in ganz NRW (Ruhrgebiet, Rheinland, Münsterland) für Kindergeburtstag, Kita, Schule und Stadtfest. 370+ Top-Bewertungen.
    </p>
    <div class="k3-hero__actions">
      <a class="btn btn--primary" href="/kontakt/" data-confetti>Unverbindlich anfragen</a>
    </div>
    <Fragment slot="photo">
      <Image
        src={heroImg}
        alt="Zaubershow NRW – Interaktiv & Lustig für Kinder"
        widths={[400, 700, 1000]}
        quality={70}
        sizes="(max-width: 900px) 80vw, 500px"
        loading="eager"
        fetchpriority="high"
      />
    </Fragment>
  </K3Hero>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section>
    <div class="container k3-narrow k3-center">
      <p class="k3-lead">Die Zaubershow von Clown Zauberer LIAR ist eine interaktive Mitmach-Show für Kinder ab 4 Jahren – für Kindergeburtstag, Kita, Schule und Familienfest in ganz NRW. Für den Kindergeburtstag: ca. 40 Minuten Zauberei und Clownerie zum Festpreis. Seit 2009 hauptberuflich, über 400 Shows pro Jahr.</p>
      <p class="zs-intro" data-reveal>
        Stellen Sie sich vor: Kinderaugen leuchten, kleine Münder stehen vor Staunen offen, plötzlich bricht schallendes Gelächter aus – und im nächsten Moment herrscht wieder ehrfürchtige Stille. Das ist meine Zaubershow! Eine perfekte Symbiose aus verblüffender Zauberei und herzerfrischender Clownerie, die Kinder (und Erwachsene!) gleichermaßen begeistert. Besonders beliebt ist die Show auf dem <a href="/kindergeburtstag/">Kindergeburtstag</a> – als erfahrener <a href="/kinderzauberer/">Kinderzauberer</a> weiß ich genau, wie man kleine Zuschauer begeistert. 🌟
      </p>
      <p class="zs-intro__motto" data-reveal data-reveal-delay="0.08">
        <strong>Flexible. Professionell. Unvergesslich.</strong>
      </p>
    </div>
  </section>

  <!-- ── Anlässe ───────────────────────────────────────────── -->
  <section class="k3-alt" data-related-services>
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">
        Für welche Anlässe kann man Zauberer LIAR sonst buchen?
      </h2>
      <div class="zs-occasions">
        <a href="/zauberer/hochzeit/" class="k3-card zs-occasion" data-reveal>
          <p class="zs-occasion__title">Zauberer für die Hochzeit</p>
          <p class="zs-occasion__text">Close-up-Zauberei am Tisch, beim Sektempfang und während der Fotosession.</p>
        </a>
        <a href="/zauberer/firmenfeier/" class="k3-card zs-occasion" data-reveal data-reveal-delay="0.08">
          <p class="zs-occasion__title">Zauberer für die Firmenfeier</p>
          <p class="zs-occasion__text">Walk-Act zwischen den Tischen oder Bühnenshow für Betriebsfeier und Jubiläum.</p>
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Einzigartig ───────────────────────────────────────── -->
  <section>
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">🎪 Was macht meine Zaubershow einzigartig?</h2>
      <div class="zs-unique__grid">
        <ProgramFrame class="zs-unique__photo" data-reveal>
          <Image
            src={staunendeKinderImg}
            alt="Staunende Kinder bei einer Zaubershow in NRW"
            widths={[400, 700]}
            quality={60}
            sizes="(max-width: 900px) 80vw, 360px"
            loading="lazy"
          />
        </ProgramFrame>
        <div>
          <p class="zs-soft" data-reveal>
            In über 17 Jahren als Clown Zauberer und Kinderzauberer im Ruhrgebiet und ganz NRW habe ich eine Zaubershow entwickelt, die anders ist als klassische Zaubervorführungen. Hier geht es nicht um einen Zauberer auf der Bühne, der Tricks vorführt, während Kinder brav zuschauen. Nein – hier werden die Kinder selbst zu Zauberern! 🎩 Ob <a href="/kindergeburtstag/">Kindergeburtstag</a>, Kita-Fest oder Schulveranstaltung – die Zaubershow passt sich jedem Anlass an. Entdecken Sie auch meine speziellen Angebote für <a href="/zauberer/zaubershow/kindergarten-kita/">Kindergärten und Kitas</a>, <a href="/zauberer/zaubershow/schule/">Schulveranstaltungen</a> und <a href="/zauberer/zaubershow/strassen-sommer-fest/">Straßen- und Sommerfeste</a>.
          </p>
          <h3 class="k3-h3">Perfekt für:</h3>
          <div class="zs-checks">
            {[
              'Stadtfeste & Straßenfeste',
              'Firmenjubiläen & Betriebsfeiern',
              'Weihnachtsfeiern & Sommerfeste',
              'Schulveranstaltungen & Kitafeiern',
              'Vereinsfeiern & Jubiläen',
              'Karneval und Weihnachtsmarkt',
              'Kindergeburtstage',
              'Kindergartengruppen',
              'Familienfeiern mit Kindern',
              'Kommunion & Konfirmation',
              'Taufen mit Kinderunterhaltung',
              'Hochzeiten',
            ].map((event) => (
              <div class="zs-checks__item">
                <span class="zs-check">✓</span>
                <span>{event}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 5 Säulen: the ring, red velvet, with the hat trick ── -->
  <section class="k3-band k3-band--velvet">
    <div class="container">
      <HatTrick />
      <GoldDivider />
      <h2 class="k3-h2 k3-center">⭐ Die 5 Säulen meiner Zaubershow:</h2>
      <div class="zs-pillars__grid">
        {pillars.map((pillar, i) => (
          <article class:list={['k3-card', 'zs-pillar', { 'k3-card--star': i === 0 }]} data-reveal data-reveal-delay={(i % 3) * 0.08}>
            <span class="zs-pillar__num">{pillar.num}</span>
            <h3>{pillar.title}</h3>
            <p class="zs-soft">{pillar.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Warum ─────────────────────────────────────────────── -->
  <section>
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">🎪 Warum LIAR als Ihr Zauber-Entertainer?</h2>
      <div class="zs-why__grid">
        {whyUs.map((reason, i) => (
          <div class="zs-why__item" data-reveal data-reveal-delay={(i % 2) * 0.07}>
            <span class="zs-why__mark">✅</span>
            <p>{reason}</p>
          </div>
        ))}
      </div>
      <p class="zs-why__close" data-reveal>
        ✨ Eine Zaubershow ist mehr als Unterhaltung – es ist ein Erlebnis, das Kinder noch lange begleitet. Die Erinnerung an strahlende Augen, herzliches Lachen und ehrfürchtiges Staunen bleibt. Lassen Sie uns gemeinsam solche Momente schaffen! Sehen Sie sich auch mein spezielles Angebot für <a href="/zauberer/zaubershow/kindergarten-kita/">Kindergärten und Kitas</a>, für <a href="/zauberer/zaubershow/schule/">Schulveranstaltungen</a> oder für <a href="/zauberer/zaubershow/strassen-sommer-fest/">Straßen- und Sommerfeste</a> an.
      </p>
    </div>
  </section>

  <!-- ── Bewertungen (inline, legacy wording), programme cards ── -->
  <section class="k3-alt">
    <div class="container">
      <GoldDivider />
      <div class="k3-center">
        <p class="k3-kicker">AUSGEZEICHNET</p>
        <p class="zs-stars" aria-hidden="true">★★★★★</p>
        <p class="zs-guest__count">Basierend auf 370+ Bewertungen</p>
      </div>
      <div class="zs-guest__grid">
        {[
          { initials: 'FB', color: '#e91e63', name: 'Fabienne Bockting', date: 'vor 2 Monaten', text: 'Wir durften am Freitag den Zauberer Michael für den 5. Geburtstag unserer Tochter buchen. Die Show war ein tolles Erlebnis für die Kinder und für uns Erwachsenen.' },
          { initials: 'CE', color: '#9c27b0', name: 'Charifa El Makhoukhi', date: 'vor 2 Monaten', text: 'Clown Liar war beim 5. Geburtstag meiner Nichte mit einer Zaubershow dabei und hat sowohl die kleinen als auch die großen verzaubert. Toller Clown... empfehlenswert!' },
          { initials: 'TA', color: '#2196f3', name: 'Thorsten Andres', date: 'vor 2 Monaten', text: 'Was ein geiler Typ! Mit viel Witz, Charme und Humor im Herzen ❤️' },
          { initials: 'NK', color: '#ff9800', name: 'Nina Keller', date: 'vor 2 Monaten', text: 'Mit unglaublich viel Charme und Humor begeistert Michael die kleinen UND die großen Zuschauer. Ganz große Klasse 🤩' },
        ].map((review, i) => (
          <figure class="k3-card zs-guest__card" data-reveal data-reveal-delay={i * 0.08}>
            <div class="zs-guest__who">
              <div class="zs-guest__avatar" style={`background-color: ${review.color};`}>
                {review.initials}
              </div>
              <div>
                <p class="zs-guest__name">{review.name}</p>
                <p class="zs-guest__date">{review.date}</p>
              </div>
            </div>
            <p class="zs-stars zs-stars--small" aria-hidden="true">★★★★★</p>
            <p class="zs-soft zs-guest__text">{review.text}</p>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Video: Hollywood premiere, curtain in front ───────── -->
  <section class="k3-band k3-band--night k3-premiere">
    <span class="k3-uplight k3-uplight--l" aria-hidden="true"></span>
    <span class="k3-uplight k3-uplight--r" aria-hidden="true"></span>
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <h2 class="k3-h2">🎬 Die Zaubershow in Aktion</h2>
      <div class="k3-video" data-reveal>
        <Curtain trigger="stage" rest="clamp(2.2rem, 10vw, 4.6rem)" span="min(42rem, 100vw - 2rem)" tieback valance />
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" label="Zaubershow ansehen" />
      </div>
    </div>
  </section>

  <!-- ── Einsatzgebiet (map without frame) ─────────────────── -->
  <section class="k3-area">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">Zaubershow in ganz NRW – Ihre Regionen</h2>
      <p class="k3-center zs-soft">Als professioneller Zauberer bin ich in ganz Nordrhein-Westfalen und darüber hinaus für Ihre Veranstaltung buchbar.</p>
      <div class="k3-area__grid">
        <div class="zs-regions">
          <h3 class="k3-h3">Ruhrgebiet</h3>
          <p class="k3-cities">Oberhausen, Essen, Duisburg, Mülheim, Gelsenkirchen, Bochum, Dortmund, Bottrop, Gladbeck, Herten, Herne, Marl, Recklinghausen, Castrop-Rauxel, Waltrop</p>
          <h3 class="k3-h3">Rheinland</h3>
          <p class="k3-cities">Düsseldorf, Krefeld, Moers, Neuss, Köln, Leverkusen, Mönchengladbach</p>
          <h3 class="k3-h3">Münsterland</h3>
          <p class="k3-cities">Münster, Haltern am See, Dorsten, Coesfeld, Dülmen</p>
          <h3 class="k3-h3">Weitere Städte</h3>
          <p class="k3-cities">Ahaus, Reken, Lünen, Hagen, Witten und viele mehr</p>
          <p class="zs-soft">🌍 Auf Anfrage auch deutschlandweit sowie in Belgien, Niederlande, Frankreich, Österreich und der Schweiz buchbar!</p>
        </div>
        <figure class="k3-area__map">
          <Image
            src={karteImg}
            alt="Einsatzgebiet Zaubershow in NRW – Karte mit Standort Gladbeck"
            loading="lazy"
            widths={[400, 800]}
            sizes="(max-width: 900px) 86vw, 460px"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Buchen: dark stage, red + blue light, three programme cards ── -->
  <section class="k3-band k3-band--spot">
    <span class="k3-spot k3-spot--red" aria-hidden="true"></span>
    <span class="k3-spot k3-spot--blue" aria-hidden="true"></span>
    <div class="container k3-center">
      <GoldDivider />
      <h2 class="k3-h2">📞 Jetzt Zaubershow buchen!</h2>
      <p class="k3-sub">✨ Bereit für magische Momente?</p>
      <p class="k3-narrow">
        Ob <a href="/kindergeburtstag/">Kindergeburtstag</a>, Schulfest, Firmenevent oder private Feier – lassen Sie uns gemeinsam Ihr Event unvergesslich machen!
      </p>
      <div class="zs-book__contact">
        <p>📱 Telefon &amp; WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
        <p>📍 Standort: Beethovenstr. 15, 45966 Gladbeck</p>
        <p>⚡ Reaktionszeit: Meist innerhalb 24 Stunden</p>
      </div>
      <h3 class="k3-h3">✅ So einfach geht's:</h3>
      <div class="zs-book__steps">
        <div class="k3-card zs-step" data-reveal>
          <p class="zs-step__title">1️⃣ Anfrage stellen</p>
          <p class="zs-soft">Anrufen oder E-Mail schreiben</p>
        </div>
        <div class="k3-card zs-step" data-reveal data-reveal-delay="0.08">
          <p class="zs-step__title">2️⃣ Termin & Details</p>
          <p class="zs-soft">Unverbindliches Angebot erhalten</p>
        </div>
        <div class="k3-card zs-step" data-reveal data-reveal-delay="0.16">
          <p class="zs-step__title">3️⃣ Buchen & freuen!</p>
          <p class="zs-soft">💡 Je früher Sie anfragen, desto größer die Chance auf Ihren Wunschtermin!</p>
        </div>
      </div>
      <a href="/kontakt/" class="btn btn--primary zs-book__btn" data-confetti>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>

  <!-- ── Content depth: reading columns with a drop cap ───── -->
  <section>
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2">Wie läuft die Zaubershow ab?</h2>
      <p class="zs-depth__text" data-reveal>
        Der Start ist unkompliziert: Ich komme rechtzeitig vor Showbeginn an und brauche nur etwa 10 Minuten für den Aufbau – eine freie Fläche von 2×2 Metern genügt völlig. Sie müssen nichts vorbereiten, kein Podest aufstellen und keine Technik organisieren. Dann geht es los: Die Show beginnt mit einer Geschichte, die die Kinder sofort abholt, und entwickelt sich Schritt für Schritt zu einem Mitmach-Erlebnis. Die Kinder werden zu Zauberassistenten, halten magische Gegenstände, sprechen Zaubersprüche – und beim Kindergeburtstag steht selbstverständlich das Geburtstagskind im Mittelpunkt und erlebt seinen eigenen großen Zaubermoment vor allen Gästen. Zum Finale steigert sich die Dramaturgie noch einmal: Der verblüffendste Trick kommt zum Schluss, damit die Kinder mit großen Augen und einem Lachen im Gesicht aus der Show gehen. Nach rund 40 Minuten ist die Zaubershow vorbei – auf Wunsch geht es mit Ballonmodellage oder Glitzer-Tattoos weiter.
      </p>
      <ul class="zs-depth__list">
        <li data-reveal><span class="zs-check">✓</span> Nur ca. 10 Minuten Aufbauzeit – keine Vorbereitung durch Sie nötig</li>
        <li data-reveal data-reveal-delay="0.05"><span class="zs-check">✓</span> Stellfläche: 2×2 Meter reichen aus</li>
        <li data-reveal data-reveal-delay="0.1"><span class="zs-check">✓</span> Showdauer: ca. 40 Minuten, mit Zusatzprogramm bis zu 90 Minuten</li>
        <li data-reveal data-reveal-delay="0.15"><span class="zs-check">✓</span> Das Geburtstagskind steht immer im Mittelpunkt</li>
      </ul>
    </div>
  </section>

  <section class="k3-alt">
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2">Für welches Alter ist die Zaubershow geeignet?</h2>
      <p class="zs-depth__text" data-reveal>
        Die Zaubershow ist ab 4 Jahren geeignet und wird konsequent an die Altersgruppe angepasst – denn ein Kita-Kind staunt anders als ein Viertklässler. Für die Jüngeren (4 bis 6 Jahre) setze ich auf einfache, klar erkennbare Zaubermomente mit viel Bewegung, Wiederholung und Clownerie: kurze Spannungsbögen, große Gesten, viel zum Mitrufen und Mitlachen. Kinder im Grundschulalter (7 bis 12 Jahre) wollen dagegen gefordert werden – sie bekommen anspruchsvollere Tricks, mehr Wortwitz und Momente, in denen sie miträtseln dürfen, wie das eben Gesehene möglich war. Und die Erwachsenen? Die sitzen erfahrungsgemäß nicht gelangweilt daneben, sondern schmunzeln auf ihrer eigenen Ebene mit: Der Humor funktioniert doppelbödig, sodass Eltern, Großeltern und Erzieher genauso auf ihre Kosten kommen wie die Kinder. Bei gemischten Gruppen – etwa auf Familienfeiern – balanciere ich das Programm so aus, dass vom Kindergartenkind bis zur Oma alle gemeinsam lachen.
      </p>
    </div>
  </section>

  <section>
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2">Drinnen oder draußen – wo funktioniert die Zaubershow?</h2>
      <p class="zs-depth__text" data-reveal>
        Beides! Da ich nur eine Fläche von etwa 2×2 Metern benötige, funktioniert die Zaubershow praktisch überall: im Wohnzimmer, im Partykeller, im Gruppenraum der Kita, in der Turnhalle, im Gemeindesaal – oder unter freiem Himmel auf der Terrasse, im Garten und beim Sommerfest. Drinnen entsteht schnell eine gemütliche, konzentrierte Atmosphäre, in der schon ein Wohnzimmer zur Zauberbühne wird. Draußen lebt die Show von der lockeren Feststimmung – wichtig ist nur ein halbwegs ebener Platz und idealerweise etwas Schatten, damit die Kinder nicht in der prallen Sonne sitzen. Und wenn das Wetter beim Gartenfest nicht mitspielt? Kein Problem: Weil der Aufbau so kompakt ist, ziehen wir kurzfristig einfach nach drinnen um – ein Plan B ist mit dieser Show immer eingebaut. Besprechen Sie Ihre Räumlichkeiten gerne kurz mit mir bei der Anfrage, dann finden wir gemeinsam den besten Platz für die Vorstellung.
      </p>
    </div>
  </section>

  <!-- ── FAQ (visible twin of the FAQPage schema; the legacy "+" stays as text) ── -->
