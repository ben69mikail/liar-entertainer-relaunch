---
import V2Layout from '../../../../layouts/V2Layout.astro';
import Reviews from '../../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../../components/v2/ReviewBadge.astro';
import Curtain from '../../../../components/v2/kids/Curtain.astro';
import K3Hero from '../../../../components/v2/kids/K3Hero.astro';
import ProgramFrame from '../../../../components/v2/kids/ProgramFrame.astro';
import GoldDivider from '../../../../components/v2/kids/GoldDivider.astro';
import YouTubeFacade from '../../../../components/YouTubeFacade.astro';
import { CONTACT } from '../../../../data/site';
import '../../../../styles/kids-v3.css';
import { Image } from 'astro:assets';
import heroImg from '../../../../assets/images/zauberer/schule-hero.jpg';
import galerieImg12 from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-12.jpg';
import schuleDortmundImg from '../../../../assets/images/zauberer/zaubershow-schule-dortmund.jpg';
import karteImg from '../../../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';

const seoTitle = 'Zaubershow für Schule NRW | LIAR';
const seoDescription = 'Zaubershow für Ihre Schule in NRW ✓ Clown Zauberer LIAR bringt Kinder zum Lachen & Staunen ✓ 370+ Top-Bewertungen ✓ Für Schulfest & Projekttage ✓ Jetzt anfragen!';

const faqItems = [
  { q: 'Für welche Klassenstufen ist die Zaubershow geeignet?', a: 'Die Show ist auf Grundschulkinder der Klassen 1 bis 4 abgestimmt und wird altersgerecht angepasst – von der Einschulungsfeier bis zur Karnevalsfeier für die älteren Schüler.' },
  { q: 'Wie viel Platz wird für die Zaubershow in der Schule benötigt?', a: 'Es genügt eine Fläche von etwa 2×2 Metern; für größere Veranstaltungen sind 4×4 Meter ideal. Die Show funktioniert im Klassenraum, in der Aula oder in der Turnhalle – bei Regen problemlos drinnen.' },
  { q: 'Wie lange dauert eine Zaubershow für die Schule?', a: 'Die Hauptshow dauert in der Regel rund 40 Minuten. Für Einschulungsfeiern ist auch eine kürzere Variante von etwa 35 Minuten möglich.' },
  { q: 'Für welche Schul-Anlässe eignet sich die Zaubershow?', a: 'Als zentrales Bühnenprogramm für Schulfeste, Sommerfeste, Einschulungen, Projekttage und Karnevalsfeiern – jeweils passend für die Klassen 1 bis 4.' },
  { q: 'Seit wann tritt Clown Zauberer LIAR an Schulen auf?', a: 'LIAR steht seit 2009 als professioneller Clown Zauberer auf der Bühne und bringt seither Magie und Staunen in Grundschulen im Ruhrgebiet und in ganz NRW.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};

const anlaesse = [
  {
    icon: '🎪',
    title: 'Schulfest & Sommerfest',
    text: 'DER Klassiker! Die Zaubershow ist das Highlight des Schulfestes und begeistert Schüler, Eltern, Geschwister und Lehrer gleichermaßen. Perfekt als zentrales Bühnenprogramm.',
    checks: ['Begeistert alle Altersgruppen (Klasse 1–4)', 'Eltern erleben ihre Kinder in Aktion', 'Wetterfest (bei Regen einfach in der Turnhalle)', 'Keine aufwendige Technik nötig', 'Schafft gemeinsame Erinnerungen'],
    dauer: 'Optimal: 40 Minuten Hauptshow',
  },
  {
    icon: '🎓',
    title: 'Einschulung & Einschulungsfeier',
    text: 'Ein magischer Start ins Schulleben! Die Einschulungsfeier wird mit einer Zaubershow zu einem unvergesslichen ersten Schultag. Die frischgebackenen Erstklässler erleben: „Schule ist toll!\"',
    checks: ['Speziell auf ABC-Schützen abgestimmt', 'Etwas einfacher als für ältere Kinder', 'Eltern, Großeltern und Verwandte sind dabei', 'Feierlicher Rahmen mit viel Humor'],
    dauer: 'Dauer: 35 Minuten (nicht zu lang für die Aufregung)',
  },
  {
    icon: '🎭',
    title: 'Karneval',
    text: 'Eine würdevolle und zugleich fröhliche Feier! Die Schüler bekommen eine besondere Zaubershow für eine besondere Feierlichkeit: KARNEVAL. Diese Show ist etwas anspruchsvoller und würdigt auch die „Großen\".',
    checks: ['Komplexere Tricks für die älteren Schüler', 'Mehr Humor und Wortspiele', 'Emotionale Feier mit schöner Erinnerung'],
    dauer: 'Dauer: 40 Minuten',
  },
];

const praktisch = [
  {
    icon: '📐',
    title: 'Platzbedarf & Räume',
    content: [
      { label: 'Minimaler Platzbedarf', value: '2×2 Meter' },
      { label: 'Ideal für große Veranstaltungen', value: '4×4 Meter' },
    ],
    raeume: ['Turnhalle / Sporthalle (optimal für große Gruppen!)', 'Aula (falls vorhanden)', 'Mehrzweckraum', 'Musikraum (bei kleineren Gruppen)', 'Großes Klassenzimmer (bei einzelnen Klassen)', 'Außenbereich (überdacht, bei gutem Wetter)'],
  },
  {
    icon: '👥',
    title: 'Gruppengrößen',
    gruppen: [
      { label: 'Einzelne Klasse: 20–30 Schüler', desc: 'Sehr intime Show, Dauer: 30–40 Min.' },
      { label: 'Zwei Klassen: 40–60 Schüler', desc: 'Noch viel Interaktion möglich, Dauer: 40 Min.' },
      { label: 'Halbe Schule / Stufe: 60–100 Schüler', desc: 'Ideal für Klasse 1–3 und 2–4 getrennt, Dauer: 40–45 Min.' },
      { label: 'Ganze Schule: 100–200+ Schüler', desc: 'Bei Schulfesten oft alle zusammen, Dauer: 45 Min.' },
    ],
  },
  {
    icon: '⏱️',
    title: 'Showdauer',
    zeiten: [
      { label: 'Standard-Show: ca. 40 Min.', desc: 'Ideal für gemischte Klassen und Stufen – von Erstklässlern bis Viertklässlern' },
    ],
    note: 'Die Dauer wird individuell mit Ihnen abgestimmt!',
  },
];

---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  structuredData={[faqSchema]}
  keywords="Zaubershow Schule, Zauberer Grundschule, Schulshow NRW, Zaubershow Schulfest, Zauberer Einschulung"
  canonical="https://liar-entertainer.com/zauberer/zaubershow/schule/"
>
  <!-- Hero: the big-top stage. No reveal here (LCP). -->
  <K3Hero>
        <p class="k3-crumbs">
          <a href="/">Clown</a> »
          <a href="/zauberer/">Zauberer</a> »
          <a href="/zauberer/zaubershow/">Zaubershow</a> »
          <span>Schule</span>
        </p>
        <ReviewBadge />
        <h1 class="k3-hero__title ks-title" data-letters>Schule</h1>
        <h2 class="k3-hero__sub">
          🎪 Die magische Zaubershow<br />für Ihre Schulveranstaltung
        </h2>
        <p class="k3-hero__claim">Magie &amp; Lernspaß für Schulkinder der Klassen 1–4</p>
        <div class="k3-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
    <Fragment slot="photo">
      <Image
        src={heroImg}
        alt="Zaubershow für Schulen in NRW"
        widths={[400, 700, 1000]}
        quality={70}
        sizes="(max-width: 900px) 80vw, 500px"
        loading="eager"
        fetchpriority="high"
      />
      <a class="k3-medal" href="#anlaesse">
        <span>Klasse</span><strong>1–4</strong>
      </a>
    </Fragment>
  </K3Hero>

  <!-- Intro -->
  <section class="k3-intro">
    <div class="container k3-split">
      <div data-reveal>
        <p class="k3-lead">
          Als erfahrener und professioneller Clown Zauberer für Schulen bringe ich seit 2009 Magie, Staunen und Begeisterung in Grundschulen im Ruhrgebiet. Meine Zaubershow ist speziell auf Schulkinder der Klassen 1 bis 4 abgestimmt – altersgerecht, interaktiv und mit pädagogischem Mehrwert. ✨
        </p>
        <p>
          Ob für Ihr Schulfest, die Einschulungsfeier, Projekttage, Abschlussfeiern der Viertklässler oder als besonderes Highlight im Schuljahr: Meine Zaubershow verwandelt jeden Schultag in ein unvergessliches Erlebnis. Die Schüler werden aktiv eingebunden, erleben Magie hautnah und sind die Stars der Show – nicht die Zaubertricks!
        </p>
        <p>
          Das Besondere? Meine Show fördert Konzentration, logisches Denken, Selbstvertrauen und soziales Lernen. Für Lehrkräfte und Schulleitung: Minimaler organisatorischer Aufwand bei maximalem pädagogischem und Unterhaltungswert. Für jüngere Kinder empfehle ich mein spezielles Programm für <a href="/zauberer/zaubershow/kindergarten-kita/">Kindergärten und Kitas</a>. Ich trete auch regelmäßig auf <a href="/zauberer/zaubershow/strassen-sommer-fest/">Straßen- und Sommerfesten</a> auf.
        </p>
      </div>
      <aside class="k3-expect" data-reveal data-reveal-delay="0.1">
        <h3 class="k3-expect__title">⭐ Was meine Show für Schulen so besonders macht:</h3>
        <ul class="k3-expect__list ks-list">
          <li><span>🎯</span> <span><strong>Altersgerecht für Klassen 1–4:</strong> Einfache Tricks, kurze Geschichten, viel Bewegung</span></li>
          <li><span>👥</span> <span><strong>Große Gruppen kein Problem:</strong> Erfahrung mit 20 bis 200+ Schülern</span></li>
          <li><span>📚</span> <span><strong>Pädagogischer Mehrwert:</strong> Fördert Konzentration, logisches Denken & Selbstbewusstsein</span></li>
          <li><span>🤝</span> <span><strong>Inklusion:</strong> Alle Schüler werden eingebunden – schüchterne wie wilde</span></li>
          <li><span>⚡</span> <span><strong>Unkompliziert:</strong> Nur 2×2 Meter Platz, kein Strom nötig, ich bringe alles mit</span></li>
          <li><span>🔄</span> <span><strong>Mehrere Shows möglich:</strong> 2–3 Shows hintereinander an einem Vormittag buchbar</span></li>
        </ul>
      </aside>
    </div>
  </section>

  <Reviews />

  <!-- Altersgruppen: dark stage, a red and a blue spotlight on the two cards around the photo -->
  <section class="k3-band k3-band--spot ks-ages">
    <span class="k3-spot k3-spot--red" aria-hidden="true"></span>
    <span class="k3-spot k3-spot--blue" aria-hidden="true"></span>
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>🌟 Für jede Altersgruppe die richtige Zauberkunst</h2>
      <p class="k3-center k3-sub">Von der Grundschule bis zur weiterführenden Schule</p>
      <div class="ks-ages__grid">
        <article class="k3-card ks-age ks-age--red" data-reveal>
          <h3>🎨 Grundschüler</h3>
          <p class="ks-text">
            Für jüngere Schüler arbeite ich mit bunten, visuellen Tricks und viel Bewegung: Ringe verschwinden spurlos, Seile zerschneiden sich von selbst wieder zusammen, und plötzlich erscheinen Süßigkeiten aus dem Nichts! Die Show ist lebhaft, interaktiv und perfekt auf die kurze Aufmerksamkeitsspanne abgestimmt.
          </p>
        </article>
        <ProgramFrame class="ks-pin" data-reveal data-reveal-delay="0.1">
          <Image
            src={galerieImg12}
            alt="Zaubershow in einer Schule mit Clown Zauberer LIAR"
            widths={[260, 520]}
            quality={60}
            sizes="(max-width: 900px) 72vw, 240px"
            loading="lazy"
            fetchpriority="low"
          />
        </ProgramFrame>
        <article class="k3-card ks-age ks-age--blue" data-reveal data-reveal-delay="0.15">
          <h3>🧠 Ältere Schüler</h3>
          <p class="ks-text">
            Bei älteren Schülern setze ich auf verblüffende Mentalmagie, Kartentricks und interaktive Illusionen, die auch kritische junge Köpfe ins Grübeln bringen. Der Clown schafft dabei die lockere Atmosphäre, während der <a href="/kinderzauberer/">Kinderzauberer</a> mit seinen Tricks für Gänsehaut-Momente sorgt.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Anlässe: programme cards -->
  <section class="ks-occasions" id="anlaesse">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>🎓 Perfekt für jeden Anlass an Ihrer Schule</h2>
      <div class="k3-cards ks-occasions__grid">
        {anlaesse.map((a, i) => (
          <article class="k3-card" data-reveal data-reveal-delay={String(i * 0.08)}>
            <p class="ks-icon">{a.icon}</p>
            <h3>{a.title}</h3>
            <p class="ks-text">{a.text}</p>
            <ul>
              {a.checks.map((c) => (
                <li><span>✓</span> {c}</li>
              ))}
            </ul>
            <p class="ks-dauer">{a.dauer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Zahlen: the ring, red velvet -->
  <section class="k3-band k3-band--velvet">
    <div class="container">
      <GoldDivider />
      <div class="k3-stats">
        <div class="k3-stat" data-reveal>
          <div class="k3-stat__icon">🪄</div>
          <div class="k3-stat__num" data-count>400</div>
          <div class="k3-stat__label">Shows im Jahr</div>
        </div>
        <div class="k3-stat" data-reveal data-reveal-delay="0.08">
          <div class="k3-stat__icon">😊</div>
          <div class="k3-stat__num">110.000</div>
          <div class="k3-stat__label">Lachende Kinder</div>
        </div>
        <div class="k3-stat" data-reveal data-reveal-delay="0.16">
          <div class="k3-stat__icon">🪄</div>
          <div class="k3-stat__num" data-count>15</div>
          <div class="k3-stat__label">Jahre Erfahrung</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Praktische Details: one programme sheet, three columns divided by fine gold rules -->
  <section class="ks-board-wrap k3-alt">
    <div class="container">
      <div class="k3-panel ks-board">
        <div class="ks-board__head">
          <div>
            <h2 class="k3-h2" data-reveal>📋 Praktische Details für Schulen</h2>
            <p class="ks-board__sub">Organisatorisches für Ihre Schule – Alles auf einen Blick</p>
          </div>
          <ProgramFrame class="ks-pin ks-pin--board" data-reveal>
            <Image
              src={schuleDortmundImg}
              alt="Zaubershow Schule Dortmund"
              widths={[220, 440]}
              quality={60}
              sizes="(max-width: 900px) 60vw, 200px"
              loading="lazy"
              fetchpriority="low"
            />
          </ProgramFrame>
        </div>
        <div class="ks-board__grid">
          <div class="ks-col" data-reveal>
            <h3>📐 Platzbedarf & Räume</h3>
            <p>Minimaler Platzbedarf: <strong>2×2 Meter</strong></p>
            <p>Ideal für große Veranstaltungen: <strong>4×4 Meter</strong></p>
            <p class="ks-col__label">Geeignete Räume:</p>
            <ul>
              <li>✓ Turnhalle / Sporthalle (optimal!)</li>
              <li>✓ Aula (falls vorhanden)</li>
              <li>✓ Mehrzweckraum</li>
              <li>✓ Musikraum (kleinere Gruppen)</li>
              <li>✓ Großes Klassenzimmer</li>
              <li>✓ Außenbereich (überdacht)</li>
            </ul>
          </div>
          <div class="ks-col" data-reveal data-reveal-delay="0.1">
            <h3>👥 Gruppengrößen</h3>
            <ul class="ks-col__spaced">
              <li><strong>Einzelne Klasse: 20–30 Schüler</strong><br />Sehr intime Show, Dauer: 30–40 Min.</li>
              <li><strong>Zwei Klassen: 40–60 Schüler</strong><br />Noch viel Interaktion möglich, Dauer: 40 Min.</li>
              <li><strong>Halbe Schule: 60–100 Schüler</strong><br />Ideal für Klasse 1–3 und 2–4 getrennt, Dauer: 40–45 Min.</li>
              <li><strong>Ganze Schule: 100–200+ Schüler</strong><br />Dauer: 45 Min. – Mikrofon empfehlenswert</li>
            </ul>
            <p class="ks-col__note">💡 Mehrere Shows hintereinander möglich – z. B. erst Klasse 1–3, dann Klasse 2–4</p>
          </div>
          <div class="ks-col" data-reveal data-reveal-delay="0.2">
            <h3>⏱️ Showdauer & Technik</h3>
            <p><strong>Standard-Show: ca. 40 Minuten</strong></p>
            <p>
              Ideal für gemischte Klassen und Stufen – von Erstklässlern bis zu Viertklässlern. Die perfekte Länge, um alle Kinder zu begeistern, ohne die Aufmerksamkeitsspanne zu überschreiten.
            </p>
            <p class="ks-col__label">Technik – Minimal!</p>
            <ul>
              <li>✓ Kein Strom nötig</li>
              <li>✓ Kein Mikrofon (bis ~80 Schüler)</li>
              <li>✓ Keine Bühne, keine Musikanlage</li>
              <li>✓ Ich bringe alles mit!</li>
            </ul>
            <p class="ks-col__note">💡 Optional für 100+ Schüler: Ein Mikrofon ist hilfreich – falls vorhanden, nutze ich es gerne.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video: Hollywood premiere, two searchlights from the floor crossing behind the video -->
  <section class="k3-band k3-band--night k3-premiere">
    <span class="k3-uplight k3-uplight--l" aria-hidden="true"></span>
    <span class="k3-uplight k3-uplight--r" aria-hidden="true"></span>
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <h2 class="k3-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="k3-video" data-reveal>
        <Curtain trigger="stage" rest="clamp(2.2rem, 10vw, 4.6rem)" span="min(42rem, 100vw - 2rem)" tieback valance />
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
      </div>
      <h3 class="k3-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>

  <!-- Einsatzgebiet (the map has no frame) -->
  <section class="k3-area" id="einsatzgebiet">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">📍 Zaubershow für Schulen in ganz NRW</h2>
      <p class="k3-center k3-narrow">Regional verwurzelt, überregional buchbar – als erfahrener Schulzauberer bin ich für Ihre Schule da.</p>
      <div class="k3-area__grid">
        <div>
          <h3 class="k3-h3">Ruhrgebiet</h3>
          <p class="k3-cities">Oberhausen, Essen, Duisburg, Mülheim, Gelsenkirchen, Bochum, Dortmund, Bottrop, Gladbeck, Herten, Herne, Marl, Recklinghausen, Dinslaken</p>
          <h3 class="k3-h3">Rheinland</h3>
          <p class="k3-cities">Düsseldorf, Krefeld, Moers, Neuss, Köln, Leverkusen, Mönchengladbach</p>
          <h3 class="k3-h3">Münsterland</h3>
          <p class="k3-cities">Münster, Dorsten, Reken, Ahaus, Coesfeld, Haltern am See</p>
          <h3 class="k3-h3">Weitere Städte</h3>
          <p class="k3-cities">Dortmund, Lünen, Hagen, Bochum, Witten und viele mehr</p>
          <p>🌍 Auf Anfrage auch deutschlandweit sowie in Belgien, Niederlande, Frankreich, Österreich und der Schweiz buchbar!</p>
        </div>
        <figure class="k3-area__map" data-reveal>
          <Image
            src={karteImg}
            alt="Wohnort Clown Zauberer LIAR"
            widths={[400, 800]}
            sizes="(max-width: 900px) 86vw, 460px"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- CTA: the ring, red velvet -->
  <section class="k3-band k3-band--velvet ks-cta">
    <div class="container k3-narrow k3-center" data-reveal>
      <GoldDivider />
      <h2 class="k3-h2">🎪 Jetzt Zaubershow für Ihre Schule buchen!</h2>
      <p>Ob Schulfest, Einschulung oder Karneval – lassen Sie uns gemeinsam ein unvergessliches Erlebnis für Ihre Schülerinnen und Schüler schaffen! Entdecken Sie auch mein Programm für <a href="/zauberer/zaubershow/kindergarten-kita/">Kindergärten und Kitas</a> oder bei <a href="/zauberer/zaubershow/strassen-sommer-fest/">Straßen- und Sommerfesten</a>.</p>
      <div class="ks-cta__lines">
        <p>📱 Telefon &amp; WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
        <p>⚡ Schnelle Antwort: Meist innerhalb 24 Stunden</p>
        <p class="ks-cta__tip">💡 Tipp: Beliebte Termine vor den Sommerferien oder zur Weihnachtszeit sind schnell vergeben – frühzeitig anfragen lohnt sich!</p>
      </div>
      <a href="/kontakt/" class="btn btn--primary" data-confetti>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>

  <!-- FAQ: native <details>; the visible "+" stays real text (legacy content) -->
  <section class="k3-faq ks-faq" id="faq">
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">Häufig gestellte Fragen</h2>
      <div class="k3-faq__list">
        {faqItems.map((i) => (
          <details class="k3-faq__item" data-reveal>
            <summary><span>{i.q}</span><span class="ks-plus">+</span></summary>
            <div class="k3-faq__answer">{i.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .ks-title { font-size: clamp(2.8rem, 7vw, 5rem); line-height: 1; }
  .ks-list li { display: flex; gap: 0.5rem; align-items: flex-start; }
  .ks-list li > span:first-child { flex: none; }

  .ks-text { color: var(--ink-soft); }
  .ks-icon { font-size: 2rem; line-height: 1; margin-bottom: 0.6rem !important; text-align: center; }
  .ks-dauer { margin: 0 !important; padding-top: var(--space-2); border-top: 1px solid rgba(184, 134, 47, 0.3); font-weight: 800; color: var(--accent-strong); font-size: 0.95rem; }

  /* ages: two programme cards in the spotlights, the photo between them */
  .ks-ages__grid { display: grid; gap: var(--space-4); align-items: center; justify-items: center; margin-top: var(--space-4); }
  .ks-age .ks-text { margin: 0; }
