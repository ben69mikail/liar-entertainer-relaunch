---
import V2Layout from '../../../../layouts/V2Layout.astro';
import Reviews from '../../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../../components/v2/ReviewBadge.astro';
import Curtain from '../../../../components/v2/kids/Curtain.astro';
import K3Hero from '../../../../components/v2/kids/K3Hero.astro';
import ProgramFrame from '../../../../components/v2/kids/ProgramFrame.astro';
import GoldDivider from '../../../../components/v2/kids/GoldDivider.astro';
import YouTubeFacade from '../../../../components/YouTubeFacade.astro';
import { CONTACT } from '../../../../data/site';
import '../../../../styles/kids-v3.css';
import { Image } from 'astro:assets';
import heroImg from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-3.jpg';
import kitaEssenImg from '../../../../assets/images/clown/kinderzauberer-kindergarten-essen.jpg';
import geburtstagKitaImg from '../../../../assets/images/zauberer/geburtstag-kita.jpg';
import galerieImg2 from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-2.jpg';
import kindergartenGelsenkirchenImg from '../../../../assets/images/zauberer/kindergarten-gelsenkirchen.jpg';
import karteImg from '../../../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';

const seoTitle = 'Zaubershow Kindergarten & Kita NRW | LIAR';
const seoDescription = 'Zaubershow für Kindergarten & Kita in NRW ✓ Kinderzauberer LIAR ✓ 370+ Top-Bewertungen ✓ Pädagogisch wertvoll ✓ Jetzt buchen!';

const faqItems = [
  { q: 'Ab welchem Alter ist die Zaubershow für Kita-Kinder geeignet?', a: 'Die Kita-Zaubershow ist speziell auf Kindergartenkinder ab etwa 3 bis 4 Jahren abgestimmt: kurze, klare Zaubereffekte, viel Interaktion und liebevoller Humor ohne Erschrecken.' },
  { q: 'Wie lange dauert die Zaubershow im Kindergarten?', a: 'Für Kita-Kinder ist eine Showdauer von etwa 30 bis 40 Minuten ideal, damit die Aufmerksamkeitsspanne der Kleinen nicht überfordert wird.' },
  { q: 'Wie viel Platz braucht LIAR in der Kita?', a: 'Es reicht ein freier Bereich von etwa 2×2 Metern, zum Beispiel im Gruppenraum, Bewegungsraum oder Turnraum. Aufwendige Technik ist nicht nötig.' },
  { q: 'Ist die Zaubershow pädagogisch wertvoll?', a: 'Ja. Die Show fördert Staunen, Konzentration und gemeinsames Erleben, bezieht die Kinder aktiv ein und stärkt spielerisch das Miteinander in der Gruppe.' },
  { q: 'Für welche Anlässe in der Kita eignet sich die Zaubershow?', a: 'Für Sommerfest, Abschlussfeier der Vorschulkinder, Laternenfest, Weihnachtsfeier oder einfach als besondere Überraschung im Kita-Alltag.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};

const anlaesse = [
  { icon: '☀️', title: 'Sommerfeste', text: 'Der Klassiker! Beim Sommerfest ist die Zaubershow oft DAS Highlight. Ob auf der Bühne oder als Walk-Act – ich sorge für strahlende Kinderaugen und zufriedene Eltern.' },
  { icon: '🎓', title: 'Abschiedsfeiern für Vorschulkinder', text: 'Die Vorschulkinder verlassen den Kindergarten – ein emotionaler Moment! Meine Show macht diesen Übergang zu einem fröhlichen, unvergesslichen Erlebnis.' },
  { icon: '🎭', title: 'Projektwochen', text: 'Projektwochen zu Themen wie „Zirkus\", „Magie\", „Fantasie\" oder „Berufe\"? Meine Show passt perfekt!' },
  { icon: '🎄', title: 'Weihnachtsfeiern & Winterfeste', text: 'Auch in der kalten Jahreszeit sorge ich für warme Kinderherzen. Die Show lässt sich wunderbar in Weihnachtsfeiern integrieren.' },
  { icon: '🎈', title: 'Faschings-/Karnevalsfeiern', text: 'Wenn es bunt und lustig wird, bin ich in meinem Element! Die Clown-Elemente meiner Show passen perfekt zur Karnevalszeit.' },
  { icon: '🎊', title: 'Jubiläen & besondere Anlässe', text: '10 Jahre Kindergarten? Neues Gebäude? Tag der offenen Tür? Für besondere Anlässe biete ich besondere Shows!' },
];

const paedagogisch = [
  { icon: '✨', title: 'Fantasie & Kreativität', text: 'Zaubergeschichten regen die Vorstellungskraft an' },
  { icon: '💪', title: 'Selbstbewusstsein', text: 'Als Zauberassistent auf der „Bühne\" zu stehen stärkt das Selbstwertgefühl' },
  { icon: '👂', title: 'Konzentration', text: '30–45 Min. aufmerksam dabei bleiben – eine beachtliche Leistung für Kindergartenkinder!' },
  { icon: '🗣️', title: 'Sprachförderung', text: 'Zaubersprüche sprechen, Dinge benennen, Fragen beantworten' },
  { icon: '🤝', title: 'Soziale Kompetenz', text: 'Zusammen helfen, abwechseln, gemeinsam Erfolge feiern' },
  { icon: '🎭', title: 'Emotionale Entwicklung', text: 'Freude, Überraschung, Staunen – ein emotionales Feuerwerk!' },
];
const _pageGallery = [
  { src: kitaEssenImg, alt: 'Lachende Kinder bei Kinderzauberer Kindergarten Essen' },
  { src: geburtstagKitaImg, alt: 'Kinder lachen im Kindergarten bei LIARs Zaubershow' },
  { src: galerieImg2, alt: 'Zaubershow für Kindergarten' },
  { src: kindergartenGelsenkirchenImg, alt: 'Kinderzauberer Kindergarten Gelsenkirchen' },
];

---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  structuredData={[faqSchema]}
  keywords="Zaubershow Kindergarten, Zauberer Kita, Zaubershow Kita NRW, Kindergarten Programm, Sommerfest Kindergarten"
  canonical="https://liar-entertainer.com/zauberer/zaubershow/kindergarten-kita/"
>
  <!-- Hero: the big-top stage. No reveal here (LCP). -->
  <K3Hero>
        <p class="k3-crumbs">
          <a href="/">Clown</a> »
          <a href="/zauberer/">Zauberer</a> »
          <a href="/zauberer/zaubershow/">Zaubershow</a> »
          <span>Kindergarten – Kita</span>
        </p>
        <ReviewBadge />
        <h1 class="k3-hero__title" data-letters>Zaubershow für <span class="k3-mark">Kindergarten &amp; Kita</span> in NRW</h1>
        <h2 class="k3-hero__sub">
          🎪 Wo Lernen auf Magie trifft –<br />zauberhafte Momente für Ihre Kita!
        </h2>
        <p class="k3-hero__claim">Pädagogisch wertvoll. Altersgerecht. Unvergesslich.</p>
        <div class="k3-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
    <Fragment slot="photo">
      <Image
        src={heroImg}
        alt="Zaubershow für Kindergarten & Kita NRW"
        widths={[400, 700, 1000]}
        quality={70}
        sizes="(max-width: 900px) 80vw, 500px"
        loading="eager"
        fetchpriority="high"
      />
      <a class="k3-medal" href="#details">
        <span>Alter</span><strong>3–6</strong>
      </a>
    </Fragment>
  </K3Hero>

  <!-- Intro -->
  <section class="k3-intro">
    <div class="container k3-split kk-intro">
      <div data-reveal>
        <p class="k3-lead">
          Sie planen ein Sommerfest, eine Abschiedsfeier für die Vorschulkinder oder suchen ein besonderes Highlight für Ihre Kita? Als erfahrener Kinderzauberer bringe ich seit über 15 Jahren Magie in Kindergärten und Kitas in ganz NRW. Meine Shows sind nicht nur unterhaltsam – sie sind pädagogisch wertvoll, altersgerecht und perfekt auf die Bedürfnisse von Bildungseinrichtungen abgestimmt! ✨
        </p>
        <p>
          Das Beste? Für Sie als Erzieher bedeutet es minimalen Aufwand bei maximalem Erfolg. Ich bringe alles mit, benötige keine Vorbereitung und nur 2×2 Meter Platz. Ich biete auch spezielle Shows für <a href="/zauberer/zaubershow/schule/">Grundschulen</a> sowie auf <a href="/zauberer/zaubershow/strassen-sommer-fest/">Straßen- und Sommerfesten</a> an.
        </p>
      </div>
      <aside class="k3-expect" data-reveal data-reveal-delay="0.1">
        <h3 class="k3-expect__title">⭐ Das macht meine Show kindergartengerecht:</h3>
        <ul class="k3-expect__list kk-list">
          <li><span>🎯</span> <span><strong>Altersgerecht für 3–6 Jahre:</strong> Einfache Tricks, kurze Geschichten, viel Bewegung</span></li>
          <li><span>👥</span> <span><strong>Große Gruppen kein Problem:</strong> Erfahrung mit 20–100 Kindern</span></li>
          <li><span>📚</span> <span><strong>Pädagogischer Mehrwert:</strong> Fördert Fantasie, Kreativität und Selbstbewusstsein</span></li>
          <li><span>🤝</span> <span><strong>Inklusion:</strong> Alle Kinder werden eingebunden – schüchterne wie wilde</span></li>
          <li><span>⚡</span> <span><strong>Unkompliziert:</strong> Minimaler Vorbereitungsaufwand, nur 2×2 Meter Platz</span></li>
        </ul>
      </aside>
    </div>
  </section>

  <Reviews />

  <!-- Anlässe -->
  <section class="kk-occasions">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>🎉 Perfekt für diese Anlässe in Kindergarten & Kita</h2>
      <div class="k3-cards kk-occasions__grid">
        {anlaesse.map((a, i) => (
          <article class="k3-card" data-reveal data-reveal-delay={String((i % 3) * 0.08)}>
            <p class="kk-icon">{a.icon}</p>
            <h3>{a.title}</h3>
            <p class="kk-card__text">{a.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Zahlen: the ring, red velvet -->
  <section class="k3-band k3-band--velvet">
    <div class="container">
      <GoldDivider />
      <div class="k3-stats">
        <div class="k3-stat" data-reveal>
          <div class="k3-stat__icon">🪄</div>
          <div class="k3-stat__num" data-count>400</div>
          <div class="k3-stat__label">Shows im Jahr</div>
        </div>
        <div class="k3-stat" data-reveal data-reveal-delay="0.08">
          <div class="k3-stat__icon">😊</div>
          <div class="k3-stat__num">110.000</div>
          <div class="k3-stat__label">Lachende Kinder</div>
        </div>
        <div class="k3-stat" data-reveal data-reveal-delay="0.16">
          <div class="k3-stat__icon">🪄</div>
          <div class="k3-stat__num" data-count>15</div>
          <div class="k3-stat__label">Jahre Erfahrung</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pädagogischer Mehrwert: paper slips with a fine gold edge -->
  <section class="kk-learn k3-alt">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>🎯 Pädagogischer Mehrwert</h2>
      <p class="k3-center k3-sub">Was Kinder bei der Zaubershow lernen:</p>
      <div class="kk-learn__grid">
        {paedagogisch.map((p, i) => (
          <div class="k3-panel kk-tile" data-reveal data-reveal-delay={String((i % 3) * 0.08)}>
            <p class="kk-icon">{p.icon}</p>
            <p class="kk-tile__title">{p.title}</p>
            <p class="kk-tile__text">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Eindrücke: every photo whole, in a programme frame -->
  <section class="kk-photos">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>📸 Eindrücke</h2>
      <div class="kk-photos__grid">
        {_pageGallery.map((s, i) => (
          <ProgramFrame class="kk-photo" data-reveal data-reveal-delay={String(i * 0.08)}>
            <Image
              src={s.src}
              alt={s.alt}
              widths={[280, 560]}
              quality={60}
              sizes="(max-width: 900px) 80vw, 260px"
              loading="lazy"
              fetchpriority="low"
            />
          </ProgramFrame>
        ))}
      </div>
    </div>
  </section>

  <!-- Praktische Details -->
  <section class="kk-details k3-alt" id="details">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>📋 Praktische Details für Kitas</h2>
      <div class="k3-grid k3-grid--3">
        <article class="k3-card kk-detail" data-reveal>
          <h3 class="kk-detail__title">📐 Platzbedarf & Räume</h3>
          <p>Minimaler Platzbedarf: <strong>2×2 Meter</strong> (ideal 3×3 Meter)</p>
          <p class="kk-detail__label">Geeignete Räume:</p>
          <ul class="kk-plain">
            <li>✓ Turnraum / Bewegungsraum (optimal!)</li>
            <li>✓ Mehrzweckraum</li>
            <li>✓ Großer Gruppenraum</li>
            <li>✓ Außenbereich (überdacht)</li>
          </ul>
        </article>
        <article class="k3-card kk-detail" data-reveal data-reveal-delay="0.08">
          <h3 class="kk-detail__title">👶 Gruppengrößen</h3>
          <ul class="kk-plain kk-plain--spaced">
            <li><strong>Ideal: 20–60 Kinder</strong><br />Perfekte Größe für intensive Interaktion</li>
            <li><strong>Möglich: 60–100 Kinder</strong><br />Show bleibt effektiv</li>
            <li><strong>Auch möglich: 100+ Kinder</strong><br />Bitte anfragen</li>
            <li><strong>Kleine Gruppen: 10–20 Kinder</strong><br />Auch buchbar!</li>
          </ul>
        </article>
        <article class="k3-card kk-detail" data-reveal data-reveal-delay="0.16">
          <h3 class="kk-detail__title">⏱️ Showdauer</h3>
          <ul class="kk-plain kk-plain--spaced">
            <li><strong>Kurze Show: 25–30 Min.</strong><br />Für jüngere Kinder (3–4 Jahre)</li>
            <li><strong>Standard-Show: 35–40 Min.</strong><br />Ideal für gemischte Altersgruppen</li>
            <li><strong>Lange Show: 45 Min.</strong><br />Für ältere Kinder oder besondere Anlässe</li>
          </ul>
          <p class="k3-card__note kk-note">Technik: Fast keine! Kein Strom, kein Mikrofon (normal), keine Bühne nötig.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Video: Hollywood premiere, two searchlights from the floor crossing behind the video -->
  <section class="k3-band k3-band--night k3-premiere">
    <span class="k3-uplight k3-uplight--l" aria-hidden="true"></span>
    <span class="k3-uplight k3-uplight--r" aria-hidden="true"></span>
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <h2 class="k3-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="k3-video" data-reveal>
        <Curtain trigger="stage" rest="clamp(2.2rem, 10vw, 4.6rem)" span="min(42rem, 100vw - 2rem)" tieback valance />
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
      </div>
      <h3 class="k3-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>

  <!-- Einsatzgebiet (the map has no frame) -->
  <section class="k3-area" id="einsatzgebiet">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">Zaubershow für Kindergärten in ganz NRW</h2>
      <p class="k3-center k3-narrow">Als erfahrener Kinderzauberer bin ich in ganz Nordrhein-Westfalen für Kindergärten und Kitas buchbar.</p>
      <div class="k3-area__grid">
        <div>
          <h3 class="k3-h3">Ruhrgebiet</h3>
          <p class="k3-cities">Oberhausen, Essen, Duisburg, Mülheim, Gelsenkirchen, Bochum, Dortmund, Bottrop, Gladbeck, Herten, Herne, Marl, Recklinghausen, Castrop-Rauxel, Waltrop</p>
          <h3 class="k3-h3">Rheinland</h3>
          <p class="k3-cities">Düsseldorf, Krefeld, Moers, Neuss, Köln, Leverkusen, Mönchengladbach</p>
          <h3 class="k3-h3">Münsterland</h3>
          <p class="k3-cities">Münster, Haltern am See, Dorsten, Coesfeld, Dülmen</p>
          <h3 class="k3-h3">Weitere Städte</h3>
          <p class="k3-cities">Ahaus, Reken, Lünen, Hagen, Witten und viele mehr</p>
          <p>🌍 Auf Anfrage auch deutschlandweit sowie in Belgien, Niederlande, Frankreich, Österreich und der Schweiz buchbar!</p>
        </div>
        <figure class="k3-area__map" data-reveal>
          <Image
            src={karteImg}
            alt="Wohnort Clown Zauberer LIAR"
            widths={[400, 800]}
            sizes="(max-width: 900px) 86vw, 460px"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- CTA: the ring, red velvet -->
  <section class="k3-band k3-band--velvet kk-cta">
    <div class="container k3-narrow k3-center" data-reveal>
      <GoldDivider />
      <h2 class="k3-h2">🎪 Jetzt anfragen für Ihren Kindergarten!</h2>
      <p>Ob Sommerfest, Abschiedsfeier oder Projektwoche – lassen Sie uns gemeinsam ein unvergessliches Erlebnis für Ihre Kinder schaffen! Ich trete auch bei <a href="/zauberer/zaubershow/schule/">Schulveranstaltungen</a> und <a href="/zauberer/zaubershow/strassen-sommer-fest/">Straßen- und Sommerfesten</a> auf.</p>
      <div class="kk-cta__lines">
        <p>📱 Telefon &amp; WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
        <p>⚡ Schnelle Antwort: Meist innerhalb 24 Stunden</p>
        <p class="kk-cta__tip">💡 Tipp: Sommerfest-Termine sind schnell ausgebucht – frühzeitig anfragen lohnt sich!</p>
      </div>
      <a href="/kontakt/" class="btn btn--primary" data-confetti>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>

  <!-- FAQ: native <details>; the visible "+" stays real text (legacy content) -->
  <section class="k3-faq kk-faq" id="faq">
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">Häufig gestellte Fragen</h2>
      <div class="k3-faq__list">
        {faqItems.map((i) => (
          <details class="k3-faq__item" data-reveal>
            <summary><span>{i.q}</span><span class="kk-plus">+</span></summary>
            <div class="k3-faq__answer">{i.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .kk-list li { display: flex; gap: 0.5rem; align-items: flex-start; }
  .kk-list li > span:first-child { flex: none; }

  /* occasions */
  .kk-occasions__grid { margin-top: var(--space-4); align-items: stretch; }
  .kk-icon { font-size: 2rem; line-height: 1; margin-bottom: 0.6rem !important; text-align: center; }
  .kk-card__text { color: var(--ink-soft); margin: 0 !important; text-align: center; }

  /* learning slips */
  .kk-learn__grid { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .kk-tile { text-align: center; padding: var(--space-3); }
  .kk-tile__title { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; margin-bottom: 0.3rem !important; }
  .kk-tile__text { color: var(--ink-soft); font-size: 0.95rem; margin: 0 !important; }

  /* photos: whole, never cropped; the frame sets only the width */
  .kk-photos__grid { display: grid; gap: var(--space-4); margin-top: var(--space-4); justify-items: center; align-items: center; }
  .kk-photos__grid :global(.kk-photo) { width: min(100%, 20rem); padding: 1rem; }
  .kk-photos__grid :global(.kk-photo:nth-child(odd)) { rotate: -1.2deg; }
  .kk-photos__grid :global(.kk-photo:nth-child(even)) { rotate: 1.2deg; }

  /* practical details */
  .kk-detail__title { font-size: 1.35rem !important; margin: 0 0 var(--space-2) !important; }
  .kk-detail > p { color: var(--ink-soft); }
  .kk-detail__label { font-weight: 800; color: var(--ink) !important; margin-bottom: 0.4rem !important; }
  .kk-plain { list-style: none; margin: 0 0 var(--space-2); padding: 0; display: grid; gap: 0.35rem; color: var(--ink-soft); }
  .kk-plain li { display: block; } /* .k3-card li is a flex row; these items carry a <br> */
  .kk-plain strong { color: var(--ink); }
  .kk-plain--spaced { gap: 0.8rem; }

  /* CTA on velvet */
  .kk-cta__lines { margin: var(--space-3) 0; font-weight: 700; }
  .kk-cta__lines p { margin-bottom: 0.4rem; }
  .kk-cta__tip { display: inline-block; margin-top: var(--space-1) !important; padding: 0.45rem 1rem; border-radius: 999px; background: rgba(255, 240, 220, 0.08); color: #ffe3a3; box-shadow: inset 0 0 0 1px rgba(233, 200, 119, 0.6); }

  /* FAQ: the real "+" (legacy text) replaces the kit's ::after badge */
  .kk-faq :global(.k3-faq__item summary::after) { content: none; }
  .kk-plus {
    flex: none; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%;
    font-family: var(--font-display); font-size: 1.2rem; line-height: 1; color: var(--gold); box-shadow: inset 0 0 0 1px var(--gold);
    transition: rotate 0.3s var(--ease-out), background-color 0.2s ease, color 0.2s ease;
  }
  .k3-faq__item[open] .kk-plus { rotate: 45deg; background: var(--velvet); color: #fff3dd; box-shadow: none; }

  @media (min-width: 901px) {
    .kk-learn__grid { grid-template-columns: repeat(3, 1fr); }
    .kk-photos__grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
