---
import { Image } from 'astro:assets';
import V2Layout from '../../layouts/V2Layout.astro';
import Reviews from '../../components/v2/Reviews.astro';
import ReviewBadge from '../../components/v2/ReviewBadge.astro';
import SectionEdge from '../../components/v2/SectionEdge.astro';
import Bunting from '../../components/v2/kids/Bunting.astro';
import Squiggle from '../../components/v2/kids/Squiggle.astro';
import { CONTACT } from '../../data/site';
import heroImg from '../../assets/images/kindergeburtstag/kindergeburtstag-hero.jpg';
import zaubershowImg from '../../assets/images/shows/zaubershow.jpg';
import ballonImg from '../../assets/images/shows/ballonmodellage.jpg';
import glitzerImg from '../../assets/images/shows/glitzer-tattoos.jpg';
import '../../styles/kids-kit.css';


const title = "Preise & Pakete – Kindergeburtstag ab 150 € | LIAR";
const description = 'Transparente Preise für Kindergeburtstag mit Clown Zauberer LIAR – Zaubershow ab 150€ – Ballontiere +20€ – Glitzer Tattoos +40€ – Keine versteckten Kosten!';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Clown für den Kindergeburtstag?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Zaubershow für den Kindergeburtstag kostet 150€ für 40 Minuten (bis ca. 12 Kinder). Zusätzlich buchbar: Ballonmodellage (+20€) und Glitzer Tattoos (+40€). Hinzu kommen Fahrtkosten von 0,40€ pro Kilometer (Hin- und Rückfahrt) ab Gladbeck."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es versteckte Kosten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein. Der genannte Preis enthält die komplette Show inklusive aller Materialien. Es kommen lediglich die Fahrtkosten hinzu, die vorab transparent berechnet werden."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich auch nur Ballonmodellage oder Glitzer Tattoos buchen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Ballonmodellage und Glitzer Tattoos sind als Ergänzung zur Zaubershow konzipiert. Für eigenständige Buchungen (z.B. auf Straßenfesten) kontaktieren Sie mich bitte für ein individuelles Angebot."
      }
    },
    {
      "@type": "Question",
      "name": "Wie bezahle ich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Bezahlung erfolgt in der Regel bar vor Ort am Tag der Veranstaltung. Auf Wunsch ist auch Überweisung vorab möglich."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Clown Zauberer LIAR – Kindergeburtstag",
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": {
    "@type": "State",
    "name": "Nordrhein-Westfalen"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Kindergeburtstag-Pakete",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Zaubershow",
        "price": "150",
        "priceCurrency": "EUR",
        "description": "40 Minuten interaktive Zaubershow für bis zu 12 Kinder, inkl. Material"
      },
      {
        "@type": "Offer",
        "name": "Zaubershow + Ballonmodellage",
        "price": "170",
        "priceCurrency": "EUR",
        "description": "Zaubershow plus Ballontiere für jedes Kind, ca. 55 Minuten"
      },
      {
        "@type": "Offer",
        "name": "Komplett-Paket",
        "price": "210",
        "priceCurrency": "EUR",
        "description": "Zaubershow + Ballonmodellage + Glitzer Tattoos, ca. 90 Minuten"
      }
    ]
  }
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow für Kinder in NRW. Ab 150€ – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const snaps = [
  { src: zaubershowImg, alt: 'Zaubershow für Kindergeburtstag mit Clown Zauberer LIAR', title: 'Zaubershow', text: '40 Min. interaktive Magie' },
  { src: ballonImg, alt: 'Ballonmodellage – bunte Ballontiere für Kinder', title: 'Ballonmodellage', text: 'Wunschtiere für jedes Kind' },
  { src: glitzerImg, alt: 'Glitzer Tattoos – funkelnde Motive für Kinder', title: 'Glitzer Tattoos', text: 'Hautverträglich, hält Tage' },
];

const travel = [
  ['Gladbeck, Bottrop, Dorsten', '8 – 12 €'],
  ['Oberhausen, Gelsenkirchen, Herten, Marl', '10 – 25 €'],
  ['Essen, Bochum, Recklinghausen', '15 – 30 €'],
  ['Duisburg, Dortmund, Herne', '25 – 40 €'],
  ['Düsseldorf, Münster', '40 – 60 €'],
  ['Köln, Bonn', '60 – 80 €'],
];

const onRequest = [
  '🎩 Close-up Zauberei / Tischzauberer',
  '🎭 Bühnenzauberer / Stand-up Show',
  '🤡 Clownshow',
  '🚶 Walk-Act',
  '🏫 Kindergarten / Schule (große Gruppen)',
];

const included = [
  { icon: '🎩', title: 'Komplettes Showprogramm', text: 'Zaubershow, Clownerie oder beides – individuell auf Ihr Event abgestimmt' },
  { icon: '🧳', title: 'Alle Materialien & Requisiten', text: 'Zaubertricks, Ballons, Glitzer-Utensilien – alles wird mitgebracht' },
  { icon: '📞', title: 'Persönliche Vorbesprechung', text: 'Telefonische Absprache zu Ablauf, Alter der Kinder und Ihren Wünschen' },
  { icon: '⏱️', title: 'Auf- und Abbau inklusive', text: 'Pünktliches Erscheinen, Aufbau und Abbau – Sie müssen nichts vorbereiten' },
  { icon: '🎂', title: 'Geburtstagskind im Mittelpunkt', text: 'Das Geburtstagskind wird zum Star der Show – ein unvergesslicher Moment' },
  { icon: '💰', title: 'Keine versteckten Kosten', text: 'Der vereinbarte Preis gilt – es kommen nur die transparenten Fahrtkosten hinzu' },
];

// Same questions and answers as faqSchema (one source for the visible FAQ and the schema).
const faq = faqSchema.mainEntity.map((q) => ({ q: q.name, a: q.acceptedAnswer.text }));
---

<V2Layout
  title={title}
  description={description}
  keywords="Preise Clown Zauberer, Kindergeburtstag Kosten, Zaubershow Preis, Clown buchen Kosten NRW, Kinderzauberer Preise"
  canonical="https://liar-entertainer.com/preise/"
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Preise & Pakete', url: '/preise/' }]}
  structuredData={[faqSchema, serviceSchema, videoSchema]}
>
  <!-- ── Hero: price tag first (trust before show). No reveal here (LCP). ── -->
  <section class="kg-hero pr-hero">
    <canvas class="kg-rays" aria-hidden="true" data-side-rays='{"rayColor1":"#ffb546","rayColor2":"#ff8a3d","origin":"top-right","speed":1.6,"intensity":2,"spread":1.4,"saturation":1.5,"blend":0.4,"falloff":1.3,"opacity":0.55}'></canvas>
    <Bunting />
    <div class="container kg-hero__grid">
      <div class="kg-hero__copy">
        <ReviewBadge />
        <h1 class="kg-hero__title pr-hero__title" data-letters>Preise &amp; Pakete – Transparent und fair</h1>
        <p class="pr-hero__lead">Bei Clown Zauberer LIAR gibt es keine versteckten Kosten. Alle Kindergeburtstag-Preise sind fest kalkuliert. Für Firmenfeiern, Stadtfeste und andere Events wird ein individuelles Angebot erstellt.</p>
        <div class="kg-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
        <nav class="kg-quick" aria-label="Schnell zu den Infos">
          <a href="#pakete">Pakete</a>
          <a href="#fahrtkosten">Fahrtkosten</a>
          <a href="#faq">Fragen</a>
        </nav>
      </div>
      <figure class="kg-hero__photo">
        <Image
          src={heroImg}
          alt="Preise und Pakete – Clown Zauberer LIAR für Kindergeburtstag"
          widths={[400, 700, 1036]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
          style="object-position: 50% 30%"
        />
        <a class="kg-sticker pr-sticker" href="#pakete">
          <span>ab</span><strong>150 €</strong>
        </a>
      </figure>
    </div>
  </section>

  <!-- ── Einleitungstext ───────────────────────────────────── -->
  <section class="kg-intro">
    <div class="container kg-narrow" data-reveal>
      <h2 class="kg-h2">Was kostet ein Clown Zauberer?</h2>
      <p class="kg-lead">
        Die Kosten für einen professionellen Clown Zauberer hängen von mehreren Faktoren ab: der <strong>Art der Veranstaltung</strong> (Kindergeburtstag, Firmenfeier, Stadtfest, Kita-Fest), der <strong>gewünschten Showdauer</strong>, der <strong>Anzahl der Kinder oder Gäste</strong>, den gebuchten <strong>Zusatzleistungen</strong> wie Ballonmodellage oder Glitzer Tattoos sowie der <strong>Anfahrtsentfernung</strong> ab Gladbeck. Auch spielt es eine Rolle, ob die Show drinnen oder draußen stattfindet und ob besondere Wünsche berücksichtigt werden sollen.
      </p>
      <p>
        Für den <strong>Kindergeburtstag</strong> biete ich feste, transparente Paketpreise an – damit Sie von Anfang an genau wissen, was auf Sie zukommt. Diese finden Sie weiter unten auf dieser Seite.
      </p>
      <p>
        Alle anderen Leistungen – ob <a href="/clown/clownshow/">Clownshow</a>, <a href="/zauberer/buehnen-zauberer/">Bühnenzauberei</a>, <a href="/zauberer/tisch-zauberer/">Tischzauberei</a>, <a href="/clown/walk-act/">Walk-Act</a> oder Auftritte bei Firmenfeiern, Stadtfesten und Schulen – laufen <strong>ausschließlich auf Anfrage</strong>. So erhalten Sie ein individuelles Angebot, das exakt zu Ihrem Event passt. Rufen Sie einfach an unter <a href={CONTACT.phoneHref}>0172-1517578</a> oder nutzen Sie das <a href="/kontakt/">Kontaktformular</a> – ich berate Sie gerne persönlich!
      </p>
    </div>
  </section>

  <Reviews />

  <!-- ── PREISLISTE — Kindergeburtstag-Pakete ──────────────── -->
  <section class="kg-prices pr-packages" id="pakete">
    <div class="container">
      <Squiggle />
      <h2 class="kg-h2 kg-center" data-reveal>Kindergeburtstag-Pakete</h2>
      <div class="kg-cards pr-cards">
        <article class="kg-card kg-card--red" data-reveal="pop">
          <h3>🎩 Zaubershow</h3>
          <p class="kg-card__price" data-count>150 €</p>
          <ul>
            <li><span>✓</span> 40 Minuten interaktive Zaubershow</li>
            <li><span>✓</span> Bis ca. 12 Kinder, Mindestalter 4 Jahre</li>
            <li><span>✓</span> Inkl. Material</li>
            <li><span>✓</span> Das Geburtstagskind steht im Mittelpunkt</li>
            <li><span>✓</span> zzgl. Fahrtkosten (0,40€/km, Hin- &amp; Rückfahrt) ab Gladbeck</li>
          </ul>
          <p class="pr-dur">Gesamtdauer: ca. 40 Minuten</p>
        </article>
        <article class="kg-card kg-card--blue" data-reveal="pop" data-reveal-delay="0.1">
          <h3>🎈 Zaubershow + Ballons</h3>
          <p class="kg-card__price" data-count>170 €</p>
          <ul>
            <li><span>✓</span> Alles aus "Zaubershow"</li>
            <li><span>✓</span> Ballonmodellage für jedes Kind</li>
            <li><span>✓</span> Große Auswahl: Hund, Schwert, Blume, Krone, Dino u.v.m.</li>
            <li><span>✓</span> zzgl. Fahrtkosten (0,40€/km, Hin- &amp; Rückfahrt) ab Gladbeck</li>
          </ul>
          <p class="pr-dur">Gesamtdauer: ca. 55 Minuten</p>
        </article>
        <article class="kg-card kg-card--yellow pr-popular" data-reveal="pop" data-reveal-delay="0.2">
          <span class="pr-flag">Beliebteste</span>
          <h3>✨ Komplett-Paket</h3>
          <p class="kg-card__price" data-count>210 €</p>
          <ul>
            <li><span>✓</span> Alles aus "Zaubershow + Ballons"</li>
            <li><span>✓</span> Glitzer Tattoos für jedes Kind</li>
            <li><span>✓</span> Hautverträglich, hält 4-8 Tage</li>
            <li><span>✓</span> Viele Motive: Einhörner, Schmetterlinge, Dinos, Sterne u.v.m.</li>
            <li><span>✓</span> zzgl. Fahrtkosten (0,40€/km, Hin- &amp; Rückfahrt) ab Gladbeck</li>
          </ul>
          <p class="pr-dur">Gesamtdauer: ca. 90 Minuten</p>
        </article>
      </div>
      <p class="kg-center kg-cta-row">
        <a href="/kontakt/" class="btn btn--primary" data-confetti>
          Jetzt unverbindlich anfragen
        </a>
      </p>
    </div>
  </section>

  <!-- ── Das erwartet Sie: three snapshots pinned to the board ── -->
  <section class="pr-expect">
    <div class="container">
      <h2 class="kg-h2 kg-center" data-reveal>Das erwartet Sie</h2>
      <div class="pr-snaps">
        {snaps.map((e, i) => (
          <div class="pr-snap" data-reveal="tilt" data-reveal-delay={i ? String(i / 10) : undefined}>
            <figure class="pr-snap__frame" data-tilt>
              <Image
                src={e.src}
                alt={e.alt}
                widths={[300, 450]}
                sizes="(max-width: 900px) 84vw, 300px"
                loading="lazy"
              />
              <figcaption>
                <p class="pr-snap__title">{e.title}</p>
                <p class="pr-snap__text">{e.text}</p>
              </figcaption>
            </figure>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Fahrtkosten (yellow band) ─────────────────────────── -->
  <section class="kg-band kg-band--yellow pr-travel" id="fahrtkosten">
    <SectionEdge color="var(--brand-yellow)" side="top" />
    <SectionEdge color="var(--brand-yellow)" side="bottom" />
    <div class="container">
      <h2 class="kg-h2">Fahrtkosten ab Gladbeck</h2>
      <p class="pr-travel__sub">(Hin- und Rückfahrt, 0,40 €/km)</p>
      <div class="kg-table-wrap pr-table" data-reveal="pop">
        <table class="kg-table">
          <thead>
            <tr>
              <th scope="col">Stadt / Region</th>
              <th scope="col" class="pr-num">ca. Fahrtkosten</th>
            </tr>
          </thead>
          <tbody>
            {travel.map(([city, cost]) => (
              <tr>
                <td>{city}</td>
                <td class="pr-num"><span class="pr-cost">{cost}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pr-travel__note">Alle Fahrtkosten verstehen sich für Hin- und Rückfahrt (0,40 €/km). Die genauen Kosten werden bei der Buchung individuell berechnet.</p>
    </div>
  </section>

  <!-- ── Events & Firmen: one bill, every line "on request" ── -->
  <section class="pr-events">
    <div class="container">
      <h2 class="kg-h2 kg-center" data-reveal>Events &amp; Firmen</h2>
      <div class="pr-bill" data-reveal="pop">
        {onRequest.map((t) => (
          <div class="pr-bill__row">
            <h3>{t}</h3>
            <p class="pr-bill__price">Preis auf Anfrage</p>
          </div>
        ))}
      </div>
      <p class="kg-center pr-events__call">
        Kontaktieren Sie mich für ein individuelles Angebot: <a href={CONTACT.phoneHref}>0172-1517578</a>
      </p>
    </div>
  </section>

  <!-- ── Was ist im Preis enthalten? (blue band) ───────────── -->
  <section class="kg-band kg-band--blue pr-included">
    <SectionEdge color="var(--brand-blue)" side="top" />
    <SectionEdge color="var(--brand-blue)" side="bottom" />
    <div class="container">
      <h2 class="kg-h2">Was ist im Preis enthalten?</h2>
      <p class="pr-included__lead">Bei Clown Zauberer LIAR ist alles dabei, was Sie für ein unvergessliches Event brauchen. Sie müssen sich um nichts kümmern – nur für gute Laune sorgen!</p>
      <ul class="pr-inc">
        {included.map((it, i) => (
          <li class="pr-inc__item" data-reveal="pop" data-reveal-delay={String((i % 2) / 10)}>
            <span class="pr-inc__icon">{it.icon}</span>
            <div>
              <p class="pr-inc__title">{it.title}</p>
              <p class="pr-inc__text">{it.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────── -->
  <section class="kg-faq" id="faq">
    <div class="container kg-narrow">
      <h2 class="kg-h2 kg-center" data-reveal>Häufige Fragen zu Preisen</h2>
      <div class="kg-faq__list">
        {faq.map((item) => (
          <details class="kg-faq__item" data-reveal="puff">
            <summary>{item.q}</summary>
            <p class="kg-faq__answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────── -->
  <section class="pr-cta">
    <Bunting />
    <div class="container kg-narrow kg-center" data-reveal>
      <h2 class="kg-h2">Jetzt unverbindlich anfragen!</h2>
      <p class="pr-cta__text">Rufen Sie an, schreiben Sie per WhatsApp oder nutzen Sie das Kontaktformular – wir melden uns innerhalb von 24 Stunden!</p>
      <div class="pr-cta__actions">
        <a href={CONTACT.phoneHref} class="btn btn--primary" data-magnetic>📞 0172-1517578</a>
        <a href="/kontakt/" class="btn btn--ghost" data-confetti>Kontaktformular →</a>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero ── */
  .pr-hero__title { font-size: clamp(2.2rem, 4.6vw, 3.6rem); }
  .pr-hero__lead { font-size: 1.12rem; color: var(--ink-soft); margin-bottom: var(--space-3); max-width: 36rem; }
  .pr-sticker span { font-size: 1rem; }
  .pr-sticker strong { font-size: 1.5rem; }

  /* ── packages ── */
  .pr-cards { margin-top: var(--space-4); }
  .pr-dur {
    margin: 0; padding-top: var(--space-2); font-weight: 800; font-size: 0.95rem;
    border-top: 2px dashed color-mix(in srgb, var(--line) 30%, transparent);
  }
  .pr-popular { box-shadow: var(--shadow-hover); }
  .pr-flag {
    position: absolute; top: -1.05rem; right: 1rem; z-index: 1;
    padding: 0.25rem 0.85rem; font-family: var(--font-display); font-weight: 700; font-size: 0.95rem;
    background: var(--ink); color: var(--bg); border-radius: 999px; rotate: 4deg;
    animation: pr-swing 3.6s var(--ease-out) 1.5s infinite;
  }
  @keyframes pr-swing { 0%, 84%, 100% { rotate: 4deg; } 90% { rotate: -3deg; } 95% { rotate: 7deg; } }

  /* ── expect: pinned snapshots ── */
  .pr-expect { background: var(--surface); border-block: var(--border); }
  .pr-snaps { display: grid; gap: var(--space-4); margin-top: var(--space-4); justify-items: center; }
  @media (min-width: 901px) { .pr-snaps { grid-template-columns: repeat(3, 1fr); } }
  .pr-snap { width: min(100%, 21rem); }
  .pr-snap:nth-child(1) { rotate: -2.5deg; }
  .pr-snap:nth-child(2) { rotate: 1.5deg; }
  .pr-snap:nth-child(3) { rotate: -1deg; }
  .pr-snap__frame {
    position: relative; margin: 0; padding: 0.75rem 0.75rem 1rem; text-align: center;
    background: var(--bg); border: var(--border); border-radius: var(--radius-sm); box-shadow: var(--shadow);
    transition: transform 0.3s var(--ease-out);
  }
  /* a strip of tape holding the photo to the board */
  .pr-snap__frame::before {
    content: ''; position: absolute; top: -0.8rem; left: 50%; width: 5.5rem; height: 1.6rem; translate: -50% 0; rotate: -4deg;
    background: color-mix(in srgb, var(--brand-yellow) 75%, transparent); border: 2px solid color-mix(in srgb, var(--line) 35%, transparent);
  }
  .pr-snap :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: calc(var(--radius-sm) - 0.3rem); border: 2px solid var(--line); }
  .pr-snap figcaption { padding-top: 0.75rem; }
  .pr-snap__title { font-family: var(--font-display); font-weight: 650; font-size: 1.35rem; margin: 0; }
  .pr-snap__text { color: var(--ink-soft); margin: 0; font-weight: 600; }

  /* ── travel (yellow band) ── */
  .pr-travel__sub { font-weight: 800; }
  .pr-table { margin-top: var(--space-3); margin-bottom: var(--space-3); max-width: 44rem; text-align: left; rotate: -0.6deg; }
  .pr-num { text-align: right; }
  .pr-cost { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; white-space: nowrap; }
  .pr-table tbody tr:nth-child(odd) { background: color-mix(in srgb, var(--brand-yellow) 14%, transparent); }
  .pr-travel__note { max-width: 40rem; margin-inline: auto; font-weight: 600; }

  /* ── events: a hand-written bill ── */
  .pr-bill {
    max-width: 46rem; margin: var(--space-4) auto var(--space-3); padding: 0.5rem var(--space-3);
    background: var(--surface); border: var(--border); border-radius: var(--radius); box-shadow: var(--shadow); rotate: 0.6deg;
  }
  .pr-bill__row {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem;
    padding: 1rem 0; border-bottom: 2px dashed color-mix(in srgb, var(--line) 30%, transparent);
  }
  .pr-bill__row:last-child { border-bottom: 0; }
  .pr-bill__row h3 { font-size: clamp(1.1rem, 2vw, 1.3rem); margin: 0; }
  .pr-bill .pr-bill__price {
    margin: 0; padding: 0.15rem 0.75rem; font-weight: 800; font-size: 0.92rem; white-space: nowrap;
