---
import { Image } from 'astro:assets';
import V2Layout from '../../layouts/V2Layout.astro';
import Reviews from '../../components/v2/Reviews.astro';
import ReviewBadge from '../../components/v2/ReviewBadge.astro';
import K3Hero from '../../components/v2/kids/K3Hero.astro';
import ProgramFrame from '../../components/v2/kids/ProgramFrame.astro';
import GoldDivider from '../../components/v2/kids/GoldDivider.astro';
import { CONTACT } from '../../data/site';
import heroImg from '../../assets/images/kindergeburtstag/kindergeburtstag-hero.jpg';
import zaubershowImg from '../../assets/images/shows/zaubershow.jpg';
import ballonImg from '../../assets/images/shows/ballonmodellage.jpg';
import glitzerImg from '../../assets/images/shows/glitzer-tattoos.jpg';
import '../../styles/kids-v3.css';


const title = "Preise & Pakete – Kindergeburtstag ab 150 € | LIAR";
const description = 'Transparente Preise für Kindergeburtstag mit Clown Zauberer LIAR – Zaubershow ab 150€ – Ballontiere +20€ – Glitzer Tattoos +40€ – Keine versteckten Kosten!';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Clown für den Kindergeburtstag?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Zaubershow für den Kindergeburtstag kostet 150€ für 40 Minuten (bis ca. 12 Kinder). Zusätzlich buchbar: Ballonmodellage (+20€) und Glitzer Tattoos (+40€). Hinzu kommen Fahrtkosten von 0,40€ pro Kilometer (Hin- und Rückfahrt) ab Gladbeck."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es versteckte Kosten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein. Der genannte Preis enthält die komplette Show inklusive aller Materialien. Es kommen lediglich die Fahrtkosten hinzu, die vorab transparent berechnet werden."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich auch nur Ballonmodellage oder Glitzer Tattoos buchen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Ballonmodellage und Glitzer Tattoos sind als Ergänzung zur Zaubershow konzipiert. Für eigenständige Buchungen (z.B. auf Straßenfesten) kontaktieren Sie mich bitte für ein individuelles Angebot."
      }
    },
    {
      "@type": "Question",
      "name": "Wie bezahle ich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Bezahlung erfolgt in der Regel bar vor Ort am Tag der Veranstaltung. Auf Wunsch ist auch Überweisung vorab möglich."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Clown Zauberer LIAR – Kindergeburtstag",
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": {
    "@type": "State",
    "name": "Nordrhein-Westfalen"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Kindergeburtstag-Pakete",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Zaubershow",
        "price": "150",
        "priceCurrency": "EUR",
        "description": "40 Minuten interaktive Zaubershow für bis zu 12 Kinder, inkl. Material"
      },
      {
        "@type": "Offer",
        "name": "Zaubershow + Ballonmodellage",
        "price": "170",
        "priceCurrency": "EUR",
        "description": "Zaubershow plus Ballontiere für jedes Kind, ca. 55 Minuten"
      },
      {
        "@type": "Offer",
        "name": "Komplett-Paket",
        "price": "210",
        "priceCurrency": "EUR",
        "description": "Zaubershow + Ballonmodellage + Glitzer Tattoos, ca. 90 Minuten"
      }
    ]
  }
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow für Kinder in NRW. Ab 150€ – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const snaps = [
  { src: zaubershowImg, alt: 'Zaubershow für Kindergeburtstag mit Clown Zauberer LIAR', title: 'Zaubershow', text: '40 Min. interaktive Magie' },
  { src: ballonImg, alt: 'Ballonmodellage – bunte Ballontiere für Kinder', title: 'Ballonmodellage', text: 'Wunschtiere für jedes Kind' },
  { src: glitzerImg, alt: 'Glitzer Tattoos – funkelnde Motive für Kinder', title: 'Glitzer Tattoos', text: 'Hautverträglich, hält Tage' },
];

const travel = [
  ['Gladbeck, Bottrop, Dorsten', '8 – 12 €'],
  ['Oberhausen, Gelsenkirchen, Herten, Marl', '10 – 25 €'],
  ['Essen, Bochum, Recklinghausen', '15 – 30 €'],
  ['Duisburg, Dortmund, Herne', '25 – 40 €'],
  ['Düsseldorf, Münster', '40 – 60 €'],
  ['Köln, Bonn', '60 – 80 €'],
];

const onRequest = [
  '🎩 Close-up Zauberei / Tischzauberer',
  '🎭 Bühnenzauberer / Stand-up Show',
  '🤡 Clownshow',
  '🚶 Walk-Act',
  '🏫 Kindergarten / Schule (große Gruppen)',
];

const included = [
  { icon: '🎩', title: 'Komplettes Showprogramm', text: 'Zaubershow, Clownerie oder beides – individuell auf Ihr Event abgestimmt' },
  { icon: '🧳', title: 'Alle Materialien & Requisiten', text: 'Zaubertricks, Ballons, Glitzer-Utensilien – alles wird mitgebracht' },
  { icon: '📞', title: 'Persönliche Vorbesprechung', text: 'Telefonische Absprache zu Ablauf, Alter der Kinder und Ihren Wünschen' },
  { icon: '⏱️', title: 'Auf- und Abbau inklusive', text: 'Pünktliches Erscheinen, Aufbau und Abbau – Sie müssen nichts vorbereiten' },
  { icon: '🎂', title: 'Geburtstagskind im Mittelpunkt', text: 'Das Geburtstagskind wird zum Star der Show – ein unvergesslicher Moment' },
  { icon: '💰', title: 'Keine versteckten Kosten', text: 'Der vereinbarte Preis gilt – es kommen nur die transparenten Fahrtkosten hinzu' },
];

// Same questions and answers as faqSchema (one source for the visible FAQ and the schema).
const faq = faqSchema.mainEntity.map((q) => ({ q: q.name, a: q.acceptedAnswer.text }));
---

<V2Layout
  title={title}
  description={description}
  keywords="Preise Clown Zauberer, Kindergeburtstag Kosten, Zaubershow Preis, Clown buchen Kosten NRW, Kinderzauberer Preise"
  canonical="https://liar-entertainer.com/preise/"
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Preise & Pakete', url: '/preise/' }]}
  structuredData={[faqSchema, serviceSchema, videoSchema]}
>
  <!-- ── Hero: price tag first (trust before show). No reveal here (LCP). ── -->
  <K3Hero>
    <ReviewBadge />
    <h1 class="k3-hero__title" data-letters>Preise &amp; Pakete – Transparent und fair</h1>
    <p class="k3-hero__text">Bei Clown Zauberer LIAR gibt es keine versteckten Kosten. Alle Kindergeburtstag-Preise sind fest kalkuliert. Für Firmenfeiern, Stadtfeste und andere Events wird ein individuelles Angebot erstellt.</p>
    <div class="k3-hero__actions">
      <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
      <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
    </div>
    <nav class="k3-quick" aria-label="Schnell zu den Infos">
      <a href="#pakete">Pakete</a>
      <a href="#fahrtkosten">Fahrtkosten</a>
      <a href="#faq">Fragen</a>
    </nav>
    <Fragment slot="photo">
      <Image
        src={heroImg}
        alt="Preise und Pakete – Clown Zauberer LIAR für Kindergeburtstag"
        widths={[400, 700, 1000]}
        quality={70}
        sizes="(max-width: 900px) 80vw, 500px"
        loading="eager"
        fetchpriority="high"
      />
      <a class="k3-medal" href="#pakete"><span>ab</span><strong>150 €</strong></a>
    </Fragment>
  </K3Hero>

  <!-- ── Einleitungstext ───────────────────────────────────── -->
  <section class="pr-intro">
    <div class="container k3-narrow" data-reveal>
      <h2 class="k3-h2">Was kostet ein Clown Zauberer?</h2>
      <p class="k3-lead">
        Die Kosten für einen professionellen Clown Zauberer hängen von mehreren Faktoren ab: der <strong>Art der Veranstaltung</strong> (Kindergeburtstag, Firmenfeier, Stadtfest, Kita-Fest), der <strong>gewünschten Showdauer</strong>, der <strong>Anzahl der Kinder oder Gäste</strong>, den gebuchten <strong>Zusatzleistungen</strong> wie Ballonmodellage oder Glitzer Tattoos sowie der <strong>Anfahrtsentfernung</strong> ab Gladbeck. Auch spielt es eine Rolle, ob die Show drinnen oder draußen stattfindet und ob besondere Wünsche berücksichtigt werden sollen.
      </p>
      <p class="k3-soft">
        Für den <strong>Kindergeburtstag</strong> biete ich feste, transparente Paketpreise an – damit Sie von Anfang an genau wissen, was auf Sie zukommt. Diese finden Sie weiter unten auf dieser Seite.
      </p>
      <p class="k3-soft">
        Alle anderen Leistungen – ob <a href="/clown/clownshow/">Clownshow</a>, <a href="/zauberer/buehnen-zauberer/">Bühnenzauberei</a>, <a href="/zauberer/tisch-zauberer/">Tischzauberei</a>, <a href="/clown/walk-act/">Walk-Act</a> oder Auftritte bei Firmenfeiern, Stadtfesten und Schulen – laufen <strong>ausschließlich auf Anfrage</strong>. So erhalten Sie ein individuelles Angebot, das exakt zu Ihrem Event passt. Rufen Sie einfach an unter <a href={CONTACT.phoneHref}>0172-1517578</a> oder nutzen Sie das <a href="/kontakt/">Kontaktformular</a> – ich berate Sie gerne persönlich!
      </p>
    </div>
  </section>

  <Reviews />

  <!-- ── PREISLISTE — Kindergeburtstag-Pakete ──────────────── -->
  <section class="pr-packages" id="pakete">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Kindergeburtstag-Pakete</h2>
      <div class="k3-cards pr-cards">
        <article class="k3-card" data-reveal>
          <h3>🎩 Zaubershow</h3>
          <p class="k3-card__price" data-count>150 €</p>
          <ul>
            <li><span>✓</span> 40 Minuten interaktive Zaubershow</li>
            <li><span>✓</span> Bis ca. 12 Kinder, Mindestalter 4 Jahre</li>
            <li><span>✓</span> Inkl. Material</li>
            <li><span>✓</span> Das Geburtstagskind steht im Mittelpunkt</li>
            <li><span>✓</span> zzgl. Fahrtkosten (0,40€/km, Hin- &amp; Rückfahrt) ab Gladbeck</li>
          </ul>
          <p class="k3-card__note pr-dur">Gesamtdauer: ca. 40 Minuten</p>
        </article>
        <article class="k3-card" data-reveal data-reveal-delay="0.08">
          <h3>🎈 Zaubershow + Ballons</h3>
          <p class="k3-card__price" data-count>170 €</p>
          <ul>
            <li><span>✓</span> Alles aus "Zaubershow"</li>
            <li><span>✓</span> Ballonmodellage für jedes Kind</li>
            <li><span>✓</span> Große Auswahl: Hund, Schwert, Blume, Krone, Dino u.v.m.</li>
            <li><span>✓</span> zzgl. Fahrtkosten (0,40€/km, Hin- &amp; Rückfahrt) ab Gladbeck</li>
          </ul>
          <p class="k3-card__note pr-dur">Gesamtdauer: ca. 55 Minuten</p>
        </article>
        <article class="k3-card pr-popular" data-reveal data-reveal-delay="0.16">
          <span class="pr-flag">Beliebteste</span>
          <h3>✨ Komplett-Paket</h3>
          <p class="k3-card__price" data-count>210 €</p>
          <ul>
            <li><span>✓</span> Alles aus "Zaubershow + Ballons"</li>
            <li><span>✓</span> Glitzer Tattoos für jedes Kind</li>
            <li><span>✓</span> Hautverträglich, hält 4-8 Tage</li>
            <li><span>✓</span> Viele Motive: Einhörner, Schmetterlinge, Dinos, Sterne u.v.m.</li>
            <li><span>✓</span> zzgl. Fahrtkosten (0,40€/km, Hin- &amp; Rückfahrt) ab Gladbeck</li>
          </ul>
          <p class="k3-card__note pr-dur">Gesamtdauer: ca. 90 Minuten</p>
        </article>
      </div>
      <p class="k3-center k3-cta-row">
        <a href="/kontakt/" class="btn btn--primary" data-confetti>
          Jetzt unverbindlich anfragen
        </a>
      </p>
    </div>
  </section>

  <!-- ── Das erwartet Sie: three acts on the programme ── -->
  <section class="k3-alt pr-expect">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Das erwartet Sie</h2>
      <div class="k3-grid k3-grid--3 pr-snaps">
        {snaps.map((e, i) => (
          <div class="pr-snap" data-reveal data-reveal-delay={i ? String(i / 10) : undefined}>
            <ProgramFrame>
              <Image
                src={e.src}
                alt={e.alt}
                widths={[300, 450]}
                sizes="(max-width: 900px) 80vw, 300px"
                loading="lazy"
              />
            </ProgramFrame>
            <p class="pr-snap__title">{e.title}</p>
            <p class="pr-snap__text">{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Fahrtkosten (the ring: red velvet) ─────────────────── -->
  <section class="k3-band k3-band--velvet pr-travel" id="fahrtkosten">
    <div class="container k3-center">
      <GoldDivider />
      <h2 class="k3-h2">Fahrtkosten ab Gladbeck</h2>
      <p class="k3-sub pr-travel__sub">(Hin- und Rückfahrt, 0,40 €/km)</p>
      <div class="k3-table-wrap pr-table" data-reveal>
        <table class="k3-table">
          <thead>
            <tr>
              <th scope="col">Stadt / Region</th>
              <th scope="col" class="pr-num">ca. Fahrtkosten</th>
            </tr>
          </thead>
          <tbody>
            {travel.map(([city, cost]) => (
              <tr>
                <td>{city}</td>
                <td class="pr-num"><span class="k3-price">{cost}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pr-travel__note">Alle Fahrtkosten verstehen sich für Hin- und Rückfahrt (0,40 €/km). Die genauen Kosten werden bei der Buchung individuell berechnet.</p>
    </div>
  </section>

  <!-- ── Events & Firmen: one programme bill, every line "on request" ── -->
  <section class="pr-events">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Events &amp; Firmen</h2>
      <div class="k3-card pr-bill" data-reveal>
        {onRequest.map((t) => (
          <div class="pr-bill__row">
            <h3>{t}</h3>
            <p class="pr-bill__price">Preis auf Anfrage</p>
          </div>
        ))}
      </div>
      <p class="k3-center pr-events__call">
        Kontaktieren Sie mich für ein individuelles Angebot: <a href={CONTACT.phoneHref}>0172-1517578</a>
      </p>
    </div>
  </section>

  <!-- ── Was ist im Preis enthalten? (dark stage, red + blue spotlight) ── -->
  <section class="k3-band k3-band--spot pr-included">
    <span class="k3-spot k3-spot--red" aria-hidden="true"></span>
    <span class="k3-spot k3-spot--blue" aria-hidden="true"></span>
    <div class="container k3-center">
      <GoldDivider />
      <h2 class="k3-h2">Was ist im Preis enthalten?</h2>
      <p class="k3-narrow pr-included__lead">Bei Clown Zauberer LIAR ist alles dabei, was Sie für ein unvergessliches Event brauchen. Sie müssen sich um nichts kümmern – nur für gute Laune sorgen!</p>
      <ul class="pr-inc">
        {included.map((it, i) => (
          <li class="pr-inc__item" data-reveal data-reveal-delay={String((i % 2) / 10)}>
            <span class="pr-inc__icon">{it.icon}</span>
            <div>
              <p class="pr-inc__title">{it.title}</p>
              <p class="pr-inc__text">{it.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────── -->
  <section class="k3-faq" id="faq">
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Häufige Fragen zu Preisen</h2>
      <div class="k3-faq__list">
        {faq.map((item) => (
          <details class="k3-faq__item" data-reveal>
            <summary><span>{item.q}</span></summary>
            <p class="k3-faq__answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────── -->
  <section class="k3-contact pr-cta">
    <div class="container k3-narrow k3-center" data-reveal>
      <GoldDivider />
      <h2 class="k3-h2">Jetzt unverbindlich anfragen!</h2>
      <p class="k3-soft pr-cta__text">Rufen Sie an, schreiben Sie per WhatsApp oder nutzen Sie das Kontaktformular – wir melden uns innerhalb von 24 Stunden!</p>
      <div class="k3-hero__actions k3-actions--center">
        <a href={CONTACT.phoneHref} class="btn btn--primary" data-magnetic>📞 0172-1517578</a>
        <a href="/kontakt/" class="btn btn--ghost" data-confetti>Kontaktformular →</a>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  /* ── packages ── */
  .pr-cards { margin-top: var(--space-4); }
  .pr-dur { font-style: normal; font-weight: 800; color: var(--ink); margin-bottom: 0 !important; }
  /* the favourite: a velvet ribbon tag on top of the programme card */
  .pr-popular { box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.7), inset 0 0 0 5px var(--surface), inset 0 0 0 6px rgba(184, 134, 47, 0.35), 0 0 0 3px rgba(233, 200, 119, 0.35), var(--shadow-hover); }
  .pr-flag {
    position: absolute; top: -0.95rem; left: 50%; translate: -50% 0; z-index: 1;
    padding: 0.25rem 1.3rem; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: #ffe3a3; white-space: nowrap;
    background: linear-gradient(180deg, #d13a42, #a8192a); border-radius: 0.3rem;
    clip-path: polygon(0 0, 100% 0, 94% 50%, 100% 100%, 0 100%, 6% 50%);
  }

  /* ── expect: three photos on the programme ── */
  .pr-snaps { justify-items: center; }
  .pr-snap { width: min(100%, 20rem); text-align: center; }
  .pr-snap:nth-child(1) :global(.pf) { rotate: -1.5deg; }
  .pr-snap:nth-child(2) :global(.pf) { rotate: 1deg; }
  .pr-snap:nth-child(3) :global(.pf) { rotate: -0.8deg; }
  .pr-snap__title { font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; margin: var(--space-3) 0 0 !important; }
  .pr-snap__text { color: var(--ink-soft); margin: 0 !important; font-weight: 600; }

  /* ── travel (velvet ring) ── */
  .pr-table { max-width: 44rem; margin: var(--space-3) auto; text-align: left; color: var(--ink); }
  .pr-num { text-align: right !important; }
  .pr-table tbody tr:nth-child(odd) { background: rgba(233, 200, 119, 0.12); }
  .pr-travel__note { max-width: 40rem; margin-inline: auto; font-weight: 600; }
  .pr-travel .k3-sub { color: var(--gold-light); margin-top: calc(-1 * var(--space-2)); }

  /* ── events: a programme bill ── */
  .pr-bill { max-width: 46rem; margin: var(--space-4) auto var(--space-3); padding-block: var(--space-3); }
  .pr-bill:hover { transform: none; }
  .pr-bill__row {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem;
    padding: 0.9rem var(--space-2); border-bottom: 1px solid rgba(184, 134, 47, 0.3);
  }
  .pr-bill__row:last-child { border-bottom: 0; }
  .k3-card .pr-bill__row h3 { font-size: clamp(1.1rem, 2vw, 1.3rem); margin: 0; text-align: left; }
  .pr-bill .pr-bill__price {
    margin: 0; padding: 0.15rem 0.8rem; font-weight: 800; font-size: 0.9rem; white-space: nowrap;
    color: var(--accent-strong); border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.7);
  }
  .pr-events__call { font-weight: 700; }

  /* ── included (dark stage): light programme slips ── */
  .pr-included__lead { color: #f4ead6; }
  .pr-inc { list-style: none; margin: var(--space-4) auto 0; padding: 0; max-width: 54rem; display: grid; gap: var(--space-2); text-align: left; }
  @media (min-width: 901px) { .pr-inc { grid-template-columns: 1fr 1fr; gap: var(--space-3); } }
  .pr-inc__item {
    display: flex; gap: 1rem; align-items: flex-start; padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2);
    color: var(--ink); background: var(--surface); border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.55), inset 0 0 0 5px var(--surface), inset 0 0 0 6px rgba(184, 134, 47, 0.25), var(--shadow);
  }
  .pr-inc__icon {
    flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; font-size: 1.4rem; line-height: 1;
    border-radius: 50%; background: radial-gradient(circle at 35% 30%, #c3283a, var(--velvet) 72%);
    box-shadow: 0 0 0 1.5px #e9c877, 0 6px 14px -6px rgba(142, 21, 32, 0.6);
  }
  .pr-included .pr-inc__title { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; margin: 0 0 0.15rem; }
  .pr-included .pr-inc__text { margin: 0; color: var(--ink-soft); }

  /* ── cta ── */
  .pr-cta { padding-block: var(--space-5) !important; }
