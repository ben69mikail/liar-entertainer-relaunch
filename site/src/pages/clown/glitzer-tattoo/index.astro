---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import SectionEdge from '../../../components/v2/SectionEdge.astro';
import Bunting from '../../../components/v2/kids/Bunting.astro';
import Glitter from '../../../components/v2/kids/Glitter.astro';
import Squiggle from '../../../components/v2/kids/Squiggle.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import { CONTACT } from '../../../data/site';
import '../../../styles/kids-kit.css';
import { Image } from 'astro:assets';
import glitzerTattooHeroImg from '../../../assets/images/clown/glitzer-tattoo-hero.jpeg';
import glitzerTattoosImg from '../../../assets/images/clown/glitzer-tattoos.jpg';
import fotogalerieClown10Img from '../../../assets/images/galerie/fotogalerie-clown-zauberer-10.jpg';

const seoTitle = 'Glitzer Tattoos Kindergeburtstag | NRW | Ab 40€ mit Zaubershow';
const seoDescription = 'Glitzer Tattoos NRW ✓ Hautverträglich & langanhaltend ✓ Über 100 Motive für Kindergeburtstage & Events ✓ 4-8 Tage Funkelspaß ✓ Jetzt anfragen!';

const vorteile = [
  { title: 'Kein Schmieren', text: 'Im Gegensatz zu Kinderschminken bleibt alles sauber' },
  { title: 'Lange Haltbarkeit', text: '4-8 Tage Funkelspaß (wasser- und wischfest)' },
  { title: 'Für jeden geeignet', text: 'Auch für empfindliche Kinderhaut' },
  { title: 'Schnell fertig', text: 'In 2-3 Minuten ist das Tattoo aufgetragen' },
  { title: 'Sieht immer toll aus', text: 'Jedes Motiv gelingt perfekt' },
  { title: 'Leicht entfernbar', text: 'Mit etwas Babyöl rückstandslos entfernbar' },
];

const motive = [
  {
    title: '👧 Beliebte Mädchen-Motive',
    items: ['🦄 Einhorn', '🦋 Schmetterling', '🌸 Blumen', '👸 Krone', '✨ Sterne', '🌈 Regenbogen', '💖 Herz', '🧚 Fee', '🐱 Katze'],
  },
  {
    title: '👦 Beliebte Jungs-Motive',
    items: ['🦖 Dinosaurier', '⚽ Fußball', '🚗 Auto', '🏴‍☠️ Pirat', '🦈 Hai', '🚀 Rakete', '⚡ Blitz', '🦁 Löwe'],
  },
  {
    title: '🎃 Saisonale Motive',
    items: ['🎃 Halloween (Kürbis, Fledermaus, Geist)', '🎄 Weihnachten (Schneeflocke, Rentier)', '🐰 Ostern (Hase, Ei, Küken)', '⚽ Fußball-EM/WM (Flaggen, Pokale)'],
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Glitzer Tattoos in NRW – Clown Zauberer LIAR",
  "description": "Glitzer Tattoos mit Clown LIAR in NRW – hautverträgliche, funkelnde Klebe-Tattoos mit über 100 Motiven für Kindergeburtstage, Kita- und Schulfeste, Straßenfeste und Events. In 2 bis 3 Minuten aufgetragen, 4 bis 8 Tage wasser- und wischfest.",
  "url": "https://liar-entertainer.com/clown/glitzer-tattoo/",
  "serviceType": ["Glitzer Tattoo", "Glitzer Tattoos Kindergeburtstag", "Kinderschminken Alternative"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Was sind Glitzer Tattoos?', acceptedAnswer: { '@type': 'Answer', text: 'Glitzer Tattoos sind temporäre, hautverträgliche Klebe-Tattoos, die mit einem hautfreundlichen Spezialkleber und funkelndem Glitzer aufgetragen werden. Bei Clown LIAR entstehen sie in 2 bis 3 Minuten und lassen Kinderaugen strahlen – der saubere Klassiker als Alternative zum Kinderschminken.' } },
    { '@type': 'Question', name: 'Wie lange halten Glitzer Tattoos?', acceptedAnswer: { '@type': 'Answer', text: 'Glitzer Tattoos halten 4 bis 8 Tage. Sie sind wasser- und wischfest, schmieren nicht und lassen sich am Ende mit etwas Babyöl rückstandslos wieder entfernen.' } },
    { '@type': 'Question', name: 'Für welche Anlässe und welches Alter eignen sich Glitzer Tattoos?', acceptedAnswer: { '@type': 'Answer', text: 'Glitzer Tattoos passen zu Kindergeburtstagen, Kita- und Schulfesten, Straßenfesten und Events – für Jungs und Mädchen ab etwa 3 Jahren. Über 100 Motive vom Einhorn bis zum Dino stehen zur Auswahl, ideal als Ergänzung zur Clownshow oder Ballonmodellage.' } },
    { '@type': 'Question', name: 'Sind Glitzer Tattoos hautverträglich?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Es kommen hautverträgliche, dermatologisch getestete Materialien zum Einsatz, die auch für empfindliche Kinderhaut geeignet sind. Im Gegensatz zum Kinderschminken bleibt alles sauber und schmiert nicht.' } },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR mit Glitzer Tattoos, Zaubershow und Comedy in NRW – funkelnde Klebe-Tattoos für Kindergeburtstage und Events.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];
---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Glitzer Tattoo Kindergeburtstag, Glitzer Tattoos NRW, Glitzer Tattoo buchen, Kinderschminken Alternative"
  canonical="https://liar-entertainer.com/clown/glitzer-tattoo/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Clown', url: '/clown/clownshow/' }, { name: 'Glitzer Tattoo', url: '/clown/glitzer-tattoo/' }]}
>
  <!-- ── Hero. No reveal here (LCP). ── -->
  <section class="kg-hero">
    <canvas class="kg-rays" aria-hidden="true" data-side-rays='{"rayColor1":"#ffb546","rayColor2":"#ff8a3d","origin":"top-right","speed":1.6,"intensity":2,"spread":1.4,"saturation":1.5,"blend":0.4,"falloff":1.3,"opacity":0.9}'></canvas>
    <Bunting />
    <div class="container kg-hero__grid">
      <div class="kg-hero__copy">
        <p class="gt-crumbs">
          <a href="/">Clown</a> »
          <a href="/">Clown Zauberer LIAR</a> »
          <span>Glitzer Tattoo</span>
        </p>
        <ReviewBadge />
        <h1 class="kg-hero__title" data-letters>Glitzer <span class="kg-mark">Tattoo</span></h1>
        <h2 class="gt-hero__sub">
          ✨ Glitzer Tattoos für Kindergeburtstag<br />&amp; Events in NRW
        </h2>
        <p class="gt-hero__claim">Der Klassiker für Kindergeburtstage – Hautverträglich &amp; Langanhaltend</p>
        <div class="kg-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
      </div>
      <figure class="kg-hero__photo">
        <Image
          src={glitzerTattooHeroImg}
          alt="Glitzer Tattoos für Kindergeburtstag & Events in NRW"
          widths={[400, 700, 1000, 1400]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
          style="object-position: 50% 0%"
        />
        <Glitter />
      </figure>
    </div>
  </section>

  <!-- ── Intro / Highlights ── -->
  <section class="kg-intro">
    <div class="container kg-intro__grid">
      <div class="kg-intro__text" data-reveal>
        <p class="kg-lead">
          Glitzer Tattoos bei Clown LIAR (Michaël Prescler) sind funkelnde, hautverträgliche Klebe-Tattoos, die in 2–3 Minuten aufgetragen werden und 4–8 Tage wasser- und wischfest halten. Über 100 Motive – vom Einhorn bis zum Dino. Buchbar in ganz NRW für <a href="/kindergeburtstag/">Kindergeburtstage</a>, Kita- und Schulfeste, Straßenfeste und Events – ideal als Ergänzung zur <a href="/clown/clownshow/">Clownshow</a> oder <a href="/clown/ballonmodellage/">Ballonmodellage</a>.
        </p>
        <ul class="gt-highlights">
          <li><span class="gt-highlights__icon">✨</span><span>Hautverträglich &amp; dermatologisch getestet</span></li>
          <li><span class="gt-highlights__icon">🎨</span><span>Über 100 verschiedene tolle Motive</span></li>
          <li><span class="gt-highlights__icon">⚡</span><span>Schnell &amp; sauber (2–3 Min. pro Tattoo)</span></li>
          <li><span class="gt-highlights__icon">💧</span><span>Wasserfest &amp; wischfest (hält 4–8 Tage)</span></li>
          <li><span class="gt-highlights__icon">👦👧</span><span>Für Jungs &amp; Mädchen (3–12 Jahre)</span></li>
          <li><span class="gt-highlights__icon">📍</span><span>In ganz NRW buchbar</span></li>
        </ul>
      </div>
      <figure class="gt-portrait" data-reveal="pop" data-reveal-delay="0.1">
        <Image
          src={glitzerTattoosImg}
          alt="Glitzer Tattoos für Kindergeburtstag & Events in NRW"
          data-scroll-tilt="3"
          widths={[340, 680]}
          sizes="340px"
          loading="lazy"
        />
        <Glitter />
      </figure>
    </div>
  </section>

  <!-- ── Weitere Anlässe (SEO-Audit 06.08.2026, H6: internal links to /clown/karneval/ + /clown/walk-act/) ── -->
  <section class="gt-related" data-related-services>
    <div class="container kg-narrow">
      <h2 class="kg-h2 kg-center" data-reveal>
        Für welche Anlässe kann man Clown LIAR sonst buchen?
      </h2>
      <div class="gt-related__grid">
        <a href="/clown/karneval/" class="gt-related__card" data-reveal="pop">
          <p class="gt-related__title">Clown für Karneval &amp; Kindersitzung</p>
          <p class="gt-related__text">Jecke Zaubershow für Kindersitzung, Karnevalsfeier und Rosenmontagsparty in NRW.</p>
        </a>
        <a href="/clown/walk-act/" class="gt-related__card" data-reveal="pop" data-reveal-delay="0.1">
          <p class="gt-related__title">Walk-Act für Straßen- und Stadtfest</p>
          <p class="gt-related__text">Clown Zauberer LIAR mitten im Publikum – Ballonfiguren und Magie zum Anfassen.</p>
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Was sind Glitzer Tattoos? ── -->
  <section class="gt-what">
    <div class="container">
      <Squiggle color="var(--brand-blue)" />
      <h2 class="kg-h2 kg-center" data-reveal>Was sind Glitzer Tattoos?</h2>
      <div class="kg-intro__grid gt-what__grid">
        <div data-reveal>
          <p class="gt-what__text">
            Glitzer Tattoos sind temporäre Körperkunst, die mit hautfreundlichem Spezialkleber und funkelndem Glitzer aufgetragen werden. Sie sind der absolute Hit auf jedem Kindergeburtstag, Straßenfest oder Event! Besonders beliebt als Ergänzung zu meiner <a href="/clown/clownshow/">Clownshow</a> oder in Kombination mit <a href="/clown/ballonmodellage/">Ballonmodellage</a>.
          </p>
          <h3 class="kg-h3">Warum Glitzer Tattoos so beliebt sind:</h3>
          <ul class="gt-pros">
            {vorteile.map((v) => (
              <li>
                <span class="gt-pros__tick">✅</span>
                <p><strong>{v.title}</strong> – {v.text}</p>
              </li>
            ))}
          </ul>
        </div>
        <figure class="gt-portrait gt-portrait--tilt" data-reveal="pop">
          <Image
            src={fotogalerieClown10Img}
            alt="Glitzer Tattoo bei Clown LIAR"
            data-scroll-tilt="3"
            widths={[340, 680]}
            sizes="340px"
            loading="lazy"
          />
          <Glitter />
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Video (yellow band) ── -->
  <section class="kg-band kg-band--yellow">
    <SectionEdge color="var(--brand-yellow)" side="top" />
    <SectionEdge color="var(--brand-yellow)" side="bottom" />
    <div class="container kg-narrow kg-center">
      <h2 class="kg-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="kg-video" data-reveal="pop">
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
      </div>
      <h3 class="kg-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">Zur Foto- und Videogalerie</a>
    </div>
  </section>

  <!-- ── Motive: sticker sheets ── -->
  <section class="gt-motifs">
    <div class="container">
      <h2 class="kg-h2 kg-center" data-reveal>🎨 Unsere Glitzer Tattoo Motive</h2>
      <p class="kg-center kg-sub">Unsere Motivauswahl ist riesig! Jedes Kind darf sich sein Lieblingsmotiv aussuchen.</p>
      <div class="gt-motifs__grid">
        {motive.map((cat, i) => (
          <article class="gt-sheet" data-reveal="tilt" data-reveal-delay={i * 0.08}>
            <h3>{cat.title}</h3>
            <div class="gt-sheet__pills">
              {cat.items.map((item) => (
                <span class="gt-pill">{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p class="kg-center kg-tip gt-tip" data-reveal>💡 <strong>Tipp:</strong> Sie haben ein spezielles Motto (z.B. Prinzessinnen-Party, Dino-Geburtstag)? Ich bringe passende Motive mit!</p>
    </div>
  </section>

  <!-- ── Vergleich (blue band) ── -->
  <section class="kg-band kg-band--blue gt-vs">
    <SectionEdge color="var(--brand-blue)" side="top" />
    <SectionEdge color="var(--brand-blue)" side="bottom" />
    <div class="container">
      <h2 class="kg-h2">Glitzer Tattoos vs. Kinderschminken</h2>
      <p class="gt-vs__sub">Warum Glitzer Tattoos besser sind als Kinderschminken</p>
      <div class="kg-table-wrap gt-vs__table" data-reveal="pop">
        <table class="kg-table">
          <thead>
            <tr>
              <th scope="col">Kriterium</th>
              <th scope="col" class="gt-vs__win">Glitzer Tattoos ✨</th>
              <th scope="col">Kinderschminken</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Haltbarkeit', '4–8 Tage', 'Wenige Stunden'],
              ['Wischfest', '✅ Ja', '❌ Nein'],
              ['Wasserfest', '✅ Ja', '❌ Nein'],
              ['Schnelligkeit', '2–3 Min.', '5–10 Min.'],
              ['Schmiert nicht', '✅', '❌ Schmiert oft'],
              ['Für sensible Haut', '✅', '⚠️ Manchmal problematisch'],
              ['Entfernung', 'Einfach mit Öl', 'Abwaschen'],
            ].map(([k, g, s]) => (
              <tr>
                <th scope="row">{k}</th>
                <td class="gt-vs__win">{g}</td>
                <td>{s}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="gt-cta">
    <div class="container kg-narrow kg-center" data-reveal>
      <h2 class="kg-h2">Jetzt Glitzer Tattoos buchen!</h2>
      <p>
        Perfekt für Kindergeburtstag, Straßenfest oder Event – ab 3 Jahren funkeln Kinderaugen mit tollen Glitzer-Motiven! Kombinieren Sie Glitzer Tattoos mit meiner <a href="/clown/clownshow/">Clownshow</a> und <a href="/clown/ballonmodellage/">Ballonmodellage</a> zum kompletten Kinderpaket.
      </p>
      <div class="gt-cta__contact">
        <p>📱 Telefon &amp; WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
      </div>
      <a href="/kontakt/" class="btn btn--primary" data-confetti>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero ── */
  .gt-crumbs { font-size: 0.88rem; font-weight: 700; color: var(--ink-soft); margin-bottom: var(--space-2); }
  .gt-crumbs a { color: inherit; }
  .gt-hero__sub { font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 650; color: var(--brand-blue); margin: 0 0 0.5rem; }
  .gt-hero__claim { font-weight: 800; margin-bottom: var(--space-3); }

  /* ── intro ── */
  .gt-highlights { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .gt-highlights li {
    display: flex; gap: 0.6rem; align-items: center; padding: 0.6rem 0.85rem;
    font-weight: 700; background: var(--bg); border: 2px solid var(--line); border-radius: var(--radius-sm);
    box-shadow: 3px 3px 0 var(--line);
  }
  .gt-highlights__icon { flex: none; font-size: 1.2rem; }
  .gt-portrait { position: relative; margin: 0; justify-self: center; rotate: 2deg; }
  .gt-portrait--tilt { rotate: -2.5deg; }
  .gt-portrait :global(img) {
    display: block; width: min(21.25rem, 80vw); height: auto; aspect-ratio: 1; object-fit: cover;
    border: 5px solid var(--line); border-radius: var(--radius); box-shadow: 8px 8px 0 var(--line);
  }

  /* ── related ── */
  .gt-related { background: var(--bg); }
  .gt-related__grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .gt-related__card {
    display: block; padding: var(--space-3); color: var(--ink); text-decoration: none;
    background: var(--surface); border: var(--border); border-radius: var(--radius); box-shadow: var(--shadow);
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s var(--ease-out);
  }
  .gt-related__card:nth-child(1) { rotate: -1deg; }
  .gt-related__card:nth-child(2) { rotate: 1deg; }
  .gt-related__card .gt-related__title { font-family: var(--font-display); font-weight: 650; font-size: 1.2rem; margin-bottom: 0.3rem; }
  .gt-related__card .gt-related__text { color: var(--ink-soft); font-size: 0.95rem; margin: 0; }
  @media (hover: hover) and (pointer: fine) {
    .gt-related__card:hover { transform: translate(-3px, -5px); box-shadow: var(--shadow-hover); }
  }

  /* ── was sind ── */
  .gt-what { background: var(--surface); border-block: var(--border); }
  .gt-what__grid { margin-top: var(--space-3); align-items: center; }
  .gt-what__text { color: var(--ink-soft); }
  .gt-pros { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .gt-pros li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .gt-pros__tick { flex: none; }
  .gt-pros li p { margin: 0; color: var(--ink-soft); }
  .gt-pros strong { color: var(--ink); }

  /* ── motive: each category is a sticker sheet, motifs are peel-off stickers ── */
  .gt-motifs__grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); margin-top: var(--space-4); }
  .gt-sheet {
    padding: var(--space-3); background: var(--surface); border: var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow); transition: rotate 0.25s var(--ease-out);
  }
  .gt-sheet:nth-child(1) { rotate: -1.2deg; }
  .gt-sheet:nth-child(2) { rotate: 0.8deg; }
  .gt-sheet:nth-child(3) { rotate: -0.5deg; }
  .gt-sheet h3 { font-size: 1.35rem; margin: 0 0 var(--space-2); }
  .gt-sheet__pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gt-pill {
    position: relative; overflow: hidden; display: inline-block; padding: 0.35rem 0.85rem;
    font-weight: 700; font-size: 0.95rem; background: var(--bg); border: 2px solid var(--line); border-radius: 999px;
    transition: transform 0.25s var(--ease-out-expo), background-color 0.2s;
  }
  /* a glint sweeps across a sticker on hover */
  .gt-pill::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.85) 50%, transparent 70%);
    translate: -120% 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .gt-sheet:hover { rotate: 0deg; }
    .gt-pill:hover { transform: translateY(-2px) rotate(-3deg); background: color-mix(in srgb, var(--brand-yellow) 40%, var(--bg)); }
    .gt-pill:hover::after { translate: 120% 0; transition: translate 0.6s var(--ease-out); }
  }
  .gt-tip { max-width: 46rem; margin-inline: auto; padding: var(--space-2) var(--space-3); background: var(--surface); border: 2px dashed var(--line); border-radius: var(--radius); }

  /* ── vergleich (blue band): the table keeps ink text ── */
  .gt-vs__sub { font-family: var(--font-display); font-size: 1.25rem; }
  .gt-vs__table { color: var(--ink); text-align: left; margin-top: var(--space-3); margin-bottom: 0; rotate: -0.5deg; }
  .gt-vs__table td { text-align: center; }
  .gt-vs__table thead th:not(:first-child) { text-align: center; }
  .gt-vs__table .gt-vs__win { font-weight: 800; color: var(--accent-strong); background: color-mix(in srgb, var(--brand-yellow) 18%, transparent); }
  .gt-vs__table thead .gt-vs__win { background: var(--accent-strong); color: #fff; }

  /* ── cta ── */
  .gt-cta { background: var(--bg); }
  .gt-cta p { color: var(--ink-soft); }
  .gt-cta__contact { margin: var(--space-3) 0; font-weight: 700; }
</style>
