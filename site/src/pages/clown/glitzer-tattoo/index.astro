  mainEntity: [
    { '@type': 'Question', name: 'Was sind Glitzer Tattoos?', acceptedAnswer: { '@type': 'Answer', text: 'Glitzer Tattoos sind temporäre, hautverträgliche Klebe-Tattoos, die mit einem hautfreundlichen Spezialkleber und funkelndem Glitzer aufgetragen werden. Bei Clown LIAR entstehen sie in 2 bis 3 Minuten und lassen Kinderaugen strahlen – der saubere Klassiker als Alternative zum Kinderschminken.' } },
