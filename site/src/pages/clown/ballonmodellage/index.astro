---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import SectionEdge from '../../../components/v2/SectionEdge.astro';
import Bunting from '../../../components/v2/kids/Bunting.astro';
import BalloonDog from '../../../components/v2/kids/BalloonDog.astro';
import Squiggle from '../../../components/v2/kids/Squiggle.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import { CONTACT } from '../../../data/site';
import '../../../styles/kids-kit.css';
import { Image } from 'astro:assets';
import ballonmodellage1Img from '../../../assets/images/clown/ballonmodellage-1.jpg';
import ballonmodellage2Img from '../../../assets/images/clown/ballonmodellage-2.jpg';
import zaubershowMitClownImg from '../../../assets/images/clown/zaubershow-mit-clown-zauberer.jpg';
import zaubervorfuehrungWeihnachtsmarktImg from '../../../assets/images/clown/zaubervorfuehrung-weihnachtsmarkt-dortmund.jpg';
import kostenPreisClownImg from '../../../assets/images/clown/kosten-preis-clown-nrw.jpg';
import clownZaubererGladbeckImg from '../../../assets/images/clown/clown-zauberer-gladbeck.jpg';

const seoTitle = "Ballonkünstler NRW buchen – Ballonmodellage für Kinder";
const seoDescription = 'Ballonmodellage NRW ✓ Ballonkünstler LIAR – bunte Ballonfiguren für Kindergeburtstage, Stadtfeste & Events ✓ Individuelle Wunschfiguren ✓ Jetzt anfragen!';

const anlaesse = [
  'Kindergeburtstage (absolute Bestseller!)',
  'Straßenfeste & Sommerfeste',
  'Firmenfeiern mit Kinderbereich',
  'Kita- & Schulfeste',
  'Weihnachtsmärkte',
  'Store-Openings & Eröffnungen',
  'Hochzeiten mit Kindern',
  'Kommunion & Konfirmation',
  'Vereinsfeste',
  'Jedes Event mit Kindern!',
];

const figuren = [
  {
    title: '🐾 Klassische Ballontiere',
    items: ['🐕 Hunde – Der absolute Klassiker!', '🐈 Katzen – Mit Schwanz und Ohren', '🐰 Hasen – Besonders beliebt zu Ostern', '🦒 Giraffen – Mit langem Hals', '🐘 Elefanten – Mit Rüssel', '🐞 Marienkäfer – Mein persönlicher Favorit!'],
  },
  {
    title: '⚔️ Für Jungs beliebt',
    items: ['⚔️ Schwerter – Zum Fechten und Spielen', '🗡️ Säbel – Für kleine Piraten', '👑 Wikinger Helm – Für Starke!', '🏹 Springende Maus – Für Bogenschützen'],
  },
  {
    title: '🌸 Für Mädchen beliebt',
    items: ['🌸 Blumen – In verschiedenen Farben', '💕 Herzen – Süß und romantisch', '👑 Kronen – Für kleine Prinzessinnen', '🦋 Schmetterlinge – Farbenfroh und elegant'],
  },
  {
    title: '🎩 Komplexe Figuren',
    items: ['🎩 Hüte – Tragbare Ballonhüte', '✈️ Flugzeuge – Für kleine Piloten', '🐉 Fantasy-Figuren – Drachen, Dinosaurier'],
  },
];

const einsatzgebiet = [
  { region: 'Ruhrgebiet', cities: 'Essen, Duisburg, Oberhausen, Gelsenkirchen, Bochum, Dortmund, Bottrop, Mülheim, Herne, Herten, Gladbeck, Marl, Dorsten, Recklinghausen, Castrop-Rauxel' },
  { region: 'Rheinland', cities: 'Düsseldorf, Köln, Krefeld, Mönchengladbach, Neuss, Leverkusen, Bonn, Bergisch Gladbach' },
  { region: 'Münsterland & Westfalen', cities: 'Münster, Coesfeld, Borken, Ahaus, Reken, Lünen, Hamm, Unna' },
];
const _pageGallery = [
  { src: zaubershowMitClownImg, alt: 'Auftritt Zaubershow mit Clown Zauberer' },
  { src: zaubervorfuehrungWeihnachtsmarktImg, alt: 'Zaubervorführung auf dem Weihnachtsmarkt' },
  { src: kostenPreisClownImg, alt: 'Kosten Preis Clown NRW' },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Ballonmodellage in NRW – Ballonkünstler Clown Zauberer LIAR",
  "description": "Ballonmodellage mit Ballonkünstler LIAR in NRW – individuelle Ballonfiguren (Ballontiere, Schwerter, Blumen, Kronen) für Kindergeburtstage, Kita- und Schulfeste, Straßenfeste und Firmenfeiern mit Kindern. Jede Wunschfigur in 2 bis 5 Minuten geformt.",
  "url": "https://liar-entertainer.com/clown/ballonmodellage/",
  "serviceType": ["Ballonmodellage", "Ballonkünstler", "Ballonfiguren Kindergeburtstag"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Was ist Ballonmodellage?', acceptedAnswer: { '@type': 'Answer', text: 'Ballonmodellage (auch Ballonkunst oder Balloon Twisting) ist die Kunst, aus langen Modellierballons in 2 bis 5 Minuten fantasievolle Figuren zu formen. Ballonkünstler LIAR gestaltet vor den Augen der Kinder Ballontiere, Schwerter, Blumen und mehr – jede Figur hält mehrere Tage.' } },
    { '@type': 'Question', name: 'Welche Ballonfiguren sind möglich?', acceptedAnswer: { '@type': 'Answer', text: 'Möglich sind klassische Ballontiere (Hund, Katze, Hase, Giraffe, Elefant, Marienkäfer), Schwerter und Säbel, Blumen, Herzen und Kronen sowie komplexe Fantasie-Figuren wie Drachen oder Flugzeuge. Jedes Kind bekommt seine individuelle Wunschfigur.' } },
    { '@type': 'Question', name: 'Für welche Anlässe eignet sich Ballonmodellage?', acceptedAnswer: { '@type': 'Answer', text: 'Ballonmodellage passt zu Kindergeburtstagen, Kita- und Schulfesten, Straßen- und Sommerfesten, Firmenfeiern mit Kinderbereich, Weihnachtsmärkten und jedem Event mit Kindern – als eigenständiges Angebot oder in Kombination mit Clownshow und Glitzer-Tattoos.' } },
    { '@type': 'Question', name: 'In welchen Städten ist der Ballonkünstler buchbar?', acceptedAnswer: { '@type': 'Answer', text: 'Ballonkünstler LIAR ist in ganz NRW unterwegs – im Ruhrgebiet (u. a. Essen, Duisburg, Gelsenkirchen, Bochum, Dortmund, Gladbeck), im Rheinland (Düsseldorf, Köln, Krefeld) sowie im Münsterland. Für besondere Events auch überregional buchbar.' } },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR mit Ballonmodellage, Zaubershow und Comedy in NRW – bunte Ballonfiguren für Kindergeburtstage und Events.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];

---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Ballonmodellage NRW, Ballonkünstler buchen, Ballontiere Kindergeburtstag, Ballonfiguren Event, Ballonmodellage Ruhrgebiet"
  canonical="https://liar-entertainer.com/clown/ballonmodellage/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Clown', url: '/clown/clownshow/' }, { name: 'Ballonmodellage', url: '/clown/ballonmodellage/' }]}
>
  <!-- ── Hero. No reveal here (LCP). ── -->
  <section class="kg-hero">
    <canvas class="kg-rays" aria-hidden="true" data-side-rays='{"rayColor1":"#ffb546","rayColor2":"#ff8a3d","origin":"top-right","speed":1.6,"intensity":2,"spread":1.4,"saturation":1.5,"blend":0.4,"falloff":1.3,"opacity":0.9}'></canvas>
    <Bunting />
    <div class="container kg-hero__grid">
      <div class="kg-hero__copy">
        <p class="bm-crumbs">
          <a href="/">Clown</a> »
          <a href="/">Clown Zauberer LIAR</a> »
          <span>Ballonmodellage</span>
        </p>
        <ReviewBadge />
        <h1 class="kg-hero__title" data-letters>Ballonmodellage in NRW – <span class="kg-mark">Ballonkünstler</span> für Kinder</h1>
        <h2 class="bm-hero__sub">
          🎈 Bunte Ballonfiguren,<br />die Kinderaugen zum Leuchten bringen
        </h2>
        <p class="bm-hero__claim">Individuelle Wunschfiguren für jedes Kind!</p>
        <div class="kg-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
      </div>
      <figure class="kg-hero__photo">
        <Image
          src={ballonmodellage1Img}
          alt="Ballonmodellage NRW – Bunte Ballonfiguren für Kinder"
          widths={[400, 700, 1000, 1400]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
          style="object-position: 48% 51%"
        />
        <span class="bm-knot" aria-hidden="true">🎈</span>
      </figure>
    </div>
  </section>

  <!-- ── Intro ── -->
  <section class="kg-intro">
    <div class="container kg-intro__grid">
      <div class="kg-intro__text" data-reveal>
        <p class="kg-lead">
          Ballonmodellage bei Clown LIAR (Michaël Prescler) bedeutet: Aus langen Modellierballons entstehen in 2–5 Minuten individuelle Wunschfiguren – Hunde, Schwerter, Blumen, Kronen und mehr. Buchbar in ganz NRW für Kindergeburtstage, Kita- und Schulfeste, Straßenfeste und Firmenfeiern mit Kindern. Jedes Kind bekommt seine eigene Figur, die mehrere Tage hält.
        </p>
        <p>
          Als Ballonkünstler forme ich seit über 15 Jahren fantasievolle Ballonfiguren für Kindergeburtstage, Kinderfeste, Straßenfeste und Events in ganz Nordrhein-Westfalen. Ob Ballontiere, Schwerter, Blumen oder komplexe Kreationen – vor den Augen der Kinder entstehen in wenigen Minuten bunte Kunstwerke aus Luftballons!
        </p>
        <p>
          Das Besondere: Jedes Kind bekommt seine individuelle Wunschfigur! Ob der Junge ein Schwert zum Fechten möchte, das Mädchen eine Blume für Mama oder beide einen Hund, eine Giraffe oder einen Marienkäfer – ich erfülle Ballonwünsche und sorge für strahlende Gesichter.
        </p>
        <p>
          Ballonmodellage ist perfekt für Kindergeburtstage, Straßenfeste, Firmenfeiern mit Kindern, Kita-Feste, Schulveranstaltungen und alle Events, bei denen Kinder dabei sind. Kombinieren Sie die Ballonkunst mit meiner <a href="/clown/clownshow/">Clownshow</a> oder ergänzen Sie das Programm um <a href="/clown/glitzer-tattoo/">Glitzer Tattoos</a> für ein rundum gelungenes Kinderfest!
        </p>
        <a href="/kindergeburtstag/" class="btn btn--primary">
          🎂 Kindergeburtstag – Preise
        </a>
      </div>
      <figure class="bm-portrait" data-reveal="pop" data-reveal-delay="0.1">
        <Image
          src={ballonmodellage2Img}
          alt="Herzballon für ein Kind bei Ballonmodellage"
          data-scroll-tilt="3"
          widths={[340, 680]}
          sizes="340px"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- ── Weitere Anlässe (SEO-Audit 06.08.2026, H6: internal links to /clown/karneval/ + /clown/walk-act/) ── -->
  <section class="bm-related" data-related-services>
    <div class="container kg-narrow">
      <h2 class="kg-h2 kg-center" data-reveal>
        Für welche Anlässe kann man Clown LIAR sonst buchen?
      </h2>
      <div class="bm-related__grid">
        <a href="/clown/karneval/" class="bm-related__card" data-reveal="pop">
          <p class="bm-related__title">Clown für Karneval &amp; Kindersitzung</p>
          <p class="bm-related__text">Jecke Zaubershow für Kindersitzung, Karnevalsfeier und Rosenmontagsparty in NRW.</p>
        </a>
        <a href="/clown/walk-act/" class="bm-related__card" data-reveal="pop" data-reveal-delay="0.1">
          <p class="bm-related__title">Walk-Act für Straßen- und Stadtfest</p>
          <p class="bm-related__text">Clown Zauberer LIAR mitten im Publikum – Ballonfiguren und Magie zum Anfassen.</p>
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Was ist Ballonmodellage? ── -->
  <section class="bm-what">
    <div class="container">
      <Squiggle color="var(--brand-blue)" />
      <h2 class="kg-h2 kg-center" data-reveal>🎈 Was ist Ballonmodellage?</h2>
      <p class="kg-center kg-sub">Ballonmodellage – Die Kunst der Ballonfiguren</p>
      <div class="kg-cards bm-what__cards">
        <article class="kg-card kg-card--red" data-reveal="pop">
          <h3>Wie funktioniert es?</h3>
          <p>
            Ballonmodellage (auch Ballonkunst oder Balloon Twisting genannt) ist die Kunst, aus langen Modellierballons fantasievolle Figuren zu formen. Mit gezielten Drehungen, Knicken und Kombinationen entstehen innerhalb von 2–5 Minuten beeindruckende Kreationen.
          </p>
          <p class="kg-card__note">Ich verwende spezielle Modellierballons, die sich perfekt formen lassen.</p>
        </article>
        <article class="kg-card kg-card--blue" data-reveal="pop" data-reveal-delay="0.1">
          <h3>Die Technik erfordert:</h3>
          <ul>
            <li><span>✓</span> Geschick und Übung</li>
            <li><span>✓</span> Schnelligkeit (damit Kinder nicht warten)</li>
            <li><span>✓</span> Kreativität für individuelle Wünsche</li>
            <li><span>✓</span> Geduld mit den kleinen Künstlern</li>
          </ul>
        </article>
        <article class="kg-card kg-card--yellow bm-what__good" data-reveal="pop" data-reveal-delay="0.2">
          <h3>Was macht gute Ballonmodellage aus?</h3>
          <ul>
            <li><strong>Schnelligkeit</strong> – Pro Figur nur 1–2 Min.</li>
            <li><strong>Vielfalt</strong> – Von Tieren bis Fantasiekreationen</li>
            <li><strong>Individualität</strong> – Jedes Kind bekommt seine Wunschfigur</li>
            <li><strong>Haltbarkeit</strong> – Die Figuren halten mehrere Tage!</li>
          </ul>
        </article>
      </div>

      <div class="bm-occasions">
        <h3 class="kg-h3 kg-center" data-reveal>Für welche Anlässe eignet sich Ballonmodellage?</h3>
        <ul class="bm-chips" data-reveal>
          {anlaesse.map((a) => (
            <li><span class="bm-chips__tick">✓</span><span>{a}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Beliebte Ballonfiguren: the balloon dog inflates in the classics card ── -->
  <section class="bm-figures">
    <div class="container">
      <h2 class="kg-h2 kg-center" data-reveal>🐾 Beliebte Ballonfiguren</h2>
      <p class="kg-center kg-sub">Das Ballonrepertoire – Von Hund bis Marienkäfer</p>
      <div class="bm-figures__grid">
        {figuren.map((cat, i) => (
          <article class="bm-fig" data-reveal="tilt" data-reveal-delay={i * 0.08}>
            {i === 0 && <BalloonDog />}
            <h3>{cat.title}</h3>
            <ul>
              {cat.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Kombinationsmöglichkeiten (blue band) ── -->
  <section class="kg-band kg-band--blue bm-combo">
    <SectionEdge color="var(--brand-blue)" side="top" />
    <SectionEdge color="var(--brand-blue)" side="bottom" />
    <div class="container">
      <h2 class="kg-h2">🎪 Kombinationsmöglichkeiten</h2>
      <p class="bm-combo__sub">Ballonmodellage perfekt kombinieren</p>
      <div class="bm-combo__grid">
        <article class="bm-combo__card" data-reveal="pop">
          <h3>🎩 Ballonmodellage + Show</h3>
          <p class="bm-combo__lead">Die perfekte Kombi für Kindergeburtstage!</p>
          <ul>
            <li><span>✓</span> 40 Min. Clown-<a href="/zauberer/zaubershow/">Zaubershow</a></li>
            <li><span>✓</span> Anschließend Ballonmodellage</li>
            <li><span>✓</span> Komplettes Programm, Kinder durchgehend beschäftigt</li>
            <li><span>✓</span> Tolle Erinnerung zum Mitnehmen</li>
          </ul>
        </article>
        <article class="bm-combo__card" data-reveal="pop" data-reveal-delay="0.1">
          <h3>🚶 Ballonmodellage + Walk-Act</h3>
          <p class="bm-combo__lead">Für große Feste ideal!</p>
          <ul>
            <li><span>✓</span> Ich bewege mich als Clown über das Fest</li>
            <li><span>✓</span> Spontane Gags und Zaubertricks</li>
            <li><span>✓</span> Forme zwischendurch Ballonfiguren</li>
            <li><span>✓</span> Sehr flexibel, belebt das gesamte Fest</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Zahlen: three balloon stickers ── -->
  <section class="bm-stats">
    <div class="container bm-stats__grid">
      <div class="bm-stat" data-reveal="pop">
        <p class="bm-stat__num" data-count>400</p>
        <p class="bm-stat__label">Shows im Jahr</p>
      </div>
      <div class="bm-stat bm-stat--blue" data-reveal="pop" data-reveal-delay="0.08">
        <p class="bm-stat__num">110.000</p>
        <p class="bm-stat__label">Lachende Kinder</p>
      </div>
      <div class="bm-stat bm-stat--yellow" data-reveal="pop" data-reveal-delay="0.16">
        <p class="bm-stat__num" data-count>15</p>
        <p class="bm-stat__label">Jahre Erfahrung</p>
      </div>
    </div>
  </section>

  <!-- ── Fotos (static strip replaces the legacy slider) ── -->
  <section class="bm-gallery">
    <div class="container">
      <h2 class="kg-h2 kg-center" data-reveal>📸 Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <p class="kg-center kg-narrow bm-gallery__text">
        Foto- und Videogalerie sind eine bereichernde und erfüllende Erfahrung: wir öffnen uns eine Welt der Emotionen! Sie regen uns an, unser Verständnis für die Welt und die Menschen um uns herum zu vertiefen. Fotos und Videos haben die Kraft, Emotionen in uns hervorzurufen und erzeugen eine emotionale Verbindung. Eine Galerie kann uns dazu bringen, uns mit den dargestellten Momenten und Geschichten zu verbinden…oder einfach spontane Eindrücke festzuhalten! Viel Spaß bei Stöbern!
      </p>
      <div class="bm-gallery__grid">
        {_pageGallery.map((g, i) => (
          <figure class="bm-gallery__item" data-reveal="pop" data-reveal-delay={i * 0.08}>
            <Image src={g.src} alt={g.alt} widths={[360, 600, 900]} sizes="(max-width: 760px) 92vw, 33vw" loading="lazy" data-scroll-tilt="3" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Einsatzgebiet ── -->
  <section class="kg-area bm-area">
    <div class="container">
      <Squiggle />
      <h2 class="kg-h2 kg-center bm-area__title">In welchen Städten ist Clown Zauberer LIAR buchbar?</h2>
      <h3 class="kg-h3 kg-center">Einsatzgebiet Ballonmodellage</h3>
      <div class="kg-area__grid">
        <div class="kg-area__text" data-reveal>
          <p>Als Ballonkünstler bin ich in ganz Nordrhein-Westfalen unterwegs:</p>
          {einsatzgebiet.map((e) => (
            <div class="bm-region">
              <p class="bm-region__name">{e.region}</p>
              <p class="kg-cities">{e.cities}</p>
            </div>
          ))}
          <p>🌍 Weitere Regionen: Auf Anfrage auch in ganz NRW und überregional!</p>
        </div>
        <figure class="kg-area__map" data-reveal>
          <Image
            src={clownZaubererGladbeckImg}
            alt="Ballonmodellage mit Clown LIAR – Einsatzgebiet"
            data-scroll-tilt="2"
            widths={[400, 800]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Video (yellow band) ── -->
  <section class="kg-band kg-band--yellow">
    <SectionEdge color="var(--brand-yellow)" side="top" />
    <SectionEdge color="var(--brand-yellow)" side="bottom" />
    <div class="container kg-narrow kg-center">
      <h2 class="kg-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="kg-video" data-reveal="pop">
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
      </div>
      <h3 class="kg-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">Zur Foto- und Videogalerie</a>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="bm-cta">
    <div class="container kg-narrow kg-center" data-reveal>
      <h2 class="kg-h2">Jetzt Ballonmodellage buchen!</h2>
      <p>
        Machen Sie Ihr Event bunter! Mit professioneller Ballonmodellage sorge ich für strahlende Kinderaugen und fantasievolle Ballonfiguren, die noch tagelang Freude bereiten! Perfekt in Kombination mit meiner <a href="/clown/clownshow/">Clownshow</a> oder ergänzt durch <a href="/clown/glitzer-tattoo/">Glitzer Tattoos</a>.
      </p>
      <div class="bm-cta__contact">
        <p>📱 Telefon &amp; WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
      </div>
      <a href="/kontakt/" class="btn btn--primary" data-confetti>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero ── */
  .bm-crumbs { font-size: 0.88rem; font-weight: 700; color: var(--ink-soft); margin-bottom: var(--space-2); }
  .bm-crumbs a { color: inherit; }
  .bm-hero__sub { font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 650; color: var(--brand-blue); margin: 0 0 0.5rem; }
  .bm-hero__claim { font-weight: 800; margin-bottom: var(--space-3); }
  /* a loose balloon tied to the photo corner, drifting gently */
  .bm-knot {
