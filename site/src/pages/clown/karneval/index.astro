---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import SectionEdge from '../../../components/v2/SectionEdge.astro';
import Bunting from '../../../components/v2/kids/Bunting.astro';
import Squiggle from '../../../components/v2/kids/Squiggle.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import { CONTACT } from '../../../data/site';
import { Image } from 'astro:assets';
import karnevalHero from '../../../assets/images/clown/karneval-hero-original.jpg';
import zaubershowKarnevalBuehne from '../../../assets/images/clown/zaubershow-karneval-buehne.jpg';
import clownZaubererGladbeck from '../../../assets/images/clown/clown-zauberer-gladbeck.jpg';
import '../../../styles/kids-kit.css';

const seoTitle = 'Kinderkarneval NRW | Clown & Zauberer | Jecke Show';
const seoDescription = 'Kinderkarneval in NRW mit Clown Zauberer LIAR ✓ Jecke Zaubershow für Karnevalssitzung & Kinderkarneval ✓ 15 Jahre Erfahrung ✓ In Ihrer Nähe ✓ Jetzt buchen!';

const anlaesse = [
  {
    icon: '🎨',
    title: 'Kinderkarneval in Kita & Schule',
    desc: 'Der absolute Renner bei Karnevalsfeiern in Kindergärten und Grundschulen! Meine Kinderkarneval-Zaubershow ist bunt, lustig und voller Mitmach-Momente. Verkleidete Prinzessinnen, Piraten und Superhelden werden zu kleinen Zauberern und erleben Magie hautnah.',
    details: [
      'Showdauer: 35–40 Minuten (flexibel anpassbar)',
      'Altersgruppe: 4–12 Jahre',
      'Gruppengröße: 20–150 Kinder',
    ],
    perfektFuer: ['Karneval im Kindergarten', 'Karnevalsfeier in Grundschulen', 'Kinderkarneval im Vereinsheim', 'Kostümfeste & Faschingsfeiern', 'Karnevalssitzungen'],
  },
  {
    icon: '🎭',
    title: 'Karnevalssitzungen & Vereinsfeiern',
    desc: 'Für die klassische Karnevalssitzung biete ich eine 20–45-minütige Zaubershow, die sich perfekt ins Programm einfügt. Mit einer Mischung aus Bühnenmagie, Comedy und karnevalistischem Humor begeistere ich Jecken jeden Alters.',
    details: [
      'Showdauer: 20–45 Minuten',
      'Format: Bühnenprogramm',
      'Publikum: Gemischtes Publikum (Familien & Erwachsene)',
    ],
    perfektFuer: ['Programmpunkt bei Kindersitzungen', 'Einlage bei Karnevalsveranstaltungen', 'Höhepunkt bei Vereinskarneval', 'Entertainment auf Karnevalsgalas', 'Pausenunterhaltung zwischen Auftritten'],
  },
];

const besonderheiten = [
  { icon: '🎭', title: 'Karnevalsgerecht & authentisch', text: 'Ich komme nicht in Alltagskleidung – sondern im echten Karnevalskostüm! Als Clown Zauberer vereint verkörpere ich perfekt den Geist des Karnevals, mit Referenzen zu Karnevalstraditionen und lokalem Brauchtum.' },
  { icon: '🎉', title: 'Interaktiv & ausgelassen', text: 'Karneval bedeutet Mitmachen – und das gilt auch für meine Show! Ob Kinder auf der Bühne, Erwachsene als Assistenten oder spontane Gags mit dem Publikum: Jeder wird Teil des närrischen Treibens!' },
  { icon: '⚡', title: 'Flexibel & unkompliziert', text: 'Karnevalsveranstaltungen haben oft enge Zeitpläne. Meine Show fügt sich flexibel ein: Ob 20 Minuten kurz und knackig oder 45 Minuten als Hauptprogramm – ich brauche nur 2×2 Meter Platz und keine aufwendige Technik!' },
];
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Karneval Zauberer in NRW – Clown Zauberer LIAR",
  "description": "Jecke Karnevals-Zaubershow mit Clown Zauberer LIAR in NRW – Bühnen- und Mitmachprogramm für Kinderkarneval, Karnevalssitzungen und Vereinsfeiern, im echten Karnevalskostüm, 20 bis 45 Minuten.",
  "url": "https://liar-entertainer.com/clown/karneval/",
  "serviceType": ["Karneval Zaubershow", "Kinderkarneval", "Karnevalssitzung Unterhaltung"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Für welche Karnevalsveranstaltungen ist die Zaubershow geeignet?', acceptedAnswer: { '@type': 'Answer', text: 'Die Karnevals-Zaubershow von Clown Zauberer LIAR passt zu Kinderkarneval in Kita und Schule, Karnevalssitzungen, Vereinsfeiern, Kostümfesten und Karnevalsgalas in NRW – als Bühnen- und Mitmachprogramm für Kinder wie für gemischtes Publikum.' } },
    { '@type': 'Question', name: 'Wie lange dauert die Karnevals-Zaubershow?', acceptedAnswer: { '@type': 'Answer', text: 'Die Show dauert flexibel zwischen 20 und 45 Minuten und fügt sich passgenau in enge Karnevals-Zeitpläne ein – ob als kurzer Programmpunkt bei einer Karnevalssitzung oder als Hauptprogramm beim Kinderkarneval.' } },
    { '@type': 'Question', name: 'Ab welchem Alter ist die Kinderkarneval-Show geeignet?', acceptedAnswer: { '@type': 'Answer', text: 'Die Kinderkarneval-Zaubershow ist für Kinder ab 4 Jahren geeignet und begeistert Gruppen von rund 20 bis 150 Kindern. Bei Karnevalssitzungen unterhält sie auch gemischtes Publikum aus Familien und Erwachsenen.' } },
    { '@type': 'Question', name: 'In welchen Städten ist der Karneval-Zauberer buchbar?', acceptedAnswer: { '@type': 'Answer', text: 'Clown Zauberer LIAR ist zu Karneval in ganz NRW unterwegs, u. a. in Köln, Düsseldorf, Essen, Dortmund, Oberhausen, Gelsenkirchen und Gladbeck. Für besondere Karnevalsveranstaltungen auch bundesweit und international buchbar.' } },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR mit jecker Karnevals-Zaubershow und Comedy in NRW – für Kinderkarneval, Karnevalssitzungen und Vereinsfeiern.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];
---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Karneval Zauberer NRW, Karnevalshow buchen, Kinderkarneval Entertainer, Karnevalssitzung Zauberer, Karneval Clown"
  canonical="https://liar-entertainer.com/clown/karneval/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Clown', url: '/clown/clownshow/' }, { name: 'Karneval', url: '/clown/karneval/' }]}
>
  <!-- ── Hero: Zirkus-Plakat in Karnevalsfarben. No reveal here (LCP). ── -->
  <section class="kg-hero kv-hero">
    <canvas class="kg-rays" aria-hidden="true" data-side-rays='{"rayColor1":"#ffb546","rayColor2":"#ff8a3d","origin":"top-right","speed":1.6,"intensity":2,"spread":1.4,"saturation":1.5,"blend":0.4,"falloff":1.3,"opacity":0.9}'></canvas>
    <Bunting />
    <div class="container kg-hero__grid">
      <div class="kg-hero__copy">
        <p class="kv-crumbs">
          <a href="/">Clown Zauberer LIAR</a> »
          <a href="/clown/clownshow/">Clown</a> »
          <span>Karneval</span>
        </p>
        <ReviewBadge />
        <h1 class="kg-hero__title kv-hero__title" data-letters>Karneval</h1>
        <h2 class="kv-hero__sub">
          🎊 Karneval Zauberer in NRW –<br />Jecke Zaubershow für die fünfte Jahreszeit!
        </h2>
        <p class="kv-hero__cheer">Alaaf &amp; Helau! Magie trifft Karnevalsfreude</p>
        <div class="kg-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
        <nav class="kg-quick" aria-label="Schnell zu den Infos">
          <a href="#anlaesse">Anlässe</a>
          <a href="#bewertungen">Bewertungen</a>
          <a href="#einsatzgebiet">Städte</a>
        </nav>
      </div>
      <figure class="kg-hero__photo">
        <Image
          src={karnevalHero}
          alt="Karneval Zauberer NRW – Jecke Zaubershow für die fünfte Jahreszeit"
          widths={[400, 700, 1000, 1400]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
          style="object-position: 51% 39%"
        />
        <a class="kg-sticker kv-sticker" href="#anlaesse">
          <span>20–45</span><strong>Min.</strong>
        </a>
      </figure>
    </div>
  </section>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="kg-intro">
    <div class="container kg-intro__grid">
      <div class="kg-intro__text" data-reveal>
        <p class="kg-lead">
          Eine Karnevals-Zaubershow mit Clown Zauberer LIAR ist ein jeckes Bühnen- und Mitmachprogramm für Kinderkarneval, Karnevalssitzungen und Vereinsfeiern in NRW – im echten Karnevalskostüm, 20 bis 45 Minuten lang, für Kinder ab 4 Jahren und gemischtes Publikum, buchbar im ganzen Rheinland und Ruhrgebiet. Seit 15 Jahren bringe ich Magie und Comedy in die fünfte Jahreszeit.
        </p>
        <p>
          Meine Karnevals-Zaubershow kombiniert verblüffende Illusionen mit jeckem Humor und Clownerie – perfekt auf die närrische Zeit abgestimmt. Alle Details zu meiner regulären <a href="/zauberer/zaubershow/">Zaubershow</a> finden Sie auf der entsprechenden Seite. Ob für Kinderkarnevalsfeiern in Kitas und Schulen, Vereinssitzungen oder Straßenkarneval: Ich sorge für staunende Gesichter und ausgelassene Stimmung!
        </p>
        <div class="kv-tip">
          <p class="kv-tip__title">⚠️ TIPP: Buchen Sie früh!</p>
          <p class="kv-tip__text">Die Karnevalszeit (vor allem die „heißen Tage" von Weiberfastnacht bis Rosenmontag) ist sehr gefragt. Sichern Sie sich Ihren Wunschtermin idealerweise schon im Herbst!</p>
        </div>
      </div>
      <figure class="kv-photo" data-reveal="pop" data-reveal-delay="0.1">
        <Image
          src={zaubershowKarnevalBuehne}
          alt="Zaubershow auf einer Bühne für Karneval in Gladbeck"
          data-scroll-tilt="3"
          widths={[400, 600, 800]}
          sizes="(max-width: 900px) 92vw, 420px"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <Reviews />

  <!-- ── Warum Zauberei & Karneval: confetti-strewn floor ──── -->
  <section class="kv-why">
    <div class="container">
      <h2 class="kg-h2 kg-center" data-reveal>🎪 Warum eine Zaubershow perfekt zu Karneval passt</h2>
      <div class="kg-cards kv-why__grid">
        {besonderheiten.map((b, i) => (
          <article
            class:list={['kg-card', 'kv-why__card', ['kg-card--red', 'kg-card--blue', 'kg-card--yellow'][i % 3]]}
            data-reveal="pop"
            data-reveal-delay={i ? String(i / 10) : undefined}
          >
            <p class="kv-icon">{b.icon}</p>
            <h3>{b.title}</h3>
            <p class="kv-why__text">{b.text}</p>
          </article>
        ))}
      </div>
      <div class="kv-why__note" data-reveal="tilt">
        <p>
          Karneval ist die Zeit der Verwandlung, des Staunens und der ausgelassenen Freude – und genau das ist auch Zauberkunst! Meine Karnevals-<a href="/zauberer/zaubershow/">Zaubershow</a> bringt diese beiden Welten zusammen. Mit karnevalsgerechtem Kostüm, jeckem Humor und Tricks, die die närrische Stimmung aufgreifen, wird jede Karnevalsveranstaltung zum Highlight.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Zahlen (red band) ─────────────────────────────────── -->
  <section class="kg-band kv-stats">
    <SectionEdge color="var(--brand-red)" side="top" />
    <SectionEdge color="var(--brand-red)" side="bottom" />
    <div class="container kv-stats__grid">
      <div class="kv-stat" data-reveal="pop">
        <div class="kv-stat__icon">🪄</div>
        <div class="kv-stat__num" data-count>400</div>
        <div class="kv-stat__label">Shows im Jahr</div>
      </div>
      <div class="kv-stat" data-reveal="pop" data-reveal-delay="0.08">
        <div class="kv-stat__icon">😊</div>
        <div class="kv-stat__num">110.000</div>
        <div class="kv-stat__label">Lachende Kinder</div>
      </div>
      <div class="kv-stat" data-reveal="pop" data-reveal-delay="0.16">
        <div class="kv-stat__icon">🪄</div>
        <div class="kv-stat__num" data-count>15</div>
        <div class="kv-stat__label">Jahre Erfahrung</div>
      </div>
    </div>
  </section>

  <!-- ── Anlässe ───────────────────────────────────────────── -->
  <section class="kv-occasions" id="anlaesse">
    <div class="container">
      <Squiggle color="var(--brand-blue)" />
      <h2 class="kg-h2 kg-center" data-reveal>🎭 Karnevals-Zaubershow für jeden Anlass</h2>
      <div class="kv-occasions__grid">
        {anlaesse.map((a, i) => (
          <article class="kv-occasion" data-reveal="pop" data-reveal-delay={i ? '0.1' : undefined}>
            <p class="kv-icon">{a.icon}</p>
            <h3>{a.title}</h3>
            <p class="kv-occasion__desc">{a.desc}</p>
            <div class="kv-chips">
              {a.details.map(d => (
                <p class="kv-chip">{d}</p>
              ))}
            </div>
            <p class="kv-occasion__label">Ideal als:</p>
            <ul class="kv-occasion__list">
              {a.perfektFuer.map(p => (
                <li><span>✓</span> {p}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Video (yellow band) ───────────────────────────────── -->
  <section class="kg-band kg-band--yellow">
    <SectionEdge color="var(--brand-yellow)" side="top" />
    <SectionEdge color="var(--brand-yellow)" side="bottom" />
    <div class="container kg-narrow kg-center">
      <h2 class="kg-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="kg-video" data-reveal="pop">
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" label="Zaubershow ansehen" />
      </div>
      <h3 class="kg-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>

  <!-- ── Einsatzgebiet ─────────────────────────────────────── -->
  <section class="kg-area" id="einsatzgebiet">
    <div class="container">
      <div class="kg-area__grid">
        <div class="kg-area__text" data-reveal>
          <h2 class="kg-h2">📍 Einsatzgebiet Karneval</h2>
          <p>
            Für Karneval bin ich in folgenden Städten NRWs unterwegs:
          </p>
          <p class="kg-cities">
            Oberhausen • Gelsenkirchen • Essen • Duisburg • Dorsten • Herten • Herne • Marl • Gladbeck • Mülheim • Düsseldorf • Dortmund • Lünen • Hagen • Moers • Krefeld • Reken • Ahaus • Münster • Köln
          </p>
          <p>
            🌍 Für besondere Karnevalsveranstaltungen bin ich auch außerhalb NRWs buchbar – in ganz Deutschland und sogar international für Karnevalsfeiern!
          </p>
          <div class="kv-reach">
            <p>📱 Telefon & WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
            <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
            <p>📍 Standort: Beethovenstr. 15, 45966 Gladbeck</p>
          </div>
        </div>
        <figure class="kg-area__map" data-reveal="pop">
          <Image
            src={clownZaubererGladbeck}
            alt="Wohnort Clown Zauberer für Karneval"
            data-scroll-tilt="2"
            widths={[400, 600, 800]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ── CTA: a closing parade ─────────────────────────────── -->
  <section class="kv-cta">
    <Bunting />
    <div class="container kg-narrow kg-center" data-reveal>
      <h2 class="kg-h2">Jetzt Karneval-Zauberer buchen!</h2>
      <p class="kv-cta__lead">Ob Kinderkarneval, Vereinssitzung oder Karnevalsfeier – machen Sie Ihre Veranstaltung mit einer jecken Zaubershow unvergesslich!</p>
      <p class="kv-cta__text">
        Sie können mir Ihre Anfrage unverbindlich senden. Ihre Angaben werden selbstverständlich absolut vertraulich behandelt und nicht weitergegeben. Je mehr Angaben ich von Ihnen bekomme, desto besser kann ich Sie beraten. Sie können auch einfach unter 0172-1517578 anrufen oder über WhatsApp schreiben. Ich helfe Ihnen gerne weiter.
      </p>
      <p class="kv-cta__hint">Karnevalstermine sind schnell ausgebucht – idealerweise schon im Herbst anfragen!</p>
      <a href="/kontakt/" class="btn btn--primary" data-confetti>
        Kontaktformular
      </a>
    </div>
  </section>
</V2Layout>

<style>
  /* Karneval confetti: three colour layers of small dots, purely CSS, behind the content */
  .kv-why, .kv-cta {
    --confetti:
      radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--brand-red) 45%, transparent) 0 0.3rem, transparent 0.34rem) 0 0 / 6rem 6rem,
      radial-gradient(circle at 65% 55%, color-mix(in srgb, var(--brand-blue) 40%, transparent) 0 0.26rem, transparent 0.3rem) 0 0 / 7.5rem 7.5rem,
      radial-gradient(circle at 40% 85%, color-mix(in srgb, var(--brand-yellow) 70%, transparent) 0 0.32rem, transparent 0.36rem) 0 0 / 5.5rem 5.5rem;
  }

  /* ── hero ── */
  .kv-crumbs { font-size: 0.85rem; font-weight: 700; color: var(--ink-soft); margin: 0 0 var(--space-2); }
  .kv-crumbs a { color: inherit; text-decoration: none; }
  .kv-hero__title { font-size: clamp(3.2rem, 9vw, 6.2rem); line-height: 0.95; color: var(--accent-strong); }
  .kv-hero__sub { font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 650; margin: 0 0 var(--space-2); }
  .kv-hero__cheer {
    display: inline-block; padding: 0.3rem 0.9rem; margin-bottom: var(--space-3);
    font-family: var(--font-display); font-weight: 650; font-size: 1.1rem;
    background: var(--brand-yellow); color: var(--ink); border: 2.5px solid var(--line); border-radius: 0.6rem; rotate: -2deg;
  }
  .kv-sticker span { font-family: var(--font-display); font-size: 1.35rem; }
  .kv-sticker strong { font-size: 1.15rem; font-family: var(--font-body); font-weight: 800; }

  /* ── intro ── */
  .kv-tip {
    margin-top: var(--space-3); padding: var(--space-2) var(--space-3);
    background: color-mix(in srgb, var(--brand-yellow) 35%, var(--surface));
    border: var(--border); border-radius: var(--radius-sm); box-shadow: 4px 4px 0 var(--line); rotate: -1deg;
  }
  .kv-tip__title { font-weight: 800; margin-bottom: 0.3rem; }
  .kg-intro__text .kv-tip__text { color: var(--ink); font-size: 0.97rem; margin: 0; }
  .kv-photo { margin: 0; justify-self: center; rotate: 2deg; }
  .kv-photo :global(img) {
    display: block; width: min(26rem, 88vw); height: auto;
    border: 5px solid var(--line); border-radius: var(--radius); box-shadow: 8px 8px 0 var(--line);
  }

  /* ── why ── */
  .kv-why { background: var(--confetti), var(--bg); }
  .kv-why__grid { margin-top: var(--space-4); }
  .kv-why__card { text-align: center; }
  .kv-icon { font-size: 2.2rem; line-height: 1; margin-bottom: var(--space-1); }
  .kv-why__text { color: var(--ink-soft); margin: 0; font-size: 0.98rem; }
  .kv-why__note {
    max-width: 52rem; margin: var(--space-5) auto 0; padding: var(--space-3); text-align: center;
    background: var(--surface); border: var(--border); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .kv-why__note p { margin: 0; color: var(--ink-soft); }

  /* ── stats (red band) ── */
  .kv-stats { background: var(--brand-red); color: #fff; }
  .kv-stats__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--space-3); }
  .kv-stat {
    text-align: center; padding: var(--space-3); border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.12); border: 2px dashed rgba(255, 255, 255, 0.45);
  }
  .kv-stat__icon { font-size: 2rem; line-height: 1; margin-bottom: 0.4rem; }
  .kv-stat__num { font-family: var(--font-display); font-size: clamp(2.6rem, 6vw, 3.6rem); font-weight: 700; line-height: 1; }
  .kv-stat__label { font-weight: 800; margin-top: 0.3rem; }

  /* ── occasions ── */
  .kv-occasions__grid { display: grid; gap: var(--space-4) var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); margin-top: var(--space-4); }
  .kv-occasion {
    padding: var(--space-3); background: var(--surface); border: var(--border); border-radius: var(--radius); box-shadow: var(--shadow);
    transition: transform 0.35s var(--ease-out-expo), box-shadow 0.3s var(--ease-out);
  }
  .kv-occasion:nth-child(1) { rotate: -1deg; }
  .kv-occasion:nth-child(2) { rotate: 1deg; }
  .kv-occasion h3 { font-size: 1.5rem; margin: 0 0 var(--space-2); }
  .kv-occasion__desc { color: var(--ink-soft); }
  .kv-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: var(--space-2); }
  .kv-chips .kv-chip {
    margin: 0; padding: 0.25rem 0.75rem; font-size: 0.88rem; font-weight: 700;
    background: var(--bg); border: 2px dashed var(--line); border-radius: 999px;
