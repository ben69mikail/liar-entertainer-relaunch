---
import V2Layout from '../../../layouts/V2Layout.astro';
import { Image } from 'astro:assets';
import heroImg from '../../../assets/images/home/clown-zauberer-hero.jpg';
import clownBeiClownshowImg from '../../../assets/images/clown/clown-bei-clownshow.jpg';
import zaubershowImg from '../../../assets/images/shows/zaubershow.jpg';
import kinderzaubererKindergartenImg from '../../../assets/images/clown/kinderzauberer-kindergarten-essen.jpg';
import clownZaubererGladbeckImg from '../../../assets/images/clown/clown-zauberer-gladbeck.jpg';
import fotogalerieClownZauberer3Img from '../../../assets/images/galerie/fotogalerie-clown-zauberer-3.jpg';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import Curtain from '../../../components/v2/kids/Curtain.astro';
import K3Hero from '../../../components/v2/kids/K3Hero.astro';
import ProgramFrame from '../../../components/v2/kids/ProgramFrame.astro';
import GoldDivider from '../../../components/v2/kids/GoldDivider.astro';
import BalloonDog from '../../../components/v2/kids/BalloonDog.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import { CONTACT } from '../../../data/site';
import '../../../styles/kids-v3.css';

const seoTitle = 'Clown für Kindergeburtstag NRW buchen | Clown LIAR';
const seoDescription = 'Clown für den Kindergeburtstag mieten: lustige Clownshow mit Comedy & Zauberei, Ballonfiguren für jedes Kind ✓ 370+ Top-Bewertungen im Ruhrgebiet & NRW!';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Clownshow in NRW",
  "description": "Professionelle Clownshow mit Comedy, Gags und Zauberei für Kindergeburtstag und Kinderfest in NRW",
  "url": "https://liar-entertainer.com/clown/clownshow/",
  "serviceType": ["Clownshow", "Kinderunterhaltung"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqItems = [
  {
    question: 'Was kostet eine Clownshow bei LIAR?',
    answer: 'Unterschiedlich! Die Gage ist immer abhängig von Art und Umfang der Veranstaltung, der Zuschauerzahl, der Anfahrt und auch eventuell der Jahreszeit. Bei KINDERGEBURTSTAGE gibt es feste Preise! Fragen Sie einfach nach!',
  },
  {
    question: 'Wieviel Platz braucht man für die Show?',
    answer: 'Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Bücherei, Kindergarten, Turnhalle…',
  },
  {
    question: 'Wie lange dauert eine Vorführung mit dem Clown?',
    answer: 'Die Clownshow ist ab 25/30 Minuten zu buchen. Das Besondere?!? Sie lässt sich flexibel in jeder Veranstaltung einbauen: Kindergeburtstag, Karnevalfeier, Kinderfest, Sommerfest im Kindergarten oder Schule, Schützenfest, Straßenfest, Betriebsfeier…',
  },
  {
    question: 'Was ist der Unterschied zwischen Clownshow und Zaubershow?',
    answer: 'Die Clownshow setzt stärker auf Comedy, Slapstick und Lachen – perfekt für jüngere Kinder (4-7 Jahre). Die Zaubershow betont Staunen und Magie – ideal für ältere Kinder (7-12 Jahre). Beide Shows enthalten Elemente der jeweils anderen!',
  },
  {
    question: 'Können auch sehr schüchterne Kinder mitmachen?',
    answer: 'Unbedingt! Schüchterne Kinder werden behutsam einbezogen, ohne sie zu drängen. Durch die pädagogische Ausbildung von Clown LIAR wird jedes Kind in seinem eigenen Tempo zum Strahlen gebracht.',
  },
  {
    question: 'Tritt Clown LIAR auch im Kindergarten oder in der Schule auf?',
    answer: 'Ja! Es gibt spezielle Programme für Kita-Feste (20-100 Kinder), Schulfeste (30-150 Schüler) und Abschlussfeiern. Die Show wird an die Gruppengröße und das Alter angepasst.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow und Clownshow für Kinder in NRW. Kindergeburtstag – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": {
    "@type": "Organization",
    "name": "Clown Zauberer LIAR",
    "url": "https://liar-entertainer.com"
  }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];
---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Clownshow NRW, Clown buchen Kindergeburtstag, Clown für Kinder, Clownshow Kindergeburtstag, Clown NRW"
  canonical="https://liar-entertainer.com/clown/clownshow/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Clown', url: '/clown/clownshow/' }, { name: 'Clownshow', url: '/clown/clownshow/' }]}
>
  <!-- ── Hero: the big-top stage (K3Hero). No reveal here (LCP). ── -->
  <K3Hero>
        <p class="k3-crumbs">
          <a href="/">Clown</a> »
          <a href="/">Clownshow</a>
        </p>
        <ReviewBadge />
        <h1 class="k3-hero__title" data-letters><span class="k3-mark">Clownshow</span> in NRW – Clown für Kindergeburtstag buchen</h1>
        <h2 class="k3-hero__sub">
          Clownshow in NRW – Lachen,<br />Spaß und lustige Unterhaltung für Kinder
        </h2>
        <div class="k3-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
        <nav class="k3-quick" aria-label="Schnell zu den Infos">
          <a href="#programme">Programme</a>
          <a href="#faq">Fragen</a>
          <a href="#bewertungen">Bewertungen</a>
          <a href="#einsatzgebiet">Städte</a>
        </nav>
    <Fragment slot="photo">
      <Image
        src={heroImg}
        alt="Clown Zauberer LIAR – Clownshow NRW mit Top-Bewertungen"
        widths={[400, 700, 1000]}
        quality={70}
        sizes="(max-width: 900px) 80vw, 500px"
        loading="eager"
        fetchpriority="high"
      />
    </Fragment>
  </K3Hero>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="k3-intro">
    <div class="container k3-narrow" data-reveal>
      <p class="k3-lead">
        Clown LIAR (Michaël Prescler) ist ein professioneller Kinderclown aus Gladbeck und tritt in ganz NRW auf. Buchbar für Kindergeburtstage, Kita- und Schulfeste sowie Familienfeiern – eine lustige Clownshow mit Comedy, Gags und Zauberei für Kinder von 4 bis 12 Jahren, ab ca. 25–30 Minuten und für Kindergeburtstage zu transparenten Festpreisen.
      </p>
      <p class="k3-soft">
        Als professioneller Kinderclown und <a href="/kinderzauberer/">Kinderzauberer</a> bringe ich seit über 15 Jahren Lachen, Spaß und gute Laune zu Kindergeburtstagen, Kinderfesten und Familienveranstaltungen in ganz Nordrhein-Westfalen. Meine Clownshow ist eine bunte Mischung aus Comedy, Clown-Gags und <a href="/zauberer/zaubershow/">Zaubershow</a> – perfekt auf Kinder zwischen 4 und 12 Jahren abgestimmt!
      </p>
      <p class="k3-panel cs-note">
        <strong>Das Besondere an meiner Clownshow:</strong> Der Clown findet den besten Draht zu den Kindern! Mit lustigen Missgeschicken, witzigen Gags und viel Interaktion sorge ich dafür, dass die Kinder ständig lachen, mitmachen und Teil der Show werden. Und wenn zwischendurch auch noch gezaubert wird, ist das Staunen groß!
      </p>
      <p class="k3-soft">
        Ob für Ihren <a href="/kindergeburtstag/">Kindergeburtstag</a> zu Hause, Kinderfest im Kindergarten, Schulfest oder Familienfeiern – ich komme zu Ihnen und verwandle jeden Anlass in ein fröhliches Spektakel. Mit minimalem Aufwand für Sie: Ich bringe alles mit, benötige nur 2×2 Meter Platz und keine technische Vorbereitung! Sie wünschen mehr Magie als Comedy? Dann ist der <a href="/kinderzauberer/">Zauberer für den Kindergeburtstag</a> die richtige Wahl.
      </p>
    </div>
  </section>

  <!-- ── Weitere Anlässe (SEO-Audit 06.08.2026, H6: internal links to /clown/karneval/ + /clown/walk-act/) ── -->
  <section class="k3-alt" data-related-services>
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>
        Für welche Anlässe kann man Clown LIAR sonst buchen?
      </h2>
      <div class="k3-links">
        <a href="/clown/karneval/" class="k3-link-card" data-reveal>
          <p class="k3-link-card__title">Clown für Karneval &amp; Kindersitzung</p>
          <p class="k3-link-card__text">Jecke Zaubershow für Kindersitzung, Karnevalsfeier und Rosenmontagsparty in NRW.</p>
        </a>
        <a href="/clown/walk-act/" class="k3-link-card" data-reveal data-reveal-delay="0.08">
          <p class="k3-link-card__title">Walk-Act für Straßen- und Stadtfest</p>
          <p class="k3-link-card__text">Clown Zauberer LIAR mitten im Publikum – Ballonfiguren und Magie zum Anfassen.</p>
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Was ist eine Clownshow? ───────────────────────────── -->
  <section class="cs-what">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Was ist eine Clownshow?</h2>
      <div class="k3-split k3-split--flip">
        <ProgramFrame class="k3-photo k3-photo--l" data-reveal>
          <Image
            src={clownBeiClownshowImg}
            alt="Clown LIAR unterhält Kinder bei einer Clownshow in NRW"
            loading="lazy"
            widths={[350, 700]}
            sizes="(max-width: 900px) 80vw, 320px"
          />
        </ProgramFrame>
        <div data-reveal data-reveal-delay="0.1">
          <h3 class="k3-h3 cs-what__h3">Clownshow – Mehr als nur Witze und rote Nasen</h3>
          <p class="k3-soft">
            Eine Clownshow ist pure Comedy für Kinder! Anders als bei einer reinen Zaubershow steht hier das Lachen im Vordergrund. Mit clownesken Gags, lustigen Missgeschicken (die natürlich geplant sind!), Slapstick und viel Bewegung bringe ich die Kinder zum Lachen und Mitmachen.
          </p>
          <h3 class="k3-h3">Was macht eine gute Clownshow aus?</h3>
          <div class="cs-traits">
            <p>
              <strong>Comedy &amp; Humor :</strong> für Kinder Keine Erwachsenen-Witze, sondern kindgerechter Humor: Dinge fallen runter, der Clown stolpert, Tricks gehen „schief" (und dann doch wieder gut) – all das lieben Kinder!
            </p>
            <p>
              <strong>Interaktion &amp; Mitmachen :</strong> Die Kinder sind nicht nur Zuschauer, sondern aktive Teilnehmer! Sie kommen nach vorne, helfen dem Clown, machen Geräusche mit und sind mittendrin statt nur dabei.
            </p>
            <p>
              <strong>Slapstick &amp; Action :</strong> Viel Bewegung, lustige Körperkomik und actionreiche Momente halten die Aufmerksamkeit der Kinder durchgehend hoch.
            </p>
            <p>
              <strong>Clownerie trifft Zaubershow :</strong> Das Beste aus beiden Welten: Der Clown zaubert auch – aber auf clowneske, witzige Art. Als Kinderzauberer überrasche ich die Kinder mit echten magischen Momenten, bei denen Tricks auch mal „schiefgehen" und dann doch wieder klappen!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Zahlen: the velvet ring ───────────────────────────── -->
  <section class="k3-band k3-band--velvet">
    <div class="container">
      <GoldDivider />
      <div class="k3-stats">
        <div class="k3-stat" data-reveal>
          <div class="k3-stat__icon">🪄</div>
          <div class="k3-stat__num" data-count>400</div>
          <div class="k3-stat__label">Shows im Jahr</div>
        </div>
        <div class="k3-stat" data-reveal data-reveal-delay="0.08">
          <div class="k3-stat__icon">😊</div>
          <div class="k3-stat__num">110.000</div>
          <div class="k3-stat__label">Lachende Kinder</div>
        </div>
        <div class="k3-stat" data-reveal data-reveal-delay="0.16">
          <div class="k3-stat__icon">🪄</div>
          <div class="k3-stat__num" data-count>15</div>
          <div class="k3-stat__label">Jahre Erfahrung</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Clownshow-Programme ───────────────────────────────── -->
  <section class="cs-programs" id="programme">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Clownshow-Programme</h2>

      <article class="k3-split cs-prog">
        <div class="k3-panel cs-prog__text" data-reveal>
          <BalloonDog />
          <h3 class="k3-h3 cs-prog__h3--dog">Clownshow für Kindergeburtstag</h3>
          <p>
            Der absolute Klassiker! Der Clown kommt zu Ihnen nach Hause und sorgt für ausgelassene Stimmung bei der Geburtstagsfeier. Die Kinder erleben Comedy, Zauberei und bekommen am Ende Ballontiere – ein unvergesslicher Geburtstag!
          </p>
          <p class="cs-prog__facts">
            Showdauer: 40 Minuten (optimal für Kindergeburtstage) Altersgruppe: 4-12 Jahre Location: Wohnzimmer, Kinderzimmer, Garten, Partykeller
          </p>
          <p>
            Was die Kinder erleben: ✓ Lustige Clown-Gags und Missgeschicke ✓ Interaktive Spiele und Mitmach-Momente ✓ Verblüffende Zaubertricks ✓ Ballontiere für jedes Kind (optional) ✓ Das Geburtstagskind steht im Mittelpunkt!
          </p>
          <p class="cs-prog__fit">
            Perfekt für: Kindergeburtstage zu Hause, auch bei begrenztem Platz
          </p>
        </div>
        <ProgramFrame class="k3-photo" data-reveal data-reveal-delay="0.1">
          <Image
            src={zaubershowImg}
            alt="Clown verzaubert Kinder bei einer Clownshow auf dem Kindergeburtstag"
            loading="lazy"
            widths={[320, 640]}
            sizes="(max-width: 900px) 80vw, 320px"
          />
        </ProgramFrame>
      </article>

      <article class="k3-split k3-split--flip cs-prog">
        <ProgramFrame class="k3-photo k3-photo--l cs-photo--narrow" data-reveal>
          <Image
            src={kinderzaubererKindergartenImg}
            alt="Clown LIAR begeistert Kinder bei Clownshow im Kindergarten"
            loading="lazy"
            widths={[320]}
            sizes="(max-width: 900px) 80vw, 280px"
          />
        </ProgramFrame>
        <div class="k3-panel cs-prog__text" data-reveal data-reveal-delay="0.1">
          <h3 class="k3-h3">Clownshow für Kindergarten &amp; Kita</h3>
          <p>
            Für Sommerfeste, Abschiedsfeiern der Vorschulkinder, Karneval oder einfach als Überraschung – die Clownshow begeistert ganze Kindergartengruppen!
          </p>
          <p class="cs-prog__facts">
            Showdauer: 30-40 Minuten Altersgruppe: 3-6 Jahre Gruppengröße: 20-100 Kinder
          </p>
          <p>
            Besonderheiten: ✓ Altersgerecht für Kindergartenkinder ✓ Viel Bewegung und Action ✓ Alle Kinder werden eingebunden ✓ Auch für große Gruppen geeignet
          </p>
          <p class="cs-prog__fit">
            Perfekt für: Kita-Feste, Sommerfeste, Abschiedsfeiern, Karnevalsfeiern
          </p>
        </div>
      </article>

      <article class="k3-split cs-prog">
        <div class="k3-panel cs-prog__text" data-reveal>
          <h3 class="k3-h3">Clownshow für Schule &amp; Schulfeste</h3>
          <p>
            Auch für Grundschulkinder ist die Clownshow ein Hit! Bei Schulfesten, Einschulungen oder Projekttagen sorgt der Clown für Lacher bei Groß und Klein.
          </p>
          <p class="cs-prog__facts">
            Showdauer: 35-45 Minuten Altersgruppe: 6-10 Jahre (Klasse 1-4) Gruppengröße: 30-150 Schüler
          </p>
          <p>
            Besonderheiten: ✓ Humor für Schulkinder (etwas anspruchsvoller) ✓ Auch für Erwachsene (Eltern) unterhaltsam ✓ Funktioniert in Turnhallen und auf Bühnen
          </p>
          <p class="cs-prog__fit">
            Perfekt für: Schulfeste, Einschulungsfeiern, Projekttage, Abschlussfeiern
          </p>
        </div>
        <ProgramFrame class="k3-photo" data-reveal data-reveal-delay="0.1">
          <Image
            src={fotogalerieClownZauberer3Img}
            alt="Clown Zauberer LIAR bringt Schulkinder zum Lachen bei Clownshow"
            loading="lazy"
            widths={[320, 640]}
            sizes="(max-width: 900px) 80vw, 320px"
          />
        </ProgramFrame>
      </article>
    </div>
  </section>

  <!-- ── Witzigste Clownshow ───────────────────────────────── -->
  <section class="k3-alt">
    <div class="container k3-narrow k3-center" data-reveal>
      <GoldDivider />
      <h2 class="k3-h2">Die WITZIGSTE Clownshow NRW mit TOP BEWERTUNGEN!</h2>
      <p>
        <strong>Diese farbenfrohe, humorvolle und magische Show ist liebevoll auf das Alter der Kinder abgestimmt.</strong>
      </p>
      <p>
        Die kleinen Zuschauer dürfen mitmachen, selbst zaubern und erleben hautnah, wie plötzlich unglaubliche Dinge geschehen.
      </p>
      <p>
        Für jedes Kind wird diese Clown- und Zaubershow zu einem intensiven, fröhlichen – und vor allem unvergesslichen Erlebnis.
      </p>
    </div>
  </section>

  <!-- ── Clown oder Zauberer? Two offers under a red and a blue spotlight ── -->
  <section class="k3-extras k3-band k3-band--spot cs-choice">
    <span class="k3-spot k3-spot--red" aria-hidden="true"></span>
    <span class="k3-spot k3-spot--blue" aria-hidden="true"></span>
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Clown oder Zauberer?</h2>
      <div class="k3-extras__grid cs-choice__grid">
        <article class="k3-extra" data-reveal>
          <h3>Buchen Sie die Clownshow, wenn…</h3>
          <p>
            ✓ Die Kinder eher jünger sind (4-7 Jahre) ✓ Sie viel Lachen und Comedy wünschen ✓ Die Kinder Slapstick und lustige Gags lieben ✓ Sie Ballontiere als Erinnerung möchten ✓ Die Stimmung ausgelassen und fröhlich sein soll
          </p>
          <p class="k3-extra__dur">
            Perfekt für: Kindergeburtstage mit jüngeren Kindern, Kita-Feste, Familienfeiern mit Kleinkindern
          </p>
        </article>
        <article class="k3-extra" data-reveal data-reveal-delay="0.08">
          <h3>Buchen Sie die Zaubershow, wenn…</h3>
          <p>
            ✓ Die Kinder eher älter sind (7-12 Jahre) ✓ Sie mehr Staunen und Magie wünschen ✓ Die Kinder komplexere Tricks sehen wollen ✓ Eine etwas „coolere", weniger clowneske Show gewünscht ist ✓ Auch Erwachsene begeistert werden sollen
          </p>
          <p class="k3-extra__dur">
            Perfekt für: Kindergeburtstage mit älteren Kindern, Schulfeste, gemischte Veranstaltungen
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Video: Hollywood premiere searchlights, curtain with tie-backs ── -->
  <section class="k3-band k3-band--night k3-premiere">
    <span class="k3-uplight k3-uplight--l" aria-hidden="true"></span>
    <span class="k3-uplight k3-uplight--r" aria-hidden="true"></span>
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <h2 class="k3-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="k3-video" data-reveal>
        <Curtain trigger="stage" rest="clamp(2.2rem, 10vw, 4.6rem)" span="min(42rem, 100vw - 2rem)" tieback valance />
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" label="Clownshow ansehen" />
      </div>
      <h3 class="k3-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>

  <!-- ── FAQ: native <details>, works without JS ───────────── -->
  <section class="k3-faq" id="faq">
    <div class="container k3-narrow">
      <GoldDivider />
      <p class="k3-kicker k3-center">Häufige Fragen zur Clownshow</p>
      <h2 class="k3-h2 k3-center">Hier sind ein paar Antworten</h2>
      <div class="k3-faq__list">
        {faqItems.map((item) => (
          <details class="k3-faq__item" data-reveal>
            <summary><span>{item.question}</span></summary>
            <div class="k3-faq__answer">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Einsatzgebiet ─────────────────────────────────────── -->
  <section class="k3-area k3-alt" id="einsatzgebiet">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center">Einsatzgebiete NRW</h2>
      <h3 class="k3-h3 k3-center">Clownshow in ganz NRW – Ihre Regionen</h3>
      <div class="k3-area__grid">
        <div>
          <p>Als Kinderclown bin ich in ganz Nordrhein-Westfalen unterwegs. Ergänzend zur Clownshow biete ich auch <a href="/clown/ballonmodellage/">Ballonmodellage</a>, <a href="/clown/glitzer-tattoo/">Glitzer Tattoos</a> und <a href="/clown/walk-act/">Walk-Act</a> an. Überzeugen Sie sich in meiner <a href="/galerie/">Galerie</a>!</p>
          <p class="k3-cities">
