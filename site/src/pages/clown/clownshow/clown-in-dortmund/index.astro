---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HeroSlider from '../../../../components/HeroSlider.astro';
import HeroStage from '../../../../components/HeroStage.astro';
import karteImg from '../../../../assets/images/home/clown-zauberer-gladbeck-karte.jpg';
import { Image } from 'astro:assets';
import _heroImgAsset from '../../../../assets/images/home/clown-zauberer-hero.jpg';
import _clownIntroAsset from '../../../../assets/images/clown/clown-zauberer-gladbeck.jpg';
import _gal1Asset from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-1.jpg';
import _gal2Asset from '../../../../assets/images/galerie/buehnen-zauberei.jpg';
import _gal3Asset from '../../../../assets/images/clown/glitzer-tattoos.jpg';
import _gal4Asset from '../../../../assets/images/zauberer/zaubershow-mit-clown-zauberer.jpg';
import _gal5Asset from '../../../../assets/images/clown/kosten-preis-clown-nrw.jpg';
import _gal6Asset from '../../../../assets/images/zauberer/zaubervorfuehrung-weihnachtsmarkt-dortmund.jpg';
import _gal7Asset from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-16.jpg';
import _gal8Asset from '../../../../assets/images/zauberer/zaubershow-staunende-kinder.jpg';
import _gal9Asset from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-2.jpg';
import GoogleReviews from '../../../../components/GoogleReviews.astro';

const seoTitle = "Clown Dortmund | TOP Bewertungen | Jetzt buchen";
const seoDescription = "Clown in Dortmund für Kindergeburtstag & Events ✓ Französischer Clown LIAR ✓ 370+ Bewertungen ✓ Auch in Bochum & Herne ✓ Jetzt buchen!";
const heroImg = _heroImgAsset.src;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Clown in Dortmund",
  "description": "Clown LIAR für Kindergeburtstag und Kinderfest in Dortmund, NRW",
  "url": "https://liar-entertainer.com/clown/clownshow/clown-in-dortmund/",
  "serviceType": ["Clownshow", "Kinderunterhaltung"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "City", "name": "Dortmund" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was braucht Clown LIAR für einen Auftritt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Kindergarten, Turnhalle… Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!"
      }
    },
    {
      "@type": "Question",
      "name": "Wieviel Platz braucht man für das Programm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LIAR ist ziemlich pflegeleicht: für die Show ist es wichtig, dass die Kinder gemütlich und ungestört sitzen können!!! Bei der Ballonmodellage ist nichts weiteres nötig. Bei GLITZER TATTOOS wären schon 2 Stühle und einen Tisch wichtig!"
      }
    },
    {
      "@type": "Question",
      "name": "Wie viele Kinder sollten überhaupt eingeladen werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

const _pageGallery = [
  { src: _gal1Asset, alt: 'Improvisationstalent Clown LIAR bei einer Veranstaltung in Dortmund' },
  { src: _gal2Asset, alt: 'Dortmund – Eindruck 2 mit Clown Zauberer LIAR' },
  { src: _gal3Asset, alt: 'Dortmund – Eindruck 3 mit Clown Zauberer LIAR' },
  { src: _gal4Asset, alt: 'Zaubershow in Dortmund mit Clown Zauberer' },
  { src: _gal5Asset, alt: 'Clown Zauberer LIAR im Einsatz in NRW-Dortmund' },
  { src: _gal6Asset, alt: 'Zaubervorführung auf dem Weihnachtsmarkt Dortmund' },
  { src: _gal8Asset, alt: 'TOP Zaubervorführung in Mülheim' },
  { src: _gal9Asset, alt: 'CLown Kinderzauberer Geburtstag' },
];

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Clown Dortmund, Clown in Dortmund, Clownshow Dortmund, Clown buchen Dortmund, Zauberer Dortmund, NRW"
  canonical="https://liar-entertainer.com/clown/clownshow/clown-in-dortmund/"
  ogImage={heroImg}
  structuredData={structuredData}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Clownshow', url: '/clown/clownshow/' },
    { name: 'Clown in Dortmund', url: '/clown/clownshow/clown-in-dortmund/' }
  ]}
>

  <!-- Hero Section -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl" style="min-height: 600px; box-shadow: 0 12px 32px rgba(0,0,0,0.14);">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImg}'); background-position: center 20%;`}></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative flex flex-col items-center justify-center text-center px-6" style="min-height: 600px;">
      <div class="inline-flex items-center gap-2 bg-white/20 text-white rounded-full px-4 py-1.5 text-sm font-medium mb-4 backdrop-blur-sm">
        <span>📍</span> Dortmund
      </div>
      <h1 class="text-white font-extrabold text-center leading-tight mb-3" style="font-size: clamp(2rem, 5vw, 3.5rem); text-shadow: 2px 2px 8px rgba(0,0,0,0.5);">
        Clown in Dortmund – LIAR | Kindergeburtstag & Events
      </h1>
      <p class="text-gray-200 text-base leading-relaxed max-w-xl mx-auto">
        Clownshow und Unterhaltung in Dortmund – Spaß, Lachen und gute Laune für Groß und Klein!
      </p>
    </div>
  </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <section class="pt-4 pb-0">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="text-sm text-[#595959]">
        <a href="/" class="text-[#d7393e] hover:underline">Clown</a>
        <span class="mx-1">»</span>
        <a href="/clown/clownshow/" class="text-[#d7393e] hover:underline">Clownshow</a>
        <span class="mx-1">»</span>
        <span>Clown in Dortmund – LIAR | Kindergeburtstag & Events</span>
      </nav>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="text-[#d7393e] font-bold text-xl mb-4">Verpassen Sie nicht DEN Clown in Dortmund! 🎉</h2>
          <p class="hero-subtitle text-[#374151] text-[17px] leading-relaxed mb-4">Clown Zauberer LIAR aus Gladbeck begeistert Dortmund mit einer lustigen Clownshow aus Comedy und Zauberei – für Kindergeburtstag, Kita-Fest und Firmenfeier, für Kinder ab 4 Jahren und auf nur 2×2 m Platz. Ebenfalls im Einsatz in Bochum, Herne und Lünen – 370+ Google-Bewertungen sprechen für sich.</p>
          <p class="text-[#374151] mb-4 leading-relaxed">Vom ersten Augenblick an zieht Sie eine mitreißende, humorvolle und magische Vorstellung in ihren Bann. Auf jedem Kindergeburtstag oder Event entsteht diese besondere Atmosphäre: Das Publikum ist nicht nur Zuschauer – es wird Teil des Geschehens! 🎭</p>
          <p class="text-[#374151] mb-4 leading-relaxed">Das Faszinierende dabei? In kürzester Zeit verwandeln sich zurückhaltende Zuschauer in begeisterte kleine Zauberer, die selbst Tricks vorführen möchten. Diese Transformation geschieht viel schneller als die meisten erwarten würden!</p>
        </div>
        <div class="flex justify-center">
          <figure class="text-center">
            <Image src={_gal7Asset} alt="Clownshow in Dortmund" class="rounded-full object-cover object-[20%] portrait-zoom" style="width: 320px; height: 320px;" width={800} height={533} loading="lazy" />
            <figcaption class="px-3 py-1.5 text-sm text-[#374151] bg-white border-t border-gray-100">Clownshow beim Familienfest in Dortmund</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  </HeroStage>
  <!-- Google Reviews -->
  <GoogleReviews />

  <section class="bg-[#eff4ff] py-14 text-center border-y border-[#c5d3f7]">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-[#d7393e] font-bold text-sm uppercase tracking-widest mb-4">DORTMUND</p>
      <h2 class="text-[#1f2025] font-bold text-3xl sm:text-4xl mb-6">✨ Clownshow in Dortmund – mit Herz &amp; Humor</h2>
      <p class="text-[#1f2025] leading-relaxed mb-4">
        Meine Show ist speziell auf Kinder abgestimmt: lebendig, interaktiv und voller Überraschungen.
      </p>
      <p class="text-[#1f2025] leading-relaxed">
        Die Kinder dürfen mitzaubern, lachen, staunen – und manchmal selbst zur kleinen Zauberin oder zum Zauberer werden.
        Dabei achte ich besonders auf Respekt, Empathie und ein liebevolles Miteinander.
      </p>
    </div>
  </section>

  <!-- Meine Arbeitsweise: Persönlich und professionell 🎭 -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl text-center mb-6">Meine Arbeitsweise: Persönlich und professionell 🎭</h2>
      <p class="text-[#374151] mb-4 leading-relaxed">Mit subtilen Gesten und ausdrucksstarker Mimik schaffe ich es, auf jedem Gesicht ein ehrliches Lächeln hervorzuzaubern 😊. Dabei gehört zu meinem Charakter auch die authentische Tollpatschigkeit – denn genau diese menschliche Seite schafft Nähe zum Publikum!</p>
      <p class="text-[#374151] mb-4 leading-relaxed">In über 6.000 Auftritten bei Privatpartys (Geburtstag, Hochzeit, Taufe), Firmenevents, Vereinsfeiern, Messen, in Theatern sowie in Kindergärten und Grundschulen habe ich eines gelernt: Jede Veranstaltung verdient ein individuelles Programm!</p>
      <p class="text-[#374151] mb-4 leading-relaxed">Ob als mobiler WALK-ACT(Pantomime), der sich flexibel durch Ihre Veranstaltung bewegt, oder in Kombination mit künstlerischer BALLONMODELLAGE und verblüffender ZAUBEREI – Ihre Veranstaltung oder private Feier (Hochzeit, Firmenjubiläum oder Geburtstag) wird dadurch zu einem echten Highlight! 🎉</p>
    </div>
  </section>


  <!-- Stats Banner -->
  <section class="w-full bg-[#fdf2f2] py-10 text-center border-y border-[#f0c4c4]">
    <div class="max-w-4xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
        <div class="text-3xl mb-2">🪄</div>
        <div class="text-4xl font-extrabold text-[#1f2025]">400</div>
        <div class="text-[#1f2025] text-sm mt-1">Shows im Jahr</div>
      </div>
      <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
        <div class="text-3xl mb-2">😊</div>
        <div class="text-4xl font-extrabold text-[#1f2025]">110.000</div>
        <div class="text-[#1f2025] text-sm mt-1">Lachende Kinder</div>
      </div>
      <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
        <div class="text-3xl mb-2">🪄</div>
        <div class="text-4xl font-extrabold text-[#1f2025]">15</div>
        <div class="text-[#1f2025] text-sm mt-1">Jahre Erfahrung</div>
      </div>
    </div>
  </section>


  <!-- Eindrücke, die bewegen 📸 -->
  <section class="bg-white py-14">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl text-center mb-6">Eindrücke, die bewegen 📸</h2>
      <p class="text-[#374151] mb-4 leading-relaxed">Fotos und Videos von meinen Shows öffnen eine Welt der Emotionen! Sie zeigen authentische Momente: lachende Kindergesichter, staunende Blicke, überraschte Erwachsene. Diese visuellen Eindrücke regen an, unser Verständnis für die Kraft von guter Unterhaltung zu vertiefen.</p>
      <p class="text-[#374151] mb-4 leading-relaxed">Bilder und Videoclips haben die besondere Kraft, Emotionen hervorzurufen und eine emotionale Verbindung zu schaffen. Eine Galerie kann uns dazu bringen, uns mit den dargestellten Momenten und Geschichten zu verbinden – oder einfach spontane, schöne Eindrücke festzuhalten! Viel Spaß beim Stöbern durch die visuellen Erinnerungen! 📷🎬</p>
    </div>
  </section>

  <!-- Bildergalerie -->
  <section class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4">
      <HeroSlider slides={_pageGallery} class="reveal" />
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-center font-bold text-[#1f2025] text-sm uppercase tracking-widest mb-2">Häufige Fragen zum Clown-Auftritt in Dortmund</h2>
      <h3 class="text-center font-bold text-[#1f2025] text-2xl sm:text-3xl mb-10">
        Hier sind ein paar Antworten
      </h3>

      <div class="space-y-3" id="faq-list">
        <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Was braucht Clown LIAR für einen Auftritt?</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Kindergarten, Turnhalle… Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!
          </div>
        </div>
        <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Wieviel Platz braucht man für das Programm?</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            LIAR ist ziemlich pflegeleicht: für die Show ist es wichtig, dass die Kinder gemütlich und ungestört sitzen können!!! Bei der Ballonmodellage ist nichts weiteres nötig. Bei GLITZER TATTOOS wären schon 2 Stühle und einen Tisch wichtig!
          </div>
        </div>
        <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Wie viele Kinder sollten überhaupt eingeladen werden?</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen.
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Video Sektion -->
  <section class="py-14 bg-[#eff4ff] border-y border-[#c5d3f7]">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-[#1f2025] font-extrabold text-xl uppercase tracking-widest mb-6">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="relative w-full max-w-2xl mx-auto mb-8" style="padding-bottom: 56.25%; position: relative;">
        <iframe
          src="https://www.youtube.com/embed/Cop0SqRIX4Y"
          title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!"
          class="absolute inset-0 w-full h-full rounded-lg"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <h3 class="text-[#1f2025] font-bold text-xl mb-6">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a
        href="/galerie/"
        class="inline-block bg-[#f5a623] hover:bg-[#e69420] text-[#1f2025] font-bold px-10 py-4 rounded-full text-base transition-colors"
      >
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>



  <!-- Einsatzgebiet -->
  <section class="bg-white py-14">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-[#d7393e] font-bold text-2xl text-center mb-10">Nicht nur in Dortmund unterwegs</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <p class="text-[#374151] mb-4 leading-relaxed">Besonders häufig trete ich in folgenden Städten auf:</p>
          <h3 class="font-bold text-[#1f2025] mb-3">Ruhrgebiet</h3>
          <p class="text-[#374151] mb-4 leading-relaxed">
            <a href="/clown/clownshow/clown-in-dortmund/" class="text-[#d7393e] hover:underline">Dortmund</a> |
            <a href="/clown/clownshow/clown-in-bochum/" class="text-[#d7393e] hover:underline">Clown in Bochum buchen</a> |
            <a href="/clown/clownshow/clown-in-oberhausen/" class="text-[#d7393e] hover:underline">Clownshow für Oberhausen</a> |
            <a href="/clown/clownshow/clown-in-gelsenkirchen/" class="text-[#d7393e] hover:underline">Clown für Kindergeburtstag in Gelsenkirchen</a> |
            <a href="/clown/clownshow/clown-in-recklinghausen/" class="text-[#d7393e] hover:underline">Clown Recklinghausen buchen</a> |
            <a href="/clown/clownshow/clown-in-marl/" class="text-[#d7393e] hover:underline">Clownshow in Marl erleben</a> |
            Duisburg |
            <a href="/clown/clownshow/clown-in-herten/" class="text-[#d7393e] hover:underline">Clown für Kinderfeste in Herten</a> |
            <a href="/clown/clownshow/clown-in-dinslaken/" class="text-[#d7393e] hover:underline">Clown in Dinslaken buchen</a> |
            <a href="/clown/clownshow/clown-in-herne/" class="text-[#d7393e] hover:underline">Clownshow für Herne</a> |
            <a href="/clown/clownshow/clown-in-muelheim/" class="text-[#d7393e] hover:underline">Mülheim an der Ruhr</a> |
            <a href="/clown/clownshow/clown-in-essen/" class="text-[#d7393e] hover:underline">Clown für Kindergeburtstag in Essen</a> |
            <a href="/clown/clownshow/clown-in-gladbeck/" class="text-[#d7393e] hover:underline">Clown Gladbeck buchen</a> (Wohnort) |
            <a href="/clown/clownshow/clown-in-bottrop/" class="text-[#d7393e] hover:underline">Clownshow in Bottrop erleben</a> |
            Castrop-Rauxel | Lünen | Witten | Hagen
          </p>
          <p class="text-[#374151] mb-4 leading-relaxed" data-far-cities>Auch außerhalb dieses Umkreises bin ich unterwegs: Termine in weiter entfernten Städten wie Duisburg, Düsseldorf und Haltern am See lassen sich einrichten – die Anfahrt plane ich dabei einfach mit ein.</p>
          <h3 class="font-bold text-[#1f2025] mb-3">Weitere NRW-Städte</h3>
          <p class="text-[#374151] leading-relaxed">
            Düsseldorf |
            Haltern am See |
            Moers | Krefeld | Reken | Unna | Kamen
          </p>
        </div>
        <div>
          <Image
            src={karteImg}
            alt="Karte Einsatzgebiet Clownshow Dortmund"
            class="rounded-lg w-full h-auto img-hover-zoom"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="bg-white py-10 border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="font-bold text-[#1f2025] text-lg mb-2">Clown Zauberer LIAR</p>
      <p class="text-[#374151] mb-2">Anschrift: Beethovenstr. 15, 45966 Gladbeck</p>
      <p class="text-[#374151] mb-4">
        TEL: <a href="tel:+491721517578" class="hover:text-[#d7393e] transition-colors">0172 – 1517578</a>
        &nbsp;|&nbsp;
        Email: <a href="mailto:info@liar-entertainer.com" class="hover:text-[#d7393e] transition-colors">info@liar-entertainer.com</a>
      </p>
      <a href="/kontakt/" class="inline-block bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold px-8 py-3 rounded transition-colors">
        Kontaktformular
      </a>
    </div>
  </section>

<!-- Cross-Linking: Weitere Services in Dortmund -->
<section class="py-10 bg-[#f9fafb]">
  <div class="max-w-3xl mx-auto px-4 text-center">
