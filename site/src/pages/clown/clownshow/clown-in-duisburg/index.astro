        "@type": "Answer",
        "text": "Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

const _pageGallery = [
  { src: _gal1Asset, alt: 'Clown in Duisburg' },
  { src: _gal2Asset, alt: 'Zaubershow auf einer Bühne' },
  { src: _gal3Asset, alt: 'Wie sehen Glitzer Tattoos aus?' },
  { src: _gal4Asset, alt: 'Duisburg – Eindruck 4 mit Clown Zauberer LIAR' },
  { src: _gal5Asset, alt: 'Duisburg – Eindruck 5 mit Clown Zauberer LIAR' },
  { src: _gal6Asset, alt: 'Duisburg – Eindruck 6 mit Clown Zauberer LIAR' },
  { src: _gal8Asset, alt: 'Duisburg – Eindruck 7 mit Clown Zauberer LIAR' },
  { src: _gal9Asset, alt: 'Duisburg – Eindruck 8 mit Clown Zauberer LIAR' },
  { src: _clownShowAsset, alt: 'Clown LIAR bei Clownshow in Duisburg' },
