            <figcaption class="px-3 py-1.5 text-sm text-[#374151] bg-white border-t border-gray-100">Clownshow für Kinder in Bottrop</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  </HeroStage>
  <!-- Google Reviews -->
