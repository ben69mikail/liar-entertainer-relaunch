---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HeroSlider from '../../../../components/HeroSlider.astro';
import HeroStage from '../../../../components/HeroStage.astro';
import karteImg from '../../../../assets/images/home/clown-zauberer-gladbeck-karte.jpg';
import { Image } from 'astro:assets';
import _heroImgAsset from '../../../../assets/images/home/clown-zauberer-hero.jpg';
import _clownIntroAsset from '../../../../assets/images/clown/clown-zauberer-gladbeck.jpg';
import _gal1Asset from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-1.jpg';
import _gal2Asset from '../../../../assets/images/galerie/buehnen-zauberei.jpg';
import _gal3Asset from '../../../../assets/images/clown/glitzer-tattoos.jpg';
import _gal4Asset from '../../../../assets/images/zauberer/zaubershow-mit-clown-zauberer.jpg';
import _gal5Asset from '../../../../assets/images/clown/kosten-preis-clown-nrw.jpg';
import _gal6Asset from '../../../../assets/images/zauberer/zaubervorfuehrung-weihnachtsmarkt-dortmund.jpg';
import _gal7Asset from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-16.jpg';
import _gal8Asset from '../../../../assets/images/zauberer/zaubershow-staunende-kinder.jpg';
import _gal9Asset from '../../../../assets/images/galerie/fotogalerie-clown-zauberer-2.jpg';
import GoogleReviews from '../../../../components/GoogleReviews.astro';

const seoTitle = "Clown Gelsenkirchen | TOP Bewertungen | Buchen";
const seoDescription = "Clown in Gelsenkirchen für Kindergeburtstag ✓ Clown LIAR ✓ 370+ Top-Bewertungen ✓ Lustig & magisch ✓ Auch in Gladbeck & Herten ✓ Jetzt buchen!";
const heroImg = _heroImgAsset.src;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Clown in Gelsenkirchen",
  "description": "Clown LIAR für Kindergeburtstag und Kinderfest in Gelsenkirchen, NRW",
  "url": "https://liar-entertainer.com/clown/clownshow/clown-in-gelsenkirchen/",
  "serviceType": ["Clownshow", "Kinderunterhaltung"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "City", "name": "Gelsenkirchen" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was braucht Clown LIAR für einen Auftritt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Kindergarten, Turnhalle… Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!"
      }
    },
    {
      "@type": "Question",
      "name": "Wieviel Platz braucht man für das Programm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LIAR ist ziemlich pflegeleicht: für die Show ist es wichtig, dass die Kinder gemütlich und ungestört sitzen können!!! Bei der Ballonmodellage ist nichts weiteres nötig. Bei GLITZER TATTOOS wären schon 2 Stühle und einen Tisch wichtig!"
      }
    },
    {
      "@type": "Question",
      "name": "Wie viele Kinder sollten überhaupt eingeladen werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

const _pageGallery = [
  { src: _gal1Asset, alt: 'Clown in Gelsenkirchen modelliert in Ballons' },
  { src: _gal2Asset, alt: 'Zaubershow in Gelsenkirchen auf einer Bühne' },
  { src: _gal3Asset, alt: 'Glitzer Tattoos für die Kinder in Gelsenkirchen' },
  { src: _gal4Asset, alt: 'Auftritt Zaubershow mit Clown Zauberer in Gelsenkirchen' },
  { src: _gal5Asset, alt: 'Clown Zauberer beim Karneval in Gelsenkirchen Resse' },
  { src: _gal6Asset, alt: 'Zaubervorführung auf dem Weihnachtsmarkt Dortmund - Nähe Gelsenkirchen' },
  { src: _gal8Asset, alt: 'Gelsenkirchen – Eindruck 7 mit Clown Zauberer LIAR' },
  { src: _gal9Asset, alt: 'Gelsenkirchen – Eindruck 8 mit Clown Zauberer LIAR' },
];

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Clown Gelsenkirchen, Clown in Gelsenkirchen, Clownshow Gelsenkirchen, Clown buchen Gelsenkirchen, Zauberer Gelsenkirchen, NRW"
  canonical="https://liar-entertainer.com/clown/clownshow/clown-in-gelsenkirchen/"
  ogImage={heroImg}
  structuredData={structuredData}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Clownshow', url: '/clown/clownshow/' },
    { name: 'Clown in Gelsenkirchen', url: '/clown/clownshow/clown-in-gelsenkirchen/' }
  ]}
>

  <!-- Hero Section -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl" style="min-height: 600px; box-shadow: 0 12px 32px rgba(0,0,0,0.14);">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImg}'); background-position: center 20%;`}></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative flex flex-col items-center justify-center text-center px-6" style="min-height: 600px;">
      <div class="inline-flex items-center gap-2 bg-white/20 text-white rounded-full px-4 py-1.5 text-sm font-medium mb-4 backdrop-blur-sm">
        <span>📍</span> Gelsenkirchen
      </div>
      <h1 class="text-white font-extrabold text-center leading-tight mb-3" style="font-size: clamp(2rem, 5vw, 3.5rem); text-shadow: 2px 2px 8px rgba(0,0,0,0.5);">
        TOP Clown in Gelsenkirchen – LIAR | Shows & Zauberkunst
      </h1>
      <p class="text-gray-200 text-base leading-relaxed max-w-xl mx-auto">
        Clownshow und Unterhaltung in Gelsenkirchen – Spaß, Lachen und gute Laune für Groß und Klein!
      </p>
    </div>
  </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <section class="pt-4 pb-0">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="text-sm text-[#595959]">
        <a href="/" class="text-[#d7393e] hover:underline">Clown</a>
        <span class="mx-1">»</span>
        <a href="/clown/clownshow/" class="text-[#d7393e] hover:underline">Clownshow</a>
        <span class="mx-1">»</span>
        <span>TOP Clown in Gelsenkirchen – LIAR | Shows & Zauberkunst</span>
      </nav>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="text-[#d7393e] font-bold text-xl mb-4">Ihr Entertainer für Gelsenkirchen! 🎉</h2>
          <p class="hero-subtitle text-[#374151] text-[17px] leading-relaxed mb-4">Clown Zauberer LIAR aus dem benachbarten Gladbeck begeistert Gelsenkirchen mit einer lustigen Clownshow aus Comedy und Zauberei – für Kindergeburtstag, Kita-Fest und Vereinsfeier, für Kinder ab 4 Jahren und auf nur 2×2 m Platz. Kurze Wege auch nach Herten und Herne – mit 370+ Google-Bewertungen.</p>
          <p class="text-[#374151] mb-4 leading-relaxed">Meine Stärke? Ich schaffe es, selbst zurückhaltende Gäste zum Mitmachen zu bewegen – ohne Druck, sondern durch sympathische Tollpatschigkeit, die verbindet statt zu distanzieren. So entsteht eine Atmosphäre, in der sich alle wohlfühlen!</p>
          <p class="text-[#374151] mb-4 leading-relaxed">Mit meiner flexiblen Clownshow gestalte ich Ereignisse, an die sich Kinder und Familien noch Jahre später gerne erinnern. Ob als beweglicher WALK-ACT zwischen den Gästen, kombiniert mit kreativer BALLONMODELLAGE oder ergänzt durch verblüffende ZAUBEREI – Ihre Veranstaltung oder private Feier (Hochzeit, Betriebsfest oder Geburtstag) erhält dadurch das gewisse Etwas! 🎭✨</p>
        </div>
        <div class="flex justify-center">
          <figure class="text-center">
            <Image src={_gal7Asset} alt="Clownshow in Gelsenkirchen" class="rounded-full object-cover object-[20%] portrait-zoom" style="width: 320px; height: 320px;" width={800} height={533} loading="lazy" />
            <figcaption class="px-3 py-1.5 text-sm text-[#374151] bg-white border-t border-gray-100">Interaktive Clownshow vor Kindern in Gelsenkirchen</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  </HeroStage>
  <!-- Google Reviews -->
  <GoogleReviews />

  <section class="bg-[#eff4ff] py-14 text-center border-y border-[#c5d3f7]">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-[#d7393e] font-bold text-sm uppercase tracking-widest mb-4">GELSENKIRCHEN</p>
      <h2 class="text-[#1f2025] font-bold text-3xl sm:text-4xl mb-6">✨ Clownshow in Gelsenkirchen – mit Herz &amp; Humor</h2>
      <p class="text-[#1f2025] leading-relaxed mb-4">
        Meine Show ist speziell auf Kinder abgestimmt: lebendig, interaktiv und voller Überraschungen.
      </p>
      <p class="text-[#1f2025] leading-relaxed">
        Die Kinder dürfen mitzaubern, lachen, staunen – und manchmal selbst zur kleinen Zauberin oder zum Zauberer werden.
        Dabei achte ich besonders auf Respekt, Empathie und ein liebevolles Miteinander.
      </p>
    </div>
  </section>

  <!-- Show-Konzept mit Herz! 💫 -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl text-center mb-6">Show-Konzept mit Herz! 💫</h2>
      <p class="text-[#374151] mb-4 leading-relaxed">Was unterscheidet meine Show von anderen? Ganz einfach: Bei mir stehen nicht die Tricks im Vordergrund, sondern die Kinder!</p>
      <p class="text-[#374151] mb-4 leading-relaxed">Natürlich sind die Zaubertricks verblüffend und die Clownerien lustig – aber das wahre Highlight ist der Moment, wenn ein schüchternes Kind plötzlich auf der „Bühne" steht und merkt: „Hey, ich kann das auch!" Diese Verwandlung von Zuschauern zu aktiven Teilnehmern geschieht schneller als gedacht.</p>
      <p class="text-[#374151] mb-4 leading-relaxed">Durch geschickte Einbindung sorge ich dafür, dass jedes Kind – egal ob mutig oder zurückhaltend – seinen Moment hat. So entstehen Erinnerungen, die bleiben. Das ist echtes Entertainment mit Mehrwert! 🎪✨</p>
    </div>
  </section>


  <!-- Stats Banner -->
  <section class="w-full bg-[#fdf2f2] py-10 text-center border-y border-[#f0c4c4]">
    <div class="max-w-4xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
        <div class="text-3xl mb-2">🪄</div>
        <div class="text-4xl font-extrabold text-[#1f2025]">400</div>
        <div class="text-[#1f2025] text-sm mt-1">Shows im Jahr</div>
      </div>
      <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
        <div class="text-3xl mb-2">😊</div>
        <div class="text-4xl font-extrabold text-[#1f2025]">110.000</div>
        <div class="text-[#1f2025] text-sm mt-1">Lachende Kinder</div>
      </div>
      <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
        <div class="text-3xl mb-2">🪄</div>
        <div class="text-4xl font-extrabold text-[#1f2025]">15</div>
        <div class="text-[#1f2025] text-sm mt-1">Jahre Erfahrung</div>
      </div>
    </div>
  </section>


  <!-- " DAS Highlight für Ihre Feier : ZAUBERSHOW " 🌟 -->
  <section class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl text-center mb-10">" DAS Highlight für Ihre Feier : ZAUBERSHOW " 🌟</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-[#d7393e] card-hover reveal">
          <h3 class="font-bold text-[#1f2025] text-lg mb-3">ZAUBERSHOW 🎩</h3>
          <p class="text-[#374151] leading-relaxed">Zauberei + Clownerie = Perfekte Mischung! Während der Clown-Charakter für Lockerheit und Lacher sorgt, bringen die Zaubertricks die „Wow"-Momente.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-[#3b55d5] card-hover reveal">
          <h3 class="font-bold text-[#1f2025] text-lg mb-3">Zusatzleistung zur Clownshow: Glitzer-Tattoos ✨</h3>
          <p class="text-[#374151] leading-relaxed">Was Sie erwarten können:</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-[#ffb546] card-hover reveal">
          <h3 class="font-bold text-[#1f2025] text-lg mb-3">Zusatzleistung zur Clownshow: Ballonmodellage 🎈</h3>
          <p class="text-[#374151] leading-relaxed">Die Kinder stehen im absoluten Mittelpunkt. Sie sind nicht nur Publikum, sondern Teil der Show. Diese Philosophie zieht sich durch jeden Trick, jede Geste! 👏✨</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bildergalerie -->
  <section class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4">
      <HeroSlider slides={_pageGallery} class="reveal" />
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-center font-bold text-[#1f2025] text-sm uppercase tracking-widest mb-2">Häufige Fragen zum Clown-Auftritt in Gelsenkirchen</h2>
      <h3 class="text-center font-bold text-[#1f2025] text-2xl sm:text-3xl mb-10">
        Hier sind ein paar Antworten
      </h3>

      <div class="space-y-3" id="faq-list">
        <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Was braucht Clown LIAR für einen Auftritt?</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Kindergarten, Turnhalle… Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!
          </div>
        </div>
        <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Wieviel Platz braucht man für das Programm?</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            LIAR ist ziemlich pflegeleicht: für die Show ist es wichtig, dass die Kinder gemütlich und ungestört sitzen können!!! Bei der Ballonmodellage ist nichts weiteres nötig. Bei GLITZER TATTOOS wären schon 2 Stühle und einen Tisch wichtig!
          </div>
        </div>
        <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Wie viele Kinder sollten überhaupt eingeladen werden?</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen.
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Video Sektion -->
  <section class="py-14 bg-[#eff4ff] border-y border-[#c5d3f7]">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-[#1f2025] font-extrabold text-xl uppercase tracking-widest mb-6">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="relative w-full max-w-2xl mx-auto mb-8" style="padding-bottom: 56.25%; position: relative;">
        <iframe
          src="https://www.youtube.com/embed/Cop0SqRIX4Y"
          title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!"
          class="absolute inset-0 w-full h-full rounded-lg"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <h3 class="text-[#1f2025] font-bold text-xl mb-6">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a
        href="/galerie/"
        class="inline-block bg-[#f5a623] hover:bg-[#e69420] text-[#1f2025] font-bold px-10 py-4 rounded-full text-base transition-colors"
      >
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>



  <!-- Einsatzgebiet -->
  <section class="bg-white py-14">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-[#d7393e] font-bold text-2xl text-center mb-10">Nicht nur in Gelsenkirchen unterwegs</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <h3 class="font-bold text-[#1f2025] mb-3">Stadtteile in Gelsenkirchen</h3>
          <p class="text-[#374151] mb-4 leading-relaxed">
            Ich bin in folgenden Stadtteilen Gelsenkirchens unterwegs: Buer, Horst, Resse, Erle, Schalke, Bismarck, Ückendorf, Beckhausen, Feldmark
          </p>
          <h3 class="font-bold text-[#1f2025] mb-3">Weitere Städte im Ruhrgebiet</h3>
          <p class="text-[#374151] mb-4 leading-relaxed">
            <a href="/clown/clownshow/clown-in-recklinghausen/" class="text-[#3b55d5] hover:underline">Clownshow in Recklinghausen erleben</a> | <a href="/clown/clownshow/clown-in-herne/" class="text-[#3b55d5] hover:underline">Clown für Kinderfeste in Herne</a> | <a href="/clown/clownshow/clown-in-marl/" class="text-[#3b55d5] hover:underline">Clown in Marl buchen</a> | <a href="/clown/clownshow/clown-in-bochum/" class="text-[#3b55d5] hover:underline">Clownshow für Bochum</a> | <a href="/clown/clownshow/clown-in-oberhausen/" class="text-[#3b55d5] hover:underline">Clown für Kindergeburtstag in Oberhausen</a> | Duisburg | <a href="/clown/clownshow/clown-in-herten/" class="text-[#3b55d5] hover:underline">Clown Herten buchen</a> | <a href="/clown/clownshow/clown-in-dinslaken/" class="text-[#3b55d5] hover:underline">Clownshow in Dinslaken erleben</a> | Dortmund | <a href="/clown/clownshow/clown-in-muelheim/" class="text-[#3b55d5] hover:underline">Clown für Kinderfeste in Mülheim</a> | <a href="/clown/clownshow/clown-in-essen/" class="text-[#3b55d5] hover:underline">Clown in Essen buchen</a> | <a href="/clown/clownshow/clown-in-bottrop/" class="text-[#3b55d5] hover:underline">Clownshow für Bottrop</a> | Castrop-Rauxel | Lünen
          </p>
          <p class="text-[#374151] mb-4 leading-relaxed" data-far-cities>Auch außerhalb dieses Umkreises bin ich unterwegs: Termine in weiter entfernten Städten wie Duisburg, Dortmund und Düsseldorf lassen sich einrichten – die Anfahrt plane ich dabei einfach mit ein.</p>
          <h3 class="font-bold text-[#1f2025] mb-3">Auch darüber hinaus</h3>
          <p class="text-[#374151] mb-4 leading-relaxed">
            Düsseldorf | Haltern am See | Moers | Krefeld | Waltrop | Datteln | Reken
          </p>
          <p class="text-[#374151] leading-relaxed">
            Internationale Auftritte: Frankreich, Belgien, Österreich, Schweiz
          </p>
        </div>
        <div>
          <Image
            src={karteImg}
            alt="Karte Einsatzgebiet Clownshow Gelsenkirchen"
            class="rounded-lg w-full h-auto img-hover-zoom"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="bg-white py-10 border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="font-bold text-[#1f2025] text-lg mb-2">Clown Zauberer LIAR</p>
      <p class="text-[#374151] mb-2">Anschrift: Beethovenstr. 15, 45966 Gladbeck</p>
      <p class="text-[#374151] mb-4">
