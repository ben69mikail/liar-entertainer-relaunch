    <div class="flex flex-wrap justify-center gap-4">
      <a href="/kindergeburtstag/geburtstag-in-gladbeck/" class="bg-white rounded-lg px-5 py-3 shadow-sm text-[#d7393e] hover:underline font-medium text-sm">🎂 Kindergeburtstag in Gladbeck</a>
      <a href="/kinderzauberer/kinderzauberer-in-gladbeck/" class="bg-white rounded-lg px-5 py-3 shadow-sm text-[#3b55d5] hover:underline font-medium text-sm">🎩 Kinderzauberer in Gladbeck</a>
    </div>
