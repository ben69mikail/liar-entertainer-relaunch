            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Wieviel Platz braucht man für die Clownshow in Xanten? 📏</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            Ganz wenig! Mit einer Fläche von nur 2×2 Metern führe ich bereits eine vollwertige Show vor – im Wohnzimmer in Lüttingen, im Garten in Wardt, im Pfarrheim in Marienbaum oder im Ferienhaus am See. Ohne lange Vorbereitungszeit, drinnen wie draußen.
          </div>
        </div>
        <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="faq-btn w-full text-left px-6 py-4 font-semibold text-[#1f2025] flex items-center justify-between gap-4"
            aria-expanded="false"
          >
            <span>Kommt der Clown zuverlässig bis nach Xanten? 🚗</span>
            <svg class="w-5 h-5 flex-shrink-0 transition-transform faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-[#374151] leading-relaxed">
            Selbstverständlich! Xanten gehört fest zu meinem Einsatzgebiet am Niederrhein. Die Anfahrt über die A57 beziehungsweise B57 plane ich großzügig ein und stimme die Ankunftszeit vorab mit Ihnen ab – bei über 400 Shows im Jahr ist Pünktlichkeit Routine.
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Video Sektion -->
  <section class="py-14 bg-[#eff4ff] border-y border-[#c5d3f7]">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-[#1f2025] font-extrabold text-xl uppercase tracking-widest mb-6">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="relative w-full max-w-2xl mx-auto mb-8" style="padding-bottom: 56.25%; position: relative;">
        <iframe
          src="https://www.youtube.com/embed/Cop0SqRIX4Y"
          title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!"
          class="absolute inset-0 w-full h-full rounded-lg"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <h3 class="text-[#1f2025] font-bold text-xl mb-6">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a
        href="/galerie/"
        class="inline-block bg-[#f5a623] hover:bg-[#e69420] text-[#1f2025] font-bold px-10 py-4 rounded-full text-base transition-colors"
      >
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>



  <!-- Einsatzgebiet -->
  <section class="bg-white py-14">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-[#d7393e] font-bold text-2xl text-center mb-10">Nicht nur in Xanten unterwegs</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <p class="text-[#374151] mb-4 leading-relaxed">Besonders häufig trete ich in folgenden Städten auf:</p>
          <h3 class="font-bold text-[#1f2025] mb-3">Niederrhein</h3>
          <p class="text-[#374151] mb-4 leading-relaxed">
            Wesel |
            Moers |
            <a href="/clown/clownshow/clown-in-dinslaken/" class="text-[#d7393e] hover:underline">Clown für Kindergeburtstag in Dinslaken</a> |
            Rheinberg | Alpen | Sonsbeck | Kalkar | Kevelaer
          </p>
          <h3 class="font-bold text-[#1f2025] mb-3">Ruhrgebiet</h3>
          <p class="text-[#374151] mb-4 leading-relaxed">
            Duisburg |
            <a href="/clown/clownshow/clown-in-oberhausen/" class="text-[#d7393e] hover:underline">Clownshow in Oberhausen erleben</a> |
            <a href="/clown/clownshow/clown-in-dorsten/" class="text-[#d7393e] hover:underline">Clown für Kinderfeste in Dorsten</a> |
            <a href="/clown/clownshow/clown-in-gladbeck/" class="text-[#d7393e] hover:underline">Clown in Gladbeck buchen</a> |
            <a href="/clown/clownshow/clown-in-essen/" class="text-[#d7393e] hover:underline">Clownshow für Essen</a>
          </p>
          <p class="text-[#374151] mb-4 leading-relaxed" data-far-cities>Auch außerhalb dieses Umkreises bin ich unterwegs: Termine in weiter entfernten Städten wie Wesel, Moers und Duisburg lassen sich einrichten – die Anfahrt plane ich dabei einfach mit ein.</p>
          <p class="text-[#374151] leading-relaxed">
            Selbstverständlich kann man mich auch überregional und international buchen – ich war bereits in Frankreich, Belgien, den Niederlanden, Österreich und der Schweiz im Einsatz!
          </p>
        </div>
        <div>
          <Image
            src={karteImg}
            alt="Karte Einsatzgebiet Clownshow Xanten"
            class="rounded-lg w-full h-auto img-hover-zoom"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="bg-white py-10 border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="font-bold text-[#1f2025] text-lg mb-2">Clown Zauberer LIAR</p>
      <p class="text-[#374151] mb-2">Anschrift: Beethovenstr. 15, 45966 Gladbeck</p>
      <p class="text-[#374151] mb-4">
        TEL: <a href="tel:+491721517578" class="hover:text-[#d7393e] transition-colors">0172 – 1517578</a>
        &nbsp;|&nbsp;
        Email: <a href="mailto:info@liar-entertainer.com" class="hover:text-[#d7393e] transition-colors">info@liar-entertainer.com</a>
      </p>
      <a href="/kontakt/" class="inline-block bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold px-8 py-3 rounded transition-colors">
        Kontaktformular
