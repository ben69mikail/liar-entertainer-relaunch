<!-- Cross-Linking: Weitere Services in Xanten -->
<section class="py-10 bg-[#f9fafb]">
  <div class="max-w-3xl mx-auto px-4 text-center">
    <h2 class="text-[#1f2025] font-bold text-xl mb-4">LIAR in Xanten buchen</h2>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/kindergeburtstag/geburtstag-in-xanten/" class="bg-white rounded-lg px-5 py-3 shadow-sm text-[#d7393e] hover:underline font-medium text-sm card-hover reveal">🎂 Kindergeburtstag in Xanten</a>
      <a href="/kinderzauberer/kinderzauberer-in-xanten/" class="bg-white rounded-lg px-5 py-3 shadow-sm text-[#3b55d5] hover:underline font-medium text-sm card-hover reveal">🎩 Kinderzauberer in Xanten</a>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  document.querySelectorAll('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('.faq-chevron');
      const isOpen = !answer?.classList.contains('hidden');
      if (isOpen) {
        answer?.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer?.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
