      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

const _pageGallery = [
  { src: _gal2Asset, alt: 'Professionelle Zaubershow für Kinder auf Bühne in Herne' },
  { src: _gal3Asset, alt: 'Hautverträgliche Glitzer Tattoos für Kinder bei Feier' },
  { src: _gal4Asset, alt: 'Herne – Eindruck 3 mit Clown Zauberer LIAR' },
  { src: _gal5Asset, alt: 'Herne – Eindruck 4 mit Clown Zauberer LIAR' },
  { src: _gal6Asset, alt: 'Herne – Eindruck 5 mit Clown Zauberer LIAR' },
  { src: _gal7Asset, alt: 'Show mit Kinder bei dem Clown in Herne' },
  { src: _gal8Asset, alt: 'Herne – Eindruck 7 mit Clown Zauberer LIAR' },
  { src: _gal9Asset, alt: 'Herne – Eindruck 8 mit Clown Zauberer LIAR' },
