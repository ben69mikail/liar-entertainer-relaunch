import _gal2Asset from '../../../../assets/images/galerie/buehnen-zauberei.jpg';
import _gal3Asset from '../../../../assets/images/clown/glitzer-tattoos.jpg';
import _gal4Asset from '../../../../assets/images/zauberer/zaubershow-mit-clown-zauberer.jpg';
import _gal5Asset from '../../../../assets/images/clown/kosten-preis-clown-nrw.jpg';
