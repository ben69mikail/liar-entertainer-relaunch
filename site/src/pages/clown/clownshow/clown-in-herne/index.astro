    <div class="flex flex-wrap justify-center gap-4">
      <a href="/kindergeburtstag/geburtstag-in-herne/" class="bg-white rounded-lg px-5 py-3 shadow-sm text-[#d7393e] hover:underline font-medium text-sm card-hover reveal">🎂 Kindergeburtstag in Herne</a>
      <a href="/kinderzauberer/kinderzauberer-in-herne/" class="bg-white rounded-lg px-5 py-3 shadow-sm text-[#3b55d5] hover:underline font-medium text-sm card-hover reveal">🎩 Kinderzauberer in Herne</a>
    </div>
