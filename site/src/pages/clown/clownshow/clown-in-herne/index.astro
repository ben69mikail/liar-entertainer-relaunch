    { name: 'Clownshow', url: '/clown/clownshow/' },
    { name: 'Clown in Herne', url: '/clown/clownshow/clown-in-herne/' }
  ]}
>

  <!-- Hero Section -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
