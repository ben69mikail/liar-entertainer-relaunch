---
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../../../components/v2/Reviews.astro';
import ReviewBadge from '../../../components/v2/ReviewBadge.astro';
import Curtain from '../../../components/v2/kids/Curtain.astro';
import K3Hero from '../../../components/v2/kids/K3Hero.astro';
import ProgramFrame from '../../../components/v2/kids/ProgramFrame.astro';
import GoldDivider from '../../../components/v2/kids/GoldDivider.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import { CONTACT } from '../../../data/site';
import '../../../styles/kids-v3.css';
import { Image } from 'astro:assets';
import walkActHeroImg from '../../../assets/images/clown/walk-act-hero.jpg';
import walkActFestEssenImg from '../../../assets/images/clown/walk-act-fest-essen.jpg';
import ballonmodellage2Img from '../../../assets/images/clown/ballonmodellage-2.jpg';
import walkActStadtfestImg from '../../../assets/images/clown/walk-act-stadtfest.jpg';

const seoTitle = 'Walk Act NRW – Clown | Zauberer | Pantomime | LIAR';
const seoDescription = 'Walk Act NRW ✓ Clown Zauberer LIAR – mobile Unterhaltung für Stadtfeste, Messen & Firmenfeiern ✓ Interaktiv, charmant & unvergesslich ✓ Jetzt anfragen!';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Walk Act in NRW – Clown Zauberer LIAR",
  "description": "Mobiler, interaktiver Walk Act mit Clown Zauberer LIAR in NRW – Close-Up-Zauberei, Pantomime und Comedy für Messen, Stadt- und Straßenfeste, Firmenevents und Empfänge, ganz ohne Bühne.",
  "url": "https://liar-entertainer.com/clown/walk-act/",
  "serviceType": ["Walk Act", "Mobile Unterhaltung", "Close-Up-Zauberei"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Was ist ein Walk Act?', acceptedAnswer: { '@type': 'Answer', text: 'Ein Walk Act ist eine mobile, interaktive Showform: Clown Zauberer LIAR mischt sich frei unter die Gäste und zaubert direkt vor ihren Augen – ohne Bühne, ohne Technik. Ideal für Messen, Stadt- und Straßenfeste, Firmenevents und Empfänge.' } },
    { '@type': 'Question', name: 'Wie lange dauert ein Walk Act?', acceptedAnswer: { '@type': 'Answer', text: 'Die Dauer wird flexibel an den Anlass angepasst – von rund 30 Minuten bis zu mehreren Stunden, auch in mehreren Sets über den Tag verteilt.' } },
    { '@type': 'Question', name: 'Braucht der Walk Act eine Bühne oder Technik?', acceptedAnswer: { '@type': 'Answer', text: 'Nein. Der Walk Act benötigt weder Bühne noch Technik. Die Unterhaltung findet mobil mitten im Publikum statt und ist indoor wie outdoor einsetzbar.' } },
    { '@type': 'Question', name: 'In welchen Städten ist der Walk Act buchbar?', acceptedAnswer: { '@type': 'Answer', text: 'Der Walk Act ist in ganz NRW buchbar, unter anderem in Köln, Düsseldorf, Essen und Dortmund. Auf Anfrage auch überregional.' } },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR als Walk Act und Bühnenkünstler in NRW – mobil, interaktiv und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": { "@type": "Organization", "name": "Clown Zauberer LIAR", "url": "https://liar-entertainer.com" }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];

const highlights = [
  {
    icon: '🎩',
    title: 'Close-Up-Zauberei',
    text: 'Magie hautnah, direkt in den Händen Ihrer Gäste.',
  },
  {
    icon: '🎭',
    title: 'Clowneske Interaktion',
    text: 'Spontane Comedy-Momente mit viel Herz und Charme.',
  },
  {
    icon: '✨',
    title: 'Pantomime & Improvisation',
    text: 'Nonverbale Unterhaltung – perfekt für internationales Publikum.',
  },
];

const idealFuer = [
  { bold: 'Messen & Promotions', rest: ' – für mehr Aufmerksamkeit an Ihrem Stand' },
  { bold: 'Straßenfeste & Stadt-Events', rest: ' – als mobiler Publikumsmagnet' },
  { bold: 'Firmenevents & Jubiläen', rest: ' – charmante Unterhaltung während des Empfangs' },
  { bold: 'Private Feiern & Eröffnungen', rest: ' – als lockerer Eisbrecher mit Humor und Herz' },
];

const vorteile = [
  'Keine Bühne oder Technik erforderlich',
  'Direkte Interaktion mit Gästen oder Kunden',
  'Flexibel einsetzbar, indoor & outdoor',
  'In ganz NRW buchbar (z. B. Köln, Düsseldorf, Essen, Dortmund)',
  'Professioneller Auftritt mit künstlerischer Qualität',
];

const ablauf = [
  { title: 'Ankommen & Einstimmung', text: 'Ich mische mich unter Ihre Gäste, baue Sympathie auf und sorge für erste Lacher.' },
  { title: 'Interaktive Zaubermomente', text: 'Kleine magische Szenen entstehen spontan zwischen den Menschen.' },
  { title: 'Begeisterung & Aufmerksamkeit', text: 'Der Walk-Act zieht das Publikum an, sorgt für Stimmung und Gesprächsstoff.' },
  { title: 'Abschluss & Erinnerung', text: 'Oft bleiben die Gäste für Fotos oder eine letzte kleine Überraschung.' },
];
---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Walk Act NRW, Walk Act buchen, Clown Walk Act, Zauberer Walk Act, Walk Act Straßenfest, Walk Act Firmenevent"
  canonical="https://liar-entertainer.com/clown/walk-act/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Clown', url: '/' }, { name: 'Walk Act', url: '/clown/walk-act/' }]}
>
  <!-- ── Hero: the big-top stage. No reveal here (LCP). ── -->
  <K3Hero>
        <p class="k3-crumbs">
          <a href="/">Clown</a> »
          <a href="/">Clown Zauberer LIAR</a> »
          <span>Walk Act</span>
        </p>
        <ReviewBadge />
        <h1 class="k3-hero__title" data-letters>Walk <span class="k3-mark">Act</span></h1>
        <h2 class="k3-hero__sub">
          Walk Act in NRW –<br />Clown Zauberer LIAR – Pantomime
        </h2>
        <p class="k3-hero__claim">Mobil. Interaktiv. Unvergesslich.</p>
        <div class="k3-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
    <Fragment slot="photo">
      <Image
        src={walkActHeroImg}
        alt="Walk Act NRW – Clown Zauberer LIAR – Pantomime"
        widths={[400, 700, 1000]}
        quality={70}
        sizes="(max-width: 900px) 80vw, 500px"
        loading="eager"
        fetchpriority="high"
      />
      <span class="wa-steps-deco" aria-hidden="true"><span>👣</span><span>👣</span><span>👣</span></span>
    </Fragment>
  </K3Hero>

  <!-- ── Intro ── -->
  <section class="k3-intro">
    <div class="container k3-narrow" data-reveal>
      <h2 class="k3-h2">Walk Act Zauberer in NRW – Clown Zauberer LIAR</h2>
      <p class="k3-lead">
        Ein Walk Act mit Clown Zauberer LIAR (Michaël Prescler) ist mobile, interaktive Walking-Unterhaltung, die sich frei unter die Gäste mischt – buchbar in ganz <strong>NRW</strong> (u. a. Köln, Düsseldorf, Essen, Dortmund) für Messen, Stadt- und Straßenfeste, Firmenevents und Empfänge. Ohne Bühne und Technik, je nach Anlass flexibel von rund 30 Minuten bis zu mehreren Stunden.
      </p>
      <p>
        Als <a href="/">Clown</a> <a href="/zauberer/">Zauberer</a> <strong>LIAR</strong> bringe ich Magie, Humor und charmante Unterhaltung direkt zu Ihren Gästen – mitten im Publikum, auf Messen, Stadtfesten oder Firmenfeiern in NRW.
      </p>
      <p>
        Ich kombiniere <strong>Zauberkunst, Pantomime und spontane Comedy</strong>, um Menschen auf natürliche Weise zu begeistern, zu vernetzen und bleibende Eindrücke zu schaffen.
      </p>
      <p class="wa-intro__punch">
        Kein Bühnenaufbau, kein Aufwand – nur pure, mobile Unterhaltung mit Herz.
      </p>
    </div>
  </section>

  <Reviews />

  <!-- ── Was ist ein Walk-Act? ── -->
  <section class="wa-split">
    <div class="container k3-split k3-split--flip">
      <ProgramFrame class="k3-photo k3-photo--l" data-reveal>
        <Image
          src={walkActFestEssenImg}
          alt="Fest Essen Walk Act"
          widths={[300, 600]}
          quality={60}
          sizes="(max-width: 900px) 80vw, 300px"
          loading="lazy"
          fetchpriority="low"
        />
      </ProgramFrame>
      <div data-reveal>
        <GoldDivider class="wa-divider" />
        <h2 class="k3-h2">Was ist ein Walk-Act?</h2>
        <p>
          Ein Walk-Act ist eine <strong>bewegliche, interaktive Showform</strong>, bei der ich mich frei unter Ihre Gäste mische.
          Ob auf einer Messe, einem Straßenfest oder einer privaten Feier – ich zaubere direkt vor den Augen der Besucher, wechsle von Gruppe zu Gruppe und erschaffe dabei magische Begegnungen voller Lachen und Staunen.
        </p>
        <p>
          Diese Art der Animation ist ideal, wenn Sie Ihrem Event <strong>eine besondere Atmosphäre</strong> verleihen möchten – lebendig, sympathisch und unvergesslich.
        </p>
      </div>
    </div>
  </section>

  <!-- ── WALK ACT Highlights ── -->
  <section class="wa-split k3-alt">
    <div class="container k3-split">
      <div data-reveal>
        <GoldDivider class="wa-divider" />
        <h2 class="k3-h2">WALK ACT Highlights</h2>
        <p class="k3-sub wa-sub">Meine Walk-Act Highlights</p>
        <div class="wa-hl">
          {highlights.map((h, i) => (
            <div class="wa-hl__item" data-reveal data-reveal-delay={i * 0.08}>
              <p class="wa-hl__title"><span class="wa-hl__icon">{h.icon}</span>{h.title}:</p>
              <p class="wa-hl__text">{h.text}</p>
            </div>
          ))}
        </div>
        <a href="/kontakt/" class="btn btn--primary" data-confetti>
          Kontaktformular
        </a>
      </div>
      <ProgramFrame class="k3-photo" data-reveal data-reveal-delay="0.1">
        <Image
          src={ballonmodellage2Img}
          alt="Herzballon bei Ballonmodellage"
          widths={[300, 600]}
          quality={60}
          sizes="(max-width: 900px) 80vw, 300px"
          loading="lazy"
          fetchpriority="low"
        />
      </ProgramFrame>
    </div>
  </section>

  <!-- ── Google-Bewertungen (legacy cards of this page), circus-programme style like the reviews ── -->
  <section class="wa-voices">
    <div class="container">
      <GoldDivider />
      <p class="wa-voices__title k3-center">⭐⭐⭐⭐⭐ Google Bewertungen</p>
      <div class="k3-grid k3-grid--3">
        <figure class="k3-card wa-voice" data-reveal>
          <div class="wa-voice__who">
            <div class="wa-voice__avatar">SJ</div>
            <div>
              <p class="wa-voice__name">Smilson Johnson</p>
              <p class="wa-voice__when">vor 2 Monaten</p>
            </div>
          </div>
          <div class="wa-voice__stars">★★★★★</div>
          <p class="wa-voice__text">In jeder Hinsicht wirklich empfehlenswert!</p>
        </figure>
        <figure class="k3-card wa-voice wa-voice--blue" data-reveal data-reveal-delay="0.08">
          <div class="wa-voice__who">
            <div class="wa-voice__avatar">TA</div>
            <div>
              <p class="wa-voice__name">Thorsten Andres</p>
              <p class="wa-voice__when">vor 2 Monaten</p>
            </div>
          </div>
          <div class="wa-voice__stars">★★★★★</div>
          <p class="wa-voice__text">Was ein geiler Typ! Witz, Charme und Humor im Herzen ❤️</p>
        </figure>
        <figure class="k3-card wa-voice wa-voice--gold" data-reveal data-reveal-delay="0.16">
          <div class="wa-voice__who">
            <div class="wa-voice__avatar">NK</div>
            <div>
              <p class="wa-voice__name">Nina Keller</p>
              <p class="wa-voice__when">vor 2 Monaten</p>
            </div>
          </div>
          <div class="wa-voice__stars">★★★★★</div>
          <p class="wa-voice__text">Mit unglaublich viel Charme und Humor begeistert Michaël die kleinen UND die großen Zuschauer. Ganz große Klasse 🐻</p>
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Straßenfest, Stadtfest, Kinderfest ── -->
  <section class="wa-split k3-alt">
    <div class="container k3-split k3-split--flip">
      <ProgramFrame class="k3-photo k3-photo--l" data-reveal>
        <Image
          src={walkActStadtfestImg}
          alt="Walk Act Stadtfest"
          widths={[300, 600]}
          quality={60}
          sizes="(max-width: 900px) 80vw, 300px"
          loading="lazy"
          fetchpriority="low"
        />
      </ProgramFrame>
      <div data-reveal>
        <GoldDivider class="wa-divider" />
        <h2 class="k3-h2 wa-fest__title">
          Straßenfest,<br />Stadtfest,<br />Kinderfest
        </h2>
        <p>
          Clown Zauberer LIAR unterhält und verblüfft die Zuschauer mit seinem Zauberprogramm. Das Publikum kann die Zauberei und Magie hautnah miterleben – denn die Zaubershow findet mitten unter den Zuschauern statt. Es ist somit die wohl faszinierendste Form der Zauberei bei Straßenfesten, <a href="/zauberer/zaubershow/strassen-sommer-fest/">Stadtfesten</a> und Kinderfesten.
        </p>
        <p>
          Da es sich um kein „festes" Programm handelt, werden die Inhalte und die Zaubertricks immer wieder auf das vorhandene Publikum angepasst. Die Straßen-Zauberei kann sehr gut mit der <a href="/clown/ballonmodellage/">Ballonmodellage</a> kombiniert werden.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Ideal für + Vorteile: dark stage, a red and a blue spotlight on the two cards ── -->
  <section class="k3-band k3-band--spot wa-ideal">
    <span class="k3-spot k3-spot--red" aria-hidden="true"></span>
    <span class="k3-spot k3-spot--blue" aria-hidden="true"></span>
    <div class="container">
      <GoldDivider />
      <div class="k3-grid k3-grid--2 wa-ideal__grid">
        <div class="k3-card wa-ideal__card" data-reveal>
          <h2 class="k3-h2">Ideal für</h2>
          <ul class="wa-ideal__list">
            {idealFuer.map((item) => (
              <li>
                <span class="wa-ideal__dot">●</span>
                <p><strong>{item.bold}</strong>{item.rest}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="k3-card wa-ideal__card" data-reveal data-reveal-delay="0.1">
          <h2 class="k3-h2">Ihre Vorteile</h2>
          <ol class="wa-ideal__list">
            {['Keine Bühne oder Technik erforderlich ✅', 'Direkte Interaktion mit Gästen oder Kunden ✅', 'Flexibel einsetzbar, indoor & outdoor ✅', 'In ganz NRW buchbar (z. B. Köln, Düsseldorf, Essen, Dortmund) ✅', 'Professioneller Auftritt mit künstlerischer Qualität ✅'].map((v, i) => (
              <li>
                <span class="wa-ideal__num">{i + 1}.</span>
                <p>{v}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Ablauf: a walking route, stop by stop ── -->
  <section class="wa-route">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Ablauf eines Walk Acts</h2>
      <div class="wa-route__track">
        <svg class="wa-route__line" viewBox="0 0 1000 24" preserveAspectRatio="none" aria-hidden="true" data-reveal="draw">
          <path d="M20 12 C 180 -4, 320 28, 500 12 S 820 -4, 980 12" fill="none" stroke="#b8862f" stroke-width="1.5" stroke-dasharray="6 7" stroke-linecap="round" />
        </svg>
        <ol class="wa-route__steps">
          {ablauf.map((step, i) => (
            <li class="wa-stop" data-reveal data-reveal-delay={i * 0.12}>
              <div class="wa-stop__num">{i + 1}</div>
              <div>
                <p class="wa-stop__title">{step.title}</p>
                <p class="wa-stop__text">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ── Video: Hollywood premiere, two searchlights from the floor crossing behind the video ── -->
  <section class="k3-band k3-band--night k3-premiere">
    <span class="k3-uplight k3-uplight--l" aria-hidden="true"></span>
    <span class="k3-uplight k3-uplight--r" aria-hidden="true"></span>
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <h2 class="k3-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="k3-video" data-reveal>
        <Curtain trigger="stage" rest="clamp(2.2rem, 10vw, 4.6rem)" span="min(42rem, 100vw - 2rem)" tieback valance />
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
      </div>
      <h3 class="k3-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">Zur Foto- und Videogalerie</a>
    </div>
  </section>

  <!-- ── Kontakt ── -->
  <section class="wa-cta">
    <div class="container k3-narrow k3-center" data-reveal>
      <GoldDivider />
      <h2 class="k3-h2">Einfach Kontakt aufnehmen</h2>
      <p>
        Sie können mir Ihre Anfrage unverbindlich senden. Ihre Angaben werden selbstverständlich absolut vertraulich behandelt und nicht weitergegeben. Je mehr Angaben ich von Ihnen bekomme, desto besser kann ich Sie beraten.
      </p>
      <div class="wa-cta__contact">
        <p>📱 Telefon &amp; WhatsApp: <a href="tel:+491721517578">0172-1517578</a></p>
        <p>✉️ E-Mail: <a href="mailto:info@liar-entertainer.com">info@liar-entertainer.com</a></p>
        <p>📍 Standort: Beethovenstr. 15, 45966 Gladbeck</p>
      </div>
      <a href="/kontakt/" class="btn btn--primary" data-confetti>
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero: footprints walk along the photo frame's lower edge, one step after another ── */
  .wa-steps-deco { position: absolute; left: 1.4rem; bottom: -1.3rem; display: flex; gap: 0.5rem; font-size: 1.7rem; line-height: 1; pointer-events: none; }
  .wa-steps-deco span { display: inline-block; rotate: 80deg; filter: drop-shadow(0 2px 4px rgba(10, 5, 40, 0.45)); animation: wa-step 3.6s var(--ease-out) infinite; }
  .wa-steps-deco span:nth-child(2) { animation-delay: 0.45s; translate: 0 -0.5rem; }
  .wa-steps-deco span:nth-child(3) { animation-delay: 0.9s; }
  @keyframes wa-step { 0%, 100% { opacity: 0.25; } 12%, 55% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .wa-steps-deco span { animation: none; } }

  /* ── intro ── */
  .wa-intro__punch { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--accent-strong); }

  /* ── split sections (photo + text) ── */
  .wa-split p { color: var(--ink-soft); }
  .wa-split strong { color: var(--ink); }
  .wa-split :global(.wa-divider) { margin-inline: 0; }
  .wa-sub { margin-top: 0; }
  .wa-fest__title { text-transform: uppercase; line-height: 1.05; }

  /* ── highlights: paper slips with a fine gold edge ── */
  .wa-hl { display: grid; gap: var(--space-2); margin-bottom: var(--space-4); }
  .wa-hl__item { padding: var(--space-2) var(--space-3); background: var(--surface); border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.4); }
  .wa-split .wa-hl__title { font-weight: 800; color: var(--ink); margin-bottom: 0.2rem; }
  .wa-hl__icon { margin-right: 0.5rem; }
  .wa-split .wa-hl__text { margin: 0; font-size: 0.97rem; }

  /* ── legacy review cards ── */
  .wa-voices__title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; }
  .wa-voice { --c: var(--velvet); margin: 0; }
  .wa-voice--blue { --c: #2c3a86; }
  .wa-voice--gold { --c: var(--gold); }
  .wa-voice__who { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.6rem; }
  .wa-voice__avatar {
    flex: none; display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: var(--c); color: #fff; font-weight: 800; font-size: 0.9rem; box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px rgba(184, 134, 47, 0.6);
  }
  .wa-voice .wa-voice__name { font-weight: 800; margin: 0; font-size: 0.95rem; }
  .wa-voice .wa-voice__when { margin: 0; font-size: 0.82rem; color: var(--ink-soft); }
  .wa-voice__stars { color: var(--star); letter-spacing: 0.06em; margin-bottom: 0.4rem; }
  .wa-voice .wa-voice__text { margin: 0; color: var(--ink-soft); }

  /* ── ideal für (spotlight stage): two programme cards ── */
  .wa-ideal__grid { margin-top: 0; }
  .wa-ideal__card .k3-h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); }
  .wa-ideal__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .wa-ideal__list li { display: flex; gap: 0.65rem; align-items: flex-start; }
  .wa-ideal__list p { margin: 0; color: var(--ink-soft); }
  .wa-ideal__card strong { color: var(--ink); }
  .wa-ideal__dot { color: var(--accent-strong); flex: none; font-size: 0.8rem; margin-top: 0.3rem; }
