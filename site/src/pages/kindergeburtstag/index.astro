---
import V2Layout from '../../layouts/V2Layout.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/kindergeburtstag/kindergeburtstag-hero.jpg';
import kinderzaubererImg from '../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';
import showImg from '../../assets/images/kindergeburtstag/clown-zauberer-kindergeburtstag-show.jpg';
import karteImg from '../../assets/images/home/clown-zauberer-gladbeck-karte.jpg';
import Reviews from '../../components/v2/Reviews.astro';
import ReviewBadge from '../../components/v2/ReviewBadge.astro';
import Curtain from '../../components/v2/kids/Curtain.astro';
import CurtainFrame from '../../components/v2/kids/CurtainFrame.astro';
import GoldDivider from '../../components/v2/kids/GoldDivider.astro';
import HatTrick from '../../components/v2/kids/HatTrick.astro';
import BalloonDog from '../../components/v2/kids/BalloonDog.astro';
import Glitter from '../../components/v2/kids/Glitter.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { CONTACT } from '../../data/site';
import '../../styles/kids-v3.css';

const seoTitle = 'Zauberer Kindergeburtstag NRW | Ab 150€ | Clown LIAR';
const seoDescription = 'Zauberer für Kindergeburtstag in NRW buchen ✓ Clown Zauberer LIAR ✓ Zaubershow ab 150€ ✓ Ballonmodellage ✓ Glitzer-Tattoos ✓ 370+ Top-Bewertungen ✓ Jetzt buchen!';

const faqItems = [
  {
    question: 'Was braucht Kinderzauberer LIAR für einen Auftritt?',
    answer: 'LIAR ist ziemlich pflegeleicht: für die Show ist es wichtig, dass die Kinder gemütlich und ungestört sitzen können!!! Bei der Ballonmodellage ist nichts weiteres nötig. Bei GLITZER TATTOOS wären 2 Stühle und einen Tisch schon wichtig! So können die Kinder sehen was angeboten wird und sich bestens entscheiden!',
  },
  {
    question: 'Wieviel Platz braucht man für den Auftritt?',
    answer: 'Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Bücherei, Kindergarten, Turnhalle… Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!',
  },
  {
    question: 'Wie viele Kinder sollten überhaupt eingeladen werden?',
    answer: 'Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen. Sicherheit geht immer vor!',
  },
  {
    question: 'Kann ich Zaubershow, Ballontiere und Glitzer Tattoos kombinieren?',
    answer: 'Ja, das ist das beliebteste Paket! Zaubershow (40 Min.) für 150€, plus Ballonmodellage (+20€) und Glitzer Tattoos (+40€). Die Gesamtdauer beträgt dann ca. 90 Minuten – der perfekte Rundum-Kindergeburtstag!',
  },
  {
    question: 'Was muss ich als Elternteil vorbereiten?',
    answer: 'Fast nichts! Es muss nur dafür gesorgt werden, dass die Kinder gemütlich sitzen können und ein Bereich von ca. 2×2 Metern frei ist. Alles andere wird mitgebracht. Für Glitzer Tattoos wären zwei Stühle und ein Tisch hilfreich.',
  },
  {
    question: 'Sind die Glitzer Tattoos hautverträglich?',
    answer: 'Ja, alle verwendeten Materialien sind dermatologisch getestet und enthalten keine bekannten Allergene. Die Tattoos halten 4-8 Tage und sind wasserfest.',
  },
  {
    question: 'Was für einen Zauberer für Kinder soll ich zum Geburtstag buchen?',
    answer: 'Für einen Geburtstag für Kinder eignet sich ein Zauberer für Kinder besonders gut, wenn die Show auf das Alter der Gäste abgestimmt ist. Bei LIAR heißt das: ab 4 Jahren, 40 Minuten, interaktiv, und das Geburtstagskind steht im Mittelpunkt.',
  },
  {
    question: 'Ab wie vielen Kindern kann ich buchen?',
    answer: 'Es gibt keine Mindestzahl. Die Zaubershow funktioniert bereits ab wenigen Kindern und ist für bis zu ca. 12 Kinder konzipiert. Für größere Gruppen (Schulfeste, Kita-Feste) gibt es individuelle Angebote.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Kindergeburtstag mit Clown Zauberer',
  description: 'Professionelle Zaubershow, Ballonmodellage und Glitzer Tattoos für Kindergeburtstage in NRW',
  provider: { "@id": "https://liar-entertainer.com/#business" },
  areaServed: {
    '@type': 'State',
    name: 'Nordrhein-Westfalen',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Kindergeburtstag-Pakete',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Zaubershow',
        price: '150',
        priceCurrency: 'EUR',
        description: '40 Minuten interaktive Zaubershow für bis zu 12 Kinder, inkl. Material',
      },
      {
        '@type': 'Offer',
        name: 'Zaubershow + Ballonmodellage',
        price: '170',
        priceCurrency: 'EUR',
        description: 'Zaubershow plus Ballontiere für jedes Kind, ca. 55 Minuten',
      },
      {
        '@type': 'Offer',
        name: 'Komplett-Paket',
        price: '210',
        priceCurrency: 'EUR',
        description: 'Zaubershow + Ballonmodellage + Glitzer Tattoos, ca. 90 Minuten',
      },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow und Clownshow für Kinder in NRW. Kindergeburtstag ab 150€ – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": {
    "@type": "Organization",
    "name": "Clown Zauberer LIAR",
    "url": "https://liar-entertainer.com"
  }
};

const structuredData = [serviceSchema, faqSchema, videoSchema];
---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Kindergeburtstag NRW, Kindergeburtstag Clown, Kindergeburtstag Zauberer, Clown Kindergeburtstag buchen, Zauberer für Kindergeburtstag, Kinderparty NRW, Kindergeburtstag Unterhaltung"
  canonical="https://liar-entertainer.com/kindergeburtstag/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Kindergeburtstag', url: '/kindergeburtstag/' }]}
>
  <!-- ── Hero: the stage between red velvet curtains. No reveal here (LCP). ── -->
  <section class="k3-hero">
    <canvas class="kg-rays" aria-hidden="true" data-side-rays='{"rayColor1":"#ffd27a","rayColor2":"#ffb546","origin":"top-right","speed":1.6,"intensity":2,"spread":1.4,"saturation":1.5,"blend":0.4,"falloff":1.3,"opacity":0.9}'></canvas>
    <Curtain rest="var(--curtain)" tieback valance />
    <div class="container k3-hero__grid">
      <div class="k3-hero__copy">
        <ReviewBadge />
        <h1 class="k3-hero__title" data-letters>
          Zauberer für <span class="k3-mark">Kindergeburtstag</span> in NRW<br />mit Clown & Lachgarantie
        </h1>
        <div class="k3-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
        <nav class="k3-quick" aria-label="Schnell zu den Infos">
          <a href="#preise">Preise &amp; Pakete</a>
          <a href="#faq">Ablauf &amp; Fragen</a>
          <a href="#bewertungen">Bewertungen</a>
          <a href="#einsatzgebiet">Städte</a>
        </nav>
      </div>
      <CurtainFrame class="k3-hero__photo" shape={heroImg.width >= heroImg.height ? 'landscape' : 'portrait'}>
        <Image
          src={heroImg}
          alt="Kindergeburtstag mit Clown Zauberer NRW"
          widths={[400, 700, 1000]}
          quality={70}
          sizes="(max-width: 900px) 80vw, 500px"
          loading="eager"
          fetchpriority="high"
        />
      </CurtainFrame>
    </div>
  </section>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="k3-intro">
    <div class="container k3-intro__grid">
      <div data-reveal>
        <h2 class="k3-kicker">Clown Zauberer für Kindergeburtstage in NRW</h2>
        <h3 class="k3-h3">Magische Momente voller Lachen, Staunen und Freude</h3>
        <p class="k3-lead">
          Ein Zauberer für den Kindergeburtstag in NRW ist ab 150&nbsp;€ buchbar: Clown Zauberer LIAR (Michaël Prescler) gestaltet eine 40-minütige interaktive Zaubershow für bis zu 12 Kinder, auf Wunsch ergänzt um Ballonmodellage und Glitzer-Tattoos. Buchbar in ganz NRW, mit 370+ Top-Bewertungen.
        </p>
        <p>
          Ein Kindergeburtstag soll unvergesslich sein – voller Lachen, Spannung und echter Magie.<br />
          Mit meiner kindgerechten <a href="/zauberer/zaubershow/">Zaubershow</a> bringe ich die Augen kleiner Gäste zum Leuchten und sorge dafür, dass jedes Kind sich als Teil der Show fühlt.
        </p>
        <p>
          Ich bin <a href="/">Clown</a> <a href="/zauberer/">Zauberer</a> LIAR (Michaël Prescler) – professioneller <a href="/kinderzauberer/">Kinderzauberer</a> mit Herz, Humor und über 15 Jahren Erfahrung auf Familienfeiern, in Kindergärten und bei Stadtfesten in ganz NRW. Alle Details zum <a href="/kinderzauberer/">Zauberer für den Kindergeburtstag</a> – Ablauf, Alter und Buchung – finden Sie auf meiner Kinderzauberer-Seite.
        </p>
        <CurtainFrame class="k3-intro__photo" shape="landscape">
          <Image
            src={showImg}
            alt="Clown Zauberer LIAR begeistert Kinder bei einer interaktiven Zaubershow"
            widths={[360, 560, 800]}
            quality={60}
            sizes="(max-width: 900px) 88vw, 620px"
            loading="lazy"
            fetchpriority="low"
          />
        </CurtainFrame>
      </div>
      <aside class="k3-expect" data-reveal data-reveal-delay="0.1">
        <CurtainFrame shape={kinderzaubererImg.width >= kinderzaubererImg.height ? 'landscape' : 'portrait'}>
          <Image
            src={kinderzaubererImg}
            alt="Kinderzauberer verzaubert Kinder auf einem Kindergeburtstag in NRW"
            widths={[320, 640]}
            quality={60}
            sizes="(max-width: 900px) 80vw, 340px"
            loading="lazy"
            fetchpriority="low"
          />
        </CurtainFrame>
        <p class="k3-expect__title">✨ Was Sie erwartet:</p>
        <ul class="k3-expect__list">
          <li>🎪 Interaktive Zaubershow vom Kinderzauberer (40 Min.)</li>
          <li>🎈 Ballonmodellage für jedes Kind (optional)</li>
          <li>✨ Glitzer Tattoos (optional)</li>
          <li>😊 Kindgerechter Humor vom erfahrenen Kinderzauberer</li>
          <li>📍 Flexibel in ganz NRW buchbar</li>
          <li>💰 Transparente Preise ab 150€</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ── Zaubershow: the ring, red velvet ─────────────────── -->
  <section class="k3-band k3-band--velvet">
    <div class="container k3-narrow k3-center" data-reveal>
      <HatTrick />
      <GoldDivider />
      <p class="k3-kicker">VOLLTREFFER</p>
      <h2 class="k3-h2">✨ Zaubershow für Geburtstag – mit Herz &amp; Humor</h2>
      <p>
        Meine <strong>Zaubershow</strong> ist speziell auf Kinder abgestimmt:<br />
        lebendig, interaktiv und voller Überraschungen.
      </p>
      <p>
        Die Kinder dürfen mitzaubern, lachen, staunen – und manchmal selbst zur kleinen Zauberin oder zum Zauberer werden.
      </p>
      <p>
        Dabei achte ich besonders auf <strong>Respekt, Empathie und ein liebevolles Miteinander</strong>.<br />
        Kein Kind wird bloßgestellt – jedes Kind wird Teil einer positiven, fröhlichen Erfahrung.
      </p>
      <p>
        Egal ob im Wohnzimmer, Garten oder im Gemeindesaal – meine Show passt sich flexibel an jede Umgebung an und sorgt garantiert für strahlende Gesichter.
      </p>
    </div>
  </section>

  <!-- ── Preise ────────────────────────────────────────────── -->
  <section class="k3-prices" id="preise">
    <div class="container">
      <GoldDivider />
      <h2 class="k3-h2 k3-center" data-reveal>Was kostet ein Zauberer für den Kindergeburtstag?</h2>

      <div class="k3-table-wrap" data-reveal>
        <table class="k3-table">
          <caption class="sr-only">Pakete und Preise für den Kindergeburtstag mit Clown Zauberer LIAR</caption>
          <thead>
            <tr>
              <th scope="col">Paket</th>
              <th scope="col">Dauer</th>
              <th scope="col">Preis</th>
              <th scope="col">Geeignet für</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Zaubershow</th>
              <td>40 Minuten</td>
              <td class="k3-price">150 €</td>
              <td>4–12 Jahre, bis ca. 12 Kinder</td>
            </tr>
            <tr>
              <th scope="row">Zaubershow + Ballonmodellage</th>
              <td>ca. 55 Minuten</td>
              <td class="k3-price">170 €</td>
              <td>Jedes Kind bekommt eine Ballonfigur</td>
            </tr>
            <tr class="is-popular">
              <th scope="row">Komplett-Paket inkl. Glitzer-Tattoos</th>
              <td>ca. 90 Minuten</td>
              <td class="k3-price">210 €</td>
              <td>Beliebteste Buchung</td>
            </tr>
            <tr class="is-muted">
              <th scope="row">Fahrtkosten</th>
              <td>–</td>
              <td class="k3-price">0,40 €/km</td>
              <td>Hin- und Rückfahrt ab Gladbeck</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="k3-cards">
        <article class="k3-card k3-card--star" data-reveal>
          <h3>🎩 Zaubershow</h3>
          <p class="k3-card__price" data-count>150 €</p>
          <ul>
            <li><span>✓</span> 40 Minuten voller Zauber, Lachen und Staunen</li>
            <li><span>✓</span> Bis ca. 12 Kinder – Mindestalter: 4 Jahre</li>
            <li><span>✓</span> Inkl. Material</li>
            <li><span>✓</span> Das Geburtstagskind steht immer im Mittelpunkt</li>
            <li><span>✓</span> zzgl. Fahrtkosten (0,40€/km, Hin- &amp; Rückfahrt) ab Gladbeck</li>
          </ul>
          <p class="k3-card__note">Direkt ab der ersten Minute nimmt die Show die kleinen Gäste mit auf eine fantasievolle Reise!</p>
        </article>

        <article class="k3-card" data-reveal data-reveal-delay="0.08">
          <h3>🎈 Luftballonmodellage</h3>
          <p class="k3-card__price" data-count>+ 20 €</p>
          <ul>
            <li><span>✓</span> Für jedes Kind 1 Ballon</li>
            <li><span>✓</span> Ca. 15 Minuten</li>
            <li><span>✓</span> Tolle Erinnerung zum Mitnehmen</li>
            <li><span>✓</span> Große Auswahl an Figuren: Hund, Schwert, Blume u.v.m.</li>
            <li><span>✓</span> Perfekte Ergänzung zur Zaubershow</li>
          </ul>
          <p class="k3-card__note">Ob Schwerter, Hunde oder Blumen – die Kinder staunen, wenn aus einem Ballon ihre Wunschfigur entsteht!</p>
        </article>

        <article class="k3-card" data-reveal data-reveal-delay="0.16">
          <h3>✨ Glitzer-Tattoos</h3>
          <p class="k3-card__price" data-count>+ 40 €</p>
          <ul>
            <li><span>✓</span> Für jedes Kind 1 Tattoo</li>
            <li><span>✓</span> Ca. 30 Minuten</li>
            <li><span>✓</span> Hautverträglich &amp; langanhaltend</li>
            <li><span>✓</span> Viele Motive: Einhörner, Schmetterlinge, Sterne u.v.m.</li>
            <li><span>✓</span> Hält mehrere Tage auf der Haut</li>
          </ul>
          <p class="k3-card__note">Ein funkelndes Highlight, das die Kinder noch Tage nach der Feier begeistert!</p>
        </article>
      </div>

      <p class="k3-center k3-cta-row">
        <a href="/kontakt/" class="btn btn--primary" data-confetti>Jetzt unverbindlich anfragen</a>
      </p>
    </div>
  </section>

  <!-- ── Zusatzleistungen ──────────────────────────────────── -->
  <section class="k3-extras k3-band k3-band--spot">
    <!-- light show: a red and a blue spotlight from either side pick out the two extras -->
    <span class="k3-spot k3-spot--red" aria-hidden="true"></span>
    <span class="k3-spot k3-spot--blue" aria-hidden="true"></span>
    <div class="container">
      <GoldDivider />
      <h3 class="k3-h2 k3-center" data-reveal>
        Zusatzleistungen zur Zaubershow: Ballonmodellage &amp; Glitzer-Tattoos
      </h3>
      <p class="k3-center k3-sub">Das i-Tüpfelchen für den perfekten Kindergeburtstag</p>
      <p class="k3-center k3-narrow">
        Optional lässt sich die Zaubershow um <a href="/clown/ballonmodellage/">Ballonmodellage</a> oder <a href="/clown/glitzer-tattoo/">Glitzer-Tattoos</a> ergänzen – der Fokus bleibt die interaktive Kinderzauberer-Show. Werfen Sie auch gerne einen Blick in meine <a href="/galerie/">Galerie</a>.
      </p>

      <div class="k3-extras__grid">
        <article class="k3-extra" data-reveal>
          <BalloonDog />
          <h4>🎈 Ballonmodellage</h4>
          <p>
            Bunte Figuren, Tiere und Überraschungen – live vor den Augen der Kinder geformt. Jedes Kind bekommt sein Wunschtier mit nach Hause!
          </p>
          <p><strong>Beliebte Ballonfiguren:</strong><br />
            🐶 Hund | 🐱 Katze | 🦖 Dinosaurier | ⚔️ Schwert | 👑 Krone | 🌸 Blume | 🦋 Schmetterling
          </p>
          <p><strong>Das Besondere:</strong> Jedes Kind darf sich sein Lieblingstier wünschen, und der Clown zaubert es direkt vor den Augen der Kinder. Die Ballonfiguren sind robust und halten mehrere Tage – ein Andenken, das Freude macht!</p>
          <p><strong>Perfekt als:</strong> – Ergänzung zur Clown-Show – Eigenständige Attraktion auf Festen – Walk-Act auf Straßenfesten</p>
          <p class="k3-extra__dur">
            <strong>Dauer:</strong> Ca. 15 Minuten für 12 Kinder (1-2 Min. pro Figur)
          </p>
        </article>

        <article class="k3-extra" data-reveal data-reveal-delay="0.08">
          <Glitter />
          <h4>✨ Glitzer Tattoos</h4>
          <p>
            Kleine Kunstwerke, die Kinder lieben – hautfreundlich, farbenfroh und mit glänzenden Augen garantiert. Die Tattoos halten 4-8 Tage und sind wasserfest!
          </p>
          <p><strong>Beliebte Motive:</strong><br />
            🦄 Einhorn | 🌸 Blumen | 🦖 Dino | ✨ Sterne | 🦋 Schmetterling | 🏴‍☠️ Pirat
          </p>
          <p><strong>Das Besondere:</strong> Jedes Kind darf sich sein Tattoo aussuchen – und seine Lieblingsfarben dazu, ob zwei oder drei spielt keine Rolle. Hauptsache: schön, bunt und lange haltbar!</p>
          <p><strong>Perfekt als:</strong> – Ergänzung zu den Kindergeburtstags-Paketen – Feiern im kleinen Rahmen – Highlight für Groß und Klein</p>
          <p class="k3-extra__dur">
            <strong>Dauer:</strong> Ca. 30 Minuten für 12 Kinder (2-3 Min. pro Tattoo)
          </p>
        </article>
      </div>

      <p class="k3-center k3-tip">
        💡 <strong>Tipp:</strong> Kombinieren Sie alle drei Leistungen für den perfekten Rundum-Sorglos-Kindergeburtstag!
      </p>
    </div>
  </section>

  <Reviews />

  <!-- ── FAQ: native <details>, works without JS ───────────── -->
  <section class="k3-faq" id="faq">
    <div class="container k3-narrow">
      <GoldDivider />
      <h2 class="k3-kicker k3-center">Häufige Fragen zum Kindergeburtstag mit Kinderzauberer</h2>
      <h3 class="k3-h2 k3-center">
        Kindergeburtstag organisieren? Hier sind ein paar Antworten für die perfekte Feier
      </h3>

      <div class="k3-faq__list">
        {faqItems.map((item) => (
          <details class="k3-faq__item" data-reveal>
            <summary><span>{item.question}</span></summary>
            <div class="k3-faq__answer">{item.answer}</div>
          </details>
        ))}
      </div>

      <div class="k3-center k3-faq__contact">
        <p class="k3-faq__contact-title">Einfach Kontakt aufnehmen</p>
        <p>
          Sie können mir Ihre Anfrage für einen Kindergeburtstag unverbindlich senden. Ihre Angaben werden selbstverständlich absolut vertraulich behandelt und nicht weitergegeben. Je mehr Angaben ich von Ihnen bekomme, desto besser kann ich Sie beraten. Sie können auch einfach unter 0172-1517578 anrufen oder über WhatsApp schreiben. Ich helfe Ihnen gerne weiter.
        </p>
        <a href="/kontakt/" class="btn btn--primary" data-confetti>Kontaktformular</a>
      </div>
    </div>
  </section>

  <!-- ── Video ─────────────────────────────────────────────── -->
  <section class="k3-band k3-band--night">
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <h2 class="k3-h2">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <div class="k3-video" data-reveal>
        <Curtain trigger="stage" rest="clamp(2.2rem, 10vw, 4.6rem)" span="min(42rem, 100vw - 2rem)" tieback valance />
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
      </div>
      <h3 class="k3-h3">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a href="/galerie/" class="btn btn--primary">Zur Foto- und Videogalerie</a>
    </div>
  </section>

  <!-- ── Einsatzgebiet ─────────────────────────────────────── -->
  <section class="k3-area" id="einsatzgebiet">
