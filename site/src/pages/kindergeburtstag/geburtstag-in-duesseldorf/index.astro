---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSlider from '../../../components/HeroSlider.astro';
import HeroStage from '../../../components/HeroStage.astro';
import karteImg from '../../../assets/images/home/clown-zauberer-gladbeck-karte.jpg';
import { Image } from 'astro:assets';
import _heroImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-hero.jpg';
import _introImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';
import _showImgAsset from '../../../assets/images/zauberer/zaubershow-mit-clown-zauberer.jpg';
import GoogleReviews from '../../../components/GoogleReviews.astro';

const seoTitle = 'Kindergeburtstag Düsseldorf | Zaubershow ab 150€';
const seoDescription = 'Kindergeburtstag in Düsseldorf mit Clown LIAR ✓ Zaubershow ab 150€ ✓ Ballonmodellage ✓ 370+ Bewertungen ✓ Auch in Duisburg & Mülheim ✓ Jetzt buchen!';
const heroImg = _heroImgAsset.src;

const faqItems = [
  {
    question: 'Was braucht Clown LIAR für einen Auftritt?',
    answer: 'Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Bücherei, Kindergarten, Turnhalle… Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!',
  },
  {
    question: 'Wieviel Platz braucht man für das Programm?',
    answer: 'LIAR ist ziemlich pflegeleicht: für die Show ist es wichtig, dass die Kinder gemütlich und ungestört sitzen können!!! Bei der Ballonmodellage ist nichts weiteres nötig. Bei GLITZER TATTOOS wären schon 2 Stühle und einen Tisch schon wichtig! So können die Kinder sehen was angeboten wird und sich bestens entscheiden!',
  },
  {
    question: 'Wie viele Kinder sollten auf dem Geburtstag überhaupt eingeladen werden?',
    answer: 'Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen. Sicherheit geht immer vor!',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Kindergeburtstag mit Clown Zauberer in Düsseldorf',
  description: 'Professionelle Zaubershow, Ballonmodellage und Glitzer Tattoos für Kindergeburtstage in Düsseldorf',
  provider: { "@id": "https://liar-entertainer.com/#business" },
  areaServed: {
    '@type': 'City',
    name: 'Düsseldorf',
  },
  offers: {
    '@type': 'Offer',
    price: '150',
    priceCurrency: 'EUR',
    description: '40 Minuten Zaubershow für Kindergeburtstag',
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const structuredData = [serviceSchema, faqSchema];

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Kindergeburtstag Düsseldorf, Geburtstag Düsseldorf, Clown Kindergeburtstag Düsseldorf, Zauberer Geburtstag Düsseldorf, Kinderparty Düsseldorf, Kindergeburtstag feiern Düsseldorf, NRW, Ruhrgebiet"
  canonical="https://liar-entertainer.com/kindergeburtstag/geburtstag-in-duesseldorf/"
  ogImage={heroImg}
  structuredData={structuredData}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Kindergeburtstag', url: '/kindergeburtstag/' },
    { name: 'Geburtstag in Düsseldorf', url: '/kindergeburtstag/geburtstag-in-duesseldorf/' }
  ]}
>

  <!-- Hero Section -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl" style="min-height: 600px; box-shadow: 0 12px 32px rgba(0,0,0,0.14);">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImg}'); background-position: center 20%;`}></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative flex flex-col items-center justify-center text-center px-6" style="min-height: 600px;">
      <div class="inline-flex items-center gap-2 bg-white/20 text-white rounded-full px-4 py-1.5 text-sm font-medium mb-4 backdrop-blur-sm">
