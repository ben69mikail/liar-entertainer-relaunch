  <!-- Mehr als nur Zuschauen – Alle machen mit! 🎭⭐👧👦 -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl text-center mb-6">Mehr als nur Zuschauen – Alle machen mit! 🎭⭐👧👦</h2>
