---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSlider from '../../../components/HeroSlider.astro';
import HeroStage from '../../../components/HeroStage.astro';
import CountUp from '../../../components/CountUp.astro';
import karteImg from '../../../assets/images/home/clown-zauberer-gladbeck-karte.jpg';
import { Image } from 'astro:assets';
import _heroImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-hero.jpg';
import _introImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';
import _showImgAsset from '../../../assets/images/zauberer/zaubershow-mit-clown-zauberer.jpg';
import GoogleReviews from '../../../components/GoogleReviews.astro';

const seoTitle = "Kindergeburtstag Waltrop | Zaubershow ab 150€";
const seoDescription = "Kindergeburtstag in Waltrop unvergesslich machen! Clown LIAR ✓ Zaubershow ab 150€ ✓ 370+ Bewertungen ✓ Auch in Datteln & Castrop-Rauxel ✓ Anfragen!";
const heroImg = _heroImgAsset.src;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Kindergeburtstag mit Clown Zauberer in Waltrop',
  description: seoDescription,
  provider: { "@id": "https://liar-entertainer.com/#business" },
  areaServed: { '@type': 'City', name: 'Waltrop' },
  offers: { '@type': 'Offer', price: '150', priceCurrency: 'EUR', description: '40 Minuten Zaubershow' },
};

const faqItems = [
  {
    question: 'Was braucht Clown LIAR für einen Auftritt?',
    answer: 'Ohne Vorbereitungszeit und mit einer Fläche von 2\u00d72 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Kindergarten, Turnhalle\u2026 Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!',
  },
