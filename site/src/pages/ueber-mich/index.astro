---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroStage from '../../components/HeroStage.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { Image } from 'astro:assets';

import heroImg from '../../assets/images/ueber-mich/ueber-mich-hero.jpg';
import clownImg from '../../assets/images/ueber-mich/ueber-mich-als-clown.jpg';
import clownZaubererImg from '../../assets/images/ueber-mich/ueber-mich-als-clown-zauberer.jpg';
import karteImg from '../../assets/images/home/clown-zauberer-gladbeck-karte.jpg';

const seoTitle = 'Über Clown Zauberer LIAR | Michael Prescler NRW';
const seoDescription = 'Lernen Sie Clown Zauberer LIAR kennen ✓ Michaël Prescler aus Gladbeck ✓ 15 Jahre Erfahrung ✓ 400+ Shows/Jahr ✓ Französischer Entertainer mit Herz & Humor in NRW';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Michaël Prescler",
  "alternateName": "LIAR",
  "jobTitle": "Professioneller Clown, Zauberer und Entertainer",
  "url": "https://liar-entertainer.com/ueber-mich/",
  "image": "https://liar-entertainer.com/images/fallback/michael-prescler.jpg",
  "sameAs": [
    "https://www.facebook.com/clownzaubererliar",
    "https://www.instagram.com/clown_zauberer_liar"
  ],
  "worksFor": { "@id": "https://liar-entertainer.com/#business" },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Beethovenstr. 15",
    "addressLocality": "Gladbeck",
    "postalCode": "45966",
    "addressCountry": "DE"
  },
  "knowsAbout": ["Zauberei", "Clownerie", "Kinderzauberei", "Ballonmodellage", "Walk-Act", "Pantomime"]
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Clown Zauberer LIAR, Michaël Prescler, Zauberer Gladbeck, Entertainer NRW, Clown Zauberer Vita"
  canonical="https://liar-entertainer.com/ueber-mich/"
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Über mich', url: '/ueber-mich/' }]}
  structuredData={personSchema}
>

  <!-- Page Title -->
  <section class="bg-white pt-8 pb-0">
    <div class="max-w-6xl mx-auto px-4">
      <p class="text-sm text-[#595959] mb-4">
        <a href="/" class="hover:text-[#d7393e]">Clown</a> »
        <span>Über mich</span>
      </p>
      <h1 class="font-black text-[#1f2025] text-3xl sm:text-5xl mb-6">Über mich</h1>
    </div>
  </section>

  <!-- Hero -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl" style="min-height: 600px; box-shadow: 0 12px 32px rgba(0,0,0,0.14);">
    <Image
      src={heroImg}
      alt="Über mich – Clown Zauberer LIAR aus Gladbeck"
      class="absolute inset-0 w-full h-full object-cover object-top"
      style="object-position: 50% 0%"
      loading="eager"
      fetchpriority="high"
      widths={[600, 900, 1200]}
      sizes="(max-width: 1152px) 100vw, 1120px"
    />
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="relative flex items-center justify-center" style="min-height: 600px;">
      <div class="text-center px-6">
        <h2 class="text-white font-bold leading-tight mb-4" style="font-size: clamp(1.6rem, 4vw, 3rem); text-shadow: 2px 2px 8px rgba(0,0,0,0.5);">
          🎭 Über mich –<br />Clown Zauberer LIAR aus Gladbeck
        </h2>
        <p class="text-white/90 text-lg font-medium">15+ Jahre Magie, Lachen &amp; unvergessliche Momente</p>
      </div>
    </div>
  </div>
    </div>
  </section>

  <!-- Über mich – Bild links, Text rechts -->
  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <!-- Bild mit rounded-2xl und Schatten -->
        <div class="flex justify-center">
          <Image
            src={clownImg}
            alt="Über mich als Clown"
            class="rounded-2xl object-cover portrait-zoom"
            style="width: 340px; height: 420px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);"
            loading="eager"
            widths={[400, 700]}
            sizes="340px"
          />
        </div>
        <!-- Bio-Text -->
        <div>
          <h2 class="font-bold text-[#d7393e] text-2xl sm:text-3xl mb-6">Über mich ?</h2>
          <div class="space-y-4 text-[#374151] leading-relaxed">
            <p>
              <strong>Alter:</strong> 49 / <strong>Geburtsland:</strong> Frankreich
            </p>
            <div>
              <p class="font-semibold text-[#1f2025] mb-2">Bildungsweg:</p>
              <p>Abitur, Studium Naturwissenschaften und Erziehungswissenschaften, zusätzliche komplette Ausbildung zum Animateur mit Schauspiel, Tanz, Zauberei, Ballonmodellage, Schminken, Stand Up, Comedy, Sportaktivitäten, PR &amp; Management inklusive 3-jähriger Tätigkeit im Bereich Kinderanimation in Frankreich. Eindrücke meiner Arbeit finden Sie in meiner <a href="/galerie/" class="text-[#d7393e] hover:underline">Foto- und Videogalerie</a>.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  </HeroStage>
  <GoogleReviews />

  <!-- Nach dem Studium – Text links, Bild rechts -->
  <section class="bg-white py-14">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <!-- Text -->
        <div class="order-2 lg:order-1">
          <h2 class="font-black text-[#1f2025] text-2xl sm:text-3xl mb-4">Nach dem Studium</h2>
          <hr class="border-[#1f2025] border-2 mb-6 w-2/3" />
          <div class="space-y-4 text-[#374151] leading-relaxed">
            <p>
              4 Jahre Animation in Europa (Spanien, Griechenland u.a.), 5 Jahre Floor Manager im alpincenter Bottrop (Längste Skihalle der Welt) mit Zuständigkeiten auch im Bereich PR, Sales, Vertrieb und Kinderanimation. Aktuelle Geschichten und Erlebnisse teile ich in meinem <a href="/blog/" class="text-[#d7393e] hover:underline">Blog</a>.
            </p>
            <p>
              Seit 2004 wohnhaft in Deutschland und <a href="/zauberer/" class="text-[#d7393e] hover:underline">Zauberer</a> seit 2009. Seit Februar 2005 Jahren Vater eines Sohnes und seit März 2009 eines weiteren und mit Begeisterung zunehmend im Kinderbereich tätig:
            </p>
            <p>
              Aus dieser Arbeit ist mein heutiger Schwerpunkt geworden: Ich bin in erster Linie <a href="/kinderzauberer/" class="text-[#d7393e] hover:underline">Kinderzauberer</a> und stehe den größten Teil des Jahres auf <a href="/kindergeburtstag/" class="text-[#d7393e] hover:underline">Kindergeburtstagen</a> in Gladbeck und dem übrigen Ruhrgebiet – alles andere, von der Firmenfeier bis zum Stadtfest, kam später dazu.
            </p>
            <!-- Datierte Timeline (SEO-Audit 06.08.2026, Massnahme M5.2): "Nach dem
                 Studium..." laesst sich von einem LLM nicht zu einer Vita verdichten.
                 Die Jahreszahlen sind aus dem bestehenden Fliesstext abgeleitet
                 ("4 Jahre Animation in Europa", "5 Jahre alpincenter", "seit 2004",
                 "seit 2009") — BITTE VON MICHAEL GEGENPRUEFEN. -->
            <div class="bg-[#f9fafb] border border-gray-200 rounded-xl p-5 my-6">
              <p class="font-bold text-[#1f2025] mb-3">Michaël Prescler im Überblick</p>
              <ul class="space-y-1.5 text-sm text-[#374151]">
                <li><strong>2000–2004</strong> Animation in Spanien, Griechenland und weiteren Ländern Europas</li>
                <li><strong>seit 2004</strong> wohnhaft in Gladbeck, Nordrhein-Westfalen</li>
                <li><strong>2004–2009</strong> Floor Manager im alpincenter Bottrop (längste Skihalle der Welt)</li>
                <li><strong>seit 2009</strong> hauptberuflich Clown und Zauberer, rund 400 Shows pro Jahr</li>
                <li><strong>Schwerpunkt</strong> Kinderzauberer für Kindergeburtstage, Kita- und Schulfeste</li>
                <li><strong>Sprachen</strong> Deutsch und Französisch</li>
                <li><strong>Nachweise</strong> erweitertes polizeiliches Führungszeugnis, Haftpflichtversicherung</li>
              </ul>
            </div>

            <ul class="space-y-2 ml-4">
              <li class="flex items-start gap-2">
                <span class="text-[#d7393e] flex-shrink-0">–</span>
                <span>Mitentwicklung von pädagogischen Kinderbewegungsprogrammen (Motorik, Motopädie und Physiotherapie in Prävention) und damit in Kleinkind (Krabbel-)Gruppen und <a href="/zauberer/zaubershow/kindergarten-kita/" class="text-[#d7393e] hover:underline">Kindergärten</a> unterwegs.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#d7393e] flex-shrink-0">–</span>
                <span>Ballonmodellage, Kinderschminken, Animation, Zauberei in Kindergärten, bei allen möglichen Feierlichkeiten</span>
              </li>
            </ul>
          </div>
        </div>
        <!-- Bild mit rounded-2xl und Schatten -->
        <div class="flex justify-center order-1 lg:order-2">
          <Image
            src={clownZaubererImg}
            alt="Über mich als Clown Zauberer"
            class="rounded-2xl object-cover portrait-zoom"
            style="width: 380px; height: 470px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);"
            loading="lazy"
            widths={[400, 700]}
            sizes="380px"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Vertrauen & Qualität (E-E-A-T) -->
  <section class="bg-white py-14">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-bold text-[#1f2025] text-2xl sm:text-3xl text-center mb-2">Warum Sie mir vertrauen können</h2>
      <p class="text-center text-[#374151] mb-10">Echte Person, echte Erfahrung, echte Bewertungen</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-gray-50 rounded-xl p-6 border-t-4 border-[#d7393e]">
          <p class="text-2xl mb-2">🗓️</p>
          <h3 class="font-bold text-[#1f2025] mb-2">Seit 2009 im Einsatz</h3>
          <p class="text-[#374151] text-sm leading-relaxed">Über 15 Jahre als professioneller Clown und Zauberer – mit rund 400 Auftritten pro Jahr und über 6.000 Shows insgesamt.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border-t-4 border-[#3b55d5]">
          <p class="text-2xl mb-2">⭐</p>
          <h3 class="font-bold text-[#1f2025] mb-2">370+ Bewertungen mit 5,0</h3>
          <p class="text-[#374151] text-sm leading-relaxed">Über 400 Familien und Veranstalter haben mich mit der Bestnote bewertet. Lesen Sie echte Stimmen in meinen <a href="/#bewertungen" class="text-[#d7393e] hover:underline">Google-Bewertungen</a>.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border-t-4 border-[#ffb546]">
          <p class="text-2xl mb-2">🛡️</p>
          <h3 class="font-bold text-[#1f2025] mb-2">Erweitertes Führungszeugnis</h3>
          <p class="text-[#374151] text-sm leading-relaxed">Für die Arbeit mit Kindern liegt ein erweitertes Führungszeugnis vor – Sicherheit und Vertrauen für Eltern, Kitas und Schulen.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border-t-4 border-[#d7393e]">
          <p class="text-2xl mb-2">👤</p>
          <h3 class="font-bold text-[#1f2025] mb-2">Klarname &amp; echte Fotos</h3>
          <p class="text-[#374151] text-sm leading-relaxed">Kein anonymes Künstlerprofil: Sie buchen Michaël Prescler persönlich. Alle Fotos und Videos zeigen echte Auftritte – nachzusehen in meiner <a href="/galerie/" class="text-[#d7393e] hover:underline">Galerie</a>.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border-t-4 border-[#3b55d5]">
          <p class="text-2xl mb-2">🎓</p>
          <h3 class="font-bold text-[#1f2025] mb-2">Vollständige Ausbildung</h3>
          <p class="text-[#374151] text-sm leading-relaxed">Studium sowie eine komplette Animateur-Ausbildung mit Schauspiel, Tanz, Zauberei, Ballonmodellage und Comedy – Entertainment auf professionellem Niveau.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-6 border-t-4 border-[#ffb546]">
          <p class="text-2xl mb-2">🇫🇷</p>
          <h3 class="font-bold text-[#1f2025] mb-2">Deutsch &amp; Französisch</h3>
          <p class="text-[#374151] text-sm leading-relaxed">Als gebürtiger Franzose unterhalte ich auch internationale Gäste zweisprachig – ein besonderes Extra für Hochzeiten und Firmenevents.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Was kann ich buchen? -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-bold text-[#1f2025] text-2xl sm:text-3xl text-center mb-8">Was kann man bei mir buchen?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Zaubershow -->
        <div class="bg-white rounded-xl p-8 shadow-sm border-t-4 border-[#d7393e] card-hover reveal">
          <h3 class="font-bold text-[#1f2025] text-xl mb-4">🎩 Zaubershow</h3>
          <p class="text-[#374151] text-sm mb-6">Eine interaktive Zaubershow voller Staunen und Lachen, bei der das Geburtstagskind immer im Mittelpunkt steht.</p>
          <a href="/zauberer/zaubershow/" class="text-[#d7393e] hover:underline text-sm font-semibold">Mehr zur Zaubershow →</a>
        </div>

        <!-- Ballonmodellage -->
        <div class="bg-white rounded-xl p-8 shadow-sm border-t-4 border-[#3b55d5] card-hover reveal">
          <h3 class="font-bold text-[#1f2025] text-xl mb-4">🎈 Luftballonmodellage</h3>
          <p class="text-[#374151] text-sm mb-6">Für jedes Kind entsteht eine eigene Ballonfigur – eine bunte Erinnerung zum Mitnehmen.</p>
          <a href="/clown/ballonmodellage/" class="text-[#3b55d5] hover:underline text-sm font-semibold">Mehr zur Ballonmodellage →</a>
        </div>

        <!-- Glitzer Tattoos -->
        <div class="bg-white rounded-xl p-8 shadow-sm border-t-4 border-[#ffb546] card-hover reveal">
          <h3 class="font-bold text-[#1f2025] text-xl mb-4">✨ Glitzer-Tattoos</h3>
          <p class="text-[#374151] text-sm mb-6">Hautverträgliche und langanhaltende Glitzer-Tattoos, bei denen sich jedes Kind sein Wunschmotiv aussuchen darf.</p>
          <a href="/clown/glitzer-tattoo/" class="text-[#d7393e] hover:underline text-sm font-semibold">Mehr zu Glitzer-Tattoos →</a>
        </div>
      </div>
      <p class="text-[#374151] text-center mt-8">Alle Preise und Pakete für den Kindergeburtstag finden Sie auf der Seite <a href="/kindergeburtstag/" class="text-[#d7393e] hover:underline font-semibold">Kindergeburtstag</a>.</p>
    </div>
  </section>

  <section class="py-14 bg-[#eff4ff]">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-[#1f2025] font-extrabold text-xl uppercase tracking-widest mb-6">Wie sieht eine Show von Clown Zauberer LIAR aus?</h2>
      <YouTubeFacade
        id="Cop0SqRIX4Y"
        title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!"
        label="Zaubershow ansehen"
      />
      <h3 class="text-[#1f2025] font-bold text-xl mb-6">
        Mehr Fotos und Videos in der Galerie
      </h3>
      <a
        href="/galerie/"
        class="inline-block bg-[#f5a623] hover:bg-[#e69420] text-[#1f2025] font-bold px-10 py-4 rounded-full text-base transition-colors"
      >
        Zur Foto- und Videogalerie
      </a>
    </div>
  </section>

  <section class="py-14 bg-[#fdf2f2]">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-bold text-[#1f2025] text-2xl sm:text-3xl text-center mb-8">📍 Regional und deutschlandweit – Wo findet man mich?</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <p class="text-[#374151] mb-6">Ich wohne in Gladbeck und bin in folgende Städte buchbar:</p>
          <p class="text-[#374151] leading-relaxed mb-4">
            Oberhausen, Gelsenkirchen, Essen, Duisburg, Dorsten, Herten, Herne, Marl, Gladbeck, Mülheim, Düsseldorf, Dortmund, Lünen, Hagen, Moers, Krefeld, Reken, Ahaus, Münster, Köln…
          </p>
          <p class="text-[#374151] font-medium">
            🌍 Jedoch kann man mich auch überregional und international (Frankreich, Belgien, Österreich, Schweiz) buchen!
          </p>
          <div class="mt-6 space-y-2">
            <p class="text-[#1f2025]">📱 TEL: <a href="tel:+491721517578" class="hover:underline font-semibold text-[#d7393e]">0172 – 1517578</a></p>
            <p class="text-[#1f2025]">✉️ Email: <a href="mailto:info@liar-entertainer.com" class="hover:underline text-[#d7393e]">info@liar-entertainer.com</a></p>
            <p class="text-[#1f2025]">📍 Anschrift: Beethovenstr. 15, 45966 Gladbeck</p>
          </div>
        </div>
        <div>
          <Image
            src={karteImg}
            alt="Wohnort Clown Zauberer LIAR"
            class="w-full rounded-xl shadow-lg img-hover-zoom"
            loading="lazy"
            widths={[400, 600]}
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1f2025] py-14 text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="font-bold text-2xl sm:text-3xl mb-4">📞 Einfach Kontakt aufnehmen</h2>
      <p class="text-gray-300 mb-6 leading-relaxed">
        Sie können mir Ihre Anfrage als Clown unverbindlich senden. Je mehr Angaben ich von Ihnen bekomme, desto besser kann ich Sie beraten. Werfen Sie auch einen Blick in meine <a href="/galerie/" class="text-white hover:underline font-semibold">Foto- und Videogalerie</a> oder lesen Sie aktuelle Geschichten in meinem <a href="/blog/" class="text-white hover:underline font-semibold">Blog</a>.
      </p>
      <a href="/kontakt/" class="inline-block bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold px-10 py-4 rounded transition-colors">
        Jetzt unverbindlich anfragen
      </a>
    </div>
  </section>

</BaseLayout>
