---
import { Image } from 'astro:assets';
import V2Layout from '../../layouts/V2Layout.astro';
import Reviews from '../../components/v2/Reviews.astro';
import ReviewBadge from '../../components/v2/ReviewBadge.astro';
import K3Hero from '../../components/v2/kids/K3Hero.astro';
import GoldDivider from '../../components/v2/kids/GoldDivider.astro';
import { CONTACT } from '../../data/site';
import heroImage from '../../assets/images/general/clown-zauberer-liar-kontaktformular.jpg';
import '../../styles/kids-v3.css';

const trust = [
  '⭐ 370+ Bewertungen – durchschnittlich 5/5 Sterne',
  '✅ über 17 Jahre Erfahrung als Profi-Entertainer',
  '🎉 Über 400 Shows jährlich in NRW',
  '🔒 Versichert & mit polizeilichem Führungszeugnis',
  '📞 Persönliche Beratung und schnelle Antwort',
];

const services = [
  { href: '/kindergeburtstag/', label: '🎂 Zauberer für Kindergeburtstag' },
  { href: '/zauberer/zaubershow/', label: '🎩 Zaubershow' },
  { href: '/clown/clownshow/', label: '🤡 Clownshow' },
  { href: '/clown/ballonmodellage/', label: '🎈 Ballonmodellage' },
  { href: '/clown/glitzer-tattoo/', label: '✨ Glitzer Tattoos' },
  { href: '/clown/walk-act/', label: '🚶 Walk-Act' },
  { href: '/zauberer/tisch-zauberer/', label: '🃏 Tischzauberer' },
  { href: '/galerie/', label: '📸 Galerie' },
];
---

<V2Layout
  title="Kontakt | Clown Zauberer LIAR | Jetzt anfragen"
  description="Kontaktieren Sie Clown Zauberer LIAR ✓ Unverbindliche Anfrage ✓ Antwort in 24h ✓ Tel: 0172 1517578 ✓ Aus Gladbeck für ganz NRW ✓ Jetzt anfragen!"
  keywords="Clown Zauberer buchen, Kontakt Zauberer NRW, Anfrage Clown, Zauberer NRW Kontakt"
  canonical="https://liar-entertainer.com/kontakt/"
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Kontakt', url: '/kontakt/' }]}
>
  <!-- ── Hero: compact, so the form is one thumb-scroll away. No reveal here (LCP). ── -->
  <K3Hero>
    <ReviewBadge />
    <h1 class="k3-hero__title" data-letters>Einfach und unverbindlich kontaktieren</h1>
    <p class="k3-hero__sub">Stellen Sie Ihre Anfrage – wir melden uns innerhalb von 24 Stunden!</p>
    <div class="k3-hero__actions">
      <a class="btn btn--primary" href="#anfrage" data-confetti>Zum Anfrageformular</a>
      <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
    </div>
    <Fragment slot="photo">
      <Image
        src={heroImage}
        alt="Kontakt Clown Zauberer LIAR"
        widths={[400, 600, 820]}
        quality={70}
        sizes="(max-width: 900px) 80vw, 500px"
        loading="eager"
        fetchpriority="high"
      />
      <span class="k3-medal" aria-hidden="true"><span>Antwort in</span><strong>24 h</strong></span>
    </Fragment>
  </K3Hero>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="kt-intro">
    <div class="container k3-narrow" data-reveal>
      <p class="k3-lead">
        Sie suchen einen <strong>Kinderzauberer für den Kindergeburtstag</strong> in Gladbeck oder in der
        Umgebung? Schreiben Sie mir einfach kurz, worum es geht – meistens antworte ich noch am selben Tag,
        spätestens innerhalb von 24 Stunden.
      </p>
      <p class="k3-soft">
        Nach Gladbeck komme ich ohne Anfahrtskosten. Im Umkreis von rund 20 Kilometern bin ich ohnehin
        regelmäßig unterwegs – unter anderem in
        <a href="/kinderzauberer/kinderzauberer-in-bottrop/">Bottrop</a>,
        <a href="/kinderzauberer/kinderzauberer-in-gelsenkirchen/">Gelsenkirchen</a>,
        <a href="/kinderzauberer/kinderzauberer-in-essen/">Essen</a> und
        <a href="/kinderzauberer/kinderzauberer-in-oberhausen/">Oberhausen</a>.
        Für andere Anlässe – Kita-Fest, Firmenfeier oder Stadtfest – nutzen Sie gern dasselbe Formular.
      </p>
    </div>
  </section>

  <!-- ── Form + direct contact ─────────────────────────────── -->
  <section class="kt-main k3-alt">
    <div class="container">
    <GoldDivider />
    <div class="kt-main__grid">
      <div class="k3-card kt-form-card" id="anfrage">
        <h2 class="k3-h2 kt-h2">Anfrage senden</h2>
        <!-- Fehlermeldungen (?fehler=… and the browser-side maths check) -->
        <div id="form-error" class="kt-error" role="alert" hidden>
          <span id="error-text"></span>
        </div>
        <form
          name="kontakt"
          method="POST"
          action="/kontakt/danke/"
          data-netlify="true"
          netlify-honeypot="website"
          class="kt-form"
          id="kontakt-form"
          data-msg-1="Bitte füllen Sie alle Pflichtfelder korrekt aus."
          data-msg-2="Beim Senden ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder rufen Sie uns direkt an."
          data-msg-captcha="Die Antwort auf die Mathe-Frage war leider falsch. Bitte versuchen Sie es erneut."
          data-msg-timeout="Das Formular war zu lange offen. Bitte laden Sie die Seite neu und versuchen Sie es erneut."
          data-msg-unknown="Ein unbekannter Fehler ist aufgetreten."
          data-msg-question="Was ist {q}?"
        >
          <input type="hidden" name="form-name" value="kontakt" />
          <!-- Honeypot-Feld gegen Spam (versteckt) -->
          <div class="kt-hp" aria-hidden="true">
            <label for="website">Website leer lassen</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="kt-field">
            <label for="name">Ihr Name *</label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder="Max Mustermann" />
          </div>
          <div class="kt-field">
            <label for="email">E-Mail *</label>
            <input type="email" id="email" name="email" required autocomplete="email" inputmode="email" placeholder="max@example.de" />
          </div>
          <div class="kt-field">
            <label for="phone">Telefon</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+49 ..." />
          </div>
          <div class="kt-row">
            <div class="kt-field">
              <label for="event-date">Veranstaltungsdatum</label>
              <input type="date" id="event-date" name="event-date" />
            </div>
            <div class="kt-field">
              <label for="event-time">Gewünschte Uhrzeit</label>
              <input type="time" id="event-time" name="event-time" />
            </div>
          </div>
          <div class="kt-field">
            <label for="event-city">Ort / Stadt *</label>
            <input type="text" id="event-city" name="event-city" required autocomplete="address-level2" placeholder="z.B. Essen, Dortmund, Bochum..." />
          </div>
          <div class="kt-field">
            <label for="event-type">Art der Veranstaltung</label>
            <select id="event-type" name="event-type">
              <option value="">Bitte wählen...</option>
              <option>Kindergeburtstag</option>
              <option>Firmenfeier</option>
              <option>Stadtfest / Open Air</option>
              <option>Kindergarten / Kita</option>
              <option>Schule</option>
              <option>Karneval</option>
              <option>Sonstiges</option>
            </select>
          </div>
          <div class="kt-field">
            <label for="message">Ihre Nachricht</label>
            <textarea id="message" name="message" rows="5" placeholder="Erzählen Sie mir von Ihrem Event..."></textarea>
          </div>
          <!-- CAPTCHA: Mathe-Frage (DSGVO-konform, keine Drittanbieter), checked in the browser before submit -->
          <div class="kt-field kt-field--captcha">
            <label for="captcha">
              Spam-Schutz: <span id="captcha-question" class="kt-captcha__q"></span> *
            </label>
            <input
              type="number"
              id="captcha"
              name="captcha"
              required
              inputmode="numeric"
              placeholder="Ihre Antwort"
              autocomplete="off"
              aria-describedby="form-error"
            />
          </div>
          <button type="submit" class="btn btn--primary kt-submit">
            Anfrage absenden →
          </button>
        </form>
      </div>

      <aside class="kt-side">
        <h2 class="k3-h2 kt-h2">Direkt Kontakt</h2>
        <div class="k3-panel kt-reach" data-reveal>
          <div class="kt-reach__item">
            <span class="kt-reach__icon">📞</span>
            <div>
              <div class="kt-reach__label">Telefon</div>
              <a href={CONTACT.phoneHref} class="kt-reach__big">
                +49 172 1517578
              </a>
              <p class="kt-reach__hint">Mo–Sa 8:00 – 20:00 Uhr</p>
            </div>
          </div>
          <div class="kt-reach__item">
            <span class="kt-reach__icon">✉</span>
            <div>
              <div class="kt-reach__label">E-Mail</div>
              <a href={`mailto:${CONTACT.email}`} class="kt-reach__mail">
                {CONTACT.email}
              </a>
              <p class="kt-reach__hint">Antwort innerhalb 24 Stunden</p>
            </div>
          </div>
          <div class="kt-reach__item">
            <span class="kt-reach__icon">📍</span>
            <div>
              <div class="kt-reach__label">Adresse</div>
              <address class="kt-reach__addr">
                Beethovenstr. 15<br />
                45966 Gladbeck<br />
                Nordrhein-Westfalen
              </address>
            </div>
          </div>
        </div>

        <!-- Trust signals -->
        <div class="k3-card kt-trust" data-reveal>
          <h3 class="kt-h3">Warum Clown Zauberer LIAR?</h3>
          <ul class="k3-ticks kt-trust__list">
            {trust.map((t) => <li>{t}</li>)}
          </ul>
        </div>

        <!-- Service-Links -->
        <div class="kt-services" data-reveal>
          <h3 class="kt-h3">Unsere Leistungen</h3>
          <div class="k3-chips kt-services__list">
            {services.map((s) => <a href={s.href}>{s.label}</a>)}
          </div>
        </div>
      </aside>
    </div>
    </div>
  </section>

  <Reviews />
</V2Layout>

<script>
  // Maths question (DSGVO-konform: kein externer Service, keine Cookies). There is no server to
  // verify a hash any more (Netlify Forms), so the answer is checked here before submitting.
  // Messages live on the form (data-msg-*), so the FR/EN pages get them translated.
  const form = document.getElementById('kontakt-form') as HTMLFormElement | null;
  const msg = (key: string) => form?.getAttribute('data-msg-' + key) ?? '';
  const errorEl = document.getElementById('form-error');
  const textEl = document.getElementById('error-text');
  const showError = (key: string) => {
    if (!errorEl || !textEl) return;
    textEl.textContent = msg(key) || msg('unknown');
    errorEl.hidden = false;
  };

  const fehler = new URLSearchParams(window.location.search).get('fehler');
  if (fehler) showError(fehler);

  const a = Math.floor(Math.random() * 10) + 1;
  const b = Math.floor(Math.random() * 10) + 1;
  const minus = Math.random() < 0.5;
  const num1 = minus ? Math.max(a, b) : a;
  const num2 = minus ? Math.min(a, b) : b;
  const answer = minus ? num1 - num2 : num1 + num2;
  const qEl = document.getElementById('captcha-question');
  if (qEl) qEl.textContent = msg('question').replace('{q}', num1 + ' ' + (minus ? '-' : '+') + ' ' + num2);

  const input = document.getElementById('captcha') as HTMLInputElement | null;
  form?.addEventListener('submit', (e) => {
    if (!input) return;
    if (Number(input.value.trim()) !== answer || input.value.trim() === '') {
      e.preventDefault();
      input.setAttribute('aria-invalid', 'true');
      showError('captcha');
      input.focus();
    }
  });
  input?.addEventListener('input', () => {
    if (input.getAttribute('aria-invalid') !== 'true') return;
    input.removeAttribute('aria-invalid');
    if (errorEl) errorEl.hidden = true;
  });
</script>

<style>
  /* ── intro ── */
  .kt-intro { padding-bottom: var(--space-4) !important; }

  /* ── main: the form is a light programme sheet, the side column holds the direct ways ── */
  .kt-main__grid { display: grid; gap: var(--space-5); align-items: start; }
  @media (min-width: 901px) {
    .kt-main__grid { grid-template-columns: 1.15fr 1fr; }
    .kt-row { grid-template-columns: 1fr 1fr; }
  }
  .kt-h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  .kt-h3 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; margin: 0 0 var(--space-2); }

  .kt-form-card { scroll-margin-top: 6rem; padding: calc(var(--space-4) + 0.25rem) var(--space-4) var(--space-4); }
  /* a form sheet does not jump away from the pointer while someone types */
  .kt-form-card:hover { transform: none; }
  .kt-form-card .kt-h2 { text-align: center; }
  .kt-form { display: grid; gap: 1.1rem; }
  .kt-row { display: grid; gap: 1.1rem; }
  .kt-field { display: grid; gap: 0.35rem; }
  .kt-field label { font-weight: 800; font-size: 0.98rem; color: var(--ink); }
  .kt-field :is(input, select, textarea) {
    width: 100%; min-height: 3.1rem; padding: 0.7rem 0.95rem;
    font: inherit; font-size: 1rem; color: var(--ink);
    background-color: #fffefa; border: 0; border-radius: var(--radius-sm);
    /* a fine gold rule instead of the old thick ink border */
    box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.55), inset 0 1px 3px rgba(43, 29, 23, 0.06);
    transition: box-shadow 0.2s var(--ease-out), background-color 0.2s ease;
  }
  .kt-field textarea { resize: vertical; min-height: 8rem; }
  .kt-field select { appearance: none; padding-right: 2.6rem; cursor: pointer;
    background-image: linear-gradient(45deg, transparent 50%, var(--gold) 50%), linear-gradient(135deg, var(--gold) 50%, transparent 50%);
    background-position: calc(100% - 1.3rem) 55%, calc(100% - 0.95rem) 55%;
    background-size: 0.38rem 0.38rem; background-repeat: no-repeat;
  }
  .kt-field ::placeholder { color: color-mix(in srgb, var(--ink-soft) 80%, transparent); }
  .kt-field :is(input, select, textarea):focus { outline: none; }
  /* clear focus: a velvet ring with a soft gold halo (visible on every field type) */
  .kt-field :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--velvet); outline-offset: 2px; background-color: #fff;
    box-shadow: inset 0 0 0 1px var(--gold), 0 0 0 6px rgba(233, 200, 119, 0.45);
  }
  .kt-field [aria-invalid='true'] { box-shadow: inset 0 0 0 2px var(--accent-strong); }
  .kt-captcha__q { font-family: var(--font-display); font-weight: 650; color: var(--accent-strong); }
  .kt-submit { width: 100%; min-height: 3.5rem; font-size: 1.15rem; cursor: pointer; }
  .kt-submit:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .kt-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .kt-error {
    margin: 0 0 var(--space-3); padding: 0.85rem 1rem; font-weight: 700;
    color: var(--accent-strong); background: #fff1ef;
    border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1.5px var(--accent-strong);
  }
  .kt-error[hidden] { display: none; }

  /* ── direct contact ── */
  .kt-reach { display: grid; gap: var(--space-3); }
  .kt-reach__item { display: flex; gap: 0.9rem; align-items: flex-start; }
  .kt-reach__icon {
    flex: none; display: grid; place-items: center; width: 2.9rem; height: 2.9rem; font-size: 1.15rem;
    border-radius: 50%; color: #ffe3a3;
    background: radial-gradient(circle at 35% 30%, #c3283a, var(--velvet) 72%);
    box-shadow: 0 0 0 1.5px #e9c877, 0 6px 14px -6px rgba(142, 21, 32, 0.6);
  }
  .kt-reach__label { font-weight: 900; }
  .kt-reach__big { font-family: var(--font-display); font-size: 1.45rem; font-weight: 650; color: var(--accent-strong); text-decoration: none; }
  .kt-reach__mail { font-weight: 800; color: var(--accent-strong); overflow-wrap: anywhere; }
  .kt-reach__hint { margin: 0.1rem 0 0 !important; font-size: 0.92rem; color: var(--ink-soft); }
  .kt-reach__addr { font-style: normal; color: var(--ink-soft); }

  .kt-trust { margin-top: var(--space-4); }
  .kt-trust .kt-h3 { text-align: center; }
  .kt-trust__list { margin: 0; font-weight: 700; }

  .kt-services { margin-top: var(--space-4); }
  .kt-services__list { justify-content: flex-start; }
  .kt-services__list a {
    display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--ink); text-decoration: none;
    transition: background-color 0.2s ease, transform 0.25s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .kt-services__list a:hover { background: var(--bg); transform: translateY(-2px); }
    .kt-reach__big:hover { text-decoration: underline; }
    .kt-field :is(input, select, textarea):hover { background-color: #fff; }
  }
  @media (max-width: 900px) {
    .kt-form-card { padding: calc(var(--space-3) + 0.5rem) 1.1rem var(--space-3); }
  }
</style>
