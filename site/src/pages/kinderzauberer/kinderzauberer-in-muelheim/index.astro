    { name: 'Kinderzauberer in Mülheim an der Ruhr', url: '/kinderzauberer/kinderzauberer-in-muelheim/' }
  ]}
>

  <!-- Hero Section -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
