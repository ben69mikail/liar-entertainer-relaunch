      <p class="text-gray-200 text-base leading-relaxed max-w-xl mx-auto">
        Kinderzauberer LIAR aus Gladbeck – 40 Minuten Zaubershow für Kinder von 4 bis 12 Jahren in Mülheim.
      </p>
    </div>
  </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <section class="pt-4 pb-0">
