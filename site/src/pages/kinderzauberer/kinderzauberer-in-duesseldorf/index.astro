---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSlider from '../../../components/HeroSlider.astro';
import HeroStage from '../../../components/HeroStage.astro';
import CountUp from '../../../components/CountUp.astro';
import aktionImg from '../../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';
import { Image } from 'astro:assets';
import GoogleReviews from '../../../components/GoogleReviews.astro';
import _heroImgAsset from '../../../assets/images/kinderzauberer/kinderzauberer-hero.jpg';
import _roundImgAsset from '../../../assets/images/kinderzauberer/zaubershow-mit-clown-zauberer-liar.jpg';
import _showImgAsset from '../../../assets/images/clown/clown-bei-clownshow.jpg';
import _kgImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';
import _zauberImgAsset from '../../../assets/images/zauberer/zaubershow-mit-clown-zauberer.jpg';
import _kostenImgAsset from '../../../assets/images/clown/kosten-preis-clown-nrw.jpg';
import _weihnachtImgAsset from '../../../assets/images/zauberer/zaubervorfuehrung-weihnachtsmarkt-dortmund.jpg';
import _zauberShowImgAsset from '../../../assets/images/zauberer/zaubershow-staunende-kinder.jpg';

const seoTitle = "Zauberer Kindergeburtstag Düsseldorf | Kinderzauberer LIAR";
const seoDescription = "Kinderzauberer in Düsseldorf buchen ✓ Lustige Zaubershow für Kindergeburtstag ✓ 370+ Bewertungen ✓ Auch in Duisburg & Mülheim ✓ Anfragen!";
const heroImg = _heroImgAsset.src;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Kinderzauberer in Düsseldorf",
  "description": "Kinderzauberer LIAR für Kindergeburtstag und Kinderevents in Düsseldorf, NRW",
  "url": "https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-duesseldorf/",
  "serviceType": ["Kinderzauberer", "Zaubershow für Kinder"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "City", "name": "Düsseldorf" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Kinderzauberer in Düsseldorf? 💰",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Preisgestaltung richtet sich nach mehreren Faktoren: Veranstaltungstyp und -größe, gewünschte Programmdauer, Teilnehmerzahl sowie Entfernung. Für klassische Kindergeburtstage habe ich attraktive Festpreise! Fordern Sie unverbindlich ein individuelles Angebot an – ich berate Sie gerne ausführlich! 📞"
      }
    },
    {
      "@type": "Question",
      "name": "Welche Raumgröße wird benötigt? 📏",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meine Zaubershow in Düsseldorf ist maximal anpassungsfähig! Ich benötige lediglich eine Aktionsfläche von 2×2 Metern – ohne langwierigen Aufbau oder komplizierte Vorbereitung. Ob in Wohnräumen, Gärten 🌳, Partykellern, Kindergärten, Schulräumen oder auf Großveranstaltungen: Ich passe mich optimal an Ihre räumlichen Verhältnisse an."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert eine Show? ⏰",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Zaubershow in Düsseldorf kann ab 30 Minuten gebucht werden und wird präzise auf Ihre Bedürfnisse zugeschnitten. Ideal für: Kindergeburtstage 🎉, Kitafeste, Schulveranstaltungen, Sommerfeste, Firmenevents, Hochzeiten, Kommunionen oder Straßenfeste. Die exakte Showlänge stimme ich individuell auf Ihr Event und das Publikum ab."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

const _pageGallery = [
  { src: _zauberImgAsset, alt: 'Auftritt Zaubershow mit Clown und Kinderzauberer in Düsseldorf' },
  { src: _kostenImgAsset, alt: 'Kinderzauberer in Düsseldorf im Einsatz auf einer Kinderfeier' },
  { src: _weihnachtImgAsset, alt: 'Zaubervorführung auf dem Weihnachtsmarkt mit dem Kinderzauberer' },
  { src: _zauberShowImgAsset, alt: 'Staunende Kinder bei einer Zaubershow mit Kinderzauberer in Düsseldorf' },
];

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Kinderzauberer Düsseldorf, Kinderzauberer in Düsseldorf, Zauberer Düsseldorf, Kindergeburtstag Düsseldorf, Zaubershow Düsseldorf, NRW"
  canonical="https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-duesseldorf/"
  ogImage={heroImg}
  structuredData={structuredData}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Kinderzauberer', url: '/kinderzauberer/' },
    { name: 'Kinderzauberer in Düsseldorf', url: '/kinderzauberer/kinderzauberer-in-duesseldorf/' }
  ]}
>

  <!-- Hero Section -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl" style="min-height: 600px; box-shadow: 0 12px 32px rgba(0,0,0,0.14);">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImg}'); background-position: center 60%;`}></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative flex flex-col items-center justify-center text-center px-6" style="min-height: 600px;">
      <div class="inline-flex items-center gap-2 bg-white/20 text-white rounded-full px-4 py-1.5 text-sm font-medium mb-4 backdrop-blur-sm">
        <span>📍</span> Düsseldorf
