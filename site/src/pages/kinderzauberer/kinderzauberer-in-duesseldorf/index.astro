      <p class="text-gray-200 text-base leading-relaxed max-w-xl mx-auto">
        Kinderzauberer LIAR aus Gladbeck – 40 Minuten Zaubershow für Kinder von 4 bis 12 Jahren in Düsseldorf.
      </p>
    </div>
  </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <section class="pt-4 pb-0">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="text-sm text-[#595959]">
        <a href="/" class="text-[#d7393e] hover:underline">Clown</a>
        <span class="mx-1">»</span>
        <a href="/kinderzauberer/" class="text-[#d7393e] hover:underline">Kinderzauberer</a>
        <span class="mx-1">»</span>
        <span>TOP Show mit Kinderzauberer in Düsseldorf buchen</span>
      </nav>
    </div>
  </section>

