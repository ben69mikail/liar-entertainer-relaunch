  <!-- Anlässe für den Kinderzauberer in Düsseldorf -->
  <section class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4">
      <h3 class="text-[#1f2025] font-bold text-xl text-center mb-8">Anlässe für den Kinderzauberer in Düsseldorf 👧👦</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm"><h4 class="font-bold text-[#1f2025] mb-2">🎂 Kindergeburtstag</h4><p class="text-[#374151] text-sm leading-relaxed">Unvergessliche Feier zu Hause oder in gemieteten Locations</p></div>
