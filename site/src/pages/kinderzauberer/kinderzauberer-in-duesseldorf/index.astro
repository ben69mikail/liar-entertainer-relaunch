          <Image src={_showImgAsset} alt="Zaubershow für Kinder in Düsseldorf" class="rounded-xl w-full max-w-md object-cover object-top shadow-sm" style="max-height:400px;max-width:28rem" loading="lazy" width={506} height={640} />
