---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSlider from '../../../components/HeroSlider.astro';
import HeroStage from '../../../components/HeroStage.astro';
import CountUp from '../../../components/CountUp.astro';
import aktionImg from '../../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';
import { Image } from 'astro:assets';
import GoogleReviews from '../../../components/GoogleReviews.astro';
import _heroImgAsset from '../../../assets/images/kinderzauberer/kinderzauberer-hero.jpg';
import _roundImgAsset from '../../../assets/images/kinderzauberer/zaubershow-mit-clown-zauberer-liar.jpg';
import _showImgAsset from '../../../assets/images/clown/clown-bei-clownshow.jpg';
import _kgImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';

const seoTitle = "Zauberer Kindergeburtstag Datteln | Kinderzauberer LIAR";
const seoDescription = "Kinderzauberer in Datteln buchen ✓ Lustige Zaubershow für Kinder ✓ 370+ Bewertungen ✓ Auch in Waltrop & Recklinghausen ✓ Jetzt anfragen!";
const heroImg = _heroImgAsset.src;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Kinderzauberer in Datteln",
  "description": "Kinderzauberer LIAR für Kindergeburtstag und Kinderevents in Datteln, NRW",
  "url": "https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-datteln/",
  "serviceType": ["Kinderzauberer", "Zaubershow für Kinder"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "City", "name": "Datteln" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Kinderzauberer in Datteln 💰?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten für einen Kinderzauberer in Datteln variieren je nach Art der Veranstaltung, Dauer der Show, Zuschauerzahl und Anfahrt. Für Kindergeburtstage biete ich Festpreise an. Kontaktieren Sie mich unverbindlich für ein individuelles Angebot – ich berate Sie gerne! 📞"
      }
    },
    {
      "@type": "Question",
      "name": "Wie viel Platz braucht die Zaubershow? 📏",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Für meine Zaubershow in Datteln benötige ich lediglich eine Fläche von 2×2 Metern – ohne lange Vorbereitungszeit! Ob Wohnzimmer, Partykeller, Garten 🌳, Kindergarten, Schule oder Eventlocation: Ich passe mich flexibel an Ihre Räumlichkeiten an."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Zaubershow in Datteln? ⏰",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meine Zaubershow in Datteln dauert ab 30 Minuten und lässt sich flexibel an Ihre Veranstaltung anpassen. Perfekt für: Kindergeburtstag 🎉, Kita-Fest, Schulfest, Sommerfest, Firmenevent, Hochzeit, Kommunion oder Straßenfest. Die Show-Dauer stimme ich individuell auf Ihr Event ab."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Kinderzauberer Datteln, Kinderzauberer in Datteln, Zauberer Datteln, Kindergeburtstag Datteln, Zaubershow Datteln, NRW"
  canonical="https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-datteln/"
  ogImage={heroImg}
  structuredData={structuredData}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Kinderzauberer', url: '/kinderzauberer/' },
    { name: 'Kinderzauberer in Datteln', url: '/kinderzauberer/kinderzauberer-in-datteln/' }
  ]}
>

  <!-- Hero Section -->
  <HeroStage blobOpacity={0.45}>
  <section class="pt-6 sm:pt-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative overflow-hidden rounded-3xl" style="min-height: 600px; box-shadow: 0 12px 32px rgba(0,0,0,0.14);">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImg}'); background-position: center 60%;`}></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative flex flex-col items-center justify-center text-center px-6" style="min-height: 600px;">
      <div class="inline-flex items-center gap-2 bg-white/20 text-white rounded-full px-4 py-1.5 text-sm font-medium mb-4 backdrop-blur-sm">
        <span>📍</span> Datteln
      </div>
      <h1 class="text-white font-extrabold text-center leading-tight mb-3" style="font-size: clamp(2rem, 5vw, 3.5rem); text-shadow: 2px 2px 8px rgba(0,0,0,0.5);">
        Zauberer für den Kindergeburtstag in Datteln
      </h1>
      <p class="text-gray-200 text-base leading-relaxed max-w-xl mx-auto">
        Kinderzauberer LIAR aus Gladbeck – 40 Minuten Zaubershow für Kinder von 4 bis 12 Jahren in Datteln.
      </p>
    </div>
  </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <section class="pt-4 pb-0">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="text-sm text-[#595959]">
        <a href="/" class="text-[#d7393e] hover:underline">Clown</a>
        <span class="mx-1">»</span>
        <a href="/kinderzauberer/" class="text-[#d7393e] hover:underline">Kinderzauberer</a>
        <span class="mx-1">»</span>
        <span>Kinderzauberer in Datteln buchen | Zaubershow für Ihr Event</span>
      </nav>
    </div>
  </section>

  <!-- Intro Image + Text -->
  <section class="py-14">
    <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="flex justify-center">
        <Image
          src={_roundImgAsset}
          alt="Kinderzauberer in Datteln"
          class="rounded-full object-cover object-[20%] portrait-zoom"
          style="width: 320px; height: 320px;"
          loading="lazy" width={600} height={450} />
      </div>
      <div>
        <p class="hero-subtitle text-[#374151] text-[17px] leading-relaxed mb-4">Ein Zauberer für Kinder muss in Datteln vor allem eines können: die Kleinen 40 Minuten lang fesseln. Sie feiern in Datteln, Oer-Erkenschwick oder Recklinghausen? Kinderzauberer LIAR aus Gladbeck kommt mit seiner rund 40-minütigen Mitmach-Zaubershow für Kinder ab 4 Jahren zu Ihnen – benötigt werden nur 2×2 Meter Platz. Mehr als 400 Google-Bewertungen zeigen, wie sehr Kinder und Eltern die Show lieben.</p>
      </div>
    </div>
  </section>

  </HeroStage>
  <!-- Google Reviews -->
  <GoogleReviews />

  <section class="bg-[#eff4ff] py-14 border-y border-[#c5d3f7]">
    <div class="max-w-5xl mx-auto px-4">
      <p class="text-[#d7393e] font-bold text-sm uppercase tracking-widest mb-4 text-center">DATTELN</p>
      <h2 class="text-[#1f2025] font-bold text-3xl sm:text-4xl mb-10 text-center">Warum LIAR als Kinderzauberer in Datteln buchen? ⭐</h2>
      <p class="text-[#1f2025] leading-relaxed mb-4">Mit LIAR, Ihrem professionellen Kinderzauberer in Datteln, wird Ihre Veranstaltung zu einem unvergesslichen Erlebnis. Ob Kindergeburtstag, Schulfest oder Firmenevent – meine interaktive Zaubershow begeistert Kinder von 4 bis 12 Jahren und bleibt lange in Erinnerung. ✨</p>
      <p class="text-[#1f2025] leading-relaxed mb-4">Sie suchen einen Kinderzauberer in Datteln? Als erfahrener Zauberer für Kinder erlebe ich täglich glänzende Kinderaugen 👀 und staunende Gesichter – und genau das macht meine Arbeit so besonders. In zauberhaften Geschichten verwandle ich Alltagsgegenstände in magische Requisiten. Das verblüfft, begeistert und sorgt für ausgelassene Stimmung bei Klein und Groß! 🎉</p>
      <div class="text-center mt-8">
        <a href="#zaubershow" class="inline-block bg-[#3b55d5] text-white font-bold px-8 py-3 rounded transition-colors hover:bg-[#2a3fa8]">
          Über die Zaubershow
        </a>
      </div>
    </div>
  </section>

  <!-- Zaubershow in Datteln: Interaktiv, lustig und unvergesslich 🪄 -->
  <section id="zaubershow" class="bg-gray-50 py-14">
    <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl mb-6">Zaubershow in Datteln: Interaktiv, lustig und unvergesslich 🪄</h2>
        <p class="text-[#374151] mb-4 leading-relaxed">Meine Zaubershow in Datteln ist eine unterhaltsame Mischung aus Zauberei und Clownerie, bei der die Kinder (nicht die Zaubertricks!) im Mittelpunkt stehen. Die jungen Zuschauer werden aktiv eingebunden und pendeln zwischen Lachen 😄 und Staunen.</p>
        <p class="text-[#374151] mb-4 leading-relaxed">Diese interaktive Show ist altersgerecht abgestimmt und macht jede Veranstaltung in Datteln zum Highlight. Diese bunte und zauberhafte Show ist optimal auf die jeweilige Altersklasse abgestimmt. Die Kinder wirken aktiv mit, werden selbst zum Zauberer 🎩 und erleben erstaunliche Momente, die unglaublich wirken. Für die kleinen Zuschauer wird diese Clown- und Zaubershow zu einem unvergesslichen Erlebnis.</p>
      </div>
      <div>
        <Image src={_showImgAsset} alt="Zaubershow in Datteln" class="rounded-xl w-full object-cover object-top shadow-sm" loading="lazy" width={506} height={640} />
      </div>
    </div>
  </section>


  <!-- Stats Banner -->
  <section class="bg-[#fdf2f2] py-10 text-center border-y border-[#f0c4c4]">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
          <div class="text-3xl mb-2">🪄</div>
          <div class="text-4xl font-extrabold text-[#d7393e]"><CountUp value={400} /></div>
          <div class="text-sm mt-1 text-[#374151]">Shows im Jahr</div>
        </div>
        <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
          <div class="text-3xl mb-2">😊</div>
          <div class="text-4xl font-extrabold text-[#d7393e]"><CountUp value={110000} /></div>
          <div class="text-sm mt-1 text-[#374151]">Lachende Kinder</div>
        </div>
        <div class="bg-white border border-[#f0c4c4] shadow-sm rounded-xl p-6 stat-card-pulse reveal">
          <div class="text-3xl mb-2">🪄</div>
          <div class="text-4xl font-extrabold text-[#d7393e]"><CountUp value={15} /></div>
          <div class="text-sm mt-1 text-[#374151]">Jahre Erfahrung</div>
        </div>
      </div>
    </div>
  </section>


  <!-- Kindergeburtstag in Datteln mit Kinderzauberer feiern 🎂🎈 -->
  <section class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl mb-6">Kindergeburtstag in Datteln mit Kinderzauberer feiern 🎂🎈</h2>
        <p class="text-[#374151] mb-4 leading-relaxed">Einen Kinderzauberer für den Kindergeburtstag in Datteln zu buchen ist einfacher als gedacht! Ich komme zu Ihnen nach Hause 🏠, in den Partykeller oder in die angemietete Location. Mit minimalem Aufwand und ohne lange Vorbereitungszeit sorge ich für strahlende Kinderaugen und entspannte Eltern.</p>
        <p class="text-[#374151] mb-4 leading-relaxed">Das Geburtstagskind steht dabei immer im Mittelpunkt meiner Show. 🌟 Die Kinder werden zum Lachen und Staunen gebracht. Der Spaß mit den Kindern steht für mich im Vordergrund, wobei das Geburtstagskind immer die Hauptrolle spielt. Das Ergebnis: lachende Kinder 😊, ausgelassene Stimmung und entspannte Eltern!</p>
        <a href="/kindergeburtstag/" class="inline-block bg-[#d7393e] hover:bg-[#b62e32] text-white font-bold px-8 py-3 rounded transition-colors mt-4">
          Kindergeburtstag – Preise
        </a>
      </div>
      <div>
        <Image src={_kgImgAsset} alt="Kindergeburtstag mit Kinderzauberer in Datteln" class="rounded-xl w-full object-cover object-top shadow-sm" loading="lazy" width={800} height={1067} />
      </div>
    </div>
  </section>

  <!-- Anlässe für den Kinderzauberer in Datteln -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl text-center mb-10">Anlässe für den Kinderzauberer in Datteln 👧👦</h2>
      <p class="text-[#374151] text-center mb-8 leading-relaxed">Meine Zaubershow ist perfekt für verschiedene Veranstaltungen in Datteln und Umgebung:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-[#d7393e] card-hover reveal">
          <div class="text-2xl mb-3">🎂</div>
          <h3 class="font-bold text-[#1f2025] text-lg mb-2">Kindergeburtstag</h3>
