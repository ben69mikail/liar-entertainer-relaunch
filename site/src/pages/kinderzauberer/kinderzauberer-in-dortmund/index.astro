---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSlider from '../../../components/HeroSlider.astro';
import HeroStage from '../../../components/HeroStage.astro';
import CountUp from '../../../components/CountUp.astro';
import aktionImg from '../../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';
import { Image } from 'astro:assets';
import GoogleReviews from '../../../components/GoogleReviews.astro';
import _heroImgAsset from '../../../assets/images/kinderzauberer/kinderzauberer-hero.jpg';
import _roundImgAsset from '../../../assets/images/kinderzauberer/zaubershow-mit-clown-zauberer-liar.jpg';
import _showImgAsset from '../../../assets/images/clown/clown-bei-clownshow.jpg';
import _kgImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';
import _zauberImgAsset from '../../../assets/images/zauberer/zaubershow-mit-clown-zauberer.jpg';
import _kostenImgAsset from '../../../assets/images/clown/kosten-preis-clown-nrw.jpg';
import _weihnachtImgAsset from '../../../assets/images/zauberer/zaubervorfuehrung-weihnachtsmarkt-dortmund.jpg';

const seoTitle = "Zauberer Kindergeburtstag Dortmund | Kinderzauberer LIAR";
const seoDescription = "Kinderzauberer in Dortmund für Kindergeburtstag & Events ✓ Clown LIAR ✓ 370+ Bewertungen ✓ Auch in Bochum & Herne ✓ Jetzt buchen!";
const heroImg = _heroImgAsset.src;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Kinderzauberer in Dortmund",
  "description": "Kinderzauberer LIAR für Kindergeburtstag und Kinderevents in Dortmund, NRW",
  "url": "https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-dortmund/",
  "serviceType": ["Kinderzauberer", "Zaubershow für Kinder"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "City", "name": "Dortmund" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was braucht Clown LIAR für einen Auftritt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ohne Vorbereitungszeit und mit einer Fläche von 2×2 Meter kann ich eine Show vorführen: Wohnzimmer, Kinderzimmer, Partykeller, Terrasse, Gartenanlage, große und kleine Bühne, Kindergarten, Turnhalle… Ob drinnen oder draußen, das Programm lässt sich spontan und flexibel ausführen!"
      }
    },
    {
      "@type": "Question",
      "name": "Wieviel Platz braucht man für das Programm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LIAR ist ziemlich pflegeleicht: für die Show ist es wichtig, dass die Kinder gemütlich und ungestört sitzen können!!! Bei der Ballonmodellage ist nichts weiteres nötig. Bei GLITZER TATTOOS wären schon 2 Stühle und einen Tisch wichtig!"
      }
    },
    {
      "@type": "Question",
      "name": "Wie viele Kinder sollten überhaupt eingeladen werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Natürlich soll das Kind seine Freunde einladen. Allerdings sollte man eine feste Zahl als Limit vorgeben. Pädagogen empfehlen, maximal genauso viele Gäste einzuladen, wie das Kind alt wird. Wer kommen darf, soll das Kind selbst bestimmen. Natürlich sind auch dabei die Aufsichtspersonen (mindestens 2) nicht zu vergessen."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

const _pageGallery = [
  { src: _zauberImgAsset, alt: 'Auftritt in einer Schule: Zaubershow mit Kinderzauberer in Dortmund' },
  { src: _kostenImgAsset, alt: 'Clown Zauberer LIAR im Einsatz in NRW bei Karneval in Dortmund' },
  { src: _weihnachtImgAsset, alt: 'Zaubervorführung auf dem Weihnachtsmarkt Dortmund' },
];

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords="Kinderzauberer Dortmund, Kinderzauberer in Dortmund, Zauberer Dortmund, Kindergeburtstag Dortmund, Zaubershow Dortmund, NRW"
  canonical="https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-dortmund/"
  ogImage={heroImg}
  structuredData={structuredData}
