---
import V2Layout from '../../layouts/V2Layout.astro';
import { Image } from 'astro:assets';

import heroImg from '../../assets/images/kinderzauberer/kinderzauberer-hero.jpg';
import kindergeburtstagMitKinderzauberer from '../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';
import clownerieUndZauberei from '../../assets/images/home/clownerie-und-zauberei.jpg';
import fotogalerieClownZauberer16 from '../../assets/images/galerie/fotogalerie-clown-zauberer-16.jpg';
import zaubershowMitClownZaubererLiar from '../../assets/images/kinderzauberer/zaubershow-mit-clown-zauberer-liar.jpg';
import clownZaubererGladbeck from '../../assets/images/kinderzauberer/clown-zauberer-gladbeck.jpg';
import Reviews from '../../components/v2/Reviews.astro';
import ReviewBadge from '../../components/v2/ReviewBadge.astro';
import SectionEdge from '../../components/v2/SectionEdge.astro';
import Bunting from '../../components/v2/kids/Bunting.astro';
import Squiggle from '../../components/v2/kids/Squiggle.astro';
import Glitter from '../../components/v2/kids/Glitter.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { CONTACT } from '../../data/site';
import '../../styles/kids-kit.css';

const seoTitle = 'Kinderzauberer NRW | Kinderzaubershow buchen | LIAR';
const seoDescription = 'Kinderzauberer LIAR in NRW ✓ Lustige Kinderzaubershow für Kindergeburtstag, Kita & Schule ✓ 370+ Bewertungen ✓ Jetzt anfragen!';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Kinderzauberer in NRW",
  "description": "Professioneller Kinderzauberer LIAR – Zaubershow für Kindergeburtstag, Schulfeste und Familienfeiern in NRW",
  "url": "https://liar-entertainer.com/kinderzauberer/",
  "serviceType": ["Kinderzauberer", "Zaubershow für Kinder"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "State", "name": "Nordrhein-Westfalen" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Auftritt von Kinderzauberer LIAR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Gage richtet sich nach Art und Umfang der Veranstaltung, Zuschauerzahl, Anfahrtsweg und Jahreszeit. Für Kindergeburtstage biete ich transparente Festpreise an. Kontaktieren Sie mich für ein unverbindliches Angebot – ich berate Sie gerne persönlich!"
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet eine Kinderzaubershow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ich arbeite mit transparenten Festpreisen ohne versteckte Kosten. Die Gage hängt von Anlass, Dauer und Anfahrt ab – über die Kontaktseite erstelle ich Ihnen gerne ein individuelles Angebot für Ihre Kinderzaubershow."
      }
    },
    {
      "@type": "Question",
      "name": "Wieviel Platz braucht man für die Zaubershow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ich benötige lediglich eine Fläche von etwa 2×2 Metern. Das bedeutet: Die Show ist möglich im Wohnzimmer, Kinderzimmer, Partykeller, auf der Terrasse, im Garten, in Turnhallen, Kindergärten, auf kleinen und großen Bühnen – praktisch überall!"
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert eine Vorführung mit dem Kinderzauberer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Show ist ab 25-30 Minuten buchbar und lässt sich flexibel gestalten. Für größere Veranstaltungen oder wenn mehr Zeit zur Verfügung steht, biete ich auch Programme von 45-60 Minuten an. Die Dauer stimme ich individuell mit Ihnen ab."
      }
    },
    {
      "@type": "Question",
      "name": "Für welches Alter ist die Zaubershow geeignet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meine Kinderzaubershow ist für Kinder von 4 bis 12 Jahren konzipiert. Ich passe das Programm altersgerecht an: Für Kindergartenkinder gestalte ich die Show etwas einfacher und kürzer, für Grundschulkinder darf es komplexer und länger sein."
      }
    }
  ]
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow und Clownshow für Kinder in NRW. Kindergeburtstag – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": {
    "@type": "Organization",
    "name": "Clown Zauberer LIAR",
    "url": "https://liar-entertainer.com"
  }
};
const structuredData = [serviceSchema, faqSchema, videoSchema];

---

<V2Layout
  title={seoTitle}
  description={seoDescription}
  keywords="Kinderzauberer NRW, Kinderzauberer buchen, Zauberer für Kinder, Zaubershow Kindergeburtstag, Kinderzauberer Ruhrgebiet"
  canonical="https://liar-entertainer.com/kinderzauberer/"
  structuredData={structuredData}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Kinderzauberer', url: '/kinderzauberer/' }]}
>
  <!-- ── Hero: Zirkus-Plakat. No reveal here (LCP). ───────────── -->
  <section class="kg-hero">
    <canvas class="kg-rays" aria-hidden="true" data-side-rays='{"rayColor1":"#ffb546","rayColor2":"#ff8a3d","origin":"top-right","speed":1.6,"intensity":2,"spread":1.4,"saturation":1.5,"blend":0.4,"falloff":1.3,"opacity":0.9}'></canvas>
    <Bunting />
    <div class="container kg-hero__grid">
      <div class="kg-hero__copy">
        <p class="kz-crumbs">
          <a href="/">Clown</a> »
          <a href="/">Clown Zauberer LIAR</a> »
        </p>
        <ReviewBadge />
        <h1 class="kg-hero__title" data-letters>Kinderzauberer in NRW – Ihre <span class="kg-mark">Kinderzaubershow</span> zum Staunen</h1>
        <h2 class="kz-hero__sub">
          Kinderzauberer in NRW –<br />Zaubershow für unvergessliche Momente
        </h2>
        <div class="kg-hero__actions">
          <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
        </div>
        <nav class="kg-quick" aria-label="Schnell zu den Infos">
          <a href="#ablauf">Ablauf der Show</a>
          <a href="#wissen">Fragen der Eltern</a>
          <a href="#bewertungen">Bewertungen</a>
          <a href="#einsatzgebiet">Städte</a>
        </nav>
      </div>
      <figure class="kg-hero__photo">
        <Image
          src={heroImg}
          alt="Kinderzauberer NRW – Zaubershow für Kinder"
          widths={[400, 700, 1000, 1400]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
          style="object-position: 46% 70%"
        />
        <a class="kg-sticker" href="#wissen">
          <span>Kinder</span><strong>4–12</strong>
        </a>
      </figure>
    </div>
  </section>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="kg-intro">
    <div class="container kg-narrow kg-center" data-reveal>
      <p class="kg-lead">
        Kinderzauberer LIAR (Michaël Prescler) ist ein professioneller Kinderzauberer aus Gladbeck und tritt in ganz NRW auf. Er gestaltet eine interaktive Kinderzaubershow für Kindergeburtstage, Schulfeste und Familienfeiern – für Kinder von 4 bis 12 Jahren, ab ca. 25–30 Minuten und für Kindergeburtstage zu transparenten Festpreisen buchbar.
      </p>
      <p class="kz-soft">
        Seit über 15 Jahren bringe ich Kinder und Familien bei Kindergeburtstagen, Schulfesten und Veranstaltungen in NRW zum Staunen – mit einer Mischung aus Clownerie, Zauberei und jeder Menge Mitmachmomenten.
      </p>
      <p class="kz-soft">
        Meine <a href="/zauberer/zaubershow/">Zaubershow</a> ist speziell für Kinder entwickelt: bunt, humorvoll und voller Mitmachmomente. Schauen Sie sich auch meine <a href="/galerie/">Galerie</a> an!
      </p>
      <p class="kz-perfect">
        🎉 Perfekt für Kindergeburtstage, Feste, Kindergärten und Schulen.
      </p>
    </div>
  </section>

  <!-- ── Video (yellow band) ───────────────────────────────── -->
  <section class="kg-band kg-band--yellow">
    <SectionEdge color="var(--brand-yellow)" side="top" />
    <SectionEdge color="var(--brand-yellow)" side="bottom" />
    <div class="container kg-narrow">
      <div class="kg-video" data-reveal="pop">
        <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" label="Zaubershow ansehen" />
      </div>
    </div>
  </section>

  <!-- ── So läuft die Show ab ──────────────────────────────── -->
  <section class="kz-show" id="ablauf">
    <div class="container kg-intro__grid">
      <div data-reveal>
        <h2 class="kg-h2">So läuft meine Kinderzaubershow ab</h2>
        <Squiggle color="var(--brand-blue)" />
        <p class="kz-soft">
          Meine Kinderzaubershow beginnt mit einer spannenden Geschichte, die die Kinder sofort in ihren Bann zieht. Schon nach wenigen Minuten wird aus der Geschichte eine rasante, witzige und zauberhafte Show, bei der die Grenzen zwischen Zauberer und Publikum verschwimmen.
        </p>
        <p class="kz-show__label">Die Kinder erleben:</p>
        <ul class="kz-show__list">
          <li>✅ Verblüffende Zaubertricks mit Alltagsgegenständen</li>
          <li>✅ Eigene Zaubermomente, wenn sie mir auf der „Bühne" assistieren</li>
          <li>✅ Lustiges Chaos, wenn Tricks scheinbar schiefgehen</li>
          <li>✅ Staunen und Lachen im ständigen Wechsel</li>
          <li>✅ Das unbezahlbare Gefühl, selbst gezaubert zu haben</li>
        </ul>
        <p class="kz-show__trick">
          Der beste Trick? Den gibt es nicht – denn der schönste Moment ist immer, wenn ich den Kindern ein echtes Lächeln ins Gesicht zaubere. Das ist die Magie, die wirklich zählt!
        </p>
        <a href="/kindergeburtstag/" class="btn btn--primary">
          Kindergeburtstag – Preise
        </a>
      </div>
      <figure class="kz-show__photo" data-reveal="pop" data-reveal-delay="0.1">
        <Glitter />
        <Image
          src={kindergeburtstagMitKinderzauberer}
          alt="Kinderzauberer auf einem Kindergeburtstag in Essen"
          data-scroll-tilt="3"
          loading="lazy"
          widths={[320, 640]}
          sizes="(max-width: 900px) 80vw, 340px"
        />
      </figure>
    </div>
  </section>

  <!-- ── Drei Versprechen ──────────────────────────────────── -->
  <section class="kg-extras kz-promises">
    <div class="container">
      <div class="kg-cards">
        <article class="kg-card kg-card--red kz-card" data-reveal="pop">
          <Image
            src={clownerieUndZauberei}
            alt="Kinderzauberer LIAR verbindet Clownerie und Zauberei auf einem Kinderfest"
            class="kz-card__img"
            loading="lazy"
            widths={[150, 300]}
            sizes="150px"
          />
          <h3>Einfach und unkompliziert</h3>
          <p>
            Mit wenig Aufwand und fast ohne Vorbereitungszeit komme ich vorbei… und lege mit meinem Programm los: lachende Kinder, ausgelassene Stimmung und entspannte Eltern!
          </p>
        </article>
        <article class="kg-card kg-card--blue kz-card" data-reveal="pop" data-reveal-delay="0.1">
          <Image
            src={fotogalerieClownZauberer16}
            alt="Kinderzauberer bringt Kinder zum Staunen bei Zaubershow in NRW"
            class="kz-card__img"
            loading="lazy"
            widths={[150, 300]}
            sizes="150px"
          />
          <h3>Sehen und mit fiebern</h3>
          <p>
            Die Kinder werden immer wieder mit eingebunden und pendeln die ganze Zeit zwischen Lachen und Staunen… und mein bester Trick funktioniert immer: den Kindern ein Lächeln ins Gesicht zu zaubern.
          </p>
        </article>
        <article class="kg-card kg-card--yellow kz-card" data-reveal="pop" data-reveal-delay="0.2">
          <Image
            src={zaubershowMitClownZaubererLiar}
            alt="Kinderzauberer bei Zaubershow in einer Schule"
            class="kz-card__img"
            loading="lazy"
            widths={[150, 300]}
            sizes="150px"
          />
          <h3>Witziger Kinderzauberer</h3>
          <p>
            Ob Schulfeier, Weihnachtsfeier, Hochzeit, Gartenfest, oder Kommunion sowie Kindergärten oder Schulen sorge ich mit meiner Kinderzaubershow für staunende und lachende Gesichter. Auch im Wohnzimmer für den Kindergeburtstag!
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Weitere Anlässe (SEO-Audit 06.08.2026, H6: internal links to /clown/karneval/ + /clown/walk-act/) ── -->
  <section class="kz-related" data-related-services>
    <div class="container kg-narrow">
      <h2 class="kg-h2 kg-center" data-reveal>
        Für welche Anlässe kann man Clown LIAR sonst buchen?
      </h2>
      <div class="kz-related__grid">
        <a href="/clown/karneval/" class="kz-related__card" data-reveal="tilt">
          <p class="kz-related__title">Clown für Karneval &amp; Kindersitzung</p>
          <p class="kz-related__text">Jecke Zaubershow für Kindersitzung, Karnevalsfeier und Rosenmontagsparty in NRW.</p>
        </a>
        <a href="/clown/walk-act/" class="kz-related__card" data-reveal="tilt" data-reveal-delay="0.1">
          <p class="kz-related__title">Walk-Act für Straßen- und Stadtfest</p>
          <p class="kz-related__text">Clown Zauberer LIAR mitten im Publikum – Ballonfiguren und Magie zum Anfassen.</p>
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ── Zahlen (red band) ─────────────────────────────────── -->
  <section class="kg-band kz-stats">
    <SectionEdge color="var(--brand-red)" side="top" />
    <SectionEdge color="var(--brand-red)" side="bottom" />
    <div class="container kz-stats__grid">
      <div class="kz-stat" data-reveal="pop">
        <div class="kz-stat__icon">🪄</div>
        <div class="kz-stat__num" data-count>400</div>
        <div class="kz-stat__label">Shows im Jahr</div>
      </div>
      <div class="kz-stat" data-reveal="pop" data-reveal-delay="0.08">
        <div class="kz-stat__icon">😊</div>
        <div class="kz-stat__num">110.000</div>
        <div class="kz-stat__label">Lachende Kinder</div>
      </div>
      <div class="kz-stat" data-reveal="pop" data-reveal-delay="0.16">
        <div class="kz-stat__icon">🪄</div>
        <div class="kz-stat__num" data-count>15</div>
        <div class="kz-stat__label">Jahre Erfahrung</div>
      </div>
    </div>
  </section>

  <!-- ── FAQ / Wissenswertes: native <details>, works without JS ── -->
  <section class="kg-faq kz-faq" id="wissen">
    <div class="container kg-narrow">
      <h2 class="kg-h2 kg-center">Was sollten Eltern über den Kinderzauberer wissen?</h2>
      <div class="kg-faq__list">
        <details class="kg-faq__item" data-reveal="puff">
          <summary><h3>Was kostet ein Auftritt von Kinderzauberer LIAR?</h3></summary>
          <p class="kg-faq__answer">
            Die Gage richtet sich nach Art und Umfang der Veranstaltung, Zuschauerzahl, Anfahrtsweg und Jahreszeit. Für Kindergeburtstage biete ich transparente Festpreise an. Kontaktieren Sie mich für ein unverbindliches Angebot – ich berate Sie gerne persönlich!
          </p>
        </details>
        <details class="kg-faq__item" data-reveal="puff">
          <summary><h3>Was kostet eine Kinderzaubershow?</h3></summary>
          <p class="kg-faq__answer">
            Ich arbeite mit transparenten Festpreisen ohne versteckte Kosten. Die Gage hängt von Anlass, Dauer und Anfahrt ab – über die <a href="/kontakt/">Kontaktseite</a> erstelle ich Ihnen gerne ein individuelles Angebot für Ihre Kinderzaubershow.
          </p>
        </details>
        <details class="kg-faq__item" data-reveal="puff">
          <summary><h3>Wieviel Platz braucht man für die Zaubershow?</h3></summary>
          <p class="kg-faq__answer">
            Ich benötige lediglich eine Fläche von etwa 2×2 Metern. Das bedeutet: Die Show ist möglich im Wohnzimmer, Kinderzimmer, Partykeller, auf der Terrasse, im Garten, in Turnhallen, Kindergärten, auf kleinen und großen Bühnen – praktisch überall!
          </p>
        </details>
        <details class="kg-faq__item" data-reveal="puff">
          <summary><h3>Wie lange dauert eine Vorführung mit dem Kinderzauberer?</h3></summary>
          <p class="kg-faq__answer">
            Die Show ist ab 25-30 Minuten buchbar und lässt sich flexibel gestalten. Für größere Veranstaltungen oder wenn mehr Zeit zur Verfügung steht, biete ich auch Programme von 45-60 Minuten an. Die Dauer stimme ich individuell mit Ihnen ab.
          </p>
        </details>
        <details class="kg-faq__item" data-reveal="puff">
          <summary><h3>Für welches Alter ist die Zaubershow geeignet?</h3></summary>
          <p class="kg-faq__answer">
            Meine Kinderzaubershow ist für Kinder von 4 bis 12 Jahren konzipiert. Ich passe das Programm altersgerecht an: Für Kindergartenkinder gestalte ich die Show etwas einfacher und kürzer, für Grundschulkinder darf es komplexer und länger sein.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ── Planung (blue band) ───────────────────────────────── -->
  <section class="kg-band kg-band--blue kz-plan">
    <SectionEdge color="var(--brand-blue)" side="top" />
    <SectionEdge color="var(--brand-blue)" side="bottom" />
    <div class="container">
      <h2 class="kg-h2" data-reveal>Zauberer für den Kindergeburtstag – Ablauf, Kosten &amp; Planung</h2>
      <div class="kz-plan__grid">
        <article class="kz-plan__card" data-reveal="pop">
          <h3>Was kostet ein Zauberer für den Kindergeburtstag?</h3>
          <p>
            Ein Zauberer für den Kindergeburtstag ist bei LIAR zu einem <strong>transparenten Festpreis</strong> buchbar – ohne versteckte Kosten. Der Festpreis gilt für die interaktive Kinderzaubershow ab ca. 25–30 Minuten. Alle Details finden Sie unter <a href="/kindergeburtstag/">Kindergeburtstag – Preise</a>.
          </p>
        </article>
        <article class="kz-plan__card" data-reveal="pop" data-reveal-delay="0.08">
          <h3>Wie läuft die Zaubershow am Geburtstag ab?</h3>
          <p>
            Die Show braucht nur etwa 2×2 Meter Platz und funktioniert im Wohnzimmer genauso wie im Partykeller oder Garten. Das Geburtstagskind steht im Mittelpunkt: Es assistiert bei den Zaubertricks und erlebt seinen eigenen Zaubermoment vor allen Gästen. Auf Wunsch ergänze ich die Show um <a href="/clown/ballonmodellage/">Ballonfiguren</a> für alle Kinder.
          </p>
        </article>
        <article class="kz-plan__card" data-reveal="pop" data-reveal-delay="0.16">
          <h3>Für welches Alter und wie viele Kinder?</h3>
          <p>
            Die Zaubershow ist für Kinder von 4 bis 12 Jahren konzipiert und wird altersgerecht angepasst – vom kleinen Kindergeburtstag bis zum Schulfest oder Kita-Fest. Auch bei größeren Gruppen kommt jedes Kind auf seine Kosten, denn Mitmachen ist das Herzstück der Show.
          </p>
        </article>
        <article class="kz-plan__card" data-reveal="pop" data-reveal-delay="0.24">
          <h3>Wann sollte man den Zauberer buchen?</h3>
          <p>
            Beliebte Wochenend-Termine sind erfahrungsgemäß früh vergeben – eine rechtzeitige Anfrage lohnt sich. Kurzfristige Termine sind je nach Verfügbarkeit ebenfalls möglich. Tipp: Wer Zauberei und <a href="/clown/clownshow/">Clownshow</a> kombiniert, bekommt ein abwechslungsreiches Programm aus einer Hand.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Ablauf des Auftritts ──────────────────────────────── -->
  <section class="kz-story">
    <div class="container kg-narrow" data-reveal>
      <h2 class="kg-h2">Wie läuft der Auftritt des Kinderzauberers ab?</h2>
      <p class="kz-soft">
        Vom ersten Kontakt bis zum Applaus ist alles bewusst einfach gehalten. Nach Ihrer Anfrage stimmen wir Termin, Ort und Programmwunsch ab – meist antworte ich innerhalb von 24 Stunden. Am Veranstaltungstag komme ich rechtzeitig an und baue in wenigen Minuten auf; mehr als eine freie Fläche von 2×2 Metern brauche ich dafür nicht. Die Show selbst beginnt mit einer Geschichte, die die Kinder sofort in die Zauberwelt hineinzieht. Von da an sind sie mittendrin statt nur dabei: Sie assistieren bei den Tricks, sprechen Zaubersprüche und erleben, wie durch ihre Hilfe scheinbar Unmögliches gelingt. Zwischendurch sorgt die Clownerie dafür, dass auf jedes Staunen ein Lachen folgt. Zum Schluss steigert sich die Show zu einem Finale, das die Kinder noch Tage später nacherzählen. Danach baue ich genauso unkompliziert wieder ab – und Sie haben entspannte Gäste und strahlende Kinder.
      </p>
      <ul class="kz-steps">
        <li><span>✓</span> Anfrage – Antwort meist innerhalb von 24 Stunden</li>
        <li><span>✓</span> Kurzer Aufbau, nur 2×2 Meter Platzbedarf</li>
        <li><span>✓</span> Interaktive Show ab 25–30 Minuten, flexibel erweiterbar</li>
        <li><span>✓</span> Kein Aufwand für Gastgeber – alles bringe ich selbst mit</li>
      </ul>
    </div>
  </section>

  <!-- ── Was unterscheidet LIAR ────────────────────────────── -->
  <section class="kz-diff">
    <div class="container kg-narrow">
      <div class="kz-diff__card" data-reveal="tilt">
        <h2 class="kg-h2">Was unterscheidet LIAR von anderen Kinderzauberern?</h2>
        <p>
