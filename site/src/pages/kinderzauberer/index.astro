      "@type": "Question",
      "name": "Für welches Alter ist die Zaubershow geeignet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meine Kinderzaubershow ist für Kinder von 4 bis 12 Jahren konzipiert. Ich passe das Programm altersgerecht an: Für Kindergartenkinder gestalte ich die Show etwas einfacher und kürzer, für Grundschulkinder darf es komplexer und länger sein."
      }
    }
  ]
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
