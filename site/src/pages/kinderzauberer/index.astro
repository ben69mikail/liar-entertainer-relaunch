  <GoogleReviews />

  <section class="py-12 bg-[#fdf2f2]">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 text-center border border-[#f0c4c4] shadow-sm">
          <div class="text-3xl mb-2">🪄</div>
          <div class="text-4xl font-extrabold text-[#d7393e]"><CountUp value={400} /></div>
