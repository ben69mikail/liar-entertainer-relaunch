  <!-- Kindergeburtstag in Bochum mit Kinderzauberer feiern -->
  <section class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
