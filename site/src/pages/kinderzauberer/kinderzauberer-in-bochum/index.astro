  </section>

  <!-- Anlässe für den Kinderzauberer in Bochum -->
  <section class="bg-gray-50 py-14">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-[#1f2025] font-bold text-2xl sm:text-3xl text-center mb-10">Anlässe für den Kinderzauberer in Bochum 👧👦</h2>
      <p class="text-[#374151] text-center mb-8 leading-relaxed">Meine Zaubershow ist perfekt für verschiedene Veranstaltungen in Bochum und Umgebung:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-[#d7393e] card-hover reveal">
          <div class="text-2xl mb-3">🎂</div>
