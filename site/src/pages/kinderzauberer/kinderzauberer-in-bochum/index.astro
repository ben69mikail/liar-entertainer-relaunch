import GoogleReviews from '../../../components/GoogleReviews.astro';
import _heroImgAsset from '../../../assets/images/kinderzauberer/kinderzauberer-hero.jpg';
import _roundImgAsset from '../../../assets/images/kinderzauberer/zaubershow-mit-clown-zauberer-liar.jpg';
import _showImgAsset from '../../../assets/images/clown/clown-bei-clownshow.jpg';
import _kgImgAsset from '../../../assets/images/kindergeburtstag/kindergeburtstag-mit-kinderzauberer.jpg';
import _galleryImgAsset from '../../../assets/images/clown/kinderzauberer-kindergarten-essen.jpg';

const seoTitle = "Zauberer Kindergeburtstag Bochum | Kinderzauberer LIAR";
const seoDescription = "Kinderzauberer in Bochum buchen ✓ Zaubershow für Kindergeburtstag & Events ✓ 370+ Bewertungen ✓ Auch in Herne & Dortmund ✓ Jetzt anfragen!";
const heroImg = _heroImgAsset.src;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Kinderzauberer in Bochum",
  "description": "Kinderzauberer LIAR für Kindergeburtstag und Kinderevents in Bochum, NRW",
  "url": "https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-bochum/",
  "serviceType": ["Kinderzauberer", "Zaubershow für Kinder"],
  "provider": { "@id": "https://liar-entertainer.com/#business" },
  "areaServed": { "@type": "City", "name": "Bochum" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Kinderzauberer in Bochum?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten für einen Kinderzauberer in Bochum variieren je nach Art der Veranstaltung, Dauer der Show, Zuschauerzahl und Anfahrt. Für Kindergeburtstage biete ich Festpreise an. Kontaktieren Sie mich unverbindlich für ein individuelles Angebot – ich berate Sie gerne!"
      }
    },
    {
      "@type": "Question",
      "name": "Wie viel Platz braucht die Zaubershow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Für meine Zaubershow in Bochum benötige ich lediglich eine Fläche von 2×2 Metern – ohne lange Vorbereitungszeit! Ob Wohnzimmer, Partykeller, Garten, Kindergarten, Schule oder Eventlocation: Ich passe mich flexibel an Ihre Räumlichkeiten an."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Zaubershow in Bochum?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meine Zaubershow in Bochum dauert ab 30 Minuten und lässt sich flexibel an Ihre Veranstaltung anpassen. Perfekt für: Kindergeburtstag, Kita-Fest, Schulfest, Sommerfest, Firmenevent, Hochzeit, Kommunion oder Straßenfest. Die Show-Dauer stimme ich individuell auf Ihr Event ab."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];

---

