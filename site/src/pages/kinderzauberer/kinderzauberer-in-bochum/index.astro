    </div>
  </section>

  <!-- Bildergalerie -->
  <section class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4 flex justify-center">
      <Image src={_galleryImgAsset} alt="Veranstaltung mit Zaubershow: Kinderzauberer in Bochum" class="rounded-xl w-full max-w-md object-cover object-top shadow-sm" style="max-height:400px;max-width:28rem" loading="lazy" width={320} height={480} />
