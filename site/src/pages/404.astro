---
import V2Layout from '../layouts/V2Layout.astro';
import Bunting from '../components/v2/kids/Bunting.astro';
import HatTrick from '../components/v2/kids/HatTrick.astro';
import '../styles/kids-kit.css';
---

<V2Layout
  title="404 – Seite nicht gefunden | Clown Zauberer LIAR"
  description="Diese Seite konnte nicht gefunden werden."
  noindex={true}
>
  <!-- The page "vanished" like in a trick: the hat brings something back on every tap. -->
  <section class="kg-hero nf">
    <Bunting />
    <div class="container nf__inner">
      <div class="nf__tent" aria-hidden="true">🎪</div>
      <h1 class="nf__title">404 – Seite nicht gefunden</h1>
      <p class="nf__lead">
        Ups! Diese Seite scheint verschwunden zu sein – aber Clown Liar findet immer eine Lösung!
      </p>
      <HatTrick />
      <div class="nf__actions">
        <a class="btn btn--primary" href="/">Zur Startseite</a>
        <a class="btn btn--ghost" href="/kontakt/" data-confetti>Kontakt</a>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .nf { min-height: 70vh; display: grid; align-content: start; }
  .nf__inner { max-width: 40rem; padding-block: var(--space-5) var(--space-4); text-align: center; }
  .nf__tent { font-size: 4.5rem; line-height: 1; margin-bottom: var(--space-2); }
  .nf__title { font-size: clamp(2rem, 6vw, 3.4rem); margin-bottom: var(--space-2); }
  .nf__lead { font-size: 1.15rem; max-width: 34rem; margin: 0 auto var(--space-4); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: var(--space-2); }
</style>
