  .hm-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }

  .hm-worlds {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); align-items: center;
    margin-top: var(--space-5); max-width: 62rem;
  }
  .hm-world {
    position: relative; display: grid; gap: 0.6rem; justify-items: center; text-align: center;
    color: var(--ink); text-decoration: none;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .hm-world__label { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.3rem); line-height: 1; }
  .hm-world__links { font-weight: 700; font-size: 0.9rem; color: var(--ink-soft); }
  .hm-world__go {
    font-weight: 800; font-size: 0.95rem; padding: 0.45rem 1rem; border-radius: 999px; border: var(--border);
    background: var(--surface); transition: background-color 0.2s ease, color 0.2s ease;
  }
  /* kids: a circus poster */
  .hm-world--kids { rotate: -2deg; }
  .hm-world__photo {
    display: block; width: 100%; border: 5px solid var(--line); border-radius: var(--radius);
    box-shadow: 9px 9px 0 var(--line); overflow: hidden; background: var(--brand-yellow);
  }
  .hm-world__photo :global(img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .hm-world--kids .hm-world__label { color: var(--brand-red); order: -1; }
  /* adult: a playing card in its own typeface and colours (a preview of the adult zone) */
  .hm-world--adult {
    --font-display: 'Bodoni Moda Variable', Georgia, serif;
    --radius: 0.85rem;
    rotate: 2.5deg;
  }
  .hm-world--adult .hm-world__label { font-style: italic; font-weight: 500; color: #141210; }
  .hm-world__card { display: block; width: min(100%, 22rem); }
  .hm-world__card :global(.hm-world__pc) { transition: transform 0.45s var(--ease-out-expo); transform-style: preserve-3d; }
  .hm-world--adult .hm-world__go { background: #141210; color: #fffdf7; border-color: #141210; border-radius: 0.5rem; }
  @media (hover: hover) and (pointer: fine) {
    .hm-world--kids:hover { transform: translateY(-8px) rotate(-1deg); }
    .hm-world--kids:hover .hm-world__go { background: var(--brand-yellow); }
    .hm-world--adult:hover { transform: translateY(-8px); }
    .hm-world--adult:hover :global(.hm-world__pc) { transform: perspective(900px) rotateY(-14deg) rotateZ(-3deg); }
    .hm-world--adult:hover .hm-world__go { background: #c8102e; border-color: #c8102e; }
  }

  /* ── sections ── */
  .hm-red { color: var(--accent-strong); }
  .hm-cta { margin-top: var(--space-3); }
  .hm-sticker { margin: 0; justify-self: center; rotate: 2deg; }
