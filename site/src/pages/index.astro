  .hm-stat__label { font-weight: 800; margin-top: 0.3rem; }

  .hm-quali__title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 650; }
  .hm-checks p { display: flex; gap: 0.6rem; align-items: flex-start; margin-bottom: 0.6rem; font-weight: 600; }
  .hm-check { color: var(--accent-strong); font-weight: 900; flex: none; }
  .hm-nocreepy { margin-top: var(--space-5); padding: var(--space-3); background: var(--surface); border: var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .hm-nocreepy .kg-h3 { margin-top: 0; }

  .hm-programs__grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); margin-top: var(--space-4); text-align: left; }
  .hm-program {
    display: flex; flex-direction: column; overflow: hidden; color: var(--ink);
