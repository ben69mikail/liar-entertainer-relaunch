  .hm-program__title {
    position: absolute; left: 1rem; bottom: 1rem; padding: 0.3rem 0.9rem; rotate: -3deg;
    font-family: var(--font-display); font-weight: 700; font-size: 1.35rem;
    background: var(--brand-yellow); color: var(--ink); border: 2.5px solid var(--line); border-radius: 0.6rem;
  }
  .hm-program__body { display: flex; flex-direction: column; flex: 1; padding: var(--space-3); color: var(--ink-soft); font-size: 0.97rem; }
  .hm-program__body strong { color: var(--ink); }
  .hm-program__list p { margin-bottom: 0.4rem; }
