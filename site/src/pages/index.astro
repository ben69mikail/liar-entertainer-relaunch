    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s var(--ease-out-expo);
  }
  .hm-program:nth-child(1) { rotate: -1deg; }
  .hm-program:nth-child(3) { rotate: 1deg; }
  .hm-program__media { position: relative; display: block; overflow: hidden; border-bottom: var(--border); }
