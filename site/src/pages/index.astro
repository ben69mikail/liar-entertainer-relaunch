---
import V2Layout from '../layouts/V2Layout.astro';
import Reviews from '../components/v2/Reviews.astro';
import SectionEdge from '../components/v2/SectionEdge.astro';
import Bunting from '../components/v2/kids/Bunting.astro';
import Squiggle from '../components/v2/kids/Squiggle.astro';
import PlayingCard from '../components/v2/adult/PlayingCard.astro';
import adultWorldImg from '../assets/images/zauberer/zauberer-nrw.png';
import '../styles/kids-kit.css';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { Image } from 'astro:assets';

import heroImg from '../assets/images/home/clown-zauberer-hero.jpg';
import heroSlide2 from '../assets/images/Slider/kinderzauberer-hero.jpg';
import heroSlide3 from '../assets/images/Slider/zaubershow-hero.jpg';
import heroSlide4 from '../assets/images/Slider/kindergeburtstag-hero.jpg';
import heroSlide5 from '../assets/images/Slider/zaubershow-mit-clown-zauberer-liar.jpg';
// Sommer-/Outdoor-Motiv zuerst (saisonale Reihenfolge; Weihnachts-Innenraum ans Ende)
const heroSlides = [
  { src: heroSlide5, alt: 'LIAR bei einer Open-Air-Zaubershow für Kinder' },
  { src: heroSlide3, alt: 'Zaubershow von LIAR vor großem Kinderpublikum' },
  { src: heroSlide2, alt: 'Kinderzauberer LIAR begeistert Kinder aus nächster Nähe' },
  { src: heroSlide4, alt: 'Clown Zauberer LIAR beim Kindergeburtstag in der Kita' },
  { src: heroImg, alt: 'Clown Zauberer LIAR bei einer Zaubershow' },
];
import portraitImg from '../assets/images/home/clown-zauberer-liar-portrait.jpg';
import michaelImg from '../assets/images/home/michael-prescler-portrait.jpg';
import clownerieImg from '../assets/images/home/clownerie-und-zauberei.jpg';
import zaubershowImg from '../assets/images/shows/zaubershow.jpg';
import ballonImg from '../assets/images/shows/ballonmodellage.jpg';
import glitzerImg from '../assets/images/shows/glitzer-tattoos.jpg';
import karteImg from '../assets/images/home/clown-zauberer-gladbeck-karte.jpg';

const title = 'Zauberer für Kindergeburtstag & Zaubershow NRW | Clown LIAR';
const description = 'Zauberer für Kindergeburtstag in NRW ✓ Clown Zauberer LIAR aus Gladbeck ✓ Zaubershow & Clownshow für Kita, Schule & Firma ✓ 370+ Top-Bewertungen ✓ Jetzt anfragen!';
const ogImage = 'https://liar-entertainer.com/images/og-startseite.jpg';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Zauberer für den Kindergeburtstag?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die 40-minütige Zaubershow von Clown Zauberer LIAR kostet 150 € Festpreis für bis zu 12 Kinder ab 4 Jahren, inklusive Material. Ballonmodellage kostet 20 € zusätzlich, Glitzer-Tattoos 40 €. Das Komplett-Paket mit allen drei Bausteinen liegt bei 210 € für rund 90 Minuten. Hinzu kommen 0,40 € pro Kilometer Fahrtkosten ab Gladbeck."
      }
    },
    {
      "@type": "Question",
      "name": "Macht Clown LIAR auch eine reine Zaubershow für Kinder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Neben der Kombination aus Clownerie und Magie bietet LIAR auch eine reine Zaubershow für Kinder an – ideal für Kindergeburtstage, Kitas, Schulen und Sommerfeste. Die Kinder machen aktiv mit und werden selbst zu kleinen Zauberern. Die Show dauert ca. 40 Minuten und ist für Kinder von 4 bis 12 Jahren geeignet."
      }
    },
    {
      "@type": "Question",
      "name": "In welchen Städten ist Clown LIAR buchbar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Clown LIAR ist in ganz NRW buchbar, insbesondere in Gladbeck, Oberhausen, Essen, Gelsenkirchen, Dortmund, Bochum, Duisburg und weiteren Städten."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert eine Clown Zaubershow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Standard-Zaubershow dauert ca. 40 Minuten und ist speziell auf Kinder von 4-12 Jahren zugeschnitten."
      }
    },
    {
      "@type": "Question",
      "name": "Wie läuft die Buchung von Clown Zauberer LIAR ab?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Buchung ist einfach: Sie senden eine Anfrage über das Kontaktformular oder rufen direkt unter 0172-1517578 an. Nach Abstimmung von Datum, Ort und gewünschter Show erhalten Sie eine verbindliche Bestätigung. Eine Anfrage 4-8 Wochen im Voraus wird empfohlen, kurzfristige Termine sind aber oft möglich."
      }
    },
    {
      "@type": "Question",
      "name": "Ist Clown LIAR ein \"gruseliger\" Clown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein! Clown LIAR tritt bewusst ohne Schminke, ohne rote Nase und ohne \"komische Haare\" auf. Sein Clown-Charakter ist freundlich, bunt und einladend. Selbst schüchterne Kinder tauen schnell auf."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich Clown LIAR auch für Erwachsenen-Events buchen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja! Neben Kindergeburtstagen bietet Clown Zauberer LIAR auch Close-up Zauberei für Hochzeiten, Firmenfeiern und Gala-Events an. Die Tischzauberei funktioniert ohne Bühne direkt an den Tischen Ihrer Gäste."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit im Voraus sollte ich buchen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eine Anfrage mindestens 4-8 Wochen im Voraus wird empfohlen, besonders an Wochenenden. Kurzfristige Buchungen sind aber oft auch möglich – einfach unter 0172-1517578 anrufen!"
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich eine Bühne oder spezielle Technik?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein! Es werden nur 2×2 Meter Platz benötigt. Die Show funktioniert im Wohnzimmer, Garten, Turnhalle oder auf einer Bühne. Alles Nötige wird mitgebracht."
      }
    },
    {
      "@type": "Question",
      "name": "Für welches Alter ist die Show geeignet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Shows sind für Kinder von 4 bis 12 Jahren konzipiert. Das Programm wird immer an die Altersgruppe angepasst: einfacher und kürzer für Kindergartenkinder, anspruchsvoller für Grundschulkinder."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Sprachen spricht Clown Zauberer LIAR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Clown Zauberer LIAR moderiert seine Shows auf Deutsch und Französisch. Dadurch sind auch zweisprachige Events und internationale Feiern in NRW und im Grenzgebiet problemlos möglich."
      }
    },
    {
      "@type": "Question",
      "name": "Was passiert bei schlechtem Wetter (Outdoor-Event)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Show ist flexibel und funktioniert drinnen wie draußen. Falls ein Outdoor-Event wegen Regen ins Haus verlegt werden muss, ist das kein Problem – es werden nur 2×2 Meter Platz benötigt."
      }
    },
    {
      "@type": "Question",
      "name": "Hat Clown LIAR eine Versicherung und ein Führungszeugnis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, Clown Zauberer LIAR ist vollständig haftpflichtversichert und verfügt über ein aktuelles polizeiliches Führungszeugnis, das auf Anfrage vorgelegt wird."
      }
    }
  ]
};

// Audit Runde 2, Massnahme A1 (12.08.2026): Hier stand ein ZWEITER Person-Knoten
// neben dem founder-Knoten aus BaseLayout - ohne @id, ohne sameAs, ohne
// hasCredential, und mit einem eigenen anonymen worksFor-LocalBusiness statt einer
// Referenz auf #business. Fuer Maschinen waren das zwei verschiedene Personen, was
// die Verknuepfung "Michael Prescler = LIAR = Kinderzauberer in Gladbeck"
// untergraebt - genau die Entitaet, auf die KI-Systeme angewiesen sind.
// Der Knoten ist entfernt; seine einzige zusaetzliche Information (knowsAbout)
// steht jetzt im founder-Knoten in BaseLayout.astro.
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!",
  "description": "Clown Zauberer LIAR zeigt seine Zaubershow und Clownshow für Kinder in NRW. Kindergeburtstage und Events – professionell, lustig und unvergesslich.",
  "thumbnailUrl": "https://img.youtube.com/vi/Cop0SqRIX4Y/maxresdefault.jpg",
  "uploadDate": "2018-02-04",
  "duration": "PT2M30S",
  "contentUrl": "https://www.youtube.com/watch?v=Cop0SqRIX4Y",
  "embedUrl": "https://www.youtube.com/embed/Cop0SqRIX4Y",
  "publisher": {
    "@type": "Organization",
    "name": "Clown Zauberer LIAR",
    "url": "https://liar-entertainer.com"
  }
};
---

<V2Layout
  title={title}
  description={description}
  keywords="Clown Kindergeburtstag NRW, Zauberer Kindergeburtstag, Clown Zauberer NRW, Zaubershow Kinder, Kinderzauberer NRW, Clown buchen NRW, Kindergeburtstag Zauberer"
  canonical="https://liar-entertainer.com/"
  ogImage={ogImage}
  structuredData={[faqSchema, videoSchema]}
>
  <!-- ── Hero: one stage, two worlds (kids poster · adult playing card). No reveal (LCP). ── -->
  <section class="kg-hero hm-hero">
    <canvas class="kg-rays" aria-hidden="true" data-side-rays='{"rayColor1":"#ffb546","rayColor2":"#ff8a3d","origin":"top-right","speed":1.6,"intensity":2,"spread":1.4,"saturation":1.5,"blend":0.4,"falloff":1.3,"opacity":0.55}'></canvas>
    <Bunting />
    <div class="container hm-hero__top">
      <div class="hm-badges">
        <span class="hm-badge"><span class="hm-badge__stars">★★★★★</span> 370+ Google-Rezensionen</span>
        <span class="hm-badge">🎩 15 Jahre Erfahrung</span>
        <span class="hm-badge">🪄 Interaktive Zaubershow</span>
      </div>
      <h1 class="hm-title" data-letters>
        <span class="hm-title__main">Clown Zauberer in NRW</span>
        <span class="sr-only"> – </span>
        <span class="hm-title__sub">Zaubershow &amp; Kindergeburtstag</span>
      </h1>
      <p class="sr-only">
        Clown Zauberer in NRW –<br /> Zaubershow &amp; Kindergeburtstag
      </p>
      <p class="hm-lead">
        40 Minuten Mitmach-Magie ab 4 Jahren · nur 2×2 m Platz nötig · 370+ ★★★★★-Google-Bewertungen
      </p>
      <div class="hm-actions">
        <a href="/kontakt/" class="btn btn--primary" data-confetti>
          Jetzt unverbindlich anfragen
        </a>
        <a href="tel:+491721517578" class="btn btn--ghost">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
          0172 1517578
        </a>
      </div>
    </div>

    <nav class="container hm-worlds" aria-label="Für wen?">
      <a class="hm-world hm-world--kids" href="/kindergeburtstag/">
        <span class="hm-world__label">Für Kinder</span>
        <span class="hm-world__photo">
          <Image src={heroSlides[0].src} alt={heroSlides[0].alt} widths={[400, 700, 1000]} sizes="(max-width: 760px) 92vw, 520px" loading="eager" fetchpriority="low" />
        </span>
        <span class="hm-world__links" aria-hidden="true">Kindergeburtstag · Kinderzauberer · Clownshow</span>
        <span class="hm-world__go" aria-hidden="true">Zur Kinderwelt →</span>
      </a>
      <a class="hm-world hm-world--adult" href="/zauberer/">
        <span class="hm-world__card">
          <PlayingCard rank="A" suit="♠" class="hm-world__pc">
            <Image src={adultWorldImg} alt="Zauberer LIAR wirft Spielkarten auf der Bühne" widths={[400, 700]} sizes="(max-width: 760px) 70vw, 360px" loading="lazy" style="object-position: 30% 30%" />
          </PlayingCard>
        </span>
        <span class="hm-world__label">Für Erwachsene</span>
        <span class="hm-world__links" aria-hidden="true">Close-up · Bühnenshow · Hochzeit · Firmenfeier</span>
        <span class="hm-world__go" aria-hidden="true">Zur Zauberei für Erwachsene →</span>
      </a>
    </nav>
  </section>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="hm-intro">
    <div class="container kg-narrow" data-reveal>
      <h2 class="kg-h2">
        <span class="hm-red">Lachen garantiert</span> – bei Ihnen zu Hause, in der Kita oder auf dem Fest
      </h2>
      <p class="kg-lead">
        Sie suchen einen Clown, der Kinderaugen zum Leuchten bringt? Clown Zauberer Liar sorgt seit
        über 15 Jahren für unvergessliche Momente auf <a href="/kindergeburtstag/">Kindergeburtstagen</a>, Straßenfesten und
        Firmenevents in ganz NRW. Als erfahrener <a href="/kinderzauberer/">Kinderzauberer</a> und
        <a href="/clown/clownshow/">Clown</a> verbindet er professionelle
        <a href="/zauberer/">Zauberei</a>
        mit Interaktion — jede Veranstaltung wird zum Highlight!
      </p>
      <p class="kg-center hm-cta">
        <a href="/kontakt/" class="btn btn--primary" data-confetti>
          Jetzt unverbindlich anfragen
        </a>
      </p>
    </div>
  </section>

  <!-- ── Was macht Clown Liar so besonders? ────────────────── -->
  <section class="kg-intro hm-special">
    <div class="container kg-intro__grid">
      <div class="kg-intro__text" data-reveal>
        <h2 class="kg-h2">
          Was macht Clown Liar so besonders?
        </h2>
        <p>
          Als professioneller Clown und Kinderzauberer bringe ich nicht nur Kinder, sondern auch Erwachsene zum Lachen.
          Meine Show kombiniert klassische Clownerie mit modernen Entertainment-&nbsp;Elementen –
          individuell abgestimmt auf Ihr Event und die Altersgruppe. Ob beim <a href="/kindergeburtstag/">Kindergeburtstag</a> oder auf der großen Bühne.
        </p>
        <p>
          <a href="/zauberer/zaubershow/">Zaubershow</a>:
          Verblüffende Zaubertricks, bei denen die Kinder aktiv mitmachen und selbst zu
          kleinen Zauberern werden. Staunen und Lachen in perfekter Balance!
        </p>
        <p>
          <strong>Walk-Act:</strong> Lustige Improvisation, witzige Gags und interaktive Clownerie, die garantiert
          für Lacher sorgt. Jeder Pantomime- oder Clown-Auftritt wird auf Ihre Gäste abgestimmt.
        </p>
        <p>
          <strong>Extras:</strong> Ballonmodellage, Glitzer Tattoos, Close-up… Ihr Clown Zauberer bringt alles
          mit, was Ihr Event unvergesslich macht.
        </p>
      </div>
      <figure class="hm-sticker" data-reveal="pop">
        <Image
          src={portraitImg}
          alt="Clown Zauberer LIAR bringt Kinder auf dem Geburtstag zum Lachen"
          loading="lazy"
          width={360}
          height={360}
          data-scroll-tilt="3"
        />
      </figure>
    </div>
  </section>

  <Reviews />

  <!-- ── Lernen Sie Clown Liar kennen ──────────────────────── -->
  <section class="hm-about">
    <div class="container kg-intro__grid">
      <div data-reveal>
        <p class="kg-kicker">Über mich</p>
        <h2 class="kg-h2">
          Lernen Sie Clown Liar kennen – Ihr Entertainer mit Herz &amp; Humor
        </h2>
        <p>
          Hallo, ich bin Liar – professioneller Clown, Zauberer und Entertainer aus
          Nordrhein-Westfalen und seit über einem Jahrzehnt bringe ich Kinderherzen zum
          Hüpfen und Erwachsene zum Schmunzeln. <a href="/ueber-mich/">Erfahren Sie mehr über mich und meinen Werdegang</a>.
        </p>
        <p>
          Meine Mission? Jeden Moment zu etwas Besonderem machen! Daher ist es mir als
          Clown wichtig, dass sich jedes Kind gesehen und einbezogen fühlt. Deshalb sind
          meine Shows interaktiv, warmherzig und voller Überraschungen. In meinem <a href="/blog/">Blog</a> erzähle ich regelmäßig von solchen besonderen Momenten.
        </p>
      </div>
      <figure class="hm-sticker hm-sticker--round" data-reveal="pop" data-reveal-delay="0.1">
        <Image
          src={michaelImg}
          alt="Foto von Michael Prescler – Clown Zauberer LIAR"
          loading="lazy"
          width={320}
          height={320}
          quality={70}
        />
      </figure>
    </div>
  </section>

  <!-- ── Zahlen (red band) ─────────────────────────────────── -->
  <section class="kg-band hm-stats">
    <SectionEdge color="var(--brand-red)" side="top" />
    <SectionEdge color="var(--brand-red)" side="bottom" />
    <div class="container hm-stats__grid">
      <div class="hm-stat" data-reveal="pop">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4V2m0 20v-2m5-15 1.5-1.5M18.5 18.5 20 20M20 9h2M2 22 14 10m3-3 3 3-2.5 2.5-3-3L17 7Z"/></svg>
        <div class="hm-stat__num" data-count>400</div>
        <div class="hm-stat__label">Shows im Jahr</div>
      </div>
      <div class="hm-stat" data-reveal="pop" data-reveal-delay="0.08">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2.5 4 2.5 4-2.5 4-2.5M9 9.5h.01M15 9.5h.01"/></svg>
        <div class="hm-stat__num">110.000</div>
        <div class="hm-stat__label">Lachende Kinder</div>
      </div>
      <div class="hm-stat" data-reveal="pop" data-reveal-delay="0.16">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 2.9 6.26L21.5 9.27l-4.75 4.28 1.23 6.72L12 16.9l-5.98 3.37 1.23-6.72L2.5 9.27l6.6-1.01L12 2Z"/></svg>
        <div class="hm-stat__num" data-count>15</div>
        <div class="hm-stat__label">Jahre Erfahrung</div>
      </div>
    </div>
  </section>

  <!-- ── Qualifikationen + Was mich auszeichnet ─────────────── -->
  <section class="hm-quali">
    <div class="container kg-intro__grid">
      <div data-reveal>
        <p class="hm-quali__title">Meine Qualifikationen:</p>
        <div class="hm-checks">
          {[
            'Über 15 Jahre Erfahrung als Clown & 30 Jahre als Entertainer',
            'über 400 erfolgreiche Auftritte in NRW und deutschlandweit im Jahr',
            'pädagogische Ausbildung',
            'Spezialisiert auf Kinder von 3–12 Jahren',
            'Versichert und polizeiliches Führungszeugnis (auf Anfrage)',
          ].map((item) => (
            <p>
              <span class="hm-check">✓</span>
              <span>{item}</span>
            </p>
          ))}
        </div>
      </div>
      <figure class="hm-sticker hm-sticker--tilt" data-reveal="pop">
        <Image
          src={clownerieImg}
          alt="Clownerie und Zauberei auf einem Kindergeburtstag in NRW"
          loading="lazy"
          width={300}
          height={300}
        />
      </figure>
    </div>
    <div class="container kg-narrow hm-nocreepy" data-reveal="tilt">
      <h3 class="kg-h3 kg-center">Was mich als Clown auszeichnet</h3>
      <p>
        Ich bin kein „gruseliger" Clown – ganz im Gegenteil: keine Schminke, keine
        „komischen Haare" und keine rote Nase! Mein Clown-Charakter ist freundlich,
        trotzdem bunt und lädt Kinder zum Mitmachen ein. Selbst schüchterne Kinder
        tauen schnell auf, wenn Clown Liar die Bühne betritt.
      </p>
    </div>
  </section>

  <!-- ── Programme (blue band) ─────────────────────────────── -->
  <section class="kg-band kg-band--blue hm-programs">
    <SectionEdge color="var(--brand-blue)" side="top" />
    <SectionEdge color="var(--brand-blue)" side="bottom" />
    <div class="container">
      <p class="kg-eyebrow">Programme</p>
      <h2 class="kg-h2">
        Das bietet Clown Zauberer Liar für Ihr Event
      </h2>
      <div class="hm-programs__grid">
        <article class="hm-program" data-reveal="pop">
          <a href="/zauberer/zaubershow/" class="hm-program__media">
            <Image src={zaubershowImg} alt="Clown Zauberer LIAR verzaubert Kinder bei einer Zaubershow in NRW" loading="lazy" width={600} height={340} />
            <span class="hm-program__title">Zaubershow</span>
          </a>
          <div class="hm-program__body">
            <p>
              Clown trifft Zauberer – Die magischste Show in NRW! Wenn der Clown zum Zauberer wird,
              passieren unglaubliche Dinge! Meine Zaubershow ist speziell für Kinder konzipiert und
              verbindet Comedy mit verblüffender Magie.
            </p>
            <div class="hm-program__list">
              <p><span class="hm-check">✓</span> <strong>Interaktive Zaubertricks</strong> – Kinder werden zu Co-Zauberern und erleben Magie hautnah</p>
              <p><span class="hm-check">✓</span> <strong>Altersgerechte Magie</strong> – Von einfachen Tricks für die Kleinen bis zu verblüffenden Illusionen für ältere Kinder</p>
              <p><span class="hm-check">✓</span> <strong>Comedy-Magie</strong> – Der Clown zaubert nicht perfekt – und genau das macht es so lustig!</p>
              <p><span class="hm-check">✓</span> <strong>Große Finale</strong> – Ein spektakulärer Abschlusszauber, den niemand vergisst</p>
            </div>
            <p class="hm-program__dur"><strong>Dauer:</strong> ca. 40 Minuten</p>
            <a href="/zauberer/zaubershow/" class="hm-program__more">
              Mehr erfahren →
            </a>
          </div>
        </article>

        <article class="hm-program" data-reveal="pop" data-reveal-delay="0.08">
          <a href="/clown/ballonmodellage/" class="hm-program__media">
            <Image src={ballonImg} alt="Clown LIAR formt Ballontiere bei Ballonmodellage auf Kindergeburtstag" loading="lazy" width={600} height={340} />
            <span class="hm-program__title">Ballonmodellage</span>
          </a>
