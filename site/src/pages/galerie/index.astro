  { src: fotogalerieClownZauberer1, alt: 'Clown und Zauberer LIAR im FC-Schalke-04-Stadion in Gelsenkirchen vor einem Auftritt', caption: 'Vor dem Auftritt im Stadion in Gelsenkirchen' },
  { src: fotogalerieClownZauberer1b, alt: 'Kinderzauberer LIAR zeigt Zaubertricks bei einem Kindergeburtstag im Garten', caption: 'Kinderzauberer LIAR bei einem Kindergeburtstag im Garten' },
  { src: fotogalerieClownZauberer17, alt: 'Clown Zauberer Liar verblüffte die Kids mit Zaubertricks.', caption: 'Kinderzauberer LIAR verblüfft die Kinder mit einem Zaubertrick' },
  { src: fotogalerieClownZauberer16, alt: 'Kinderkarneval in Capelle', caption: 'Kinderkarneval in Capelle mit Clown Zauberer LIAR' },
  { src: fotogalerieClownZauberer9, alt: 'Kinderzauberer LIAR mit dem Zauber-Malbuch bei einem Kindergeburtstag', caption: 'Das Zauber-Malbuch – ein Klassiker beim Kindergeburtstag' },
  { src: fotogalerieClownZauberer7, alt: 'Clown LIAR bei einer Bühnenshow auf einem Weihnachtsmarkt vor großem Publikum', caption: 'Bühnenshow auf einem Weihnachtsmarkt vor großem Publikum' },
  { src: fotogalerieClownZauberer10, alt: 'Zauberer LIAR begeistert Kinder mit einem Zaubertrick beim Kindergeburtstag', caption: 'Der Moment des Staunens beim Kindergeburtstag' },
