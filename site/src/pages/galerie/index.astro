const referenzen = [
  { name: 'OPEL Champions League UEFA', detail: '' },
  { name: 'AWO Essen', detail: '' },
  { name: 'IKEA', detail: '' },
  { name: 'IHK Dortmund', detail: '' },
  { name: 'Schalke 04', detail: '' },
  { name: 'Sparkasse Mülheim an der Ruhr', detail: '' },
  { name: 'Sparkasse Gladbeck', detail: '' },
  { name: 'Sparkasse Essen', detail: '' },
  { name: 'AWO Gelsenkirchen', detail: '' },
  { name: 'Stadt Mülheim', detail: '' },
  { name: 'Stadt Essen', detail: '' },
  { name: 'Stadt Gelsenkirchen', detail: '' },
  { name: 'Weihnachtsmarkt Dortmund', detail: 'Zaubershow für Kinder' },
  { name: 'Modehaus Mensing', detail: 'Walk Act Close-up Zauberer' },
  { name: 'VKJ in Essen', detail: '' },
  { name: 'Juk Haus Ahlen', detail: 'Zaubershow und Workshop für Kinder' },
  { name: 'Kulturamt Gladbeck', detail: 'WalkAct Strassenfest und Bühnenshow' },
  { name: 'Techniker Krankenkasse', detail: 'Kinderschminken und Kindershow' },
  { name: 'Kinderklinik Marienhospital, Bottrop', detail: 'Zaubershow und Ballonmodellage' },
  { name: 'Sparkasse, Bottrop', detail: 'Walk-Act mit Ballonmodellage' },
  { name: 'Metro', detail: 'Galazauberei, Walkact' },
  { name: 'Tuffi', detail: 'Galazauberei' },
  { name: 'ADAC', detail: 'Walk-Act mit Ballonmodellage' },
  { name: 'Van der Valk Hotelkette seit 2008', detail: 'Kinderentertainment/Brunch' },
  { name: 'Alpincenter Bottrop 2004 bis 2009', detail: 'Floormanager und Kinderentertainment' },
  { name: 'VFL-Bochum', detail: '' },
  { name: 'Kinderschutzbund, Bottrop', detail: '' },
  { name: 'Kinderschutzbund, Essen', detail: '' },
  { name: 'Hits4Kids Event-Serien 2008, 2009', detail: 'Walk-Act mit Ballonmodellage' },
  { name: 'Babymesse 2009', detail: 'Walk-Act mit Ballonmodellage und Kinderzaubershow' },
  { name: 'St-Gobain Essen', detail: '' },
  { name: 'Stadtmarketing Bottrop', detail: 'Walk-Act mit Ballonmodellage und Kinderzaubershow' },
  { name: 'Kinderwelt Recklinghausen', detail: 'Walk-Act mit Ballonmodellage und Kinderzaubershow' },
  { name: 'Feldschlösschen Essen', detail: 'Close-up Zauberei und Zaubershow für Erwachsene' },
  { name: 'Kindergärten', detail: 'Schnee-Leo-Bewegungsparcour, Zauberei, Animation' },
  { name: 'Grundschulen', detail: 'Schnee-Leo-Bewegungsparcour, Festunterstützung, Workshops Zauberei und anderes' },
];
// Masonry columns: 2 → 3 (≥640px) → 4 (≥1024px) inside the 72rem container, minus the card padding.
const WALL_SIZES =
  '(min-width: 1184px) 268px, (min-width: 1024px) calc((100vw - 5rem) / 4), (min-width: 640px) calc((100vw - 4rem) / 3), calc(50vw - 2rem)';
---

<V2Layout
  title="Galerie | Clown Zauberer LIAR — Fotos & Videos"
  description="Galerie von Clown Zauberer LIAR ✓ Fotos & Videos von Zaubershow, Clownshow & Events in NRW ✓ Presseartikel & Referenzen ✓ 370+ begeisterte Kunden!"
  keywords="Clown Zauberer Fotos, Zaubershow Video, Clown NRW Galerie, Zauberer Presse, Clown Zauberer LIAR Referenzen"
  canonical="https://liar-entertainer.com/galerie/"
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Galerie', url: '/galerie/' }]}
>
  <!-- ── Hero: title + jump chips. No reveal (LCP). ── -->
  <section class="kg-hero gl-hero">
    <div class="container gl-hero__inner">
      <ReviewBadge />
      <h1 class="gl-hero__title">Fotos – Videos – Presse Referenzen</h1>
      <p class="gl-hero__sub">
        Impressionen aus Auftritten von Clown Zauberer LIAR in NRW
      </p>
      <nav class="kg-quick gl-jump" aria-label="Schnell zu den Bereichen">
        <a href="#videos">Videos</a>
        <a href="#fotos">Fotos</a>
        <a href="#presse">Presse</a>
        <a href="#referenzen">Referenzen</a>
      </nav>
    </div>
  </section>

  <!-- ── Videos ── -->
  <section class="gl-videos" id="videos">
    <div class="container">
      <div class="kg-narrow kg-center" data-reveal>
        <h2 class="kg-h2">Videos</h2>
        <p class="gl-lead">
          Ein Bild sagt mehr als tausend Worte, noch mehr erzählt Ihnen ein Video. Die nachfolgenden Imagefilme vermitteln Ihnen einen guten Eindruck von meiner Arbeit mit Kindern. Natürlich haben Sie die Möglichkeit in meine kleine Fotogalerie zu stöbern. Viel Spaß!!!
        </p>
      </div>
      <div class="gl-videos__grid">
        <div class="gl-video" data-reveal="pop">
          <h3 class="gl-video__title">Neues Video</h3>
          <div class="gl-video__frame">
            <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
          </div>
        </div>
        <div class="gl-video gl-video--vintage" data-reveal="pop" data-reveal-delay="0.1">
          <h3 class="gl-video__title">Vintage</h3>
          <div class="gl-video__frame">
            <YouTubeFacade id="2n54fC-04lo" title="---VINTAGE--- Clown Zauberer LIAR, die lustigste Zaubershow NRW. ---VINTAGE---" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Fotos: snapshot collage in natural proportions ── -->
  <section class="gl-photos" id="fotos">
    <div class="container">
      <h2 class="kg-h2 kg-center" data-reveal>📸 Fotos</h2>
      <div class="gl-wall">
        {photoImages.map((img) => (
          <figure class="gl-snap" data-reveal="pop">
            <Image
              src={img.src}
              alt={img.alt}
              widths={[200, 280, 400, 560]}
              sizes={WALL_SIZES}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Presse: clippings pinned to the wall ── -->
  <section class="gl-press" id="presse">
    <div class="container">
      <div class="kg-narrow kg-center" data-reveal>
        <h2 class="kg-h2">📰 Presse &amp; Zeitungsartikel</h2>
        <p class="gl-lead">
          Berichte und Artikel aus lokalen Zeitungen über Auftritte und Events von Clown Zauberer LIAR.
        </p>
      </div>
      <div class="gl-wall gl-wall--press">
        {presseImages.map((img) => (
          <figure class="gl-snap gl-snap--clip" data-reveal="pop">
            <Image
              src={img.src}
              alt={img.alt}
              widths={[200, 280, 400, 560]}
              sizes={WALL_SIZES}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Referenzen (blue band) ── -->
  <section class="kg-band kg-band--blue gl-refs" id="referenzen">
    <SectionEdge color="var(--brand-blue)" side="top" />
    <SectionEdge color="var(--brand-blue)" side="bottom" />
    <div class="container">
      <div class="kg-narrow" data-reveal>
        <h2 class="kg-h2">⭐ Referenzen</h2>
        <p class="gl-refs__lead">
          Eine Auswahl an Kunden und Partnern, für die Clown Zauberer LIAR bereits aufgetreten ist.
        </p>
      </div>
      <ul class="gl-refs__list">
        {referenzen.map((ref) => (
          <li class:list={['gl-ref', { 'gl-ref--detail': ref.detail }]}>
            <p class="gl-ref__name">{ref.name}</p>
            {ref.detail && <p class="gl-ref__detail">({ref.detail})</p>}
          </li>
        ))}
      </ul>
      <p class="gl-refs__more">…und viele andere mehr!</p>
    </div>
  </section>

  <Reviews />

  <!-- ── CTA ── -->
  <section class="gl-cta">
    <div class="container kg-narrow kg-center" data-reveal="tilt">
      <p class="gl-cta__text">Möchten Sie Clown Zauberer LIAR für Ihr Event buchen?</p>
      <a href="/kontakt/" class="btn btn--primary" data-confetti>
        Jetzt anfragen
      </a>
      <nav class="kg-quick gl-cta__links" aria-label="Weitere Seiten">
        <a href="/kindergeburtstag/">🎂 Kindergeburtstag-Preise</a>
        <a href="/zauberer/zaubershow/">🎩 Zaubershow</a>
        <a href="/clown/clownshow/">🤡 Clownshow</a>
        <a href="/ueber-mich/">👤 Über mich</a>
        <a href="/blog/">📝 Blog</a>
      </nav>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero ── */
  .gl-hero { padding-block: var(--space-5) var(--space-4); text-align: center; }
  .gl-hero__inner { max-width: 54rem; }
  .gl-hero__title {
    font-size: clamp(2.3rem, 6.5vw, 4.6rem); line-height: 1.02; margin: var(--space-3) 0 var(--space-2);
    text-wrap: balance;
  }
  .gl-hero__sub { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.15rem, 2.4vw, 1.45rem); color: var(--accent-2); }
  .gl-jump { justify-content: center; }
  .gl-jump a { min-height: 2.75rem; display: inline-flex; align-items: center; }

  .gl-lead { color: var(--ink-soft); font-size: 1.08rem; }

  /* ── videos ── */
  .gl-videos { background: var(--surface); border-block: var(--border); }
  .gl-videos__grid {
    display: grid; gap: var(--space-4) var(--space-4); margin-top: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  .gl-video { text-align: center; }
  .gl-video__title { font-size: clamp(1.3rem, 2.4vw, 1.6rem); margin: 0 0 var(--space-2); }
  .gl-video__frame {
    border: 5px solid var(--line); border-radius: var(--radius); overflow: hidden;
    box-shadow: 8px 8px 0 var(--line); rotate: -1deg; background: var(--ink);
  }
  .gl-video--vintage .gl-video__frame { rotate: 1deg; }
  .gl-video__frame :global(.yt-frame) { margin: 0; max-width: none; }
  .gl-video__frame :global(.yt-fill) { border-radius: 0; }

  /* ── photo + press walls: masonry via CSS columns, every shot keeps its own proportions ── */
  .gl-photos { background: var(--bg); }
  .gl-wall { columns: 2; column-gap: var(--space-2); margin-top: var(--space-4); }
  @media (min-width: 640px) { .gl-wall { columns: 3; } }
  @media (min-width: 1024px) { .gl-wall { columns: 4; } }
  .gl-snap {
    break-inside: avoid; margin: 0 0 var(--space-2); padding: 0.45rem 0.45rem 0;
    background: var(--surface); border: var(--border); border-radius: var(--radius-sm);
    box-shadow: 4px 4px 0 var(--line);
    transition: transform 0.35s var(--ease-out-expo), box-shadow 0.3s var(--ease-out), rotate 0.35s var(--ease-out-expo);
  }
  .gl-snap:nth-child(4n + 1) { rotate: -1deg; }
  .gl-snap:nth-child(4n + 2) { rotate: 0.8deg; }
  .gl-snap:nth-child(4n + 3) { rotate: -0.4deg; }
  .gl-snap:nth-child(4n) { rotate: 1.2deg; }
  .gl-snap :global(img) {
    display: block; width: 100%; height: auto;
    border-radius: calc(var(--radius-sm) - 0.3rem);
  }
  .gl-snap figcaption {
    padding: 0.55rem 0.3rem 0.65rem; font-size: 0.9rem; line-height: 1.35; font-weight: 600; color: var(--ink-soft);
  }
  .gl-press { background: var(--bg-alt); border-top: var(--border); }
  /* press clippings: newsprint-grey card, a strip of tape on top */
  .gl-snap--clip { position: relative; background: #fbf7ee; padding-top: 0.9rem; }
  .gl-snap--clip::before {
    content: ''; position: absolute; top: -0.65rem; left: 50%; width: 4.5rem; height: 1.3rem; translate: -50% 0; rotate: -3deg;
    background: color-mix(in srgb, var(--brand-yellow) 60%, transparent); border: 1.5px solid color-mix(in srgb, var(--line) 25%, transparent);
  }
  @media (hover: hover) and (pointer: fine) {
    .gl-snap:hover { rotate: 0deg; transform: translateY(-5px) scale(1.02); box-shadow: 8px 8px 0 var(--line); }
  }

