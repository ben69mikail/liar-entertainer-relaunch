  { src: fotogalerieClownZauberer3, alt: 'Zauberer LIAR bei einer Kindershow mit Ballonmodellage in einem Saal', caption: 'Kinderzauberer LIAR mit Ballonmodellage bei einer Kindershow im Saal' },
  { src: fotogalerieClownZauberer2, alt: 'Clown LIAR bei einer Kindershow im Freien mit vielen Kindern', caption: 'Kindershow unter freiem Himmel – Clown Zauberer LIAR mitten im Publikum' },
