  { src: closeUpZaubereiDortmund, alt: 'Close Up Zauberei Dortmund', caption: 'Close-up-Zauberei in Dortmund' },
  { src: tischZaubererMuelheim, alt: 'Tisch Zauberer Mülheim', caption: 'Tischzauberer in Mülheim an der Ruhr' },
  { src: buehnenZaubererEssen, alt: 'Bühnen Zauberer Essen', caption: 'Bühnenshow auf einer Firmenfeier in Essen' },
  { src: buehnenZaubereiGelsenkirchen, alt: 'Bühnen Zauberei Gelsenkirchen', caption: 'Bühnenzauberei in Gelsenkirchen' },
  { src: buehnenZauberei, alt: 'Bühnen Zauberei Oberhausen', caption: 'Bühnenzauberei in Oberhausen' },
