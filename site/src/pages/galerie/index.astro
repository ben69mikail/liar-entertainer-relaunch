  { src: zaubererGladbeck, alt: 'Zauberer Gladbeck Zeitungsartikel', caption: 'Zeitungsbericht über Zauberer LIAR in Gladbeck' },
  { src: weihnachtsmarktKray, alt: 'Weihnachtsmarkt Kray Zeitungsartikel', caption: 'Presseartikel zum Auftritt auf dem Weihnachtsmarkt in Kray' },
  { src: wazMagicDinner, alt: 'WAZ Magic Dinner Zeitungsartikel', caption: 'WAZ-Bericht über das Magic Dinner mit Zauberer LIAR' },
  { src: stadtspiegelJanuar2012, alt: 'Stadtspiegel Januar 2012', caption: 'Stadtspiegel, Januar 2012: Bericht über Clown Zauberer LIAR' },
  { src: stadtspiegelJuli2014, alt: 'Stadtspiegel Juli 2014', caption: 'Stadtspiegel, Juli 2014: Bericht über Clown Zauberer LIAR' },
  { src: zauberhafteWelt, alt: 'Zauberhafte Welt Zeitungsartikel', caption: 'Zeitungsartikel „Zauberhafte Welt" über Clown Zauberer LIAR' },
  { src: bottropBewegDich2013, alt: 'Bottrop Beweg Dich 2013', caption: 'Presseartikel zur Aktion „Bottrop beweg dich" 2013' },
  { src: kitaSpielenMachtSchlau, alt: 'Kita – Spielen macht schlau', caption: 'Bericht zum Kita-Projekt „Spielen macht schlau"' },
  { src: stadtpicknick20151, alt: 'Stadtpicknick 2015', caption: 'Stadtpicknick 2015: Zeitungsbericht zum Auftritt' },
  { src: stadtpicknick20152, alt: 'Stadtpicknick 2015', caption: 'Stadtpicknick 2015: weiterer Presseausschnitt' },
