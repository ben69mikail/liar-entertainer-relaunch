  { src: fotogalerieClownZauberer13, alt: 'Zauberer LIAR bei einer Zaubershow im Garten zum Kindergeburtstag', caption: 'Zaubershow im Garten zum Kindergeburtstag' },
  { src: fotogalerieClownZauberer8, alt: 'Kinderzauberer LIAR bei einer Zaubershow für Kinder in einem Saal', caption: 'Kinderzauberer LIAR bei einer Zaubershow im Saal' },
  { src: fotogalerieClownZauberer15, alt: 'Zauberer LIAR bei einem Tuch-Zaubertrick im Freien', caption: 'Tuch-Zaubertrick unter freiem Himmel' },
  { src: fotogalerieClownZauberer14, alt: 'Clown LIAR bei der Ballonmodellage: ein gelber Ballonhund entsteht', caption: 'Ballonmodellage: ein gelber Ballonhund entsteht' },
  { src: tischZaubererNrw, alt: 'Tisch-Zauberer-NRW', caption: 'Tischzauberei direkt am Gästetisch in NRW' },
  { src: closeUpZaubereiMuelheim, alt: 'Close-Up-Zauberei-Muelheim', caption: 'Close-up-Zauberei in Mülheim an der Ruhr' },
  { src: closeUpZaubereiDortmund, alt: 'Close Up Zauberei Dortmund', caption: 'Close-up-Zauberei in Dortmund' },
  { src: tischZaubererMuelheim, alt: 'Tisch Zauberer Mülheim', caption: 'Tischzauberer in Mülheim an der Ruhr' },
  { src: buehnenZaubererEssen, alt: 'Bühnen Zauberer Essen', caption: 'Bühnenshow auf einer Firmenfeier in Essen' },
  { src: buehnenZaubereiGelsenkirchen, alt: 'Bühnen Zauberei Gelsenkirchen', caption: 'Bühnenzauberei in Gelsenkirchen' },
  { src: buehnenZauberei, alt: 'Bühnen Zauberei Oberhausen', caption: 'Bühnenzauberei in Oberhausen' },
  { src: standUpZauberei, alt: 'Stand up Zauberei', caption: 'Stand-up-Zauberei vor Erwachsenenpublikum' },
  { src: tischZaubererNrwBuehne, alt: 'Bühnen Zauberer NRW', caption: 'Bühnenzauberer LIAR bei einem Auftritt in NRW' },
