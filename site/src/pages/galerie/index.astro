  { src: fotogalerieClownZauberer8, alt: 'Kinderzauberer LIAR bei einer Zaubershow für Kinder in einem Saal', caption: 'Kinderzauberer LIAR bei einer Zaubershow im Saal' },
  { src: fotogalerieClownZauberer15, alt: 'Zauberer LIAR bei einem Tuch-Zaubertrick im Freien', caption: 'Tuch-Zaubertrick unter freiem Himmel' },
  { src: fotogalerieClownZauberer14, alt: 'Clown LIAR bei der Ballonmodellage: ein gelber Ballonhund entsteht', caption: 'Ballonmodellage: ein gelber Ballonhund entsteht' },
  { src: tischZaubererNrw, alt: 'Tisch-Zauberer-NRW', caption: 'Tischzauberei direkt am Gästetisch in NRW' },
