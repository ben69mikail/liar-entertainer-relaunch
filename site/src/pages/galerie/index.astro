const presseImages = [
  { src: zaubererGladbeck, alt: 'Zauberer Gladbeck Zeitungsartikel', caption: 'Zeitungsbericht über Zauberer LIAR in Gladbeck' },
  { src: weihnachtsmarktKray, alt: 'Weihnachtsmarkt Kray Zeitungsartikel', caption: 'Presseartikel zum Auftritt auf dem Weihnachtsmarkt in Kray' },
  { src: wazMagicDinner, alt: 'WAZ Magic Dinner Zeitungsartikel', caption: 'WAZ-Bericht über das Magic Dinner mit Zauberer LIAR' },
  { src: stadtspiegelJanuar2012, alt: 'Stadtspiegel Januar 2012', caption: 'Stadtspiegel, Januar 2012: Bericht über Clown Zauberer LIAR' },
  { src: stadtspiegelJuli2014, alt: 'Stadtspiegel Juli 2014', caption: 'Stadtspiegel, Juli 2014: Bericht über Clown Zauberer LIAR' },
  { src: zauberhafteWelt, alt: 'Zauberhafte Welt Zeitungsartikel', caption: 'Zeitungsartikel „Zauberhafte Welt" über Clown Zauberer LIAR' },
  { src: bottropBewegDich2013, alt: 'Bottrop Beweg Dich 2013', caption: 'Presseartikel zur Aktion „Bottrop beweg dich" 2013' },
  { src: kitaSpielenMachtSchlau, alt: 'Kita – Spielen macht schlau', caption: 'Bericht zum Kita-Projekt „Spielen macht schlau"' },
  { src: stadtpicknick20151, alt: 'Stadtpicknick 2015', caption: 'Stadtpicknick 2015: Zeitungsbericht zum Auftritt' },
  { src: stadtpicknick20152, alt: 'Stadtpicknick 2015', caption: 'Stadtpicknick 2015: weiterer Presseausschnitt' },
];

const referenzen = [
  { name: 'OPEL Champions League UEFA', detail: '' },
  { name: 'AWO Essen', detail: '' },
  { name: 'IKEA', detail: '' },
  { name: 'IHK Dortmund', detail: '' },
  { name: 'Schalke 04', detail: '' },
  { name: 'Sparkasse Mülheim an der Ruhr', detail: '' },
  { name: 'Sparkasse Gladbeck', detail: '' },
  { name: 'Sparkasse Essen', detail: '' },
  { name: 'AWO Gelsenkirchen', detail: '' },
  { name: 'Stadt Mülheim', detail: '' },
  { name: 'Stadt Essen', detail: '' },
  { name: 'Stadt Gelsenkirchen', detail: '' },
  { name: 'Weihnachtsmarkt Dortmund', detail: 'Zaubershow für Kinder' },
  { name: 'Modehaus Mensing', detail: 'Walk Act Close-up Zauberer' },
  { name: 'VKJ in Essen', detail: '' },
  { name: 'Juk Haus Ahlen', detail: 'Zaubershow und Workshop für Kinder' },
  { name: 'Kulturamt Gladbeck', detail: 'WalkAct Strassenfest und Bühnenshow' },
  { name: 'Techniker Krankenkasse', detail: 'Kinderschminken und Kindershow' },
  { name: 'Kinderklinik Marienhospital, Bottrop', detail: 'Zaubershow und Ballonmodellage' },
  { name: 'Sparkasse, Bottrop', detail: 'Walk-Act mit Ballonmodellage' },
  { name: 'Metro', detail: 'Galazauberei, Walkact' },
  { name: 'Tuffi', detail: 'Galazauberei' },
  { name: 'ADAC', detail: 'Walk-Act mit Ballonmodellage' },
  { name: 'Van der Valk Hotelkette seit 2008', detail: 'Kinderentertainment/Brunch' },
  { name: 'Alpincenter Bottrop 2004 bis 2009', detail: 'Floormanager und Kinderentertainment' },
  { name: 'VFL-Bochum', detail: '' },
  { name: 'Kinderschutzbund, Bottrop', detail: '' },
  { name: 'Kinderschutzbund, Essen', detail: '' },
  { name: 'Hits4Kids Event-Serien 2008, 2009', detail: 'Walk-Act mit Ballonmodellage' },
  { name: 'Babymesse 2009', detail: 'Walk-Act mit Ballonmodellage und Kinderzaubershow' },
  { name: 'St-Gobain Essen', detail: '' },
  { name: 'Stadtmarketing Bottrop', detail: 'Walk-Act mit Ballonmodellage und Kinderzaubershow' },
  { name: 'Kinderwelt Recklinghausen', detail: 'Walk-Act mit Ballonmodellage und Kinderzaubershow' },
  { name: 'Feldschlösschen Essen', detail: 'Close-up Zauberei und Zaubershow für Erwachsene' },
  { name: 'Kindergärten', detail: 'Schnee-Leo-Bewegungsparcour, Zauberei, Animation' },
  { name: 'Grundschulen', detail: 'Schnee-Leo-Bewegungsparcour, Festunterstützung, Workshops Zauberei und anderes' },
];
// Masonry columns: 2 → 3 (≥640px) → 4 (≥1024px) inside the 72rem container, minus gaps and the frame padding.
const WALL_SIZES =
  '(min-width: 1184px) 250px, (min-width: 1024px) calc((100vw - 5rem) / 4 - 1.6rem), (min-width: 640px) calc((100vw - 4rem) / 3 - 1.6rem), calc(50vw - 2.9rem)';
---

<V2Layout
  title="Galerie | Clown Zauberer LIAR — Fotos & Videos"
  description="Galerie von Clown Zauberer LIAR ✓ Fotos & Videos von Zaubershow, Clownshow & Events in NRW ✓ Presseartikel & Referenzen ✓ 370+ begeisterte Kunden!"
  keywords="Clown Zauberer Fotos, Zaubershow Video, Clown NRW Galerie, Zauberer Presse, Clown Zauberer LIAR Referenzen"
  canonical="https://liar-entertainer.com/galerie/"
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Galerie', url: '/galerie/' }]}
>
  <!-- ── Hero: the big-top stage (K3Hero), title + jump chips. No reveal here (LCP). ── -->
  <K3Hero>
    <div class="k3-hero-center">
      <ReviewBadge />
      <h1 class="k3-hero__title gl-hero__title" data-letters>Fotos – Videos – Presse Referenzen</h1>
      <p class="k3-hero__sub">
        Impressionen aus Auftritten von Clown Zauberer LIAR in NRW
      </p>
      <nav class="k3-quick gl-jump" aria-label="Schnell zu den Bereichen">
        <a href="#videos">Videos</a>
        <a href="#fotos">Fotos</a>
        <a href="#presse">Presse</a>
        <a href="#referenzen">Referenzen</a>
      </nav>
    </div>
  </K3Hero>

  <!-- ── Videos: night band, premiere searchlights, a curtain in front of each film ── -->
  <section class="k3-band k3-band--night k3-premiere gl-videos" id="videos">
    <span class="k3-uplight k3-uplight--l" aria-hidden="true"></span>
    <span class="k3-uplight k3-uplight--r" aria-hidden="true"></span>
    <div class="container">
      <div class="k3-narrow k3-center" data-reveal>
        <GoldDivider />
        <h2 class="k3-h2">Videos</h2>
        <p class="gl-lead">
          Ein Bild sagt mehr als tausend Worte, noch mehr erzählt Ihnen ein Video. Die nachfolgenden Imagefilme vermitteln Ihnen einen guten Eindruck von meiner Arbeit mit Kindern. Natürlich haben Sie die Möglichkeit in meine kleine Fotogalerie zu stöbern. Viel Spaß!!!
        </p>
      </div>
      <div class="gl-videos__grid">
        <div class="gl-video">
          <h3 class="k3-h3 gl-video__title">Neues Video</h3>
          <div class="k3-video gl-video__frame" data-reveal>
            <Curtain trigger="stage" rest="clamp(1.8rem, 8vw, 3.4rem)" span="min(30rem, 100vw - 2rem)" tieback valance />
            <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
          </div>
        </div>
        <div class="gl-video">
          <h3 class="k3-h3 gl-video__title">Vintage</h3>
          <div class="k3-video gl-video__frame" data-reveal data-reveal-delay="0.1">
            <Curtain trigger="stage" rest="clamp(1.8rem, 8vw, 3.4rem)" span="min(30rem, 100vw - 2rem)" tieback valance />
            <YouTubeFacade id="2n54fC-04lo" title="---VINTAGE--- Clown Zauberer LIAR, die lustigste Zaubershow NRW. ---VINTAGE---" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Fotos: masonry wall of programme frames, every shot whole in its own proportions ── -->
  <section class="gl-photos" id="fotos">
    <div class="container">
      <div data-reveal>
        <GoldDivider />
        <h2 class="k3-h2 k3-center">📸 Fotos</h2>
      </div>
      <div class="gl-wall">
        {photoImages.map((img) => (
          <figure class="gl-snap" data-reveal="pop">
            <span class="gl-snap__photo">
              <Image
                src={img.src}
                alt={img.alt}
                widths={[200, 280, 400, 560]}
                sizes={WALL_SIZES}
                loading="lazy"
                decoding="async"
              />
            </span>
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Presse: clippings as programme sheets with a velvet ribbon ── -->
  <section class="k3-alt gl-press" id="presse">
    <div class="container">
      <div class="k3-narrow k3-center" data-reveal>
        <GoldDivider />
        <h2 class="k3-h2">📰 Presse &amp; Zeitungsartikel</h2>
        <p class="gl-lead">
          Berichte und Artikel aus lokalen Zeitungen über Auftritte und Events von Clown Zauberer LIAR.
        </p>
      </div>
      <div class="gl-wall gl-wall--press">
        {presseImages.map((img) => (
          <figure class="gl-snap gl-snap--clip" data-reveal="pop">
            <span class="gl-snap__photo">
              <Image
                src={img.src}
                alt={img.alt}
                widths={[200, 280, 400, 560]}
                sizes={WALL_SIZES}
                loading="lazy"
                decoding="async"
              />
            </span>
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Referenzen: the velvet ring, names on paper slips ── -->
  <section class="k3-band k3-band--velvet gl-refs" id="referenzen">
    <div class="container">
      <div class="k3-narrow k3-center" data-reveal>
        <GoldDivider />
        <h2 class="k3-h2">⭐ Referenzen</h2>
        <p class="gl-refs__lead">
          Eine Auswahl an Kunden und Partnern, für die Clown Zauberer LIAR bereits aufgetreten ist.
        </p>
      </div>
      <ul class="gl-refs__list">
        {referenzen.map((ref) => (
          <li class:list={['gl-ref', { 'gl-ref--detail': ref.detail }]}>
            <p class="gl-ref__name">{ref.name}</p>
            {ref.detail && <p class="gl-ref__detail">({ref.detail})</p>}
          </li>
        ))}
      </ul>
      <p class="gl-refs__more">…und viele andere mehr!</p>
    </div>
  </section>

  <Reviews />

  <!-- ── CTA: one programme sheet ── -->
  <section class="k3-alt gl-cta">
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <div class="k3-prog gl-cta__card" data-reveal="tilt">
        <p class="gl-cta__text">Möchten Sie Clown Zauberer LIAR für Ihr Event buchen?</p>
        <a href="/kontakt/" class="btn btn--primary" data-confetti>
          Jetzt anfragen
        </a>
        <nav class="k3-quick gl-cta__links" aria-label="Weitere Seiten">
          <a href="/kindergeburtstag/">🎂 Kindergeburtstag-Preise</a>
          <a href="/zauberer/zaubershow/">🎩 Zaubershow</a>
          <a href="/clown/clownshow/">🤡 Clownshow</a>
          <a href="/ueber-mich/">👤 Über mich</a>
          <a href="/blog/">📝 Blog</a>
        </nav>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  /* ── hero ── */
  .gl-hero__title { text-wrap: balance; }
  .gl-jump a { min-height: 2.75rem; display: inline-flex; align-items: center; }

  .gl-lead { color: var(--ink-soft); font-size: 1.08rem; }
  .k3-band .gl-lead { color: #e9dcc6; }

  /* ── videos: two films side by side on desktop, each behind its own little curtain ── */
  .gl-videos__grid { display: grid; gap: var(--space-4); margin-top: var(--space-3); }
  .gl-video { text-align: center; }
  .gl-video__title { margin: 0 0 var(--space-1); }
  .gl-videos .k3-video { max-width: 30rem; margin: var(--space-2) auto 0; }
  @media (min-width: 901px) {
    .gl-videos__grid { grid-template-columns: 1fr 1fr; }
  }

  /* ── photo + press walls: masonry via CSS columns, every shot keeps its own proportions ── */
  .gl-wall { columns: 2; column-gap: var(--space-2); margin-top: var(--space-3); }
  @media (min-width: 640px) { .gl-wall { columns: 3; column-gap: var(--space-3); } }
  @media (min-width: 1024px) { .gl-wall { columns: 4; } }
  /* a programme sheet per photo: light paper, double gold rule, gold corner flourishes */
  .gl-snap {
    position: relative; break-inside: avoid; margin: 0 0 var(--space-3); padding: 0.8rem 0.8rem 0;
    background:
      var(--orn-tl) left 0.35rem top 0.35rem / 1.15rem no-repeat,
      var(--orn-tr) right 0.35rem top 0.35rem / 1.15rem no-repeat,
      var(--orn-bl) left 0.35rem bottom 0.35rem / 1.15rem no-repeat,
      var(--orn-br) right 0.35rem bottom 0.35rem / 1.15rem no-repeat,
      var(--surface);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.55), inset 0 0 0 4px var(--surface), inset 0 0 0 5px rgba(184, 134, 47, 0.22), var(--shadow);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out), rotate 0.35s var(--ease-out);
  }
  .gl-snap:nth-child(4n + 1) { rotate: -0.6deg; }
  .gl-snap:nth-child(4n + 2) { rotate: 0.5deg; }
  .gl-snap:nth-child(4n) { rotate: 0.7deg; }
  .gl-snap__photo { display: block; overflow: hidden; border-radius: 0.35rem; box-shadow: 0 0 0 1px rgba(184, 134, 47, 0.45); }
  .gl-snap :global(img) { display: block; width: 100%; height: auto; }
  .gl-snap figcaption {
    padding: 0.6rem 0.6rem 1rem; text-align: center; font-size: 0.9rem; line-height: 1.35; font-weight: 600; color: var(--ink-soft);
  }
