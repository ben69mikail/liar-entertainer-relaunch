// === Post-stylize: Bottrop-spezifische Anpassungen ===
// Bottrop wird komplett per Client-JS gefixt (siehe Script-Block unten)

// === Post-stylize: Castrop-Rauxel-spezifische Anpassungen ===
if (scrapedContent && pageSlug === 'geburtstag-in-castrop-rauxel') {
  // CR2: Abstände nach "Sie sind gestresst" reduzieren
  scrapedContent = scrapedContent.replace(
    /(<\/p>\s*)((?:<br\s*\/?>|\s|&nbsp;)*?)(\s*<figure)/gi,
