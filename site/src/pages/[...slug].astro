 * Old WPForms contact forms inside the scraped HTML posted back to their own (static) page, so every
 * enquiry was lost. Route them to Netlify Forms (same fields, labels and texts) and drop the dead
 * WordPress token / reCAPTCHA inputs (the hidden reCAPTCHA input also failed the a11y label audit).
 */
function netlifyWpForms(html: string): string {
  let n = 0;
  return html
    .replace(/<form([^>]*?)\sclass="([^"]*\bwpforms-form\b[^"]*)"([^>]*)>/gi, (_m, a: string, cls: string, b: string) => {
      const attrs = `${a} class="${cls}"${b}`
        .replace(/\s(action|method|data-token|data-token-time|enctype)="[^"]*"/gi, '');
      n++;
      const name = n === 1 ? 'kontakt-alt' : `kontakt-alt-${n}`;
      return `<form${attrs} name="${name}" method="POST" action="/kontakt/danke/" data-netlify="true"><input type="hidden" name="form-name" value="${name}" />`;
    })
    .replace(/<input[^>]*name="g-recaptcha-hidden"[^>]*>/gi, '')
    .replace(/<input[^>]*name="wpforms\[(token|post_id|id)\]"[^>]*>/gi, '');
}
