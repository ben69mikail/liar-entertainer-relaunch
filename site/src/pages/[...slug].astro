  );

  // O3: "Perfekt zugeschnitten" blaue Sektion: aus dem price-grid herausnehmen
  // und als eigenständige volle-Breite-Sektion mit 2 Feature-Karten nebeneinander darstellen.
  // Die Section steckt im WordPress-Content verschachtelt und wird per Client-JS repositioniert.
  // Hier markieren wir sie nur mit einer speziellen Klasse.
  scrapedContent = scrapedContent.replace(
    /(<section[^>]*class="[^"]*)(alignfull[^"]*has-1-columns[^"]*"[^>]*>[\s\S]*?Perfekt zugeschnitten)/i,
    '$1perfekt-section $2'
  );
}

// === Post-stylize: Castrop-Rauxel-spezifische Anpassungen ===
if (scrapedContent && pageSlug === 'geburtstag-in-castrop-rauxel') {
  // CR1: "So läuft meine Show" zentrieren (egal ob h2, h3, strong)
  scrapedContent = scrapedContent.replace(
    /(<(?:h2|h3|strong)[^>]*>)([\s\S]*?So läuft meine Show[\s\S]*?)(<\/(?:h2|h3|strong)>)/i,
    (match, open, content, close) => {
      if (!open.includes('text-align')) {
        return open.replace('>', ' style="text-align:center;display:block;">') + content + close;
      }
      return match;
    }
  );

  // CR2: Abstände zwischen Text und Bildern reduzieren (leere Absätze und <br> entfernen)
  scrapedContent = scrapedContent.replace(/<p>\s*(&nbsp;|\s)*<\/p>/gi, '');
  scrapedContent = scrapedContent.replace(/(<\/p>)\s*(<br\s*\/?>)+\s*(<figure|<div class="wp-block-image)/gi, '$1$3');
}

// === Post-stylize: Waltrop-spezifische Anpassungen ===
if (scrapedContent && pageSlug === 'geburtstag-in-waltrop') {
