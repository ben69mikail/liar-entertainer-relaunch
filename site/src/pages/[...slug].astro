if (scrapedContent) {
  scrapedContent = fixLegacyCopy(scrapedContent);
  // isBlogPost/isCityPage sind hier noch nicht initialisiert (Temporal Dead Zone) -
  // deshalb die bereits verfuegbaren Aequivalente verwenden.
  scrapedContent = demoteLegacyH1(scrapedContent, page.type === 'post' || _isCitySlug);
}

// === Post-stylize: Doppelte Preissektionen entfernen ===
// Wenn price-grid existiert UND es noch einen ungestylten "Die Preise"/"ZAUBERSHOW"/"40 Minuten" Block gibt,
// entferne die gesamte Section die den ungestylten Block enthält
if (scrapedContent && scrapedContent.includes('price-grid') && scrapedContent.includes('price-card')) {
  // Pattern: Section mit "Die Preise" + "ZAUBERSHOW" + "40 Minuten" als Text (NICHT in price-card)
  // Entferne die section, die "Die Preise" als Überschrift enthält und KEINE price-card hat
  // Typisch: <section ...has-1-columns...>...<strong>Was kostet ein Zauberer für den Kindergeburtstag?</strong>...<h3>ZAUBERSHOW</h3>...40 Minuten...</section>
  scrapedContent = scrapedContent.replace(
    /<section[^>]*class="[^"]*has-1-columns[^"]*"[^>]*>(?:(?!<\/section>)[\s\S])*?(?:Die Preise|ZAUBERSHOW)(?:(?!<\/section>)[\s\S])*?(?:40 Minuten|Festpreis)(?:(?!<\/section>)[\s\S])*?<\/section>/gi,
    (match) => {
      // Nur entfernen wenn KEIN price-card drin ist
      if (match.includes('price-card')) return match;
      return '';
    }
  );
  // Pattern B: wp-block-group mit "Die Preise" + "ZAUBERSHOW" (einige Seiten nutzen div statt section)
  scrapedContent = scrapedContent.replace(
    /<div[^>]*class="[^"]*wp-block-group[^"]*"[^>]*>(?:(?!<\/section>|<section)[\s\S])*?(?:Die Preise|ZAUBERSHOW)(?:(?!<\/section>|<section)[\s\S])*?(?:40 Minuten|Festpreis)[\s\S]*?(?:<\/div>\s*){2,5}/gi,
    (match) => {
      if (match.includes('price-card')) return match;
      // Nur kurze Matches (< 3000 chars) entfernen um nicht zu viel Content zu löschen
      if (match.length > 3000) return match;
      return '';
    }
  );
  // Pattern C: Für Seiten wie Wesel/Xanten mit "Im Festpreis enthalten/inbegriffen" als zweite Preis-H2
  scrapedContent = scrapedContent.replace(
    /<section[^>]*class="[^"]*has-1-columns[^"]*"[^>]*>(?:(?!<\/section>)[\s\S])*?Im Festpreis (?:enthalten|inbegriffen)(?:(?!<\/section>)[\s\S])*?<\/section>/gi,
    (match) => {
      if (match.includes('price-card')) return match;
      return '';
    }
  );
}

// === Post-stylize: Einheitliche 3-Spalten Preiskarten auf ALLEN Seiten ===
// Ersetze den Inhalt jedes price-grid durch die 3 Standard-Karten (Zaubershow, Ballonmodellage, Glitzer-Tattoos)
if (scrapedContent && scrapedContent.includes('price-grid') && pageSlug.startsWith('geburtstag-in-')) {
  const standardPriceCards = `
    <div class="price-card"><h3>🎩 Zaubershow</h3>
      <p class="price-amount">150 €</p>
      <p>✓ 40 Minuten voller Zauber, Lachen und Staunen</p>
