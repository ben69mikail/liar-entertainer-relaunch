const _isCitySlug = pageSlug.startsWith('geburtstag-in-') || pageSlug.startsWith('kinderzauberer-in-') || pageSlug.startsWith('clown-in-');

// === Legacy-H1 entfernen (SEO-Audit 06.08.2026, Massnahme H5) ===
// Das importierte WordPress-Markup bringt eine eigene <h1 class="title entry-title">
// mit. Das Template rendert den Titel bereits daruber -> zwei H1 pro Blogpost.
// Betroffen waren 30 Seiten. Auch der Legacy-Breadcrumb daneben ist doppelt.
// Jede <h1> aus importiertem WordPress-Markup auf <h2> herabstufen: Das Template
// rendert die Seiten-H1 bereits selbst, jede weitere ist ein Duplikat (Massnahme H5).
function demoteLegacyH1(html: string, templateRendersH1: boolean): string {
  let seen = 0;
  // Ganze h1-Elemente als Paar ersetzen - getrennte Ersetzung von oeffnendem und
  // schliessendem Tag erzeugt sonst unbalanciertes Markup.
  return html.replace(/<h1(\s[^>]*)?>([\s\S]*?)<\/h1>/gi, (_m, attrs, inner) => {
    seen++;
    // Rendert das Template selbst eine H1 (Blogpost, Stadtseite), ist JEDE
    // Legacy-H1 ein Duplikat. Sonst bleibt die erste als Seiten-H1 bestehen.
    const keepAsH1 = !templateRendersH1 && seen === 1;
    const tag = keepAsH1 ? 'h1' : 'h2';
    return `<${tag}${attrs || ''}>${inner}</${tag}>`;
  });
}

// Textkorrekturen im importierten Legacy-Markup (SEO-Audit 06.08.2026).
// Bewusst hier statt in src/data/*.json: die beiden Datendateien sind zusammen
// ~9,5 MB reiner WordPress-Export und bleiben unveraendert; alle Transformationen
// leben an einer Stelle in der Render-Pipeline.
function fixLegacyCopy(html: string): string {
  return html
    // H7: Grammatikfehler, erscheint im FAQ-Schema und damit potenziell im SERP
    .replace(/Was kostet einen Auftritt/g, 'Was kostet ein Auftritt')
    // K2: verbindliche Bewertungszahl ist 370+ (Vorgabe Michael 06.08.2026)
    .replace(/400\+\s*(Top-)?Bewertungen/g, (_m, top) => `370+ ${top || ''}Bewertungen`)
    .replace(/über 400\s*(Google-)?(Top-)?Bewertungen/g, (_m, g, top) => `370+ ${g || ''}${top || ''}Bewertungen`)
    // M3: nichtssagende Ueberschrift durch eine Frage ersetzen
    .replace(/Schnelle Eindrücke/gi, 'Wie sieht eine Show von Clown Zauberer LIAR aus?');
}

function stripLegacyPostHeader(html: string): string {
  return html
    .replace(/<small[^>]*class="[^"]*breadcrumbs?[^"]*"[^>]*>[\s\S]*?<\/small>/gi, '')
    .replace(/<h1[^>]*class="[^"]*entry-title[^"]*"[^>]*>[\s\S]*?<\/h1>/gi, '');
}

// === Legacy-Blog-Posts: kaputte wp-content-Bilder komplett entfernen ===
// Die wp-content/uploads-URLs liefern 410 Gone (.htaccess) → Bilder samt
// <figure>-Wrapper/Captions und Bild-Links aus dem HTML strippen.
function stripWpImages(html: string): string {
  let out = html
    // 1. Bild-Links auf wp-content (Lightbox o.ä.): <a href="...wp-content..."><img ...></a>
    .replace(/<a[^>]*href="[^"]*wp-content\/uploads[^"]*"[^>]*>\s*(?:<img[^>]*>\s*)+<\/a>/gi, '')
    // 2. Alle <img>-Tags, die wp-content/uploads referenzieren (src/srcset/data-*, auch Optimole-CDN)
    .replace(/<img[^>]*wp-content\/uploads[^>]*>/gi, '')
    // 2b. K1 (11.08.2026): auch wp-content/plugins - die WPForms-Lade-Spinner
    //     (submit-spin.svg) blieben sonst als tote Requests auf zwei Seiten stehen.
    .replace(/<img[^>]*wp-content\/plugins[^>]*>/gi, '')
    // 3. Übrig gebliebene leere Links
    .replace(/<a[^>]*>(?:\s|&nbsp;)*<\/a>/gi, '');
  // 4. <figure> ohne verbliebenes Medium (kein img/iframe/video mehr) → samt <figcaption>
  //    entfernen. Loop für verschachtelte Galerie-Figures.
  const emptyFigure = /<figure[^>]*>(?:(?!<img|<iframe|<video|<\/figure>)[\s\S])*<\/figure>/gi;
  let prev: string;
  do {
    prev = out;
    out = out.replace(emptyFigure, '');
  } while (out !== prev);
  // 4b. Verwaiste </figure>-Schließtags (äußere Galerie-Figure), wenn keine <figure> mehr offen ist
  if (!/<figure[\s>]/i.test(out)) out = out.replace(/<\/figure>/gi, '');
  return out
    // 5. Leere wp-block-image-Container
    .replace(/<div[^>]*class="[^"]*wp-block-image[^"]*"[^>]*>(?:\s|&nbsp;)*<\/div>/gi, '')
    // 6. Leere Absätze, die durch das Strippen entstanden sind
    .replace(/<p[^>]*>(?:\s|&nbsp;|<br\s*\/?>)*<\/p>/gi, '');
}

let scrapedContent: string | null = _processedScraped && _isCitySlug
  ? stylizeCityContent(_processedScraped)
  : _processedScraped;

// SEO-Audit 11.08.2026, Massnahme K1: stripWpImages lief bisher nur fuer
// page.type === 'post'. /clown/clown-zauberer/ und /zauberer/zaubershow/karneval/
// sind aber type 'page' und lieferten dadurch 16 wp-content-Bilder aus, die per
// .htaccess bewusst 410 Gone zurueckgeben - also 16 kaputte Bilder auf zwei Seiten.
// stripLegacyPostHeader bleibt bewusst auf 'post' beschraenkt (Blog-spezifisch).
if (scrapedContent) {
  scrapedContent = stripWpImages(scrapedContent);
  if (page.type === 'post') {
    scrapedContent = stripLegacyPostHeader(scrapedContent);
