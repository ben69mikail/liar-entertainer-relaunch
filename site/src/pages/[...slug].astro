    scrapedContent = scrapedContent.replace(festpreisMatch[0], '');
    const firstCardEnd = scrapedContent.match(/<div class="price-card">[\s\S]*?<\/div>/i);
    if (firstCardEnd) {
      const insertIdx = scrapedContent.indexOf(firstCardEnd[0]) + firstCardEnd[0].length - 6;
      scrapedContent = scrapedContent.substring(0, insertIdx)
        + `<hr style="border:none;border-top:1px solid #eee;margin:0.75rem 0"><p style="font-weight:600;color:#3b55d5;margin-bottom:0.25rem">Im Festpreis enthalten:</p>${festpreisContent}`
        + scrapedContent.substring(insertIdx);
    }
  }

  // W6: Pricing-Bereich visuell aufwerten (jetzt auf hellem Hintergrund)
  // Finde den exakten H2 der "Ehrliche Preise" enthält (indexOf statt [\s\S]*? Regex)
  const ehrlicheIdx = scrapedContent.indexOf('Ehrliche Preise');
  if (ehrlicheIdx > -1) {
    const h2Start = scrapedContent.lastIndexOf('<h2', ehrlicheIdx);
    const h2End = scrapedContent.indexOf('</h2>', ehrlicheIdx);
    if (h2Start > -1 && h2End > -1) {
      const preisH2 = scrapedContent.substring(h2Start, h2End + 5);
      const preisIdx = h2Start;
      const afterPreisH2 = scrapedContent.substring(preisIdx);
      const priceGridPos = afterPreisH2.indexOf('class="price-grid"');
      if (priceGridPos > -1) {
        // Finde das schließende </div> des price-grid (zähle open/close div Tags)
        const gridDivStart = afterPreisH2.lastIndexOf('<div', priceGridPos);
        let depth = 0;
        let gridEndIdx = -1;
        const searchStr = afterPreisH2.substring(gridDivStart);
        const divRegex = /<\/?div[^>]*>/gi;
        let dm;
        while ((dm = divRegex.exec(searchStr)) !== null) {
          if (dm[0].startsWith('</')) depth--;
          else depth++;
          if (depth === 0) {
            gridEndIdx = gridDivStart + dm.index + dm[0].length;
            break;
          }
        }
        if (gridEndIdx > -1) {
          const pricingBlock = afterPreisH2.substring(0, gridEndIdx);
          scrapedContent = scrapedContent.substring(0, preisIdx)
            + `<div class="waltrop-pricing-section">${pricingBlock}</div>`
            + scrapedContent.substring(preisIdx + gridEndIdx);
        }
      }
    }
  }

  // W7: CTA-Bereich "unvergesslich machen" — H3 → H2 Upgrade
  scrapedContent = scrapedContent.replace(
    /<h3([^>]*)>([\s\S]*?Kindergeburtstag in Waltrop unvergesslich[\s\S]*?)<\/h3>/i,
    '<h2$1>$2</h2>'
  );
}

// === HTML-Tag-Balancierung: Offene <div>-Tags schließen ===
