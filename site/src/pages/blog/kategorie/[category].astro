---
import V2Layout from '../../../layouts/V2Layout.astro';
import BlogCards from '../../../components/v2/BlogCards.astro';
import K3Hero from '../../../components/v2/kids/K3Hero.astro';
import GoldDivider from '../../../components/v2/kids/GoldDivider.astro';
import { getAllBlogPosts, getAllCategories, catToSlug } from '../../../utils/allPosts';
import '../../../styles/kids-v3.css';

export async function getStaticPaths() {
  const cats = await getAllCategories();
  const allPosts = await getAllBlogPosts();
  return cats.map((c) => ({
    params: { category: c.slug },
    props: {
      categoryName: c.name,
      posts: allPosts.filter((p) =>
        p.categories.some((pc) => catToSlug(pc) === c.slug),
      ),
    },
  }));
}

interface PostSummary {
  slug: string;
  href: string;
  title: string;
  date: Date;
  excerpt: string;
  image: string;
  categories: string[];
}

const { categoryName, posts } = Astro.props as {
  categoryName: string;
  posts: PostSummary[];
};


const canonicalSlug = catToSlug(categoryName);

// Dünne Kategorien (<5 Artikel) nicht indexieren — Thin-Content-Schutz.
// Schwelle 06.08.2026 von 2 auf 5 angehoben: im Build gemessen erreicht eine
// Kategorie erst ab ca. 5 Beiträgen über 300 Wörter. Darunter: 40–220 Wörter,
// 0–1 interne Links — genau der Index-Bloat aus dem GSC-Bericht.
// TODO (redaktionell): kindergeburtstag, geburtstag, ratgeber und karneval mit
// einem eigenen Einleitungstext ausbauen und danach wieder auf index setzen.
// Werthaltige Kategorien stehen in der Sitemap (sitemap.xml.ts, gleiche Schwelle).
const isThin = posts.length < 5;

// Redaktionelle Einleitungen (SEO-Audit 11.08.2026, Massnahme M3): Kategorien mit
// genug Beitraegen fuer den Index, aber ohne eigenen Text, waren reine Teaser-Listen
// (~205 Woerter). Die Einleitung verankert das Thema im Kindergeburtstags- bzw.
// Kinderzauberer-Kontext und gibt der Archivseite eigenen redaktionellen Wert.
const CATEGORY_INTROS: Record<string, string> = {
  feste:
    'Ob Sommerfest in der Kita, Straßenfest oder Familienfeier: Hier sammle ich Berichte und Planungstipps rund um Feste in NRW. Vieles davon lässt sich direkt auf den <a href="/kindergeburtstag/">Kindergeburtstag</a> übertragen – vom Zeitplan über die Sitzordnung bis zu der Frage, wann ein Programmpunkt wie eine Zaubershow wirklich trägt. Wer gerade ein Fest plant, findet hier Erfahrungswerte aus über 15 Jahren Bühnenpraxis statt Checklisten von der Stange.',
  geburtstag:
    'Alles rund um den Kindergeburtstag: Programmideen, Ablaufpläne, Altersempfehlungen und ehrliche Antworten auf die Fragen, die Eltern mir am Telefon stellen. Die Beiträge zeigen, wie eine Feier für 4- bis 12-Jährige entspannt bleibt – mit oder ohne <a href="/kinderzauberer/">Kinderzauberer</a>. Wer stattdessen die konkreten Leistungen und Pakete sucht, wird auf der Seite <a href="/kindergeburtstag/">Kindergeburtstag</a> schneller fündig.',
  saisonal:
    'Jede Jahreszeit stellt eigene Anforderungen an eine Kinderfeier: Hitze im Juli, Dauerregen im Mai, Karneval im Februar. In dieser Kategorie sammle ich saisonale Tipps für <a href="/kindergeburtstag/">Kindergeburtstage</a> und Feste in NRW – inklusive Plan B fürs Wetter. So lässt sich früh entscheiden, ob die Show drinnen oder draußen stattfindet und welche Programmpunkte im jeweiligen Monat überhaupt funktionieren.',
  'pantomime-nrw':
    'Als Pantomime und Walk-Act bin ich in NRW auf Stadtfesten, Weihnachtsmärkten und Vereinsfeiern unterwegs – leise, ohne Worte, mitten im Publikum. Die Beiträge hier zeigen diese Auftritte im Alltag und machen deutlich, worin sich ein <a href="/clown/walk-act/">Walk-Act</a> von einer klassischen Bühnenshow unterscheidet. Für die Feier zu Hause ist dagegen die interaktive Show des <a href="/kinderzauberer/">Kinderzauberers</a> das passendere Format – mehr dazu auf der Seite <a href="/kindergeburtstag/">Kindergeburtstag</a>.',
};
const intro = CATEGORY_INTROS[canonicalSlug] ?? null;
---

<V2Layout
  title={`${categoryName} | Blog | Clown Zauberer LIAR`}
  description={`Alle Blog-Artikel zur Kategorie ${categoryName} vom Clown Zauberer LIAR. Berichte, Tipps und Neuigkeiten rund um Kindergeburtstag, Zauberei und Events in NRW.`}
  canonical={`https://liar-entertainer.com/blog/kategorie/${canonicalSlug}/`}
  noindex={isThin}
>
  <!-- ── Hero: the big-top stage (K3Hero), crumbs, title, count, intro. No reveal (LCP). ── -->
  <K3Hero>
    <div class="k3-hero-center">
      <nav class="bk-crumbs" aria-label="Brotkrumen">
        <a class="k3-chip" href="/blog/">← Blog</a>
        <span class="bk-crumbs__sep">/</span>
        <span>{categoryName}</span>
      </nav>

      <h1 class="k3-hero__title bk-hero__title">{categoryName}</h1>
      <p class="bk-hero__count">
        {posts.length} {posts.length === 1 ? 'Artikel' : 'Artikel'} in dieser Kategorie
      </p>

      {intro && <p class="k3-hero__text bk-hero__intro" set:html={intro} />}
    </div>
  </K3Hero>

  <section class="bk-list">
    <div class="container">
      <GoldDivider />
      <BlogCards posts={posts} featureFirst={posts.length >= 3} eager={1} />
    </div>
  </section>
</V2Layout>

<style>
  .bk-crumbs {
    display: inline-flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: center;
    font-size: 0.92rem; font-weight: 700; color: #eadcc6; margin-bottom: var(--space-2);
  }
  .bk-crumbs__sep { opacity: 0.6; }
  .bk-hero__title { overflow-wrap: anywhere; text-wrap: balance; margin-top: 0; }
  /* the count as a little velvet ticket with a gold rule */
  .bk-hero__count {
    display: inline-block; padding: 0.35rem 1rem; margin: 0;
    font-family: var(--font-display); font-weight: 600; color: #ffe3a3;
    background: linear-gradient(180deg, #a8192a, var(--velvet)); border-radius: 0.5rem;
    box-shadow: 0 0 0 1px #e9c877, 0 0 0 4px rgba(142, 21, 32, 0.9), 0 0 0 5px rgba(233, 200, 119, 0.5);
  }
  .bk-hero__intro { max-width: 42rem; margin: var(--space-4) auto 0 !important; text-align: left; line-height: 1.7; }
  .bk-list { background: var(--bg); padding-top: var(--space-5); }
</style>
