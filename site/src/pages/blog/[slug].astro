---
import { getCollection, render } from 'astro:content';
import V2Layout from '../../layouts/V2Layout.astro';
import Reviews from '../../components/v2/Reviews.astro';
import BlogFooter from '../../components/v2/BlogFooter.astro';
import ProgramFrame from '../../components/v2/kids/ProgramFrame.astro';
import GoldDivider from '../../components/v2/kids/GoldDivider.astro';
import { CONTACT } from '../../data/site';
import postsData from '../../data/posts.json';
import { generateHeroWithOverlay } from '../../utils/heroOverlay';
import { generateStoryImage } from '../../utils/storyOverlay';
import { catToSlug } from '../../utils/allPosts';
import '../../styles/kids-v3.css';
import '../../styles/article.css';

type WPPost = { slug: string };

export async function getStaticPaths() {
  const wpSlugs = new Set((postsData as WPPost[]).map((p) => p.slug));
  const entries = await getCollection('blog');
  return entries
    .filter((e) => !e.data.draft && !wpSlugs.has(String(e.id)))
    .map((e) => ({ params: { slug: String(e.id) }, props: { entry: e } }));
}

const { entry } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
};
const { Content } = await render(entry);

const slug = String(entry.id);
const dateLabel = new Date(entry.data.publishDate).toLocaleDateString('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
const isoDate = entry.data.publishDate.toISOString();
const canonical = `https://liar-entertainer.com/blog/${slug}/`;
const desc = entry.data.description ?? entry.data.title;

// SEO-Title: nutzt optionales seoTitle-Frontmatter (<=60 Zeichen) fuer den
// <title>-Tag, sonst Standard-Fallback. Die sichtbare H1/Artikel-Ueberschrift
// (entry.data.title) bleibt davon unberuehrt.
const pageTitle = entry.data.seoTitle ?? `${entry.data.title} | Clown Zauberer LIAR`;

// Hero-Image mit Title-Overlay (build-time via sharp, OG-Image-Standard 1200x630)
const heroDisplayUrl = entry.data.heroImage
  ? await generateHeroWithOverlay(entry.data.heroImage, entry.data.title, slug)
  : undefined;
const heroAbsolute = heroDisplayUrl?.startsWith('/')
  ? `https://liar-entertainer.com${heroDisplayUrl}`
  : heroDisplayUrl;
const ogImage = heroAbsolute ?? entry.data.heroImage ?? undefined;

// Story-Image fuer FB/IG Photo Stories (build-time via sharp, 1080x1920 9:16).
// Wird vom n8n Story-Repost-Workflow als story_image_url verwendet.
// Awaited damit Datei beim Build sicher geschrieben ist (Side-Effect).
if (entry.data.heroImage) {
  await generateStoryImage(entry.data.heroImage, entry.data.title, slug);
}

// BlogPosting schema.org structured data — Publisher referenziert das globale
// LocalBusiness aus Document via @id (https://liar-entertainer.com/#business)
const modifiedIso = entry.data.updatedDate
  ? entry.data.updatedDate.toISOString()
  : isoDate;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: desc,
  ...(ogImage ? { image: ogImage } : {}),
  author: {
    '@type': 'Person',
    '@id': 'https://liar-entertainer.com/#person',
    name: entry.data.author || 'Michaël Prescler',
    url: 'https://liar-entertainer.com/ueber-mich/',
  },
  publisher: { '@id': 'https://liar-entertainer.com/#business' },
  datePublished: isoDate,
  dateModified: modifiedIso,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
---


<V2Layout
  title={pageTitle}
  description={desc}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  heroPreload={heroDisplayUrl}
  structuredData={articleSchema}
>
  <!-- ── Article head: slim big-top stage (crumbs, title, meta), the cover hangs below it as a programme sheet.
       No reveals on the article (reading first). ── -->
  <section class="bp-head">
    <div class="bp-col">
      <nav class="bp-crumbs" aria-label="Brotkrumen">
        <a href="/">Clown</a>
        <span>»</span>
        <a href="/blog/">Blog</a>
        <span>»</span>
        <span>{entry.data.title}</span>
      </nav>
      <h1 class="bp-title">{entry.data.title}</h1>
      <div class="bp-meta">
        <time datetime={isoDate}>{dateLabel}</time>
        {entry.data.author && <span>· von {entry.data.author}</span>}
        {entry.data.categories.length > 0 && (
          <span class="bp-cats">
            {entry.data.categories.map((c) => (
              <a class="bp-cat" href={`/blog/kategorie/${catToSlug(c)}/`}>{c}</a>
            ))}
          </span>
        )}
      </div>
      {heroDisplayUrl && (
        <ProgramFrame class="bp-hero">
          <img
            src={heroDisplayUrl}
            alt={entry.data.heroImageAlt ?? entry.data.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1200"
            height="630"
          />
        </ProgramFrame>
      )}
    </div>
  </section>

  <!-- ── Article body: calm reading column ── -->
  <section class="bp-body">
    <div class="bp-col">
      <article class="bp-prose">
        <Content />
      </article>

      <!-- Autorbox: E-E-A-T signal, linked to the Person schema (#person) -->
      <aside class="bp-author">
        <div class="bp-author__icon">🎩</div>
        <div>
          <p class="bp-author__title">Über den Autor: {entry.data.author || 'Michaël Prescler'}</p>
          <p class="bp-author__text">
            Michaël Prescler alias <strong>Clown Zauberer LIAR</strong> ist seit 2009 professioneller
            Clown, Zauberer und Kinderentertainer aus Gladbeck. Mit rund 400 Shows pro Jahr, über
            110.000 begeisterten Kindern und 370+ Google-Bewertungen (5,0 ★) gehört er zu den
            aktivsten Kinderzauberern in NRW. Er schreibt hier aus der Praxis – über das, was auf
            echten Kindergeburtstagen und Festen wirklich funktioniert.
          </p>
          <a href="/ueber-mich/" class="bp-author__more">Mehr über LIAR →</a>
        </div>
      </aside>

      <!-- Service quick links (legacy: above the cover; moved below the article for reading flow) -->
      <nav class="bp-services" aria-labelledby="bp-services-title">
        <p class="bp-services__title" id="bp-services-title">Unsere Leistungen</p>
        <div class="k3-quick">
          <a href="/clown/clownshow/">🤡 Clownshow</a>
          <a href="/zauberer/">🎩 Zauberer</a>
          <a href="/kinderzauberer/">✨ Kinderzauberer</a>
          <a href="/kindergeburtstag/">🎂 Zauberer für Kindergeburtstag</a>
          <a href="/zauberer/zaubershow/">🪄 Zaubershow</a>
          <a href="/galerie/">📸 Galerie</a>
        </div>
      </nav>
    </div>
  </section>

  <Reviews />

  <!-- ── Book-now CTA ── -->
  <section class="bp-cta">
    <div class="container k3-narrow k3-center">
      <GoldDivider />
      <div class="k3-prog bp-cta__card">
        <h2 class="k3-h2">Jetzt LIAR buchen</h2>
        <p class="bp-cta__text">Unvergessliche Unterhaltung für Ihr Event – einfach und unverbindlich anfragen!</p>
        <div class="bp-cta__actions">
          <a href="/kontakt/" class="btn btn--primary" data-confetti>Kontakt aufnehmen</a>
          <a href={CONTACT.phoneHref} class="btn btn--ghost">+49 172 1517578</a>
        </div>
      </div>
    </div>
  </section>

  <BlogFooter currentSlug={slug} categories={entry.data.categories} />
</V2Layout>
