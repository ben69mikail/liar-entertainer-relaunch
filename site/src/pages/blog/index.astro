---
import V2Layout from '../../layouts/V2Layout.astro';
import Reviews from '../../components/v2/Reviews.astro';
import BlogCards from '../../components/v2/BlogCards.astro';
import { getAllBlogPosts, getAllCategories } from '../../utils/allPosts';
import '../../styles/kids-kit.css';

const posts = await getAllBlogPosts();
const categories = await getAllCategories();
---

<V2Layout
  title="Blog | Clown Zauberer LIAR — Aktuelles & Events"
  description="Neuigkeiten vom Clown Zauberer LIAR ✓ Berichte von Shows, Festen & Events in NRW ✓ Tipps für die perfekte Kinderparty ✓ Fotos & Erfahrungsberichte"
  keywords="Clown Zauberer Blog, Zauberer Tipps, Kindergeburtstag Tipps, Clown NRW News"
  canonical="https://liar-entertainer.com/blog/"
>
  <!-- ── Hero: title, intro, service + category chips. No reveal (LCP). ── -->
  <section class="kg-hero bl-hero">
    <div class="container bl-hero__inner">
      <h1 class="bl-hero__title" data-letters>Blog</h1>
      <p class="bl-hero__sub">Aktuelles von Clown Zauberer LIAR</p>
      <p class="bl-hero__text">
        Hier berichte ich über meine Auftritte, Tipps und Neuigkeiten rund um Zaubershow und Kinderunterhaltung.
        <a href="/ueber-mich/">Mehr über mich erfahren</a>.
      </p>

      <nav class="kg-quick bl-services" aria-label="Leistungen">
        <a href="/clown/clownshow/">🤡 Clownshow</a>
        <a href="/zauberer/">🎩 Zauberer</a>
        <a href="/kinderzauberer/">✨ Kinderzauberer</a>
        <a href="/kindergeburtstag/">🎂 Zauberer für Kindergeburtstag</a>
        <a href="/zauberer/zaubershow/">🪄 Zaubershow</a>
        <a href="/galerie/">📸 Galerie</a>
      </nav>

      {categories.length > 0 && (
        <nav class="bl-cats" aria-label="Blog-Kategorien">
          <span class="bl-cats__label">Kategorien:</span>
          {categories.slice(0, 12).map((cat) => (
            <a class="bl-chip" href={`/blog/kategorie/${cat.slug}/`}>
              {cat.name} <span class="bl-chip__count">({cat.count})</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  </section>

  <!-- ── Posts: newest first and featured, then the poster wall ── -->
  <section class="bl-list">
    <div class="container">
      <BlogCards posts={posts} featureFirst eager={1} />
    </div>
  </section>

  <Reviews />
</V2Layout>

<style>
  .bl-hero { padding-block: var(--space-5) var(--space-4); text-align: center; }
  .bl-hero__inner { max-width: 52rem; }
  .bl-hero__title {
    font-size: clamp(3.4rem, 10vw, 6.5rem); line-height: 0.95; margin: 0 0 var(--space-1);
    color: var(--accent-strong);
  }
  .bl-hero__sub { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.25rem, 2.6vw, 1.6rem); color: var(--accent-2); }
  .bl-hero__text { max-width: 40rem; margin-inline: auto; color: var(--ink-soft); font-size: 1.05rem; }
  .bl-services { justify-content: center; }

  .bl-cats {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.5rem;
    margin-top: var(--space-3); padding-top: var(--space-3);
    border-top: 2px dashed color-mix(in srgb, var(--line) 30%, transparent);
  }
  .bl-cats__label { font-family: var(--font-display); font-weight: 650; margin-right: 0.25rem; }
  .bl-chip {
    display: inline-flex; align-items: center; gap: 0.3rem; min-height: 2.75rem;
    padding: 0.35rem 0.9rem; border-radius: 999px; text-decoration: none; font-weight: 800; font-size: 0.92rem;
    color: var(--ink); background: var(--surface); border: var(--border); box-shadow: 2px 2px 0 var(--line);
    transition: transform 0.25s var(--ease-out-expo), background-color 0.2s, box-shadow 0.2s;
  }
  .bl-chip__count { font-weight: 600; color: var(--ink-soft); }
  .bl-chip:nth-child(3n + 2) { background: color-mix(in srgb, var(--brand-yellow) 35%, var(--surface)); }
  .bl-chip:nth-child(3n) { background: color-mix(in srgb, var(--brand-blue) 12%, var(--surface)); }
  @media (hover: hover) and (pointer: fine) {
    .bl-chip:hover { transform: translate(-2px, -2px) rotate(-2deg); box-shadow: 4px 4px 0 var(--line); }
  }

  .bl-list { background: var(--bg); padding-top: var(--space-4); }
</style>
