---
/**
 * v2 blog teaser list, kids v3 look (2026-10-06): every post is a circus-programme sheet (gold
 * rule + corner flourishes); its cover sits whole on a small big-top stage, never cropped. Used by /blog/, /blog/kategorie/*,
 * and the "Weiterlesen" block under every post (components/v2/BlogFooter.astro).
 * Text per card is the legacy wording 1:1 (date, title, excerpt, link text); the category
 * label is new UI built from the post's own data.
 */
import type { BlogPostSummary } from '../../utils/allPosts';
import { cardThumb } from '../../utils/cardThumb';

interface Props {
  posts: Pick<BlogPostSummary, 'href' | 'title' | 'date' | 'excerpt' | 'image' | 'categories'>[];
  /** first post spans the row, image beside the text on desktop */
  featureFirst?: boolean;
  /** how many leading images load eagerly (the first one also gets fetchpriority=high) */
  eager?: number;
  heading?: 'h2' | 'h3';
  moreLabel?: string;
  /** smaller cards (related posts under an article) */
  compact?: boolean;
}

const {
  posts,
  featureFirst = false,
  eager = 0,
  heading = 'h2',
  moreLabel = 'Weiterlesen →',
  compact = false,
} = Astro.props;
const Heading = heading;

function formatDate(d: Date) {
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
}
---

<div class:list={['bc-grid', { 'bc-grid--compact': compact }]}>
  {posts.map((post, i) => {
    const feature = featureFirst && i === 0;
    const isEager = i < eager;
    return (
      <article
        class:list={['bc-card', { 'bc-card--feature': feature }]}
        data-reveal={isEager ? undefined : 'up'}
      >
        <a class="bc-media" href={post.href} tabindex="-1" aria-hidden="true">
          <img
            src={cardThumb(post.image)}
            alt={post.title}
            loading={isEager ? 'eager' : 'lazy'}
            fetchpriority={i === 0 && isEager ? 'high' : undefined}
            decoding="async"
            width="400"
            height="240"
          />
        </a>
        <div class="bc-body">
          <p class="bc-meta">
            <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
            {post.categories[0] && <span class="bc-cat">{post.categories[0]}</span>}
          </p>
          <Heading class="bc-title">
            <a href={post.href}>{post.title}</a>
          </Heading>
          <p class="bc-excerpt">{post.excerpt}</p>
          <a class="bc-more" href={post.href}>{moreLabel}</a>
        </div>
      </article>
    );
  })}
</div>

<style>
  .bc-grid {
    display: grid;
    gap: var(--space-4) var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .bc-grid--compact { grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-3); }

  /* circus-programme sheet: light paper, fine double gold rule, gold corner flourishes */
  .bc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.85rem;
    background:
      var(--orn-tl) left 0.4rem top 0.4rem / 1.3rem no-repeat,
      var(--orn-tr) right 0.4rem top 0.4rem / 1.3rem no-repeat,
      var(--orn-bl) left 0.4rem bottom 0.4rem / 1.3rem no-repeat,
      var(--orn-br) right 0.4rem bottom 0.4rem / 1.3rem no-repeat,
      var(--surface);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.55), inset 0 0 0 5px var(--surface), inset 0 0 0 6px rgba(184, 134, 47, 0.25), var(--shadow);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  /* the cover on a small big-top stage: the whole image, letterboxed, never cropped */
  .bc-media {
    display: block; position: relative; overflow: hidden; border-radius: 0.5rem;
    background: var(--k3-bigtop, #241355);
    box-shadow: 0 0 0 1px rgba(184, 134, 47, 0.5);
  }
  .bc-media img { display: block; width: 100%; height: auto; aspect-ratio: 5 / 3; object-fit: contain; }

  .bc-body { display: flex; flex-direction: column; flex: 1; padding: var(--space-2) 0.6rem 0.9rem; }
  .bc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.6rem; margin: 0 0 0.5rem; font-size: 0.9rem; font-weight: 700; color: var(--ink-soft); }
  .bc-cat {
    padding: 0.1rem 0.65rem; border-radius: 999px; font-size: 0.8rem; font-weight: 800;
    background: #fbefd2; color: #6e4a0e; box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.6);
  }
  .bc-title { font-size: clamp(1.2rem, 2vw, 1.4rem); font-weight: 600; line-height: 1.22; margin: 0 0 0.6rem; text-wrap: balance; }
  .bc-title a { color: var(--ink); text-decoration: none; }
  /* the whole card is one big target; the title link stretches over it */
  .bc-title a::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: var(--radius); }
  .bc-title a:focus-visible { outline: none; }
  .bc-card:has(.bc-title a:focus-visible) { outline: 3px solid var(--accent-2); outline-offset: 4px; }
  .bc-excerpt { color: var(--ink-soft); font-size: 0.98rem; margin: 0 0 var(--space-2); }
  .bc-more {
    margin-top: auto; align-self: flex-start; position: relative; z-index: 2;
    padding-top: 0.6rem; border-top: 1px solid rgba(184, 134, 47, 0.35);
    font-family: var(--font-display); font-weight: 600; color: var(--accent-strong); text-decoration: none;
  }

  .bc-grid--compact .bc-body { padding: var(--space-2) 0.5rem 0.8rem; }
  .bc-grid--compact .bc-title { font-size: 1.15rem; }
  .bc-grid--compact .bc-excerpt {
    font-size: 0.93rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  .bc-card--feature { grid-column: 1 / -1; }
  .bc-card--feature .bc-title { font-size: clamp(1.5rem, 3.4vw, 2.3rem); }
  .bc-card--feature .bc-excerpt { font-size: 1.08rem; }
  @media (min-width: 901px) {
    .bc-card--feature { display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--space-3); align-items: center; padding: 1.1rem; }
    .bc-card--feature .bc-body { padding: var(--space-3) var(--space-3) var(--space-3) 0; justify-content: center; }
    .bc-card--feature .bc-more { margin-top: var(--space-1); }
  }

  @media (hover: hover) and (pointer: fine) {
    .bc-card:hover {
      transform: translateY(-4px);
      box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.7), inset 0 0 0 5px var(--surface), inset 0 0 0 6px rgba(184, 134, 47, 0.35), var(--shadow-hover);
    }
    .bc-card:hover .bc-title a { color: var(--accent-strong); }
    .bc-more { transition: translate 0.25s var(--ease-out); }
    .bc-card:hover .bc-more { translate: 4px 0; }
  }
</style>
