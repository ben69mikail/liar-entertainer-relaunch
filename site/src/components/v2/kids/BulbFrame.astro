---
/**
 * Kids v3 photo frame (user, 2026-10-06): a fine gold frame lined with little light bulbs, like a
 * circus sign. The photo is always whole (natural ratio, never cropped) and never animated in,
 * so the frame may carry the LCP image. When the frame comes into view (fx.ts data-stage →
 * .is-staged) the bulbs switch on one after another and then shimmer softly. Bulbs are
 * aria-hidden; reduced motion shows them lit and still.
 */
interface Props {
  class?: string;
  style?: string;
  [key: `data-${string}`]: unknown;
}
const { class: cls, style, ...rest } = Astro.props;

// Bulb positions along the frame, clockwise from the top-left corner (percent of the frame box).
const TOP = 9;
const SIDE = 6;
const at = (i: number, n: number) => (i / (n - 1)) * 100;
const bulbs = [
  ...Array.from({ length: TOP }, (_, i) => ({ x: at(i, TOP), y: 0 })),
  ...Array.from({ length: SIDE - 2 }, (_, i) => ({ x: 100, y: at(i + 1, SIDE) })),
  ...Array.from({ length: TOP }, (_, i) => ({ x: 100 - at(i, TOP), y: 100 })),
  ...Array.from({ length: SIDE - 2 }, (_, i) => ({ x: 0, y: 100 - at(i + 1, SIDE) })),
];
---

<figure class:list={['bf', cls]} style={style} data-stage {...rest}>
  <span class="bf__photo"><slot /></span>
  <span class="bf__bulbs" aria-hidden="true">
    {bulbs.map((b, i) => <span class="bf__bulb" style={`left:${b.x}%;top:${b.y}%;--i:${i}`}></span>)}
  </span>
</figure>

<style>
  .bf {
    --bf-gold: #b8862f;
    position: relative; margin: 0; padding: clamp(0.9rem, 2.2vw, 1.25rem);
    border-radius: 1rem;
    /* gold frame: a fine double rule on warm paper, soft lift */
    background:
      linear-gradient(#fffaf0, #fffaf0) padding-box,
      linear-gradient(135deg, #9c6f22, #f0cf7a 30%, #b8862f 55%, #f6dc95 78%, #9c6f22) border-box;
    border: 2px solid transparent;
    box-shadow:
      inset 0 0 0 5px #fffaf0,
      inset 0 0 0 6px rgba(184, 134, 47, 0.55),
      0 2px 6px rgba(43, 29, 23, 0.08),
      0 22px 44px -20px rgba(43, 29, 23, 0.45);
  }
  .bf__photo { display: block; overflow: hidden; border-radius: 0.6rem; }
  .bf__photo :global(img) { display: block; width: 100%; height: auto; }

  /* bulbs sit on the frame line */
  .bf__bulbs { position: absolute; inset: 0.45rem; pointer-events: none; }
  .bf__bulb {
    position: absolute; width: 0.62rem; height: 0.62rem; translate: -50% -50%; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fffdf2 0 22%, #ffe7a3 45%, #f2b33c 80%);
    box-shadow: 0 0 0 1px rgba(156, 111, 34, 0.55), 0 0 10px 2px rgba(255, 196, 80, 0.55);
    transition: opacity 0.35s ease;
    transition-delay: calc(var(--i) * 40ms);
  }

  /* off until the frame is staged; then a slow, staggered shimmer (opacity only) */
  :global(.motion-ok) .bf:not(.is-staged) .bf__bulb { opacity: 0.3; box-shadow: 0 0 0 1px rgba(156, 111, 34, 0.55); }
  :global(.motion-ok) .bf.is-staged .bf__bulb {
    animation: bf-shimmer 2.4s ease-in-out calc(1.2s + var(--i) * 0.12s) infinite alternate;
  }
  @keyframes bf-shimmer { to { opacity: 0.72; } }

  @media (prefers-reduced-motion: reduce) {
    .bf__bulb { transition: none; animation: none !important; }
  }
</style>
