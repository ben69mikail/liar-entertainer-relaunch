---
// A top hat; when it scrolls into view a rabbit pops out (fx.ts data-hat). aria-hidden decoration.
---

<div class="hat" data-hat aria-hidden="true">
  <div class="hat__stage">
    <svg class="hat__pop" viewBox="0 0 80 90">
      <ellipse cx="28" cy="20" rx="7" ry="20" fill="#fff" stroke="#2b1d17" stroke-width="3" />
      <ellipse cx="50" cy="18" rx="7" ry="20" fill="#fff" stroke="#2b1d17" stroke-width="3" transform="rotate(12 50 18)" />
      <ellipse cx="28" cy="22" rx="3" ry="12" fill="#ffb7c0" />
      <circle cx="40" cy="58" r="24" fill="#fff" stroke="#2b1d17" stroke-width="3" />
      <circle cx="32" cy="54" r="3" fill="#2b1d17" /><circle cx="48" cy="54" r="3" fill="#2b1d17" />
      <ellipse cx="40" cy="63" rx="4" ry="3" fill="#ff8fa3" />
      <path d="M36 68q4 4 8 0" fill="none" stroke="#2b1d17" stroke-width="2.5" stroke-linecap="round" />
    </svg>
  </div>
  <svg class="hat__hat" viewBox="0 0 120 90">
    <rect x="28" y="8" width="64" height="62" rx="6" fill="#2b1d17" />
    <rect x="28" y="50" width="64" height="12" fill="var(--brand-red)" />
    <ellipse cx="60" cy="72" rx="56" ry="12" fill="#2b1d17" />
    <ellipse cx="60" cy="9" rx="32" ry="7" fill="#46332a" />
  </svg>
  <span class="hat__star hat__star--1">✦</span><span class="hat__star hat__star--2">✧</span><span class="hat__star hat__star--3">✦</span>
</div>

<style>
  .hat { position: relative; width: 8rem; margin: 0 auto var(--space-2); }
  .hat__stage { position: absolute; left: 50%; bottom: 3.2rem; width: 5rem; height: 6.2rem; translate: -50% 0; overflow: hidden; }
  .hat__pop { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hat__hat { position: relative; display: block; width: 100%; }
  .hat__star { position: absolute; color: var(--brand-yellow); font-size: 1.2rem; opacity: 0; }
  .hat__star--1 { left: -0.5rem; top: 0.5rem; }
  .hat__star--2 { right: -0.6rem; top: -0.4rem; }
  .hat__star--3 { right: 0.4rem; top: 2.4rem; }
  .hat:global(.is-in) .hat__star { animation: twinkle-pop 0.9s var(--ease-out) forwards; }
  .hat:global(.is-in) .hat__star--2 { animation-delay: 0.15s; }
  .hat:global(.is-in) .hat__star--3 { animation-delay: 0.3s; }
  @keyframes twinkle-pop {
    0% { opacity: 0; transform: scale(0.6) rotate(0deg); }
    40% { opacity: 1; transform: scale(1.25) rotate(45deg); }
    100% { opacity: 0.85; transform: scale(1) rotate(90deg); }
  }
</style>
