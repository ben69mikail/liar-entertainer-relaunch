---
/**
 * A party rabbit (hat + balloon, it is a birthday after all) hops across the bottom of its
 * section once, when the section is well in view. JS-only toy (fx-rich.ts rabbitRun):
 * hidden without JS and under reduced motion. Decorative.
 */
const ink = '#2b1d17';
---

<div class="rr" data-rabbit-run hidden aria-hidden="true">
  <div class="rr__runner">
    <svg class="rr__bunny" viewBox="0 -45 150 175">
      <!-- balloon on a string -->
      <path d="M102 58 C112 40 118 30 120 18" fill="none" stroke={ink} stroke-width="2" />
      <g class="rr__balloon">
        <path d="M120 -18c-11 0-17 9-17 18 0 12 10 21 17 23 7-2 17-11 17-23 0-9-6-18-17-18z" fill="#3b55d5" stroke={ink} stroke-width="2.5" />
        <ellipse cx="114" cy="-6" rx="3.5" ry="6" fill="#fff" opacity=".5" transform="rotate(-20 114 -6)" />
      </g>
      <!-- body -->
      <ellipse cx="62" cy="92" rx="34" ry="24" fill="#fff" stroke={ink} stroke-width="3" />
      <circle cx="28" cy="88" r="8" fill="#fff" stroke={ink} stroke-width="3" />
      <!-- legs -->
      <g class="rr__legs">
        <ellipse cx="44" cy="114" rx="13" ry="6" fill="#fff" stroke={ink} stroke-width="3" />
        <ellipse cx="82" cy="114" rx="9" ry="5" fill="#fff" stroke={ink} stroke-width="3" />
      </g>
      <!-- head -->
      <circle cx="96" cy="70" r="20" fill="#fff" stroke={ink} stroke-width="3" />
      <ellipse cx="88" cy="38" rx="6" ry="18" fill="#fff" stroke={ink} stroke-width="3" transform="rotate(-12 88 38)" />
      <ellipse cx="88" cy="40" rx="2.5" ry="11" fill="#ffb7c0" transform="rotate(-12 88 40)" />
      <circle cx="102" cy="66" r="2.8" fill={ink} />
      <ellipse cx="114" cy="74" rx="3.5" ry="2.6" fill="#ff8fa3" />
      <path d="M100 79q5 3 9-1" fill="none" stroke={ink} stroke-width="2.2" stroke-linecap="round" />
      <!-- party hat -->
      <path d="M96 50 L108 22 L118 52 Z" fill="#ffb546" stroke={ink} stroke-width="2.5" stroke-linejoin="round" />
      <path d="M100 41 L113 41 M103 33 L111 33" stroke="#d7393e" stroke-width="3" />
      <circle cx="108" cy="21" r="3.5" fill="#d7393e" stroke={ink} stroke-width="2" />
      <!-- forearm holding the string -->
      <ellipse cx="100" cy="94" rx="8" ry="5" fill="#fff" stroke={ink} stroke-width="3" transform="rotate(-30 100 94)" />
    </svg>
  </div>
</div>

<style>
  .rr { position: absolute; left: 0; right: 0; bottom: 0.4rem; height: 12rem; overflow: hidden; pointer-events: none; z-index: 2; }
  .rr[hidden] { display: none; }
  .rr__runner { position: absolute; left: 0; bottom: 0; width: clamp(7rem, 11vw, 9.5rem); transform: translateX(-120%); }
  .rr__bunny { display: block; width: 100%; overflow: visible; transform-origin: 50% 100%; }
  .rr.is-running .rr__bunny { animation: rr-hop 0.48s cubic-bezier(0.33, 0, 0.67, 1) infinite; }
  .rr.is-running .rr__legs { animation: rr-legs 0.48s ease-in-out infinite; transform-origin: 60px 112px; }
  .rr__balloon { transform-origin: 120px 20px; animation: rr-bob 1.6s ease-in-out infinite alternate; }
  @keyframes rr-hop {
    0%, 100% { transform: translateY(0) rotate(0deg) scale(1.04, 0.96); }
    45% { transform: translateY(-2.4rem) rotate(-6deg) scale(0.97, 1.03); }
  }
  @keyframes rr-legs { 0%, 100% { transform: scaleX(1); } 45% { transform: scaleX(1.25) rotate(-8deg); } }
  @keyframes rr-bob { from { rotate: -6deg; } to { rotate: 8deg; } }
</style>
