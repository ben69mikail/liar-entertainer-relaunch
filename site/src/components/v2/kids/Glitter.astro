---
// Glitter sparkles around the Glitzer-Tattoo card: they twinkle in turn, brighter on hover. Decorative.
const sparks = [
  { x: 8, y: 10, s: 1.1, d: 0 }, { x: 88, y: 6, s: 0.8, d: 0.6 }, { x: 94, y: 46, s: 1, d: 1.2 },
  { x: 4, y: 62, s: 0.7, d: 1.8 }, { x: 70, y: 92, s: 0.9, d: 0.9 }, { x: 30, y: 96, s: 0.6, d: 1.5 },
];
---

<span class="gl" aria-hidden="true">
  {sparks.map((p) => <span class="gl__s" style={`left:${p.x}%;top:${p.y}%;--s:${p.s};--d:${p.d}s`}>✦</span>)}
</span>

<style>
  .gl { position: absolute; inset: -0.8rem; pointer-events: none; }
  .gl__s {
    position: absolute; font-size: calc(1.9rem * var(--s)); line-height: 1; color: var(--brand-yellow);
    text-shadow: 0 0 6px rgba(255, 181, 70, 0.7);
    animation: gl-twinkle 2.4s ease-in-out var(--d) infinite;
  }
  .gl__s:nth-child(3n) { color: var(--brand-red); text-shadow: 0 0 6px rgba(215, 57, 62, 0.5); }
  .gl__s:nth-child(3n + 1) { color: var(--brand-blue); text-shadow: 0 0 6px rgba(59, 85, 213, 0.5); }
  @keyframes gl-twinkle {
    0%, 100% { opacity: 0.35; transform: scale(0.6) rotate(0deg); }
    50% { opacity: 1; transform: scale(1) rotate(45deg); }
  }
  :global(.kg-extra:hover) .gl__s { animation-duration: 0.9s; }
  @media (prefers-reduced-motion: reduce) { .gl__s { animation: none; opacity: 0.8; } }
</style>
