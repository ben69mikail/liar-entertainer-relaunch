---
/**
 * One v2 template for all 69 city pages (kinderzauberer-in-*, geburtstag-in-*, clown-in-*).
 * Data comes from src/data/cities/*.json (scripts/extract-cities.ts): seo + hero + the city's own
 * ordered blocks. Text is 1:1 legacy; layout intent was translated into c-* classes.
 *
 * Kids v3 „Manege im Zelt“ (user 2026-10-06, prototype /kindergeburtstag/): K3Hero big-top hero,
 * every photo in the circus-programme frame (ProgramFrame / .c-pf for photos inside the legacy
 * HTML), never cropped; gold-line dividers between blocks; band tone → red velvet, tint → k3-alt;
 * c-card → programme card; video with the tied-back curtain and the premiere searchlights.
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import V2Layout from '../../../layouts/V2Layout.astro';
import Reviews from '../Reviews.astro';
import ReviewBadge from '../ReviewBadge.astro';
import K3Hero from './K3Hero.astro';
import ProgramFrame from './ProgramFrame.astro';
import GoldDivider from './GoldDivider.astro';
import Curtain from './Curtain.astro';
import YouTubeFacade from '../../YouTubeFacade.astro';
import { CONTACT } from '../../../data/site';
import '../../../styles/kids-v3.css';

export interface CityData {
  seo: {
    title: string;
    description: string;
    keywords?: string;
    canonical: string;
    structuredData: object[];
    breadcrumbs?: { name: string; url: string }[];
  };
  hero: { image: string; imageAlt: string; badge: string; h1: string; lead: string[]; crumbs: string; intro: string };
  blocks: (
    | { kind: 'reviews' }
    | { kind: 'stats'; items: { icon: string; num: string; label: string }[] }
    | { kind: 'faq'; head: string; items: { q: string; a: string }[] }
    | { kind: 'video'; head: string; tail: string }
    | { kind: 'gallery'; head: string; images: { asset: string; alt: string }[] }
    | { kind: 'prose'; html: string; tone: 'plain' | 'tint' | 'band' }
  )[];
}
interface Props { city: CityData }
const { city } = Astro.props;

const ASSETS = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });
const asset = (path: string) => {
  const hit = ASSETS[path];
  if (!hit) throw new Error(`CityPage: unknown asset ${path}`);
  return hit.default;
};

/**
 * Replace extractor placeholders <img data-asset="…" alt="…"> with optimized, sized images,
 * each set whole into a circus-programme frame (.c-pf = the ProgramFrame look for raw HTML);
 * the service-area map („Karte …“) stays unframed.
 */
async function withImages(html: string): Promise<string> {
  const re = /<img data-asset="([^"]+)" alt="([^"]*)">/g;
  const jobs = [...html.matchAll(re)].map(async (m) => {
    const img = await getImage({ src: asset(m[1]), width: 900, format: 'webp' });
    const tag = `<img src="${img.src}" width="${img.attributes.width}" height="${img.attributes.height}" alt="${m[2]}" loading="lazy" decoding="async" class="c-img">`;
    // the service-area map stays without a frame (user 2026-10-06)
    const framed = /^Karte /.test(m[2]) ? `<span class="c-map">${tag}</span>` : `<span class="c-pf"><span class="c-pf__photo">${tag}</span></span>`;
    return [m[0], framed] as const;
  });
  let out = html;
  for (const [from, to] of await Promise.all(jobs)) out = out.replace(from, to);
  return out;
}

const heroAsset = asset(city.hero.image);
const intro = await withImages(city.hero.intro);
const blocks = await Promise.all(
  city.blocks.map(async (b) => {
    if (b.kind === 'prose') return { ...b, html: await withImages(b.html) };
    if (b.kind === 'faq') return { ...b, head: await withImages(b.head), items: await Promise.all(b.items.map(async (i) => ({ ...i, a: await withImages(i.a) }))) };
    if (b.kind === 'video') return { ...b, tail: await withImages(b.tail) };
    if (b.kind === 'gallery') return { ...b, head: await withImages(b.head) };
    return b;
  }),
);
// legacy hero was a CSS background (no alt); describe the photo by the page's own headline
const heroAlt = city.hero.imageAlt || `Clown Zauberer LIAR – ${city.hero.h1.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim()}`;
---

<V2Layout
  title={city.seo.title}
  description={city.seo.description}
  keywords={city.seo.keywords}
  canonical={city.seo.canonical}
  ogImage={heroAsset.src}
  structuredData={city.seo.structuredData}
  breadcrumbs={city.seo.breadcrumbs}
>
  <!-- ── Hero: the big top (LCP: no reveal) ── -->
  <K3Hero>
    {city.hero.crumbs && <p class="ct-crumbs" set:html={city.hero.crumbs} />}
    <ReviewBadge />
    <p class="ct-badge" set:html={city.hero.badge} />
    <h1 class="k3-hero__title ct-title" data-letters set:html={city.hero.h1} />
    {city.hero.lead.map((l) => <p class="ct-lead" set:html={l} />)}
    <div class="k3-hero__actions">
      <a class="btn btn--primary" href="/kontakt/" data-confetti>Jetzt unverbindlich anfragen</a>
      <a class="btn btn--ghost" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">Per WhatsApp fragen</a>
    </div>
    <Fragment slot="photo">
      <Image src={heroAsset} alt={heroAlt} widths={[400, 700, 1000]} quality={70} sizes="(max-width: 900px) 80vw, 500px" loading="eager" fetchpriority="high" />
    </Fragment>
  </K3Hero>

  {intro && (
    <section class="ct-intro">
      <div class="container ct-prose" data-reveal set:html={intro} />
    </section>
  )}

  {blocks.map((b) => {
    if (b.kind === 'reviews') return <Reviews />;
    if (b.kind === 'stats')
      return (
        <section class="k3-band k3-band--velvet ct-stats">
          <div class="container">
            <GoldDivider />
            <div class="ct-stats__grid">
              {b.items.map((s, j) => (
                <div class="ct-stat" data-reveal data-reveal-delay={j * 0.08}>
                  <div class="ct-stat__icon">{s.icon}</div>
                  <div class="ct-stat__num" data-count={/^\d{1,3}$/.test(s.num) ? '' : undefined}>{s.num}</div>
                  <div class="ct-stat__label">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    if (b.kind === 'faq')
      return (
        <section class="k3-faq">
          <div class="container k3-narrow">
            <GoldDivider />
            <div class="ct-prose ct-center" set:html={b.head} />
            <div class="k3-faq__list">
              {b.items.map((q) => (
                <details class="k3-faq__item" data-reveal>
                  <summary><span>{q.q}</span></summary>
                  <div class="k3-faq__answer" set:html={q.a} />
                </details>
              ))}
            </div>
          </div>
        </section>
      );
    if (b.kind === 'video')
      return (
        <section class="k3-band k3-band--night k3-premiere">
          <span class="k3-uplight k3-uplight--l" aria-hidden="true"></span>
          <span class="k3-uplight k3-uplight--r" aria-hidden="true"></span>
          <div class="container k3-narrow k3-center">
            <GoldDivider />
            <h2 class="k3-h2">{b.head}</h2>
            <div class="k3-video" data-reveal>
              <Curtain trigger="stage" rest="clamp(2.2rem, 10vw, 4.6rem)" span="min(42rem, 100vw - 2rem)" tieback valance />
              <YouTubeFacade id="Cop0SqRIX4Y" title="Clown Zauberer für Geburtstag, Feier, Veranstaltung in NRW : die lustigste Zaubershow im Pott!" />
            </div>
            <div class="ct-prose" set:html={b.tail} />
          </div>
        </section>
      );
    if (b.kind === 'gallery')
      return (
        <section class="ct-gallery">
          <div class="container">
            <GoldDivider />
            {b.head && <div class="ct-prose ct-center" set:html={b.head} />}
            <div class="ct-gallery__grid">
              {b.images.map((g, j) => (
                <ProgramFrame class="ct-gallery__item" data-reveal data-reveal-delay={(j % 3) * 0.06}>
                  <Image src={asset(g.asset)} alt={g.alt} widths={[300, 600]} quality={60} sizes="(max-width: 900px) 80vw, 320px" loading="lazy" />
                </ProgramFrame>
              ))}
            </div>
          </div>
        </section>
      );
    // prose: the city's own sections, in their own order (band → red velvet, tint → warm paper)
    return (
      <section class:list={[{ 'k3-band k3-band--velvet': b.tone === 'band', 'k3-alt': b.tone === 'tint' }]}>
        <div class="container">
          <GoldDivider />
          <div class="ct-prose" data-reveal set:html={b.html} />
        </div>
      </section>
    );
  })}
</V2Layout>

<style>
  /* ── hero copy on the dark big-top stage ── */
  .ct-crumbs { font-size: 0.85rem; color: rgba(246, 236, 220, 0.8); margin-bottom: 0.7rem !important; }
  .ct-crumbs :global(a) { color: inherit; }
  .ct-badge {
    display: inline-block; margin: var(--space-2) 0 0 !important; padding: 0.3rem 0.95rem; border-radius: 999px;
    font-weight: 800; color: #fff3e2; background: rgba(255, 252, 245, 0.1); box-shadow: inset 0 0 0 1px rgba(233, 200, 119, 0.75);
  }
  .ct-lead { font-size: 1.15rem; font-weight: 700; color: rgba(246, 236, 220, 0.92); }

  /* ── prose: translated legacy layout (c-*) in the v3 look ── */
  .ct-prose { max-width: 62rem; margin-inline: auto; }
  .ct-prose :global(h2) { font-size: clamp(1.75rem, 3.6vw, 2.6rem); line-height: 1.15; font-weight: 600; margin: 0 0 var(--space-3); }
  .ct-prose :global(h3) { font-size: clamp(1.2rem, 2.2vw, 1.5rem); font-weight: 600; margin: var(--space-3) 0 var(--space-1); }
  .ct-prose :global(h4) { font-size: 1.1rem; font-weight: 600; margin: var(--space-2) 0 var(--space-1); }
  .ct-prose :global(ul), .ct-prose :global(ol) { padding-left: 1.2rem; margin: 0 0 var(--space-2); }
  .ct-prose :global(li) { margin-bottom: 0.35rem; }
  /* legacy check lists (<li><span>✓</span> …) get a gold tick, no bullet */
  .ct-prose :global(ul:has(> li > span:first-child)) { list-style: none; padding-left: 0; }
  .ct-prose :global(li > span:first-child) { color: var(--gold); font-weight: 900; margin-right: 0.15rem; }
  .ct-prose :global(.c-center) { text-align: center; }
  .ct-prose :global(.c-small) { font-size: 0.95rem; }
  .ct-prose :global(.c-kicker) {
    display: inline-block; font-family: var(--font-body); font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; font-size: 0.95rem; color: var(--accent-strong);
  }
  .ct-prose :global(.c-grid) { display: grid; gap: var(--space-3); align-items: start; margin: var(--space-2) 0; }
  .ct-prose :global(.c-row) { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  /* c-card = circus-programme card: light paper, fine double gold rule, gold corner flourishes */
  .ct-prose :global(.c-card) {
    position: relative; padding: calc(var(--space-3) + 0.5rem) var(--space-3) var(--space-3); color: var(--ink);
    background:
      var(--orn-tl) left 0.55rem top 0.55rem / 1.5rem no-repeat,
      var(--orn-tr) right 0.55rem top 0.55rem / 1.5rem no-repeat,
      var(--orn-bl) left 0.55rem bottom 0.55rem / 1.5rem no-repeat,
      var(--orn-br) right 0.55rem bottom 0.55rem / 1.5rem no-repeat,
      var(--surface);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.55), inset 0 0 0 5px var(--surface), inset 0 0 0 6px rgba(184, 134, 47, 0.25), var(--shadow);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .ct-prose :global(.c-card:hover) { transform: translateY(-3px); box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.7), inset 0 0 0 5px var(--surface), inset 0 0 0 6px rgba(184, 134, 47, 0.35), var(--shadow-hover); }
  }
  .ct-prose :global(.c-card h3:first-child) { margin-top: 0; }
  .ct-prose :global(.c-num) {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; margin: 0 auto var(--space-1);
    border-radius: 50%; background: var(--surface); color: var(--velvet); box-shadow: inset 0 0 0 1.5px var(--gold);
    font-family: var(--font-display); font-weight: 650; font-size: 1.2rem;
  }
  .ct-prose :global(.c-card:not(.c-center) .c-num) { margin-inline: 0; }
  /* photos inside the legacy HTML: the ProgramFrame look (components/v2/kids/ProgramFrame.astro), never cropped */
  .ct-prose :global(.c-pf) {
    display: block; width: min(100%, 30rem); margin: var(--space-2) auto; padding: 1.3rem;
    border-radius: var(--radius);
    background:
      var(--orn-tl) left 0.45rem top 0.45rem / 1.3rem no-repeat,
      var(--orn-tr) right 0.45rem top 0.45rem / 1.3rem no-repeat,
      var(--orn-bl) left 0.45rem bottom 0.45rem / 1.3rem no-repeat,
      var(--orn-br) right 0.45rem bottom 0.45rem / 1.3rem no-repeat,
      var(--surface);
    box-shadow: inset 0 0 0 1px rgba(184, 134, 47, 0.55), inset 0 0 0 5px var(--surface), inset 0 0 0 6px rgba(184, 134, 47, 0.25), var(--shadow);
  }
  .ct-prose :global(.c-pf__photo) { display: block; overflow: hidden; border-radius: 0.45rem; box-shadow: 0 0 0 1px rgba(184, 134, 47, 0.45); }
  .ct-prose :global(.c-img) { display: block; width: 100%; height: auto; }
  .ct-prose :global(.c-map) { display: block; width: min(100%, 30rem); margin: var(--space-2) auto; }
  .ct-prose :global(.c-map .c-img) { border-radius: var(--radius-sm); }
  /* a card is already a frame: a photo inside it sits flush, without a second frame */
  .ct-prose :global(.c-card .c-pf) { padding: 0; background: none; box-shadow: none; }
  .ct-prose :global(figure) { margin: 0; }
  .ct-prose :global(figcaption) { text-align: center; color: var(--ink-soft); margin-top: 0.4rem; }
  .k3-band .ct-prose :global(figcaption) { color: inherit; opacity: 0.85; }
  /* former JS carousel: the photos side by side, each in its programme frame */
  .ct-prose :global(.c-strip) { display: grid; gap: var(--space-3); margin: var(--space-3) 0 0; }
  .ct-prose :global(.c-strip .c-pf) { margin: 0 auto; width: min(100%, 24rem); }
  .ct-prose :global(.c-strip .c-pf:nth-child(odd)) { rotate: -1deg; }
  .ct-prose :global(.c-strip .c-pf:nth-child(even)) { rotate: 1deg; }
  /* centred running text is hard to read in a narrow column: phones get it ragged-right */
  @media (max-width: 640px) {
    .ct-prose :global(p.c-center:not(.c-kicker)), .ct-prose :global(div.c-center > p) { text-align: left; }
  }
  .ct-prose :global(.btn) { margin: var(--space-1) 0.25rem; }
  .ct-intro .ct-prose :global(p:first-of-type) { font-size: 1.15rem; font-weight: 600; color: var(--ink); }

  /* on the velvet band: light text, cards stay paper with dark text and normal links */
  .k3-band .ct-prose :global(.c-kicker) { color: var(--gold-light); }
  .k3-band .ct-prose :global(.c-card a:not(.btn)) { color: var(--link); }
  .k3-band .ct-prose :global(.c-card .c-kicker) { color: var(--accent-strong); }

  /* ghost buttons on the dark bands (outside the paper cards): light text, gold rule, like the hero */
  [data-zone='kids'] .k3-band .ct-prose :global(.btn--ghost:not(.c-card .btn)) { background: transparent; color: #fff3e2; box-shadow: inset 0 0 0 1.5px #e9c877; }

  /* ── stats: three gold-ruled tiles in the ring ── */
  .ct-stats__grid { display: grid; gap: var(--space-3); }
  .ct-stat {
    text-align: center; padding: var(--space-3); border-radius: var(--radius);
    background: rgba(255, 240, 210, 0.07); box-shadow: inset 0 0 0 1px rgba(233, 200, 119, 0.6), inset 0 0 0 5px rgba(0, 0, 0, 0), inset 0 0 0 6px rgba(233, 200, 119, 0.25);
  }
  .ct-stat__icon { font-size: 2rem; }
  .ct-stat__num { font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 3.4rem); font-weight: 650; line-height: 1; color: #ffe3a3; }
  .ct-stat__label { font-weight: 800; margin-top: 0.3rem; }

  /* ── gallery: every photo whole in its programme frame ── */
  .ct-gallery__grid { display: grid; gap: var(--space-3); margin-top: var(--space-3); justify-items: center; }
  .ct-gallery__grid :global(.ct-gallery__item) { width: min(100%, 22rem); }
  .ct-gallery__grid :global(.ct-gallery__item:nth-child(odd)) { rotate: -1deg; }
  .ct-gallery__grid :global(.ct-gallery__item:nth-child(even)) { rotate: 1deg; }
  .ct-center { text-align: center; }

  @media (min-width: 901px) {
    .ct-prose :global(.c-grid) { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
    .ct-prose :global(.c-strip) { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
    .ct-stats__grid { grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
    .ct-gallery__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; }
    .ct-gallery__grid :global(.ct-gallery__item) { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct-prose :global(.c-card) { transition: none; }
  }
</style>
