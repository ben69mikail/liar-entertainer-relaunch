---
/**
 * Red velvet stage curtain (kids v3, user 2026-10-06): starts closed, then opens from the middle
 * all the way to the sides like a real theatre curtain. Each half is made of soft fabric panels
 * that travel at slightly different times and sway as they go, so the cloth bunches up and
 * ripples instead of moving as one stiff board. Pure CSS (translate + skew only, runs without
 * JS); the resting state is open, so reduced motion simply shows it open.
 *
 * trigger="load"  – opens right after the page paints (hero)
 * trigger="stage" – opens when it scrolls into view (fx.ts data-stage → .is-staged; e.g. video)
 * rest            – how much of each side the gathered curtain still covers when open
 * Decorative only: aria-hidden, never takes clicks.
 */
interface Props {
  trigger?: 'load' | 'stage';
  rest?: string;
  class?: string;
}
const { trigger = 'load', rest = '0px', class: cls } = Astro.props;
const PANELS = 7;
const panels = Array.from({ length: PANELS }, (_, i) => i);
---

<div
  class:list={['cu', `cu--${trigger}`, cls]}
  style={`--rest:${rest};--n:${PANELS}`}
  data-stage={trigger === 'stage' ? '' : undefined}
  aria-hidden="true"
>
  {['l', 'r'].map((side) => (
    <span class={`cu__half cu__half--${side}`}>
      {panels.map((i) => <span class="cu__panel" style={`--i:${i}`}></span>)}
    </span>
  ))}
</div>

<style>
  .cu {
    position: absolute; inset: 0; z-index: 2; pointer-events: none; overflow: hidden;
    container-type: size;
    /* one panel = 1/n of a half; open = all panels gathered inside --rest at the side */
    --w: calc(50cqw / var(--n));
    --gather: max(0px, calc(var(--rest) - var(--w)));
    --ease: cubic-bezier(0.65, 0.02, 0.25, 1);
  }
  .cu__half { position: absolute; top: 0; bottom: 0; width: 50%; }
  .cu__half--l { left: 0; }
  .cu__half--r { right: 0; }

  .cu__panel {
    position: absolute; top: 0; bottom: 0; width: calc(var(--w) + 2px);
    z-index: var(--i); /* inner panels lie over outer ones: the bunched cloth shows its folds */
    /* one soft fold: deep valley at the edges, velvet sheen on the crest */
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2), transparent 20%, transparent 72%, rgba(0, 0, 0, 0.3)),
      linear-gradient(90deg, #66101a 0%, #96182a 20%, #c7323c 47%, #a51d2c 72%, #66101a 100%);
    border-radius: 0 0 40% 40% / 0 0 1.4rem 1.4rem; /* soft hem, no hard corners */
    transform-origin: 50% 0;
    translate: var(--tx);
  }
  .cu__half--l .cu__panel {
    left: calc(var(--i) * var(--w));
    --tx: calc(var(--i) * (var(--gather) / (var(--n) - 1) - var(--w)));
    --sway: -2.5deg;
    box-shadow: -8px 0 16px -8px rgba(40, 0, 6, 0.6);
  }
  .cu__half--r .cu__panel {
    right: calc(var(--i) * var(--w));
    --tx: calc(var(--i) * (var(--w) - var(--gather) / (var(--n) - 1)));
    --sway: 2.5deg;
    box-shadow: 8px 0 16px -8px rgba(40, 0, 6, 0.6);
  }

  /* closed → open: the panel at the middle leads, the outer ones follow a beat later; each one
     leans into the movement and settles back (skew), which reads as heavy fabric. */
  :global(.motion-ok) .cu--load .cu__panel {
    animation:
      cu-slide 1.9s var(--ease) calc(0.25s + (var(--n) - 1 - var(--i)) * 0.08s) backwards,
      cu-sway 1.9s ease-in-out calc(0.25s + (var(--n) - 1 - var(--i)) * 0.08s);
  }
  :global(.motion-ok) .cu--stage:not(.is-staged) .cu__panel { translate: 0 0; }
  :global(.motion-ok) .cu--stage.is-staged .cu__panel {
    animation:
      cu-slide 1.7s var(--ease) calc(0.1s + (var(--n) - 1 - var(--i)) * 0.07s) backwards,
      cu-sway 1.7s ease-in-out calc(0.1s + (var(--n) - 1 - var(--i)) * 0.07s);
  }
  @keyframes cu-slide { from { translate: 0 0; } }
  @keyframes cu-sway { 0%, 100% { transform: skewX(0deg); } 40% { transform: skewX(var(--sway)); } }

  @media (prefers-reduced-motion: reduce) {
    .cu__panel { animation: none !important; translate: var(--tx) !important; }
  }
</style>
