---
// Wimpelkette: decorative circus bunting in the three logo colours.
const flags = Array.from({ length: 18 }, (_, i) => ['var(--brand-red)', 'var(--brand-blue)', 'var(--brand-yellow)'][i % 3]);
---

<div class="bunting" aria-hidden="true">
  <svg viewBox="0 0 1200 70" preserveAspectRatio="none">
    <path d="M0 8 Q600 46 1200 8" fill="none" stroke="var(--line)" stroke-width="2.5" />
  </svg>
  <ul>
    {flags.map((c, i) => <li style={`--c:${c};--i:${i}`}></li>)}
  </ul>
</div>

<style>
  .bunting { position: relative; height: 4.6rem; overflow: hidden; pointer-events: none; }
  /* rope and flags bob together; each motion owns its own property so none overrides another:
     translate = position on the rope curve, transform = drop-in, rotate + scale = wind */
  .bunting > svg, .bunting > ul { animation: rope 3.8s ease-in-out infinite alternate; }
  .bunting svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bunting ul {
    position: absolute; inset: 0; display: flex; justify-content: space-between;
    margin: 0; padding: 0 1%; list-style: none;
  }
  .bunting li {
    width: 2.6rem; height: 2.8rem; background: var(--c);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    translate: 0 calc(0.45rem + sin((var(--i) / 17) * 3.1416) * 1.35rem);
    transform-origin: top center;
    filter: drop-shadow(2px 2px 0 var(--line));
    /* flags drop in one by one, then a wind wave runs along the line with a gust every ~7 s */
    animation:
      drop 0.7s var(--ease-out-expo) calc(var(--i) * 0.045s) backwards,
      wind 7.2s ease-in-out calc(var(--i) * -0.16s) infinite;
  }
  .bunting li:nth-child(odd) { width: 2.4rem; }
  @keyframes drop { from { transform: translateY(-150%); } }
  @keyframes wind {
    0%, 100% { rotate: -5deg; scale: 1 1; }
    12% { rotate: 6deg; scale: 0.94 1.03; }
    24% { rotate: -4deg; scale: 1 1; }
    36% { rotate: 5deg; scale: 0.96 1.02; }
    50% { rotate: -3deg; }
    58% { rotate: 17deg; scale: 0.86 1.06; } /* gust */
    66% { rotate: -9deg; scale: 0.95 1; }
    76% { rotate: 6deg; }
    88% { rotate: -6deg; scale: 0.97 1.02; }
  }
  @keyframes rope { from { transform: translateY(-2px); } to { transform: translateY(3px); } }
  @media (max-width: 640px) { .bunting li:nth-child(n + 10) { display: none; } }
  @media (prefers-reduced-motion: reduce) { .bunting li, .bunting > svg, .bunting > ul { animation: none; } }
</style>
