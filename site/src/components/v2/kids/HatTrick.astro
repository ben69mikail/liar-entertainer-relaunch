---
/**
 * Kids counterpart of the adult pick-a-card trick: tap the top hat and something new
 * comes out each time (rabbit → dove → balloon → bouquet). Wired by fx-rich.ts hatTrick().
 * Without JS: a hat with the rabbit peeking out. Results are announced to screen readers.
 */
const ink = '#2b1d17';
---

<div class="ht" data-hat-trick>
  <div class="ht__wrap">
  <div class="ht__stage" aria-hidden="true">
    <!-- rabbit -->
    <svg class="ht__item is-up" data-name="Ein Hase!" viewBox="0 0 80 90">
      <ellipse cx="28" cy="20" rx="7" ry="20" fill="#fff" stroke={ink} stroke-width="3" />
      <ellipse cx="50" cy="18" rx="7" ry="20" fill="#fff" stroke={ink} stroke-width="3" transform="rotate(12 50 18)" />
      <ellipse cx="28" cy="22" rx="3" ry="12" fill="#ffb7c0" />
      <circle cx="40" cy="58" r="24" fill="#fff" stroke={ink} stroke-width="3" />
      <circle cx="32" cy="54" r="3" fill={ink} /><circle cx="48" cy="54" r="3" fill={ink} />
      <ellipse cx="40" cy="63" rx="4" ry="3" fill="#ff8fa3" />
      <path d="M36 68q4 4 8 0" fill="none" stroke={ink} stroke-width="2.5" stroke-linecap="round" />
    </svg>
    <!-- dove -->
    <svg class="ht__item" data-name="Eine Taube!" viewBox="0 0 90 80">
      <path d="M18 52c0-16 14-28 32-26 10 1 18 8 20 16l12-6-6 14c-4 14-20 22-36 20C26 69 18 62 18 52z" fill="#fff" stroke={ink} stroke-width="3" stroke-linejoin="round" />
      <path class="ht__wing" d="M40 44c4-18 20-30 36-30-6 12-10 26-22 32" fill="#f4f1ff" stroke={ink} stroke-width="3" stroke-linejoin="round" />
      <circle cx="30" cy="44" r="2.6" fill={ink} />
      <path d="M18 46l-9 3 9 4" fill="#ffb546" stroke={ink} stroke-width="2.5" stroke-linejoin="round" />
    </svg>
    <!-- balloon -->
    <svg class="ht__item" data-name="Ein Luftballon!" viewBox="0 0 60 100">
      <path d="M30 4C14 4 6 18 6 32c0 18 14 32 24 36 10-4 24-18 24-36C54 18 46 4 30 4z" fill="#d7393e" stroke={ink} stroke-width="3" />
      <ellipse cx="21" cy="22" rx="5" ry="9" fill="#fff" opacity=".5" transform="rotate(-20 21 22)" />
      <path d="M27 68l3 5 3-5z" fill="#d7393e" stroke={ink} stroke-width="2" />
      <path d="M30 73c-5 7 5 12 0 19" fill="none" stroke={ink} stroke-width="2" />
    </svg>
    <!-- bouquet -->
    <svg class="ht__item" data-name="Ein Blumenstrauß!" viewBox="0 0 90 90">
      <path d="M45 88 30 50M45 88l15-38M45 88V44" stroke="#2f8f4e" stroke-width="4" stroke-linecap="round" />
      <g stroke={ink} stroke-width="2.5">
        <circle cx="28" cy="40" r="11" fill="#ff8fa3" /><circle cx="28" cy="40" r="4" fill="#ffb546" />
        <circle cx="62" cy="40" r="11" fill="#3b55d5" /><circle cx="62" cy="40" r="4" fill="#ffb546" />
        <circle cx="45" cy="28" r="13" fill="#d7393e" /><circle cx="45" cy="28" r="5" fill="#ffb546" />
      </g>
    </svg>
    <span class="ht__puff"></span>
  </div>

  <button type="button" class="ht__hat" aria-describedby="ht-hint">
    <span class="sr-only">Zaubertrick: etwas aus dem Zylinder zaubern</span>
    <svg viewBox="0 0 120 90" aria-hidden="true">
      <rect x="28" y="8" width="64" height="62" rx="6" fill={ink} />
      <rect x="28" y="50" width="64" height="12" fill="var(--brand-red)" />
      <ellipse cx="60" cy="72" rx="56" ry="12" fill={ink} />
      <ellipse cx="60" cy="9" rx="32" ry="7" fill="#46332a" />
    </svg>
  </button>
  </div>
  <p class="ht__hint" id="ht-hint">Tipp auf den Zylinder!</p>
  <span class="sr-only" aria-live="polite" data-hat-live></span>
</div>

<style>
  .ht { position: relative; width: 9rem; margin: 0 auto var(--space-3); text-align: center; }
  /* hat and stage share one box: the stage sits on the brim, items rise out of the hat's mouth */
  .ht__wrap { position: relative; padding-top: 5.5rem; }
  .ht__stage {
    position: absolute; left: 50%; top: 0; width: 5.6rem; height: 6.6rem;
    translate: -50% 0; overflow: hidden; pointer-events: none; z-index: 2;
  }
  .ht__item {
    position: absolute; left: 0; bottom: 0; width: 100%; height: 100%;
    transform: translateY(105%);
  }
  /* no-JS / initial state: the rabbit peeks out */
  .ht__item.is-up { transform: translateY(-4%) rotate(-6deg); }
  .ht__puff {
    position: absolute; inset: auto 0 -0.6rem; height: 3rem; opacity: 0;
    background:
      radial-gradient(circle at 20% 60%, #fff 0 22%, transparent 23%),
      radial-gradient(circle at 50% 40%, #fff 0 26%, transparent 27%),
      radial-gradient(circle at 80% 60%, #fff 0 22%, transparent 23%);
  }
  .ht__hat {
    display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer;
    position: relative; z-index: 1; transform-origin: 50% 90%;
  }
  .ht__hat svg { display: block; width: 100%; filter: drop-shadow(4px 4px 0 rgba(0, 0, 0, 0.25)); }
  .ht__hat:focus-visible { outline: 3px solid var(--brand-yellow); outline-offset: 4px; border-radius: 1rem; }
  @media (hover: hover) and (pointer: fine) {
    .ht__hat:hover { rotate: -4deg; }
  }
  .ht__hat { transition: rotate 0.25s var(--ease-out-expo); }
  .ht__hint {
    margin: 0.4rem 0 0; font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: inherit;
    white-space: nowrap;
  }
</style>
