---
import { CONTACT } from '../../data/site';
// Brief: "Anfragen" + Telefon/WhatsApp immer erreichbar. Pure links, no third-party script.
---

<nav class="sc" aria-label="Schnellkontakt" data-sticky-cta>
  <a class="sc__btn" href={CONTACT.phoneHref}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.2 11.4 11.4 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.6 3.6a1 1 0 0 1-.3 1z" /></svg>
    <span>Anrufen</span>
  </a>
  <a class="sc__btn sc__btn--wa" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.1.1.7-.1 1.3z" /></svg>
    <span>WhatsApp</span>
  </a>
  <a class="sc__btn sc__btn--main" href="/kontakt/">
    <span>Jetzt anfragen</span>
  </a>
</nav>

<style>
  /* mobile devices only (user, 2026-10-07): phones + touch tablets; never on a desktop with a mouse */
  .sc {
    position: fixed;
    z-index: 60;
    display: none;
    grid-template-columns: 1fr 1fr 1.4fr;
    inset: auto 0 0 0;
    padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom));
    gap: 0.4rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-top: var(--border);
  }
  .sc__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    border: var(--border);
  }
  .sc__btn svg { width: 1.15rem; height: 1.15rem; fill: currentColor; flex: none; }
  .sc__btn--wa { color: #0f7a35; }
  .sc__btn--main { background: var(--accent-strong); color: var(--accent-ink); }

  @media (max-width: 767.98px), (hover: none) and (pointer: coarse) {
    .sc { display: grid; }
    :global(body.v2) { padding-bottom: calc(4.2rem + env(safe-area-inset-bottom)); }
  }

  :global([data-zone='adult']) .sc__btn { border-radius: var(--radius-sm); font-family: var(--font-body); font-weight: 600; letter-spacing: 0.04em; }
  :global([data-zone='adult']) .sc { border-radius: var(--radius); }
  :global([data-zone='adult']) .sc__btn--main { background: var(--ink); }
</style>
