---
import { Image } from 'astro:assets';
import clownLogo from '../../assets/images/general/logo-clown-nrw.png';
import goldLogo from '../../assets/images/brand/logo-liar-gold.webp';
import { CONTACT, FOOTER_MAIN, FOOTER_NEWS, LEGAL_NAV } from '../../data/site';
import { zoneFor } from '../../lib/site-map';

const adult = zoneFor(Astro.url.pathname) === 'adult';
const external = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---

<footer class="sf">
  <div class="container sf__grid">
    <div>
      <h2 class="sf__h">Infos</h2>
      {adult
        ? <Image src={goldLogo} alt="Zauberer LIAR – Zauberei & Comedy" width={150} loading="lazy" class="sf__logo" />
        : <Image src={clownLogo} alt="LOGO Clown Zauberer LIAR" width={110} loading="lazy" class="sf__logo" />}
      <p>{CONTACT.name}<br />{CONTACT.person}<br />{CONTACT.address}</p>
      <p>
        Tel: <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a><br />
        Email: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </p>
      <p><a href={CONTACT.googleReviewHref} target="_blank" rel="noopener noreferrer">⭐ Bewertung auf Google schreiben</a></p>
    </div>
    <div>
      <h2 class="sf__h">News Clown Zauberer</h2>
      <ul>{FOOTER_NEWS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="sf__h">Social Media</h2>
      <ul>
        <li><a href={CONTACT.instagram.href} target="_blank" rel="noopener noreferrer">Instagram {CONTACT.instagram.label}</a></li>
        <li><a href={CONTACT.facebook.href} target="_blank" rel="noopener noreferrer">Facebook {CONTACT.facebook.label}</a></li>
      </ul>
      <h2 class="sf__h">Hauptseiten</h2>
      <ul>{FOOTER_MAIN.map((l) => <li><a href={l.href} {...external(l.href)}>{l.label}</a></li>)}</ul>
    </div>
  </div>
  <div class="container sf__bottom">
    <p>&copy; {new Date().getFullYear()} Clown Zauberer LIAR – Alle Rechte vorbehalten</p>
    <nav aria-label="Rechtliches">
      {LEGAL_NAV.map((l) => <a href={l.href}>{l.label}</a>)}
      <button type="button" onclick="window.liarOpenConsent && window.liarOpenConsent()">Cookie-Einstellungen</button>
    </nav>
  </div>
</footer>

<style>
  .sf { background: var(--ink); color: var(--bg); padding-block: var(--space-5) var(--space-4); font-size: 0.95rem; }
  /* keep legal links clear of the desktop contact dock */
  @media (min-width: 768px) { .sf { padding-bottom: 6.5rem; } }
  :global([data-zone='adult']) .sf { background: var(--ink); color: var(--bg); }
  .sf__grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .sf__h { font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 0.75rem; color: inherit; }
  .sf__h:not(:first-child) { margin-top: var(--space-3); }
  .sf__logo { height: auto; margin-bottom: 0.75rem; background: #fff; border-radius: 0.75rem; padding: 0.4rem; }
  :global([data-zone='adult']) .sf__logo { background: none; padding: 0; }
  .sf ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .sf a { color: inherit; text-underline-offset: 0.2em; }
  .sf a:hover { color: var(--accent-3); }
  .sf__bottom {
    display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: space-between; align-items: center;
    margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    font-size: 0.85rem;
  }
  .sf__bottom p { margin: 0; }
  .sf__bottom nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  .sf__bottom button { color: inherit; text-decoration: underline; background: none; border: 0; cursor: pointer; font: inherit; }
</style>
