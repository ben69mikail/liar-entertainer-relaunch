---
/**
 * Circus sign "Ich spreche auch Französisch · Englisch · Spanisch" (user, 2026-10-09): small board,
 * six cartoon arrows around it (left, right, two above, two below) that blink in a marquee chase
 * and nudge towards it. Rendered once per page by V2Layout; src/lib/place-sign.ts moves it between
 * two sections (start of the 3rd section, after its divider) so it fills a gap, not the hero.
 * Kids/neutral: programme-sheet ivory with a gold double rule, Fraunces, circus-red arrows.
 * Adult: the same board in the salon voice (Bodoni, gold arrows).
 * Motion: opacity/transform of whole elements only; still for prefers-reduced-motion.
 */
const arrow = 'M4 30c10-2 22-3 34-2l-1-9 23 15-24 13 2-9c-11-1-22 0-33 2z';
const ARROWS = ['l', 'tl', 'tr', 'r', 'br', 'bl'];
---

<Fragment set:html="<!--ls-->" />
<div class="ls" data-language-sign>
  {ARROWS.map((a) => <svg class={`ls__arrow ls__arrow--${a}`} viewBox="0 0 64 56" aria-hidden="true"><path d={arrow} /></svg>)}
  <div class="ls__board">
    <span class="ls__bulbs" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <p class="ls__text"><span class="ls__kicker">Ich spreche auch</span> <span class="ls__langs">Französisch · Englisch · Spanisch</span></p>
  </div>
</div>
<Fragment set:html="<!--/ls-->" />

<style>
  .ls {
    --ls-red: #c8102e;
    --ls-ink: #3b0c14;
    --ls-gold: #b8862f;
    --ls-a: clamp(1.8rem, 4vw, 2.4rem); /* arrow size */
    position: relative; width: fit-content; max-width: 100%;
    margin: 0 auto var(--space-4);
    padding: calc(var(--ls-a) + 0.25rem) calc(var(--ls-a) + 0.45rem);
  }
  .ls__board {
    position: relative; rotate: -2deg; text-align: center;
    padding: 0.62rem 1.2rem 0.52rem;
    background: #fffaf0; color: var(--ls-ink); border-radius: 0.75rem;
    box-shadow:
      inset 0 0 0 1.5px var(--ls-gold), inset 0 0 0 3.5px #fffaf0, inset 0 0 0 4.5px rgba(184, 134, 47, 0.55),
      0 10px 20px -12px rgba(0, 0, 0, 0.5);
  }
  .ls__text { margin: 0 !important; line-height: 1.15; font-family: var(--font-display); text-wrap: balance; }
  .ls__kicker { display: block; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.02em; color: var(--ls-red); }
  .ls__langs { display: block; font-size: clamp(1.05rem, 2vw, 1.25rem); font-weight: 650; }
  /* every second sign on a long page leans the other way */
  .ls--r .ls__board { rotate: 2deg; }

  /* marquee bulbs on the top edge */
  .ls__bulbs { position: absolute; inset: -0.35rem 1rem auto; display: flex; justify-content: space-between; }
  .ls__bulbs i {
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff8d6, #ffd36b 45%, #d99a1e);
    box-shadow: 0 0 4px 1px rgba(255, 205, 90, 0.85);
  }

  /* six arrows around the board, all pointing at it */
  .ls__arrow { position: absolute; width: var(--ls-a); height: auto; overflow: visible; filter: drop-shadow(0 0 4px rgba(255, 214, 120, 0.7)); }
  .ls__arrow path { fill: #e8243f; stroke: #fff3e2; stroke-width: 4; stroke-linejoin: round; paint-order: stroke; }
  .ls__arrow--l { left: 0; top: 50%; margin-top: calc(var(--ls-a) * -0.44); --ls-dx: 1; }
  .ls__arrow--r { right: 0; top: 50%; margin-top: calc(var(--ls-a) * -0.44); scale: -1 1; --ls-dx: -1; }
  .ls__arrow--tl, .ls__arrow--tr { top: 0; rotate: 90deg; --ls-dy: 1; }
  .ls__arrow--bl, .ls__arrow--br { bottom: 0; rotate: -90deg; --ls-dy: -1; }
  .ls__arrow--tl, .ls__arrow--bl { left: 28%; }
  .ls__arrow--tr, .ls__arrow--br { right: 28%; }

  /* adult salon voice */
  :global(html[data-zone='adult']) .ls__text { font-family: 'Bodoni Moda', var(--font-display), serif; }
  :global(html[data-zone='adult']) .ls__kicker { font-family: var(--font-body); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8a0f22; }
  :global(html[data-zone='adult']) .ls__arrow path { fill: #b8862f; stroke: #fff6e3; }
  :global(html[data-zone='adult']) .ls__board { rotate: -1deg; }
  :global(html[data-zone='adult']) .ls--r .ls__board { rotate: 1deg; }

  @media (prefers-reduced-motion: no-preference) {
    /* whole element only (composited), a marquee chase around the board */
    .ls__arrow { animation: ls-arrow 1.2s infinite; will-change: transform, opacity; }
    .ls__arrow--tl { animation-delay: 0.2s; }
    .ls__arrow--tr { animation-delay: 0.4s; }
    .ls__arrow--r { animation-delay: 0.6s; }
    .ls__arrow--br { animation-delay: 0.8s; }
    .ls__arrow--bl { animation-delay: 1s; }
    .ls__bulbs i { animation: ls-bulb 1.6s ease-in-out infinite; }
    .ls__bulbs i:nth-child(2n) { animation-delay: 0.8s; }
  }
  @keyframes ls-arrow {
    0% { opacity: 1; translate: 0 0; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    18% { opacity: 1; translate: calc(var(--ls-dx, 0) * 4px) calc(var(--ls-dy, 0) * 4px); }
    45% { opacity: 1; translate: 0 0; }
    50%, 95% { opacity: 0.25; }
    100% { opacity: 1; }
  }
  @keyframes ls-bulb { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
</style>
