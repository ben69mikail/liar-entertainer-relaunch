---
// Pastell-Hero-Stage: ruhige, markenfarbene Gradient-Blobs + dezente Magie-Funken
// hinter dem Slot-Inhalt. Reines CSS (Klassen in global.css), reduced-motion-safe.
// blobOpacity erlaubt Abstufung pro Seitentyp (Default 0.62 = etwas dezenter als Startseite).
interface Props {
  class?: string;
  blobOpacity?: number;
  sparkles?: boolean;
}
const { class: cls = '', blobOpacity = 0.62, sparkles = true } = Astro.props;
const styleVar = `--blob-opacity:${blobOpacity}`;
---
<div class:list={["hero-stage relative overflow-hidden", cls]} style={styleVar}>
  <div class="hero-blobs" aria-hidden="true">
    <span class="blob blob-red"></span>
    <span class="blob blob-blue"></span>
    <span class="blob blob-gold"></span>
  </div>
  {sparkles && (
    <div class="hero-sparkles" aria-hidden="true">
      <span class="spark" style="top:10%; left:7%;">✦</span>
      <span class="spark" style="top:5%; left:40%;">✧</span>
      <span class="spark" style="top:14%; right:9%;">✦</span>
      <span class="spark" style="top:60%; left:5%;">✧</span>
      <span class="spark" style="top:66%; right:7%;">✦</span>
    </div>
  )}
  <slot />
</div>
